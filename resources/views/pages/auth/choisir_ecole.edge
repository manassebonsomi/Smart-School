<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Choisir une école | Smart School</title>

    <meta
        name="description"
        content="Sélectionnez l'école que vous souhaitez gérer dans Smart School."
    >

    <script src="https://cdn.tailwindcss.com"></script>

    <link
        rel="preconnect"
        href="https://fonts.googleapis.com"
    >
    <link
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    >
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

    <style>

        html,
        body {
            min-height: 100%;
        }

        body {
            font-family: 'Inter', sans-serif;
        }

        .page-bg {
            background:
                radial-gradient(
                    circle at top left,
                    rgba(59, 130, 246, 0.10),
                    transparent 32%
                ),
                radial-gradient(
                    circle at bottom right,
                    rgba(15, 23, 42, 0.06),
                    transparent 34%
                ),
                #f8fafc;
        }

        .school-card {
            transition:
                transform 180ms ease,
                box-shadow 180ms ease,
                border-color 180ms ease;
        }

        .school-card:hover {
            transform: translateY(-3px);
        }

        .school-card.is-loading {
            pointer-events: none;
            opacity: 0.7;
        }

        .school-card.active {
            border-color: rgb(37 99 235);
            box-shadow:
                0 20px 45px rgba(37, 99, 235, 0.10);
        }

        .fade-in {
            animation: fadeIn 320ms ease-out;
        }

        @keyframes fadeIn {

            from {
                opacity: 0;
                transform: translateY(8px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }

        }

        .spinner {
            animation: spin 800ms linear infinite;
        }

        @keyframes spin {

            from {
                transform: rotate(0deg);
            }

            to {
                transform: rotate(360deg);
            }

        }

        .scrollbar-thin::-webkit-scrollbar {
            width: 6px;
        }

        .scrollbar-thin::-webkit-scrollbar-track {
            background: transparent;
        }

        .scrollbar-thin::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 999px;
        }

    </style>
</head>

<body class="page-bg min-h-screen text-slate-800">

    <!-- =========================================================
         PAGE
    ========================================================== -->

    <div class="min-h-screen">

        <!-- =====================================================
             HEADER
        ====================================================== -->

        <header class="border-b border-slate-200 bg-white/90 backdrop-blur">
            <div
                class="
                    mx-auto
                    flex
                    max-w-7xl
                    items-center
                    justify-between
                    gap-4
                    px-4
                    py-4
                    sm:px-6
                    lg:px-8
                "
            >

                <!-- BRAND -->

                <div class="flex items-center gap-3">

                    <div
                        class="
                            flex
                            h-11
                            w-11
                            shrink-0
                            items-center
                            justify-center
                            rounded-xl
                            bg-blue-600
                            text-white
                            shadow-sm
                        "
                    >
                        <i class="fa-solid fa-school"></i>
                    </div>

                    <div>

                        <p
                            class="
                                text-sm
                                font-extrabold
                                tracking-tight
                                text-slate-900
                            "
                        >
                            Smart School
                        </p>

                        <p class="text-xs text-slate-400">
                            Gestion scolaire intelligente
                        </p>

                    </div>

                </div>

                <!-- USER -->

                <div class="flex items-center gap-3">

                    <div class="hidden text-right sm:block">

                        <p
                            id="headerUserName"
                            class="
                                text-sm
                                font-semibold
                                text-slate-700
                            "
                        >
                            Chargement...
                        </p>

                        <p
                            id="headerUserEmail"
                            class="
                                text-xs
                                text-slate-400
                            "
                        >
                            —
                        </p>

                    </div>

                    <div
                        id="headerAvatar"
                        class="
                            flex
                            h-10
                            w-10
                            items-center
                            justify-center
                            rounded-full
                            bg-slate-900
                            text-sm
                            font-bold
                            text-white
                        "
                    >
                        SS
                    </div>

                </div>

            </div>
        </header>


        <!-- =====================================================
             MAIN
        ====================================================== -->

        <main class="px-4 py-8 sm:px-6 sm:py-12 lg:px-8">

            <div class="mx-auto max-w-6xl">

                <!-- INTRO -->

                <div
                    class="
                        mx-auto
                        max-w-2xl
                        text-center
                    "
                >

                    <div
                        class="
                            mx-auto
                            flex
                            h-16
                            w-16
                            items-center
                            justify-center
                            rounded-2xl
                            bg-blue-50
                            text-blue-600
                        "
                    >
                        <i class="fa-solid fa-building-columns text-2xl"></i>
                    </div>

                    <h1
                        class="
                            mt-6
                            text-3xl
                            font-extrabold
                            tracking-tight
                            text-slate-900
                            sm:text-4xl
                        "
                    >
                        Choisissez votre école
                    </h1>

                    <p
                        class="
                            mx-auto
                            mt-3
                            max-w-xl
                            text-sm
                            leading-6
                            text-slate-500
                            sm:text-base
                        "
                    >
                        Votre compte est associé à plusieurs établissements.
                        Sélectionnez l'école dans laquelle vous souhaitez
                        travailler actuellement.
                    </p>

                </div>


                <!-- =================================================
                     ERROR
                ================================================== -->

                <div
                    id="pageError"
                    class="
                        mx-auto
                        mt-8
                        hidden
                        max-w-3xl
                        rounded-2xl
                        border
                        border-red-200
                        bg-red-50
                        px-5
                        py-4
                        text-sm
                        text-red-700
                    "
                >
                    <div class="flex items-start gap-3">

                        <i class="fa-solid fa-circle-exclamation mt-0.5"></i>

                        <div>
                            <p
                                id="pageErrorMessage"
                                class="font-medium"
                            >
                                Une erreur est survenue.
                            </p>
                        </div>

                    </div>
                </div>


                <!-- =================================================
                     LOADING
                ================================================== -->

                <div
                    id="loadingState"
                    class="mt-10"
                >

                    <div
                        class="
                            mx-auto
                            flex
                            max-w-md
                            flex-col
                            items-center
                            justify-center
                            rounded-3xl
                            border
                            border-slate-200
                            bg-white
                            px-6
                            py-12
                            text-center
                            shadow-sm
                        "
                    >

                        <div
                            class="
                                flex
                                h-14
                                w-14
                                items-center
                                justify-center
                                rounded-2xl
                                bg-blue-50
                                text-blue-600
                            "
                        >
                            <i
                                class="
                                    fa-solid
                                    fa-spinner
                                    spinner
                                    text-xl
                                "
                            ></i>
                        </div>

                        <p
                            class="
                                mt-5
                                text-sm
                                font-semibold
                                text-slate-700
                            "
                        >
                            Chargement de vos écoles...
                        </p>

                        <p
                            class="
                                mt-1
                                text-xs
                                text-slate-400
                            "
                        >
                            Préparation de votre espace de travail
                        </p>

                    </div>

                </div>


                <!-- =================================================
                     EMPTY
                ================================================== -->

                <div
                    id="emptyState"
                    class="
                        mt-10
                        hidden
                    "
                >

                    <div
                        class="
                            mx-auto
                            max-w-md
                            rounded-3xl
                            border
                            border-slate-200
                            bg-white
                            px-6
                            py-12
                            text-center
                            shadow-sm
                        "
                    >

                        <div
                            class="
                                mx-auto
                                flex
                                h-14
                                w-14
                                items-center
                                justify-center
                                rounded-2xl
                                bg-slate-100
                                text-slate-400
                            "
                        >
                            <i class="fa-solid fa-school-lock text-xl"></i>
                        </div>

                        <h2
                            class="
                                mt-5
                                text-lg
                                font-bold
                                text-slate-800
                            "
                        >
                            Aucune école disponible
                        </h2>

                        <p
                            class="
                                mt-2
                                text-sm
                                leading-6
                                text-slate-500
                            "
                        >
                            Votre compte n'est actuellement associé à aucune
                            école active.
                        </p>

                        <button
                            id="emptyLogoutButton"
                            type="button"
                            class="
                                mt-6
                                inline-flex
                                items-center
                                justify-center
                                gap-2
                                rounded-xl
                                bg-slate-900
                                px-5
                                py-3
                                text-sm
                                font-semibold
                                text-white
                                transition
                                hover:bg-slate-800
                            "
                        >
                            <i class="fa-solid fa-right-from-bracket"></i>
                            Se déconnecter
                        </button>

                    </div>

                </div>


                <!-- =================================================
                     SCHOOL LIST
                ================================================== -->

                <div
                    id="schoolsSection"
                    class="mt-10 hidden"
                >

                    <div
                        id="schoolsGrid"
                        class="
                            grid
                            grid-cols-1
                            gap-5
                            md:grid-cols-2
                            xl:grid-cols-3
                        "
                    ></div>

                </div>


                <!-- =================================================
                     FOOTER
                ================================================== -->

                <div
                    class="
                        mx-auto
                        mt-10
                        flex
                        max-w-3xl
                        flex-col
                        items-center
                        justify-between
                        gap-3
                        border-t
                        border-slate-200
                        pt-6
                        text-center
                        sm:flex-row
                        sm:text-left
                    "
                >

                    <div>

                        <p
                            class="
                                text-xs
                                font-medium
                                text-slate-500
                            "
                        >
                            Une seule école peut être active à la fois.
                        </p>

                        <p
                            class="
                                mt-1
                                text-xs
                                text-slate-400
                            "
                        >
                            Vous pourrez changer d'école depuis votre espace
                            de travail.
                        </p>

                    </div>

                    <button
                        id="logoutButton"
                        type="button"
                        class="
                            inline-flex
                            items-center
                            gap-2
                            rounded-lg
                            px-3
                            py-2
                            text-xs
                            font-semibold
                            text-slate-500
                            transition
                            hover:bg-white
                            hover:text-red-600
                        "
                    >
                        <i class="fa-solid fa-right-from-bracket"></i>
                        Déconnexion
                    </button>

                </div>

            </div>

        </main>

    </div>


<script src="/assets/js/choisir_ecole.js"></script>

</body>
</html>