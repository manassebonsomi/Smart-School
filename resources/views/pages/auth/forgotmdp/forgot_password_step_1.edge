<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Mot de passe oublié | Smart School</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

    <style>
        body {
            font-family:
                Inter,
                ui-sans-serif,
                system-ui,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                sans-serif;
        }

        .form-input {
            width: 100%;
            padding: .85rem 1rem;
            border-radius: .8rem;
            border: 1px solid #e2e8f0;
            background: white;
            outline: none;
            font-size: .875rem;
            transition: .2s ease;
        }

        .form-input:focus {
            border-color: #38bdf8;
            box-shadow: 0 0 0 3px rgba(56,189,248,.15);
        }

        .auth-card {
            box-shadow: 0 25px 60px rgba(15,23,42,.10);
        }

        @media (max-width: 640px) {
            .auth-card {
                box-shadow: none;
            }
        }
    </style>
</head>

<body class="min-h-screen bg-slate-50">

<main class="min-h-screen flex items-center justify-center px-4 py-8 sm:px-6">

    <div class="w-full max-w-5xl">

        <div class="grid lg:grid-cols-2 bg-white rounded-3xl overflow-hidden auth-card border border-slate-200">

            <!-- LEFT -->
            <section
                class="hidden lg:flex flex-col justify-between p-10 xl:p-12 bg-gradient-to-br from-sky-500 to-cyan-400 text-white"
            >

                <div>

                    <div class="flex items-center gap-3">

                        <div class="w-12 h-12 rounded-2xl bg-white/15 flex items-center justify-center">
                            <i class="fa-solid fa-graduation-cap text-xl"></i>
                        </div>

                        <div>
                            <h1 class="text-xl font-bold">
                                Smart School
                            </h1>

                            <p class="text-xs text-white/70">
                                Gestion scolaire intelligente
                            </p>
                        </div>

                    </div>

                    <div class="mt-16">

                        <p class="text-xs uppercase tracking-widest text-white/70 font-semibold">
                            Sécurité du compte
                        </p>

                        <h2 class="mt-4 text-4xl xl:text-5xl font-bold leading-tight">
                            Retrouvons
                            <br>
                            votre accès.
                        </h2>

                        <p class="mt-5 text-sm leading-7 text-white/80 max-w-md">
                            Nous allons vous guider pour récupérer
                            l'accès à votre compte Smart School
                            de manière sécurisée.
                        </p>

                    </div>

                </div>

                <div class="grid grid-cols-2 gap-3 mt-10">

                    <div class="rounded-2xl bg-white/10 border border-white/10 p-4">

                        <i class="fa-solid fa-shield-halved"></i>

                        <p class="text-xs font-semibold mt-3">
                            Sécurisé
                        </p>

                        <p class="text-[10px] text-white/70 mt-1">
                            Protection de vos données
                        </p>

                    </div>

                    <div class="rounded-2xl bg-white/10 border border-white/10 p-4">

                        <i class="fa-solid fa-clock"></i>

                        <p class="text-xs font-semibold mt-3">
                            Rapide
                        </p>

                        <p class="text-[10px] text-white/70 mt-1">
                            Récupération en quelques étapes
                        </p>

                    </div>

                </div>

            </section>


            <!-- RIGHT -->
            <section class="p-6 sm:p-8 lg:p-10 xl:p-12">

                <!-- MOBILE BRAND -->
                <div class="flex lg:hidden items-center gap-3 mb-10">

                    <div class="w-11 h-11 rounded-xl bg-sky-500 text-white flex items-center justify-center">
                        <i class="fa-solid fa-graduation-cap"></i>
                    </div>

                    <div>
                        <h1 class="font-bold">
                            Smart School
                        </h1>

                        <p class="text-xs text-slate-400">
                            Espace sécurisé
                        </p>
                    </div>

                </div>


                <div class="w-14 h-14 rounded-2xl bg-sky-50 text-sky-600 flex items-center justify-center">

                    <i class="fa-solid fa-key text-xl"></i>

                </div>


                <h2 class="mt-6 text-2xl sm:text-3xl font-bold">
                    Mot de passe oublié ?
                </h2>


                <p class="mt-3 text-sm text-slate-500 leading-6">
                    Entrez l'adresse e-mail associée à votre
                    compte. Nous vous enverrons un code de
                    vérification.
                </p>


                @if(flashMessages.has('errors.email'))
                    <div class="mt-6 rounded-xl border border-red-200 bg-red-50 p-4">
                        <div class="flex items-start gap-3">
                            <i class="fa-solid fa-circle-exclamation text-red-500 mt-0.5"></i>

                            <p class="text-sm text-red-700">
                                {{ flashMessages.get('errors.email') }}
                            </p>
                        </div>
                    </div>
                @endif


                @if(flashMessages.has('success'))
                    <div class="mt-6 rounded-xl border border-emerald-200 bg-emerald-50 p-4">
                        <div class="flex items-start gap-3">
                            <i class="fa-solid fa-circle-check text-emerald-500 mt-0.5"></i>

                            <p class="text-sm text-emerald-700">
                                {{ flashMessages.get('success') }}
                            </p>
                        </div>
                    </div>
                @endif


                <form
                    id="forgotPasswordForm"
                    method="POST"
                    action="/password/reset"
                    class="mt-8"
                >

                    {{ csrfField() }}

                    <label
                        for="email"
                        class="block mb-2 text-xs font-semibold text-slate-600"
                    >
                        Adresse e-mail
                    </label>


                    <div class="relative">

                        <i class="fa-regular fa-envelope absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>

                        <input
                            id="email"
                            name="email"
                            type="email"
                            class="form-input pl-11"
                            placeholder="vous@exemple.com"
                            autocomplete="email"
                            required
                        >

                    </div>


                    <button
                        id="submitButton"
                        type="submit"
                        class="mt-5 w-full py-3.5 rounded-xl bg-sky-500 hover:bg-sky-600 text-white font-semibold text-sm flex items-center justify-center gap-2 transition"
                    >

                        <span id="buttonText">
                            Envoyer le code
                        </span>

                        <i
                            id="buttonLoader"
                            class="fa-solid fa-spinner fa-spin hidden"
                        ></i>

                    </button>

                </form>


                <div class="mt-6 p-4 rounded-xl bg-sky-50 border border-sky-100">

                    <div class="flex items-start gap-3">

                        <i class="fa-solid fa-circle-info text-sky-600 mt-0.5"></i>

                        <p class="text-xs text-sky-700 leading-5">
                            Le code de récupération est valable pendant
                            une durée limitée.
                        </p>

                    </div>

                </div>


                <div class="mt-8 text-center">

                    <a
                        href="/"
                        class="text-sm font-semibold text-sky-600 hover:text-sky-700"
                    >
                        <i class="fa-solid fa-arrow-left mr-1"></i>
                        Retour à la connexion
                    </a>

                </div>


                <p class="mt-10 text-center text-xs text-slate-400">
                    © 2026 Smart School. Tous droits réservés.
                </p>

            </section>

        </div>

    </div>

</main>


<script>
    const form = document.getElementById('forgotPasswordForm')
    const button = document.getElementById('submitButton')
    const text = document.getElementById('buttonText')
    const loader = document.getElementById('buttonLoader')

    form.addEventListener('submit', () => {
        button.disabled = true
        button.classList.add('opacity-80', 'cursor-not-allowed')
        text.textContent = 'Envoi en cours...'
        loader.classList.remove('hidden')
    })
</script>

</body>
</html>