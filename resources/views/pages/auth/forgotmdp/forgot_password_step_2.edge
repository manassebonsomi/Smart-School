<!DOCTYPE html>
<html lang="fr">

<head>

    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Vérification | Smart School</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <script>
document.addEventListener('DOMContentLoaded', () => {
    const inputs = document.querySelectorAll('.code-input')
    const form = document.getElementById('verifyForm')
    const code = document.getElementById('code')
    inputs.forEach((input, index) => {
        input.addEventListener('input', () => {
            input.value = input.value.replace(/\D/g, '').slice(0, 1)
            if (input.value && index < inputs.length - 1) inputs[index + 1].focus()
        })
        input.addEventListener('keydown', event => {
            if (event.key === 'Backspace' && !input.value && index > 0) inputs[index - 1].focus()
        })
        input.addEventListener('paste', event => {
            event.preventDefault()
            const pasted = (event.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '').slice(0, 6)
            pasted.split('').forEach((digit, position) => {
                if (inputs[position]) inputs[position].value = digit
            })
            if (inputs[Math.min(pasted.length - 1, inputs.length - 1)]) inputs[Math.min(pasted.length - 1, inputs.length - 1)].focus()
        })
    })
    form?.addEventListener('submit', event => {
        const value = Array.from(inputs).map(input => input.value).join('')
        const error = document.getElementById('codeError')
        if (value.length !== 6) {
            event.preventDefault()
            error.textContent = 'Veuillez saisir les 6 chiffres du code.'
            error.classList.remove('hidden')
            return
        }
        code.value = value
    })
    let seconds = 60
    const resendButton = document.getElementById('resendButton')
    const interval = setInterval(() => {
        seconds--
        const countdown = document.getElementById('countdown')
        if (countdown) countdown.textContent = seconds
        if (seconds <= 0) {
            clearInterval(interval)
            resendButton.disabled = false
            resendButton.classList.remove('text-slate-400', 'cursor-not-allowed')
            resendButton.classList.add('text-sky-600')
            resendButton.textContent = 'Renvoyer le code'
        }
    }, 1000)
})
</script>

</body>
</html>