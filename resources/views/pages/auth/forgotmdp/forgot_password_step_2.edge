        >

        <input
            class="code-input"
            maxlength="1"
            inputmode="numeric"
        >

        <input
            class="code-input"
            maxlength="1"
            inputmode="numeric"
        >

        <input
            class="code-input"
            maxlength="1"
            inputmode="numeric"
        >

        <input
            class="code-input"
            maxlength="1"
            inputmode="numeric"
