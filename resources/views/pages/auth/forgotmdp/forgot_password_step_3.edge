<!DOCTYPE html>
<html lang="fr">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Nouveau mot de passe | Smart School</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <script>
document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('resetPasswordForm')
    const password = document.getElementById('newPassword')
    const confirmation = document.getElementById('confirmPassword')
    const error = document.getElementById('matchError')
    form?.addEventListener('submit', event => {
        error.classList.add('hidden')
        if (password.value !== confirmation.value) {
            event.preventDefault()
            error.textContent = 'Les deux mots de passe ne correspondent pas.'
            error.classList.remove('hidden')
        }
    })
})
function togglePassword(id, button) {
    const input = document.getElementById(id)
    const icon = button.querySelector('i')
    const visible = input.type === 'text'
    input.type = visible ? 'password' : 'text'
    icon.classList.toggle('fa-eye', visible)
    icon.classList.toggle('fa-eye-slash', !visible)
}
function checkStrength() {
    const value = document.getElementById('newPassword').value
    const checks = [value.length >= 8, /[A-Z]/.test(value), /[0-9]/.test(value), /[^A-Za-z0-9]/.test(value)]
    ;['reqLength', 'reqUpper', 'reqNumber', 'reqSpecial'].forEach((id, index) => updateRequirement(id, checks[index]))
    const score = checks.filter(Boolean).length
    const bar = document.getElementById('strengthBar')
    const text = document.getElementById('strengthText')
    bar.style.width = `${score * 25}%`
    bar.style.background = score <= 1 ? '#ef4444' : score <= 3 ? '#f59e0b' : '#10b981'
    text.textContent = score <= 1 ? 'Mot de passe faible' : score <= 3 ? 'Mot de passe moyen' : 'Mot de passe fort'
}
function updateRequirement(id, valid) {
    const element = document.getElementById(id)
    element.classList.toggle('text-slate-400', !valid)
    element.classList.toggle('text-emerald-600', valid)
    const icon = element.querySelector('i')
    icon.className = valid ? 'fa-solid fa-circle-check text-[10px] mr-2' : 'fa-solid fa-circle text-[5px] mr-2'
}
</script>

</body>
</html>