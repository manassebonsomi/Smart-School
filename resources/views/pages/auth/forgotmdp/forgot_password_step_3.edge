<!DOCTYPE html>
<html lang="fr">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Nouveau mot de passe | Smart School</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

    <style>
        body {
            font-family:
                Inter,
                ui-sans-serif,
                system-ui,
                sans-serif;
        }

        .form-input {
            width: 100%;
            padding: .85rem 1rem;
            border-radius: .8rem;
            border: 1px solid #e2e8f0;
            outline: none;
            font-size: .875rem;
            transition: .2s ease;
        }

        .form-input:focus {
            border-color: #38bdf8;
            box-shadow: 0 0 0 3px rgba(56,189,248,.15);
        }

        .strength {
            height: 5px;
            background: #e2e8f0;
            border-radius: 999px;
            overflow: hidden;
        }

        .strength-bar {
            width: 0;
            height: 100%;
            border-radius: 999px;
            transition: .2s ease;
        }
    </style>

</head>

<body class="min-h-screen bg-slate-50">

<main class="min-h-screen flex items-center justify-center px-4 py-8">

    <section class="w-full max-w-xl bg-white rounded-3xl border border-slate-200 shadow-xl p-6 sm:p-8 lg:p-10">

        <div class="flex items-center justify-center gap-3">

            <div class="w-11 h-11 rounded-xl bg-sky-500 text-white flex items-center justify-center">

                <i class="fa-solid fa-graduation-cap"></i>

            </div>

            <div>

                <h1 class="font-bold">
                    Smart School
                </h1>

                <p class="text-xs text-slate-400">
                    Nouveau mot de passe
                </p>

            </div>

        </div>


        <div class="text-center mt-10">

            <div class="mx-auto w-16 h-16 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center">

                <i class="fa-solid fa-lock text-xl"></i>

            </div>

            <h2 class="mt-5 text-2xl font-bold">
                Créer un nouveau mot de passe
            </h2>

            <p class="mt-3 text-sm text-slate-500 leading-6">
                Choisissez un mot de passe suffisamment fort
                pour protéger votre compte.
            </p>

        </div>


        @if(flashMessages.has('errors.password_confirmation'))

            <div class="mt-6 rounded-xl border border-red-200 bg-red-50 p-4">

                <div class="flex items-start gap-3">

                    <i class="fa-solid fa-circle-exclamation text-red-500 mt-0.5"></i>

                    <p class="text-sm text-red-700">
                        {{ flashMessages.get('errors.password_confirmation') }}
                    </p>

                </div>

            </div>

        @endif


        @if(flashMessages.has('error'))

            <div class="mt-6 rounded-xl border border-red-200 bg-red-50 p-4">

                <div class="flex items-start gap-3">

                    <i class="fa-solid fa-circle-exclamation text-red-500 mt-0.5"></i>

                    <p class="text-sm text-red-700">
                        {{ flashMessages.get('error') }}
                    </p>

                </div>

            </div>

        @endif


        <form
            id="resetForm"
            method="POST"
            action="/password/reset/new"
            class="mt-8"
        >

            {{ csrfField() }}

            <label class="block mb-2 text-xs font-semibold text-slate-600">
                Nouveau mot de passe
            </label>

            <div class="relative">

                <input
                    id="newPassword"
                    name="password"
                    type="password"
                    class="form-input pr-12"
                    placeholder="Nouveau mot de passe"
                    minlength="8"
                    required
                >

                <button
                    type="button"
                    onclick="togglePassword('newPassword', this)"
                    class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400"
                >
                    <i class="fa-regular fa-eye"></i>
                </button>

            </div>


            <div class="mt-3">

                <div class="strength">
                    <div id="strengthBar" class="strength-bar"></div>
                </div>

                <p id="strengthText" class="text-[10px] text-slate-400 mt-1">
                    Minimum 8 caractères
                </p>

            </div>


            <div class="mt-5">

                <label class="block mb-2 text-xs font-semibold text-slate-600">
                    Confirmer le mot de passe
                </label>

                <div class="relative">

                    <input
                        id="confirmPassword"
                        name="password_confirmation"
                        type="password"
                        class="form-input pr-12"
                        placeholder="Confirmez le mot de passe"
                        minlength="8"
                        required
                    >

                    <button
                        type="button"
                        onclick="togglePassword('confirmPassword', this)"
                        class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400"
                    >
                        <i class="fa-regular fa-eye"></i>
                    </button>

                </div>

            </div>


            <div class="mt-5 p-4 rounded-xl bg-slate-50 border border-slate-200">

                <p class="text-xs font-semibold text-slate-600">
                    Votre mot de passe doit contenir :
                </p>

                <div class="grid sm:grid-cols-2 gap-2 mt-3">

                    <p id="reqLength" class="text-[10px] text-slate-400">
                        <i class="fa-solid fa-circle text-[5px] mr-2"></i>
                        Au moins 8 caractères
                    </p>

                    <p id="reqUpper" class="text-[10px] text-slate-400">
                        <i class="fa-solid fa-circle text-[5px] mr-2"></i>
                        Une majuscule
                    </p>

                    <p id="reqNumber" class="text-[10px] text-slate-400">
                        <i class="fa-solid fa-circle text-[5px] mr-2"></i>
                        Un chiffre
                    </p>

                    <p id="reqSpecial" class="text-[10px] text-slate-400">
                        <i class="fa-solid fa-circle text-[5px] mr-2"></i>
                        Un caractère spécial
                    </p>

                </div>

            </div>


            <p
                id="passwordError"
                class="hidden mt-3 text-xs text-red-500"
            ></p>


            <button
                id="resetButton"
                type="submit"
                class="mt-6 w-full py-3.5 rounded-xl bg-sky-500 hover:bg-sky-600 text-white text-sm font-semibold flex items-center justify-center gap-2"
            >

                <span id="resetText">
                    Enregistrer le nouveau mot de passe
                </span>

                <i
                    id="resetLoader"
                    class="fa-solid fa-spinner fa-spin hidden"
                ></i>

            </button>

        </form>


        <p class="mt-8 text-center text-xs text-slate-400">
            © 2026 Smart School. Tous droits réservés.
        </p>

    </section>

</main>


<script>
    const password = document.getElementById('newPassword')
    const confirmation = document.getElementById('confirmPassword')

    const error = document.getElementById('passwordError')

    const bar = document.getElementById('strengthBar')
    const strengthText = document.getElementById('strengthText')

    const form = document.getElementById('resetForm')
    const button = document.getElementById('resetButton')
    const buttonText = document.getElementById('resetText')
    const loader = document.getElementById('resetLoader')


    function togglePassword(id, button) {

        const input = document.getElementById(id)
        const icon = button.querySelector('i')

        const isPassword = input.type === 'password'

        input.type = isPassword ? 'text' : 'password'

        icon.classList.toggle('fa-eye', !isPassword)
        icon.classList.toggle('fa-eye-slash', isPassword)
    }


    function updateRequirement(id, valid) {

        const element = document.getElementById(id)

        const icon = element.querySelector('i')

        element.classList.toggle('text-slate-400', !valid)
        element.classList.toggle('text-emerald-600', valid)

        icon.className = valid
            ? 'fa-solid fa-circle-check text-[10px] mr-2'
            : 'fa-solid fa-circle text-[5px] mr-2'
    }


    function checkStrength() {

        const value = password.value

        const checks = {
            length: value.length >= 8,
            upper: /[A-Z]/.test(value),
            number: /[0-9]/.test(value),
            special: /[^A-Za-z0-9]/.test(value),
        }

        updateRequirement('reqLength', checks.length)
        updateRequirement('reqUpper', checks.upper)
        updateRequirement('reqNumber', checks.number)
        updateRequirement('reqSpecial', checks.special)

        const score = Object.values(checks).filter(Boolean).length

        bar.style.width = `${score * 25}%`

        if (score <= 1) {
            bar.style.background = '#ef4444'
            strengthText.textContent = 'Mot de passe faible'
        }
        else if (score <= 3) {
            bar.style.background = '#f59e0b'
            strengthText.textContent = 'Mot de passe moyen'
        }
        else {
            bar.style.background = '#10b981'
            strengthText.textContent = 'Mot de passe fort'
        }
    }


    password.addEventListener('input', checkStrength)


    form.addEventListener('submit', (event) => {

        error.classList.add('hidden')

        const value = password.value
        const confirm = confirmation.value

        const valid =
            value.length >= 8 &&
            /[A-Z]/.test(value) &&
            /[0-9]/.test(value) &&
            /[^A-Za-z0-9]/.test(value)

        if (value !== confirm) {

            event.preventDefault()

            error.textContent =
                'Les deux mots de passe ne correspondent pas.'

            error.classList.remove('hidden')

            return
        }

        if (!valid) {

            event.preventDefault()

            error.textContent =
                'Veuillez respecter toutes les règles de sécurité.'

            error.classList.remove('hidden')

            return
        }

        button.disabled = true
        button.classList.add('opacity-80', 'cursor-not-allowed')

        buttonText.textContent = 'Enregistrement...'
        loader.classList.remove('hidden')
    })
</script>

</body>
</html>