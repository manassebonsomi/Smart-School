<!DOCTYPE html>

<html lang="fr">

<head>

<meta charset="UTF-8">

<meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
>

<meta
    name="description"
    content="Vérification de votre adresse email Smart School"
>

<title>Vérification de l'e-mail | Smart School</title>


<script src="https://cdn.tailwindcss.com"></script>

<script src="https://unpkg.com/lucide@latest"></script>


<script>

    tailwind.config = {

        theme: {

            extend: {

                colors: {

                    primary: {

                        50: '#f0f9ff',
                        100: '#e0f2fe',
                        200: '#bae6fd',
                        300: '#7dd3fc',
                        400: '#38bdf8',
                        500: '#0ea5e9',
                        600: '#0284c7',
                        700: '#0369a1',
                        800: '#075985',
                        900: '#0c4a6e'

                    }

                }

            }

        }

    }

</script>


<style>

    body {

        font-family:
            Inter,
            ui-sans-serif,
            system-ui,
            sans-serif;

    }


    .spinner {

        width: 24px;
        height: 24px;

        border:
            3px solid #bae6fd;

        border-top-color:
            #0284c7;

        border-radius:
            9999px;

        animation:
            spin .7s linear infinite;

    }


    @keyframes spin {

        to {
            transform: rotate(360deg);
        }

    }

</style>
```

</head>

<body
    class="
        min-h-screen
        bg-slate-50
        text-slate-900
        flex
        items-center
        justify-center
        px-5
    "
>

```
<main class="w-full max-w-md">

    <div
        class="
            rounded-3xl
            border
            border-slate-200
            bg-white
            p-8
            shadow-xl
            shadow-slate-200/50
            text-center
        "
    >


        <!-- LOGO -->

        <div
            class="
                mx-auto
                flex
                h-16
                w-16
                items-center
                justify-center
                rounded-2xl
                bg-primary-50
                text-primary-600
            "
        >

            <i
                data-lucide="mail-check"
                class="h-8 w-8"
            ></i>

        </div>


        <!-- LOADING -->

        <div
            id="loadingState"
            class="mt-6"
        >

            <h1
                class="
                    text-xl
                    font-bold
                    text-slate-900
                "
            >
                Vérification de votre e-mail
            </h1>


            <p
                class="
                    mt-3
                    text-sm
                    leading-6
                    text-slate-500
                "
            >
                Nous vérifions votre adresse e-mail.
                Veuillez patienter quelques instants.
            </p>


            <div
                class="
                    mt-6
                    flex
                    justify-center
                "
            >

                <span class="spinner"></span>

            </div>

        </div>


        <!-- SUCCESS -->

        <div
            id="successState"
            class="hidden mt-6"
        >

            <div
                class="
                    mx-auto
                    flex
                    h-14
                    w-14
                    items-center
                    justify-center
                    rounded-full
                    bg-emerald-50
                    text-emerald-600
                "
            >

                <i
                    data-lucide="circle-check"
                    class="h-7 w-7"
                ></i>

            </div>


            <h1
                class="
                    mt-5
                    text-xl
                    font-bold
                    text-emerald-700
                "
            >
                Adresse e-mail vérifiée
            </h1>


            <p
                id="successMessage"
                class="
                    mt-3
                    text-sm
                    leading-6
                    text-slate-500
                "
            >
                Votre adresse e-mail a été vérifiée avec succès.
            </p>


            <a
                href="/"
                class="
                    mt-7
                    inline-flex
                    items-center
                    justify-center
                    gap-2
                    rounded-xl
                    bg-primary-600
                    px-5
                    py-3
                    text-sm
                    font-semibold
                    text-white
                    transition
                    hover:bg-primary-700
                "
            >

                <i
                    data-lucide="log-in"
                    class="h-4 w-4"
                ></i>

                Se connecter

            </a>

        </div>


        <!-- ERROR -->

        <div
            id="errorState"
            class="hidden mt-6"
        >

            <div
                class="
                    mx-auto
                    flex
                    h-14
                    w-14
                    items-center
                    justify-center
                    rounded-full
                    bg-red-50
                    text-red-600
                "
            >

                <i
                    data-lucide="circle-alert"
                    class="h-7 w-7"
                ></i>

            </div>


            <h1
                class="
                    mt-5
                    text-xl
                    font-bold
                    text-red-700
                "
            >
                Vérification impossible
            </h1>


            <p
                id="errorMessage"
                class="
                    mt-3
                    text-sm
                    leading-6
                    text-slate-500
                "
            >
                Le lien de vérification est invalide.
            </p>


            <a
                href="/"
                class="
                    mt-7
                    inline-flex
                    items-center
                    justify-center
                    gap-2
                    rounded-xl
                    border
                    border-slate-200
                    px-5
                    py-3
                    text-sm
                    font-semibold
                    text-slate-700
                    transition
                    hover:bg-slate-50
                "
            >

                Retour à la connexion

            </a>

        </div>


        <p
            class="
                mt-8
                text-xs
                text-slate-400
            "
        >
            © 2026 Smart School. Tous droits réservés.
        </p>

    </div>

</main>


<script>

    lucide.createIcons()


    const token =
        "{{ token }}"


    const loadingState =
        document.getElementById(
            'loadingState'
        )


    const successState =
        document.getElementById(
            'successState'
        )


    const errorState =
        document.getElementById(
            'errorState'
        )


    const successMessage =
        document.getElementById(
            'successMessage'
        )


    const errorMessage =
        document.getElementById(
            'errorMessage'
        )


    async function verifyEmail() {

        try {

            const response =
                await fetch(
                    `/api/auth/verify-email/${encodeURIComponent(token)}`,
                    {

                        method:
                            'GET',

                        headers: {

                            Accept:
                                'application/json',

                        },

                    }
                )


            const result =
                await response
                    .json()
                    .catch(
                        () => null
                    )


            loadingState.classList.add(
                'hidden'
            )


            if (
                !response.ok ||
                !result?.success
            ) {

                errorMessage.textContent =
                    result?.message ||
                    'Le lien de vérification est invalide ou a expiré.'


                errorState.classList.remove(
                    'hidden'
                )


                lucide.createIcons()

                return

            }


            successMessage.textContent =
                result.message ||
                'Votre adresse e-mail a été vérifiée avec succès.'


            successState.classList.remove(
                'hidden'
            )


            lucide.createIcons()

        } catch (
            error
        ) {

            console.error(
                'Erreur vérification email:',
                error
            )


            loadingState.classList.add(
                'hidden'
            )


            errorMessage.textContent =
                'Impossible de contacter le serveur. Veuillez réessayer.'


            errorState.classList.remove(
                'hidden'
            )


            lucide.createIcons()

        }

    }


    verifyEmail()

</script>

</body>

</html>
