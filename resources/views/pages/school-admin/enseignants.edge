<!DOCTYPE html>
<html lang="fr">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Enseignants | Smart School</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            200: '#bae6fd',
                            300: '#7dd3fc',
                            400: '#38bdf8',
                            500: '#0ea5e9',
                            600: '#0284c7',
                            700: '#0369a1',
                            800: '#075985',
                            900: '#0c4a6e'
                        }
                    }
                }
            }
        }
    </script>

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

    <style>

        body {
            font-family:
                Inter,
                ui-sans-serif,
                system-ui,
                sans-serif;
        }

        .menu-link {
            display: flex;
            align-items: center;
            gap: .75rem;
            border-radius: .75rem;
            padding: .75rem 1rem;
            font-size: .875rem;
            color: #475569;
            transition: .2s ease;
        }

        .menu-link:hover {
            background: #f0f9ff;
            color: #0369a1;
        }

        .teacher-card {
            transition:
                transform .2s ease,
                box-shadow .2s ease;
        }

        .teacher-card:hover {
            transform: translateY(-2px);
            box-shadow:
                0 12px 30px
                rgba(15,23,42,.08);
        }

    </style>

</head>

<body class="bg-slate-50 text-slate-900">

<div
    id="overlay"
    class="fixed inset-0 z-40 hidden bg-slate-900/40 lg:hidden"
></div>


<!-- SIDEBAR -->

<aside
    id="sidebar"
    class="
        fixed
        inset-y-0
        left-0
        z-50
        flex
        w-72
        -translate-x-full
        flex-col
        border-r
        border-slate-200
        bg-white
        transition-transform
        lg:translate-x-0
    "
>

    <div
        class="
            flex
            h-20
            items-center
            gap-3
            border-b
            border-slate-100
            px-6
        "
    >

        <div
            class="
                flex
                h-11
                w-11
                items-center
                justify-center
                rounded-xl
                bg-primary-600
                text-white
            "
        >
            <i class="fa-solid fa-school"></i>
        </div>

        <div>

            <h1 class="font-extrabold">
                SMART SCHOOL
            </h1>

            <p class="text-xs text-slate-400">
                Espace établissement
            </p>

        </div>

    </div>


    <div class="flex-1 overflow-y-auto px-4 py-6">

        <div
            class="
                mb-6
                rounded-xl
                bg-primary-50
                p-4
            "
        >

            <p
                class="
                    text-xs
                    font-medium
                    text-primary-600
                "
            >
                Établissement
            </p>

            <p
                id="schoolNameSidebar"
                class="
                    mt-1
                    text-sm
                    font-bold
                    text-primary-900
                "
            >
                —
            </p>

            <p
                id="schoolLocationSidebar"
                class="
                    mt-1
                    text-xs
                    text-primary-600
                "
            >
                —
            </p>

        </div>


        <p
            class="
                mb-3
                px-3
                text-[10px]
                font-bold
                uppercase
                tracking-widest
                text-slate-400
            "
        >
            Principal
        </p>

        <nav class="space-y-1">

            <a
                href="/school-admin/dashboard"
                class="menu-link"
            >
                <i class="fa-solid fa-gauge-high w-4"></i>
                Tableau de bord
            </a>

        </nav>


        <p
            class="
                mb-3
                mt-8
                px-3
                text-[10px]
                font-bold
                uppercase
                tracking-widest
                text-slate-400
            "
        >
            Scolarité
        </p>

        <nav class="space-y-1">

            <a
                href="/school-admin/eleves"
                class="menu-link"
            >
                <i class="fa-solid fa-graduation-cap w-4"></i>
                Élèves
            </a>

            <a
                href="/school-admin/enseignants"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    bg-primary-50
                    px-4
                    py-3
                    text-sm
                    font-semibold
                    text-primary-700
                "
            >
                <i class="fa-solid fa-users w-4"></i>
                Enseignants
            </a>

            <a
                href="/school-admin/classes"
                class="menu-link"
            >
                <i class="fa-solid fa-layer-group w-4"></i>
                Classes
            </a>

            <a
                href="/school-admin/matieres"
                class="menu-link"
            >
                <i class="fa-solid fa-book-open w-4"></i>
                Matières
            </a>

        </nav>


        <p
            class="
                mb-3
                mt-8
                px-3
                text-[10px]
                font-bold
                uppercase
                tracking-widest
                text-slate-400
            "
        >
            Académique
        </p>

        <nav class="space-y-1">

            <a
                href="/school-admin/evaluations"
                class="menu-link"
            >
                <i class="fa-solid fa-clipboard-check w-4"></i>
                Évaluations
            </a>

            <a
                href="/school-admin/notes"
                class="menu-link"
            >
                <i class="fa-solid fa-file-lines w-4"></i>
                Notes & bulletins
            </a>

            <a
                href="/school-admin/presences"
                class="menu-link"
            >
                <i class="fa-solid fa-calendar-check w-4"></i>
                Présences
            </a>

        </nav>


        <p
            class="
                mb-3
                mt-8
                px-3
                text-[10px]
                font-bold
                uppercase
                tracking-widest
                text-slate-400
            "
        >
            Administration
        </p>

        <nav class="space-y-1">

            <a
                href="/school-admin/communiques"
                class="menu-link"
            >
                <i class="fa-solid fa-bullhorn w-4"></i>
                Communiqués
            </a>

            <a
                href="/school-admin/paiements"
                class="menu-link"
            >
                <i class="fa-solid fa-wallet w-4"></i>
                Paiements
            </a>

            <a
                href="/school-admin/parametres"
                class="menu-link"
            >
                <i class="fa-solid fa-gear w-4"></i>
                Paramètres
            </a>

        </nav>

    </div>


    <div
        class="
            border-t
            border-slate-100
            p-4
        "
    >

        <div class="mb-3 flex items-center gap-3 rounded-xl bg-slate-50 p-3">

            <div
                id="sidebarUserInitials"
                class="
                    flex
                    h-10
                    w-10
                    shrink-0
                    items-center
                    justify-center
                    rounded-full
                    bg-primary-600
                    text-xs
                    font-bold
                    text-white
                "
            >
                AD
            </div>

            <div class="min-w-0">

                <p
                    id="sidebarUserName"
                    class="truncate text-sm font-bold text-slate-800"
                >
                    —
                </p>

                <p
                    id="sidebarUserEmail"
                    class="truncate text-xs text-slate-400"
                >
                    —
                </p>

            </div>

        </div>


        <button
            id="logoutButton"
            class="
                flex
                w-full
                items-center
                gap-3
                rounded-xl
                px-4
                py-3
                text-sm
                text-slate-600
                hover:bg-red-50
                hover:text-red-600
            "
        >
            <i class="fa-solid fa-right-from-bracket w-4"></i>
            Se déconnecter
        </button>

    </div>

</aside>


<!-- CONTENT -->

<div class="lg:pl-72">

    <!-- HEADER -->

    <header
        class="
            sticky
            top-0
            z-30
            flex
            h-20
            items-center
            justify-between
            border-b
            border-slate-200
            bg-white/90
            px-4
            backdrop-blur
            sm:px-6
            lg:px-8
        "
    >

        <button
            id="menuButton"
            class="rounded-xl p-2 lg:hidden"
            aria-label="Menu"
        >
            <i class="fa-solid fa-bars"></i>
        </button>


        <div class="hidden lg:block">

            <p
                id="schoolHeader"
                class="text-xs text-slate-400"
            >
                —
            </p>

            <h2 class="font-bold">
                Enseignants
            </h2>

        </div>


        <div class="flex items-center gap-4">

            <button
                class="
                    relative
                    rounded-xl
                    p-2.5
                    hover:bg-slate-100
                "
                aria-label="Notifications"
            >
                <i class="fa-regular fa-bell"></i>

                <span
                    class="
                        absolute
                        right-2
                        top-2
                        h-2
                        w-2
                        rounded-full
                        bg-red-500
                    "
                ></span>

            </button>


            <div
                id="userInitials"
                class="
                    flex
                    h-9
                    w-9
                    items-center
                    justify-center
                    rounded-full
                    bg-primary-600
                    text-sm
                    font-bold
                    text-white
                "
            >
                AD
            </div>

        </div>

    </header>


    <!-- MAIN -->

    <main class="p-4 sm:p-6 lg:p-8">

        <div
            id="pageError"
            class="
                mb-6
                hidden
                rounded-2xl
                border
                border-red-200
                bg-red-50
                p-4
                text-sm
                text-red-700
            "
        ></div>


        <!-- INTRO -->

        <section class="mb-8">

            <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">

                <div>

                    <p
                        id="adminGreeting"
                        class="
                            text-sm
                            font-medium
                            text-primary-600
                        "
                    >
                        Bonjour 👋
                    </p>

                    <h1 class="mt-2 text-2xl font-extrabold sm:text-3xl">
                        Enseignants
                    </h1>

                    <p class="mt-2 text-sm text-slate-500">
                        Gérez les enseignants rattachés à votre établissement.
                    </p>

                </div>


                <button
                    id="addTeacherButton"
                    type="button"
                    class="
                        inline-flex
                        items-center
                        justify-center
                        gap-2
                        rounded-xl
                        bg-primary-600
                        px-5
                        py-3
                        text-sm
                        font-semibold
                        text-white
                        shadow-sm
                        hover:bg-primary-700
                    "
                >
                    <i class="fa-solid fa-plus"></i>
                    Ajouter un enseignant
                </button>

            </div>

        </section>


        <!-- STATISTICS -->

        <section
            class="
                grid
                gap-4
                sm:grid-cols-3
            "
        >

            <div class="rounded-2xl border bg-white p-5 shadow-sm">

                <p class="text-sm text-slate-500">
                    Total
                </p>

                <p
                    id="statTotal"
                    class="mt-2 text-3xl font-extrabold"
                >
                    —
                </p>

            </div>


            <div class="rounded-2xl border bg-white p-5 shadow-sm">

                <p class="text-sm text-slate-500">
                    Actifs
                </p>

                <p
                    id="statActive"
                    class="mt-2 text-3xl font-extrabold text-emerald-600"
                >
                    —
                </p>

            </div>


            <div class="rounded-2xl border bg-white p-5 shadow-sm">

                <p class="text-sm text-slate-500">
                    Inactifs
                </p>

                <p
                    id="statInactive"
                    class="mt-2 text-3xl font-extrabold text-amber-600"
                >
                    —
                </p>

            </div>

        </section>


        <!-- FILTERS -->

        <section
            class="
                mt-6
                rounded-2xl
                border
                bg-white
                p-5
                shadow-sm
            "
        >

            <div class="grid gap-4 md:grid-cols-[1fr_220px_auto]">

                <div class="relative">

                    <label
                        class="
                            mb-2
                            block
                            text-xs
                            font-semibold
                            text-slate-500
                        "
                    >
                        Rechercher
                    </label>

                    <div class="relative">

                        <i
                            class="
                                fa-solid
                                fa-magnifying-glass
                                absolute
                                left-4
                                top-1/2
                                -translate-y-1/2
                                text-slate-300
                            "
                        ></i>

                        <input
                            id="searchInput"
                            type="search"
                            placeholder="Nom, prénom, e-mail, téléphone..."
                            class="
                                w-full
                                rounded-xl
                                border
                                border-slate-200
                                bg-slate-50
                                py-3
                                pl-11
                                pr-4
                                text-sm
                                outline-none
                                focus:border-primary-400
                                focus:ring-2
                                focus:ring-primary-100
                            "
                        >

                    </div>

                </div>


                <div>

                    <label
                        class="
                            mb-2
                            block
                            text-xs
                            font-semibold
                            text-slate-500
                        "
                    >
                        Statut
                    </label>

                    <select
                        id="statusFilter"
                        class="
                            w-full
                            rounded-xl
                            border
                            border-slate-200
                            bg-slate-50
                            px-4
                            py-3
                            text-sm
                            outline-none
                            focus:border-primary-400
                            focus:ring-2
                            focus:ring-primary-100
                        "
                    >
                        <option value="">
                            Tous
                        </option>

                        <option value="ACTIF">
                            Actifs
                        </option>

                        <option value="INACTIF">
                            Inactifs
                        </option>

                    </select>

                </div>


                <div class="flex items-end">

                    <button
                        id="resetFiltersButton"
                        type="button"
                        class="
                            inline-flex
                            w-full
                            items-center
                            justify-center
                            gap-2
                            rounded-xl
                            border
                            border-slate-200
                            px-4
                            py-3
                            text-sm
                            font-semibold
                            text-slate-600
                            hover:bg-slate-50
                            md:w-auto
                        "
                    >
                        <i class="fa-solid fa-rotate-left"></i>
                        Réinitialiser
                    </button>

                </div>

            </div>

        </section>


        <!-- TABLE -->

        <section
            class="
                mt-6
                overflow-hidden
                rounded-2xl
                border
                bg-white
                shadow-sm
            "
        >

            <div
                class="
                    flex
                    flex-col
                    gap-3
                    border-b
                    border-slate-100
                    px-5
                    py-5
                    sm:flex-row
                    sm:items-center
                    sm:justify-between
                "
            >

                <div>

                    <h2 class="font-bold">
                        Liste des enseignants
                    </h2>

                    <p
                        id="resultCount"
                        class="mt-1 text-xs text-slate-400"
                    >
                        Chargement…
                    </p>

                </div>

            </div>


            <div class="overflow-x-auto">

                <table class="min-w-full">

                    <thead class="bg-slate-50">

                        <tr>

                            <th
                                class="
                                    px-5
                                    py-4
                                    text-left
                                    text-xs
                                    font-bold
                                    uppercase
                                    tracking-wider
                                    text-slate-400
                                "
                            >
                                Enseignant
                            </th>

                            <th
                                class="
                                    px-5
                                    py-4
                                    text-left
                                    text-xs
                                    font-bold
                                    uppercase
                                    tracking-wider
                                    text-slate-400
                                "
                            >
                                Contact
                            </th>

                            <th
                                class="
                                    px-5
                                    py-4
                                    text-left
                                    text-xs
                                    font-bold
                                    uppercase
                                    tracking-wider
                                    text-slate-400
                                "
                            >
                                Statut
                            </th>

                            <th
                                class="
                                    px-5
                                    py-4
                                    text-right
                                    text-xs
                                    font-bold
                                    uppercase
                                    tracking-wider
                                    text-slate-400
                                "
                            >
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody id="teacherTable">
                    </tbody>

                </table>

            </div>


            <div
                id="emptyState"
                class="hidden px-6 py-16 text-center"
            >

                <div
                    class="
                        mx-auto
                        flex
                        h-14
                        w-14
                        items-center
                        justify-center
                        rounded-2xl
                        bg-primary-50
                        text-primary-600
                    "
                >
                    <i class="fa-solid fa-chalkboard-user text-xl"></i>
                </div>

                <h3 class="mt-4 font-bold">
                    Aucun enseignant trouvé
                </h3>

                <p class="mt-2 text-sm text-slate-400">
                    Aucun enseignant ne correspond aux critères actuels.
                </p>

            </div>


            <div
                class="
                    flex
                    items-center
                    justify-between
                    border-t
                    border-slate-100
                    px-5
                    py-4
                "
            >

                <p
                    id="paginationInfo"
                    class="text-xs text-slate-400"
                >
                    —
                </p>

                <div
                    id="pagination"
                    class="flex items-center gap-2"
                ></div>

            </div>

        </section>

    </main>

</div>


<!-- MODAL AJOUT -->

<div
    id="teacherModal"
    class="
        fixed
        inset-0
        z-[100]
        hidden
        items-center
        justify-center
        bg-slate-900/50
        p-4
    "
>

    <div
        class="
            w-full
            max-w-2xl
            max-h-[90vh]
            overflow-y-auto
            rounded-2xl
            bg-white
            shadow-2xl
        "
    >

        <div
            class="
                flex
                items-start
                justify-between
                border-b
                border-slate-100
                px-6
                py-5
            "
        >

            <div>

                <h3 class="text-lg font-bold">
                    Ajouter un enseignant
                </h3>

                <p class="mt-1 text-sm text-slate-400">
                    Créez un compte ou associez un utilisateur existant.
                </p>

            </div>

            <button
                id="closeTeacherModal"
                type="button"
                class="
                    rounded-xl
                    p-2
                    text-slate-400
                    hover:bg-slate-100
                "
            >
                <i class="fa-solid fa-xmark"></i>
            </button>

        </div>


        <div class="p-6">

            <div
                id="formError"
                class="
                    mb-5
                    hidden
                    rounded-xl
                    border
                    border-red-200
                    bg-red-50
                    p-4
                    text-sm
                    text-red-700
                "
            ></div>


            <div
                class="
                    mb-6
                    grid
                    gap-3
                    sm:grid-cols-2
                "
            >

                <label
                    class="
                        cursor-pointer
                        rounded-xl
                        border
                        border-primary-200
                        bg-primary-50
                        p-4
                    "
                >

                    <input
                        type="radio"
                        name="teacherMode"
                        value="new"
                        class="sr-only"
                        checked
                    >

                    <span class="block text-sm font-bold text-primary-800">
                        Nouveau compte
                    </span>

                    <span class="mt-1 block text-xs text-primary-600">
                        Créer un nouvel utilisateur enseignant.
                    </span>

                </label>


                <label
                    class="
                        cursor-pointer
                        rounded-xl
                        border
                        border-slate-200
                        p-4
                    "
                >

                    <input
                        type="radio"
                        name="teacherMode"
                        value="existing"
                        class="sr-only"
                    >

                    <span class="block text-sm font-bold text-slate-700">
                        Utilisateur existant
                    </span>

                    <span class="mt-1 block text-xs text-slate-400">
                        Réutiliser un compte déjà présent.
                    </span>

                </label>

            </div>


            <!-- MODE EXISTANT -->
<div
    id="existingUserSection"
    class="hidden"
>

    <label
        class="
            mb-2
            block
            text-sm
            font-semibold
            text-slate-700
        "
    >
        Rechercher un utilisateur
    </label>


    <div class="relative">

        <i
            class="
                fa-solid
                fa-magnifying-glass
                absolute
                left-4
                top-1/2
                -translate-y-1/2
                text-slate-300
            "
        ></i>

        <input
            id="existingUserSearch"
            type="search"
            autocomplete="off"
            placeholder="Nom, prénom, e-mail, téléphone..."
            class="
                w-full
                rounded-xl
                border
                border-slate-200
                bg-slate-50
                py-3
                pl-11
                pr-4
                text-sm
                outline-none
                focus:border-primary-400
                focus:ring-2
                focus:ring-primary-100
            "
        >

    </div>


    <input
        id="existingUserId"
        type="hidden"
    >


    <div
        id="existingUserResults"
        class="
            relative
            mt-2
            hidden
            max-h-60
            overflow-y-auto
            rounded-xl
            border
            border-slate-200
            bg-white
            shadow-lg
        "
    ></div>


    <div
        id="existingUserSelected"
        class="
            mt-3
            hidden
            rounded-xl
            border
            border-primary-200
            bg-primary-50
            p-4
        "
    ></div>

</div>


            <!-- NOUVEAU COMPTE -->

            <div
                id="newUserSection"
            >

                <div class="grid gap-4 sm:grid-cols-2">

                    <div>

                        <label class="mb-2 block text-sm font-semibold text-slate-700">
                            Prénom *
                        </label>

                        <input
                            id="teacherPrenom"
                            type="text"
                            required
                            class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100"
                        >

                    </div>


                    <div>

                        <label class="mb-2 block text-sm font-semibold text-slate-700">
                            Nom *
                        </label>

                        <input
                            id="teacherNom"
                            type="text"
                            required
                            class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100"
                        >

                    </div>


                    <div>

                        <label class="mb-2 block text-sm font-semibold text-slate-700">
                            Postnom
                        </label>

                        <input
                            id="teacherPostnom"
                            type="text"
                            class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100"
                        >

                    </div>


                    <div>

                        <label class="mb-2 block text-sm font-semibold text-slate-700">
                            Pseudo
                        </label>

                        <input
                            id="teacherPseudo"
                            type="text"
                            class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100"
                        >

                    </div>


                    <div>

                        <label class="mb-2 block text-sm font-semibold text-slate-700">
                            E-mail *
                        </label>

                        <input
                            id="teacherEmail"
                            type="email"
                            required
                            class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100"
                        >

                    </div>


                    <div>

                        <label class="mb-2 block text-sm font-semibold text-slate-700">
                            Téléphone
                        </label>

                        <input
                            id="teacherTelephone"
                            type="tel"
                            class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100"
                        >

                    </div>


                    <div>

                        <label class="mb-2 block text-sm font-semibold text-slate-700">
                            Sexe
                        </label>

                        <select
    id="teacherSexe"
    class="
        w-full
        rounded-xl
        border
        border-slate-200
        px-4
        py-3
        text-sm
        outline-none
        focus:border-primary-400
        focus:ring-2
        focus:ring-primary-100
    "
>
    <option value="">
        Sélectionner
    </option>

    <option value="HOMME">
        Homme
    </option>

    <option value="FEMME">
        Femme
    </option>

    <option value="AUTRE">
        Autre
    </option>
</select>

                    </div>


                    <div>

                        <label class="mb-2 block text-sm font-semibold text-slate-700">
                            Mot de passe *
                        </label>

                        <input
                            id="teacherPassword"
                            type="password"
                            minlength="8"
                            required
                            class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100"
                        >

                    </div>

                </div>

            </div>


            <div class="mt-7 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">

                <button
                    id="cancelTeacherButton"
                    type="button"
                    class="
                        rounded-xl
                        border
                        border-slate-200
                        px-5
                        py-3
                        text-sm
                        font-semibold
                        text-slate-600
                        hover:bg-slate-50
                    "
                >
                    Annuler
                </button>

                <button
                    id="saveTeacherButton"
                    type="button"
                    class="
                        rounded-xl
                        bg-primary-600
                        px-5
                        py-3
                        text-sm
                        font-semibold
                        text-white
                        hover:bg-primary-700
                    "
                >
                    Enregistrer
                </button>

            </div>

        </div>

    </div>

</div>
<!-- Modal confirmation suspension / activation -->
<div
    id="statusTeacherModal"
    class="
        fixed inset-0 z-[100]
        hidden
        items-center
        justify-center
        bg-slate-950/50
        p-4
        backdrop-blur-sm
    "
>
    <div
        class="
            w-full
            max-w-md
            overflow-hidden
            rounded-2xl
            bg-white
            shadow-2xl
        "
    >

        <!-- Header -->
        <div class="border-b border-slate-100 px-6 py-5">
            <div class="flex items-start justify-between gap-4">

                <div class="flex items-center gap-3">

                    <div
                        id="statusModalIcon"
                        class="
                            flex
                            h-11
                            w-11
                            items-center
                            justify-center
                            rounded-xl
                            bg-amber-50
                            text-amber-600
                        "
                    >
                        <i class="fa-solid fa-ban"></i>
                    </div>

                    <div>
                        <h3
                            id="statusModalTitle"
                            class="
                                text-base
                                font-bold
                                text-slate-800
                            "
                        >
                            Suspendre l'enseignant
                        </h3>

                        <p class="mt-1 text-sm text-slate-400">
                            Confirmation requise
                        </p>
                    </div>

                </div>

                <button
                    id="closeStatusTeacherModal"
                    type="button"
                    class="
                        flex
                        h-9
                        w-9
                        items-center
                        justify-center
                        rounded-lg
                        text-slate-400
                        transition
                        hover:bg-slate-100
                        hover:text-slate-600
                    "
                >
                    <i class="fa-solid fa-xmark"></i>
                </button>

            </div>
        </div>


        <!-- Body -->
        <div class="px-6 py-6">

            <p
                id="statusModalMessage"
                class="
                    text-sm
                    leading-6
                    text-slate-600
                "
            >
                Êtes-vous sûr de vouloir effectuer cette action ?
            </p>

        </div>


        <!-- Footer -->
        <div
            class="
                flex
                justify-end
                gap-3
                border-t
                border-slate-100
                bg-slate-50
                px-6
                py-4
            "
        >

            <button
                id="cancelStatusTeacherButton"
                type="button"
                class="
                    rounded-xl
                    border
                    border-slate-200
                    bg-white
                    px-5
                    py-2.5
                    text-sm
                    font-semibold
                    text-slate-600
                    transition
                    hover:bg-slate-100
                "
            >
                Annuler
            </button>


            <button
                id="confirmStatusTeacherButton"
                type="button"
                class="
                    rounded-xl
                    bg-amber-500
                    px-5
                    py-2.5
                    text-sm
                    font-semibold
                    text-white
                    shadow-sm
                    transition
                    hover:bg-amber-600
                "
            >
                Confirmer
            </button>

        </div>

    </div>
</div>

<script src="/assets/js/school_admin/enseignants.js"></script>

</body>
</html>