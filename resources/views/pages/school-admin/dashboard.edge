<!DOCTYPE html>

<html lang="fr">

<head>

<meta charset="UTF-8">

<meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
>

<title>Administration | Smart School</title>

<script src="https://cdn.tailwindcss.com"></script>

<script>
    tailwind.config = {
        theme: {
            extend: {
                colors: {
                    primary: {
                        50: '#f0f9ff',
                        100: '#e0f2fe',
                        200: '#bae6fd',
                        300: '#7dd3fc',
                        400: '#38bdf8',
                        500: '#0ea5e9',
                        600: '#0284c7',
                        700: '#0369a1',
                        800: '#075985',
                        900: '#0c4a6e'
                    }
                }
            }
        }
    }
</script>

<link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
>

<style>
    body {
        font-family:
            Inter,
            ui-sans-serif,
            system-ui,
            sans-serif;
    }

    .stat-card {
        transition:
            transform .2s ease,
            box-shadow .2s ease;
    }

    .stat-card:hover {
        transform: translateY(-2px);
        box-shadow:
            0 12px 30px
            rgba(15,23,42,.08);
    }

    .menu-link {
        display: flex;
        align-items: center;
        gap: .75rem;
        border-radius: .75rem;
        padding: .75rem 1rem;
        font-size: .875rem;
        color: #475569;
        transition: .2s ease;
    }

    .menu-link:hover {
        background: #f0f9ff;
        color: #0369a1;
    }
</style>

</head>

<body class="bg-slate-50 text-slate-900">

<div
    id="overlay"
    class="fixed inset-0 z-40 hidden bg-slate-900/40 lg:hidden"
></div>

<!-- SIDEBAR -->

<aside
    id="sidebar"
    class="
        fixed
        inset-y-0
        left-0
        z-50
        flex
        w-72
        -translate-x-full
        flex-col
        border-r
        border-slate-200
        bg-white
        transition-transform
        lg:translate-x-0
    "
>

<div
    class="
        flex
        h-20
        items-center
        gap-3
        border-b
        border-slate-100
        px-6
    "
>

    <div
        class="
            flex
            h-11
            w-11
            items-center
            justify-center
            rounded-xl
            bg-primary-600
            text-white
        "
    >
        <i class="fa-solid fa-school"></i>
    </div>

    <div>

        <h1 class="font-extrabold">
            SMART SCHOOL
        </h1>

        <p class="text-xs text-slate-400">
            Espace établissement
        </p>

    </div>

</div>


<div class="flex-1 overflow-y-auto px-4 py-6">

    <div
        class="
            mb-6
            rounded-xl
            bg-primary-50
            p-4
        "
    >

        <p
            class="
                text-xs
                font-medium
                text-primary-600
            "
        >
            Établissement
        </p>

        <p
            id="schoolNameSidebar"
            class="
                mt-1
                text-sm
                font-bold
                text-primary-900
            "
        >
            —
        </p>

        <p
            id="schoolLocationSidebar"
            class="
                mt-1
                text-xs
                text-primary-600
            "
        >
            —
        </p>

    </div>


    <p
        class="
            mb-3
            px-3
            text-[10px]
            font-bold
            uppercase
            tracking-widest
            text-slate-400
        "
    >
        Principal
    </p>

    <nav class="space-y-1">

        <a
            href="/school-admin/dashboard"
            class="
                flex
                items-center
                gap-3
                rounded-xl
                bg-primary-50
                px-4
                py-3
                text-sm
                font-semibold
                text-primary-700
            "
        >

            <i
                class="fa-solid fa-gauge-high w-4"
            ></i>

            Tableau de bord

        </a>

    </nav>


    <p
        class="
            mb-3
            mt-8
            px-3
            text-[10px]
            font-bold
            uppercase
            tracking-widest
            text-slate-400
        "
    >
        Scolarité
    </p>

    <nav class="space-y-1">

        <a
            href="/school-admin/eleves"
            class="menu-link"
        >
            <i
                class="fa-solid fa-graduation-cap w-4"
            ></i>

            Élèves
        </a>

        <a
            href="/school-admin/enseignants"
            class="menu-link"
        >
            <i
                class="fa-solid fa-users w-4"
            ></i>

            Enseignants
        </a>

        <a
            href="/school-admin/classes"
            class="menu-link"
        >
            <i
                class="fa-solid fa-layer-group w-4"
            ></i>

            Classes
        </a>

        <a
            href="/school-admin/matieres"
            class="menu-link"
        >
            <i
                class="fa-solid fa-book-open w-4"
            ></i>

            Matières
        </a>

    </nav>


    <p
        class="
            mb-3
            mt-8
            px-3
            text-[10px]
            font-bold
            uppercase
            tracking-widest
            text-slate-400
        "
    >
        Académique
    </p>

    <nav class="space-y-1">

        <a
            href="/school-admin/evaluations"
            class="menu-link"
        >
            <i
                class="fa-solid fa-clipboard-check w-4"
            ></i>

            Évaluations
        </a>

        <a
            href="/school-admin/notes"
            class="menu-link"
        >
            <i
                class="fa-solid fa-file-lines w-4"
            ></i>

            Notes & bulletins
        </a>

        <a
            href="/school-admin/presences"
            class="menu-link"
        >
            <i
                class="fa-solid fa-calendar-check w-4"
            ></i>

            Présences
        </a>

    </nav>


    <p
        class="
            mb-3
            mt-8
            px-3
            text-[10px]
            font-bold
            uppercase
            tracking-widest
            text-slate-400
        "
    >
        Administration
    </p>

    <nav class="space-y-1">

        <a
            href="/school-admin/communiques"
            class="menu-link"
        >
            <i
                class="fa-solid fa-bullhorn w-4"
            ></i>

            Communiqués
        </a>

        <a
            href="/school-admin/paiements"
            class="menu-link"
        >
            <i
                class="fa-solid fa-wallet w-4"
            ></i>

            Paiements
        </a>

        <a
            href="/school-admin/parametres"
            class="menu-link"
        >
            <i
                class="fa-solid fa-gear w-4"
            ></i>

            Paramètres
        </a>

    </nav>

</div>


<div
    class="
        border-t
        border-slate-100
        p-4
    "
>

    <button
        id="logoutButton"
        class="
            flex
            w-full
            items-center
            gap-3
            rounded-xl
            px-4
            py-3
            text-sm
            text-slate-600
            hover:bg-red-50
            hover:text-red-600
        "
    >

        <i
            class="fa-solid fa-right-from-bracket w-4"
        ></i>

        Se déconnecter

    </button>

</div>

</aside>

<!-- CONTENT -->

<div class="lg:pl-72">

<!-- HEADER -->

<header
    class="
        sticky
        top-0
        z-30
        flex
        h-20
        items-center
        justify-between
        border-b
        border-slate-200
        bg-white/90
        px-4
        backdrop-blur
        sm:px-6
        lg:px-8
    "
>

    <button
        id="menuButton"
        class="
            rounded-xl
            p-2
            lg:hidden
        "
        aria-label="Menu"
    >
        <i class="fa-solid fa-bars"></i>
    </button>


    <div class="hidden lg:block">

        <p
            id="schoolHeader"
            class="text-xs text-slate-400"
        >
            —
        </p>

        <h2 class="font-bold">
            Tableau de bord
        </h2>

    </div>


    <div class="flex items-center gap-4">

        <button
            class="
                relative
                rounded-xl
                p-2.5
                hover:bg-slate-100
            "
            aria-label="Notifications"
        >

            <i
                class="fa-regular fa-bell"
            ></i>

            <span
                class="
                    absolute
                    right-2
                    top-2
                    h-2
                    w-2
                    rounded-full
                    bg-red-500
                "
            ></span>

        </button>


        <div
            id="userInitials"
            class="
                flex
                h-9
                w-9
                items-center
                justify-center
                rounded-full
                bg-primary-600
                text-sm
                font-bold
                text-white
            "
        >
            AD
        </div>

    </div>

</header>


<!-- MAIN -->

<main
    class="
        p-4
        sm:p-6
        lg:p-8
    "
>

    <div
        id="dashboardError"
        class="
            hidden
            mb-6
            rounded-2xl
            border
            border-red-200
            bg-red-50
            p-4
            text-sm
            text-red-700
        "
    ></div>


    <!-- INTRODUCTION -->

    <div class="mb-8">

        <p
            id="adminGreeting"
            class="
                text-sm
                font-medium
                text-primary-600
            "
        >
            Bonjour, 👋
        </p>

        <h1
            id="schoolTitle"
            class="
                mt-2
                text-2xl
                font-extrabold
                sm:text-3xl
            "
        >
            —
        </h1>

        <p
            class="
                mt-2
                text-sm
                text-slate-500
            "
        >
            Voici la situation actuelle de votre établissement.
        </p>

    </div>


    <!-- STATISTICS -->

    <div
        class="
            grid
            gap-4
            sm:grid-cols-2
            xl:grid-cols-4
        "
    >

        <div
            class="
                stat-card
                rounded-2xl
                border
                bg-white
                p-5
                shadow-sm
            "
        >

            <div
                class="
                    flex
                    justify-between
                "
            >

                <div
                    class="
                        rounded-xl
                        bg-primary-50
                        p-3
                        text-primary-600
                    "
                >
                    <i
                        class="fa-solid fa-graduation-cap"
                    ></i>
                </div>

            </div>

            <p
                class="
                    mt-5
                    text-sm
                    text-slate-500
                "
            >
                Élèves
            </p>

            <h3
                id="studentsCount"
                class="
                    text-3xl
                    font-extrabold
                "
            >
                —
            </h3>

            <p
                class="
                    text-xs
                    text-slate-400
                "
            >
                élèves rattachés à l'école
            </p>

        </div>


        <div
            class="
                stat-card
                rounded-2xl
                border
                bg-white
                p-5
                shadow-sm
            "
        >

            <div
                class="
                    rounded-xl
                    bg-violet-50
                    p-3
                    text-violet-600
                    w-fit
                "
            >
                <i
                    class="fa-solid fa-chalkboard-user"
                ></i>
            </div>

            <p
                class="
                    mt-5
                    text-sm
                    text-slate-500
                "
            >
                Enseignants
            </p>

            <h3
                id="teachersCount"
                class="
                    text-3xl
                    font-extrabold
                "
            >
                —
            </h3>

            <p
                class="
                    text-xs
                    text-slate-400
                "
            >
                comptes enseignants actifs
            </p>

        </div>


        <div
            class="
                stat-card
                rounded-2xl
                border
                bg-white
                p-5
                shadow-sm
            "
        >

            <div
                class="
                    rounded-xl
                    bg-emerald-50
                    p-3
                    text-emerald-600
                    w-fit
                "
            >
                <i
                    class="fa-solid fa-layer-group"
                ></i>
            </div>

            <p
                class="
                    mt-5
                    text-sm
                    text-slate-500
                "
            >
                Classes
            </p>

            <h3
                id="classesCount"
                class="
                    text-3xl
                    font-extrabold
                "
            >
                —
            </h3>

            <p
                class="
                    text-xs
                    text-slate-400
                "
            >
                classes rattachées à l'école
            </p>

        </div>


        <div
            class="
                stat-card
                rounded-2xl
                border
                bg-white
                p-5
                shadow-sm
            "
        >

            <div
                class="
                    rounded-xl
                    bg-amber-50
                    p-3
                    text-amber-600
                    w-fit
                "
            >
                <i
                    class="fa-solid fa-book-open"
                ></i>
            </div>

            <p
                class="
                    mt-5
                    text-sm
                    text-slate-500
                "
            >
                Matières
            </p>

            <h3
                id="subjectsCount"
                class="
                    text-3xl
                    font-extrabold
                "
            >
                —
            </h3>

            <p
                class="
                    text-xs
                    text-slate-400
                "
            >
                matières configurées
            </p>

        </div>

    </div>


    <!-- ADMINISTRATIVE VIEW -->

    <div
        class="
            mt-6
            grid
            gap-6
            xl:grid-cols-3
        "
    >

        <div
            class="
                rounded-2xl
                border
                bg-white
                p-6
                shadow-sm
                xl:col-span-2
            "
        >

            <div class="flex items-center justify-between">

                <div>

                    <h3 class="font-bold">
                        Vue administrative
                    </h3>

                    <p
                        class="
                            mt-1
                            text-xs
                            text-slate-400
                        "
                    >
                        Répartition des utilisateurs de l'établissement
                    </p>

                </div>

            </div>


            <div
                class="
                    mt-8
                    grid
                    gap-4
                    sm:grid-cols-3
                "
            >

                <div
                    class="
                        rounded-xl
                        bg-violet-50
                        p-4
                    "
                >

                    <p
                        class="
                            text-xs
                            text-violet-600
                        "
                    >
                        Enseignants
                    </p>

                    <p
                        id="teachersSecondary"
                        class="
                            mt-2
                            text-2xl
                            font-extrabold
                        "
                    >
                        —
                    </p>

                </div>


                <div
                    class="
                        rounded-xl
                        bg-emerald-50
                        p-4
                    "
                >

                    <p
                        class="
                            text-xs
                            text-emerald-600
                        "
                    >
                        Parents
                    </p>

                    <p
                        id="parentsCount"
                        class="
                            mt-2
                            text-2xl
                            font-extrabold
                        "
                    >
                        —
                    </p>

                </div>


                <div
                    class="
                        rounded-xl
                        bg-primary-50
                        p-4
                    "
                >

                    <p
                        class="
                            text-xs
                            text-primary-600
                        "
                    >
                        Utilisateurs
                    </p>

                    <p
                        id="usersCount"
                        class="
                            mt-2
                            text-2xl
                            font-extrabold
                        "
                    >
                        —
                    </p>

                </div>

            </div>


            <div
                class="
                    mt-6
                    rounded-xl
                    border
                    border-dashed
                    border-slate-200
                    p-5
                "
            >

                <div
                    class="
                        flex
                        items-start
                        gap-3
                    "
                >

                    <i
                        class="
                            fa-solid
                            fa-circle-info
                            mt-0.5
                            text-primary-600
                        "
                    ></i>

                    <p
                        class="
                            text-sm
                            text-slate-500
                        "
                    >
                        Les indicateurs de présence et de performance académique seront alimentés automatiquement lorsque leurs modules backend seront connectés.
                    </p>

                </div>

            </div>

        </div>


        <!-- CONTEXT -->

        <div
            class="
                rounded-2xl
                border
                bg-white
                p-6
                shadow-sm
            "
        >

            <h3 class="font-bold">
                Contexte actuel
            </h3>


            <div
                class="
                    mt-6
                    space-y-4
                "
            >

                <div
                    class="
                        flex
                        items-center
                        justify-between
                    "
                >

                    <span
                        class="
                            text-sm
                            text-slate-500
                        "
                    >
                        École
                    </span>

                    <strong
                        id="contextSchool"
                    >
                        —
                    </strong>

                </div>


                <div
                    class="
                        flex
                        items-center
                        justify-between
                    "
                >

                    <span
                        class="
                            text-sm
                            text-slate-500
                        "
                    >
                        Rôle
                    </span>

                    <span
                        id="contextRole"
                        class="
                            rounded-lg
                            bg-primary-50
                            px-3
                            py-2
                            text-xs
                            font-bold
                            text-primary-700
                        "
                    >
                        —
                    </span>

                </div>


                <div
                    class="
                        flex
                        items-center
                        justify-between
                    "
                >

                    <span
                        class="
                            text-sm
                            text-slate-500
                        "
                    >
                        Statut
                    </span>

                    <span
                        id="schoolStatus"
                        class="
                            rounded-lg
                            bg-emerald-50
                            px-3
                            py-2
                            text-xs
                            font-bold
                            text-emerald-700
                        "
                    >
                        —
                    </span>

                </div>

            </div>


            <div class="mt-6">

                <a
                    href="/school-admin/parametres"
                    class="
                        inline-flex
                        w-full
                        items-center
                        justify-center
                        gap-2
                        rounded-xl
                        border
                        border-slate-200
                        px-4
                        py-3
                        text-sm
                        font-semibold
                        hover:bg-slate-50
                    "
                >

                    <i
                        class="fa-solid fa-gear"
                    ></i>

                    Gérer l'établissement

                </a>

            </div>

        </div>

    </div>


    <!-- SCHOOLS -->

    <div
        class="
            mt-6
            rounded-2xl
            border
            bg-white
            p-6
            shadow-sm
        "
    >

        <div
            class="
                flex
                flex-col
                gap-3
                sm:flex-row
                sm:items-center
                sm:justify-between
            "
        >

            <div>

                <h3 class="font-bold">
                    Mes écoles
                </h3>

                <p
                    class="
                        mt-1
                        text-xs
                        text-slate-400
                    "
                >
                    Changez d'établissement sans quitter votre session.
                </p>

            </div>


            <span
                id="schoolCountBadge"
                class="
                    rounded-lg
                    bg-slate-100
                    px-3
                    py-2
                    text-xs
                    font-semibold
                    text-slate-600
                "
            >
                Chargement…
            </span>

        </div>


        <div
            id="schoolsList"
            class="
                mt-6
                grid
                gap-3
                md:grid-cols-2
                xl:grid-cols-3
            "
        ></div>

    </div>

</main>

</div>

<script src="/assets/js/school_admin/dashboard.js"></script>

</body>
</html>
