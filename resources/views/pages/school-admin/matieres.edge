                        h-9
                        w-9
                        shrink-0
                        items-center
                        justify-center
                        rounded-lg
                        text-slate-400
                        transition
                        hover:bg-red-50
                        hover:text-red-600
                    "
                    title="Déconnexion"
                    aria-label="Déconnexion"
                >
                    <i
                        class="
                            fa-solid
                            fa-right-from-bracket
                        "
                    ></i>
                </button>

            </div>

        </div>

    </aside>


    <!-- =========================================================
         MAIN
    ========================================================== -->

    <main
        class="
            min-h-screen
            lg:ml-72
        "
    >

        <!-- HEADER -->

        <header
            class="
                sticky
                top-0
                z-30
                h-20
                bg-white
                border-b
                border-slate-200
            "
        >

            <div
                class="
                    flex
                    h-full
                    items-center
                    justify-between
                    px-4
                    sm:px-6
                    lg:px-8
                "
            >

                <div
                    class="
                        flex
                        items-center
                        gap-3
                    "
                >

                    <button
                        id="openSidebar"
                        type="button"
                        class="
                            flex
                            h-10
                            w-10
                            items-center
                            justify-center
                            rounded-xl
                            text-slate-600
                            hover:bg-slate-100
                            lg:hidden
                        "
                        aria-label="Ouvrir le menu"
                    >
                        <i
                            class="
                                fa-solid
                                fa-bars
                                text-lg
                            "
                        ></i>
                    </button>


                    <div>

                        <h2
                            class="
                                text-lg
                                font-bold
                                text-slate-800
                                sm:text-xl
                            "
                        >
                            Gestion des matières
                        </h2>

                        <p
                            class="
                                hidden
                                text-sm
                                text-slate-400
                                sm:block
                            "
                        >
                            Gérez les disciplines de votre établissement.
                        </p>

                    </div>

                </div>


                <div
                    class="
                        flex
                        items-center
                        gap-3
                    "
                >

                    <button
                        type="button"
                        class="
                            relative
                            hidden
                            h-10
                            w-10
                            items-center
                            justify-center
                            rounded-xl
                            text-slate-500
                            hover:bg-slate-100
                            sm:flex
                        "
                        aria-label="Notifications"
                    >
                        <i
                            class="
                                fa-regular
                                fa-bell
                                text-lg
                            "
                        ></i>

                        <span
                            class="
                                absolute
                                right-2
                                top-2
                                h-2
                                w-2
                                rounded-full
                                bg-red-500
                            "
                        ></span>
                    </button>


                    <div
                        class="
                            hidden
                            h-8
                            w-px
                            bg-slate-200
                            sm:block
                        "
                    ></div>


                    <div
                        class="
                            hidden
                            items-center
                            gap-3
                            sm:flex
                        "
                    >

                        <div
                            id="headerUserInitials"
                            class="
                                flex
                                h-10
                                w-10
                                items-center
                                justify-center
                                rounded-full
                                bg-sky-100
                                font-bold
                                text-sky-600
                            "
                        >
                            —
                        </div>


                        <div
                            class="
                                min-w-0
                            "
                        >

                            <p
                                id="headerUserName"
                                class="
                                    max-w-[180px]
                                    truncate
                                    text-sm
                                    font-semibold
                                    text-slate-800
                                "
                            >
                                Chargement…
                            </p>

                            <p
                                id="headerUserEmail"
                                class="
                                    max-w-[180px]
                                    truncate
                                    text-xs
                                    text-slate-400
                                "
                            >
                                —
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </header>


        <!-- =====================================================
             CONTENT
        ====================================================== -->

        <div
            class="
                p-4
                sm:p-6
                lg:p-8
            "
        >

            <!-- PAGE INTRO -->

            <section>

                <div
                    class="
                        flex
                        flex-col
                        gap-5
                        lg:flex-row
                        lg:items-end
                        lg:justify-between
                    "
                >

                    <div>

                        <span
                            id="schoolBadgeName"
                            class="
                                inline-flex
                                items-center
                                gap-2
                                rounded-full
                                bg-sky-50
                                px-3
                                py-1.5
                                text-xs
                                font-semibold
                                text-sky-600
                            "
                        >
                            <i
                                class="
                                    fa-solid
                                    fa-school
                                "
                            ></i>

                            Établissement
                        </span>


                        <h1
                            class="
                                mt-4
                                text-2xl
                                font-extrabold
                                tracking-tight
                                text-slate-900
                                sm:text-3xl
                            "
                        >
                            Gestion des matières
                        </h1>


                        <p
                            class="
                                mt-2
                                max-w-2xl
                                text-sm
                                leading-6
                                text-slate-500
                                sm:text-base
                            "
                        >
                            Configurez et gérez les disciplines enseignées
                            dans votre établissement.
                        </p>

                    </div>


                    <button
                        id="addSubjectButton"
                        type="button"
                        onclick="openCreateModal()"
                        class="
                            inline-flex
                            items-center
                            justify-center
                            gap-2
                            rounded-xl
                            bg-sky-500
                            px-4
                            py-3
                            text-sm
                            font-semibold
                            text-white
                            shadow-sm
                            transition
                            hover:bg-sky-600
                            hover:shadow-md
                        "
                    >

                        <i
                            class="
                                fa-solid
                                fa-plus
                            "
                        ></i>

                        Nouvelle matière

                    </button>

                </div>

            </section>


            <!-- =================================================
                 PAGE ERROR
            ================================================== -->

            <div
                id="pageError"
                class="
                    mt-6
                    hidden
                    rounded-xl
                    border
                    border-red-200
                    bg-red-50
                    px-4
                    py-3
                    text-sm
                    text-red-700
                "
            ></div>


            <!-- =================================================
                 KPI
            ================================================== -->

            <section
                class="
                    mt-8
                    grid
                    gap-4
                    sm:grid-cols-2
                    xl:grid-cols-4
                "
            >

                <!-- TOTAL -->

                <div
                    class="
                        rounded-2xl
                        border
                        border-slate-200
                        bg-white
                        p-5
                        shadow-sm
                    "
                >

                    <div class="flex items-start justify-between">

                        <div>

                            <p
                                class="
                                    text-sm
                                    font-medium
                                    text-slate-500
                                "
                            >
                                Total matières
                            </p>

                            <p
                                id="statTotal"
                                class="
                                    mt-2
                                    text-3xl
                                    font-extrabold
                                    text-slate-900
                                "
                            >
                                —
                            </p>

                            <p
                                class="
                                    mt-1
                                    text-xs
                                    text-slate-400
                                "
                            >
                                Disciplines configurées
                            </p>

                        </div>


                        <div
                            class="
                                flex
                                h-11
                                w-11
                                items-center
                                justify-center
                                rounded-xl
                                bg-sky-50
                                text-sky-600
                            "
                        >
                            <i
                                class="
                                    fa-solid
                                    fa-book
                                "
                            ></i>
                        </div>

                    </div>

                </div>


                <!-- ACTIVE -->

                <div
                    class="
                        rounded-2xl
                        border
                        border-slate-200
                        bg-white
                        p-5
                        shadow-sm
                    "
                >

                    <div class="flex items-start justify-between">

                        <div>

                            <p
                                class="
                                    text-sm
                                    font-medium
                                    text-slate-500
                                "
                            >
                                Matières actives
                            </p>

                            <p
                                id="statActive"
                                class="
                                    mt-2
                                    text-3xl
                                    font-extrabold
                                    text-slate-900
                                "
                            >
                                —
                            </p>

                            <p
                                id="statActivePercent"
                                class="
                                    mt-1
                                    text-xs
                                    text-slate-400
                                "
                            >
                                —
                            </p>

                        </div>


                        <div
                            class="
                                flex
                                h-11
                                w-11
                                items-center
                                justify-center
                                rounded-xl
                                bg-emerald-50
                                text-emerald-600
                            "
                        >
                            <i
                                class="
                                    fa-solid
                                    fa-circle-check
                                "
                            ></i>
                        </div>

                    </div>

                </div>


                <!-- INACTIVE -->

                <div
                    class="
                        rounded-2xl
                        border
                        border-slate-200
                        bg-white
                        p-5
                        shadow-sm
                    "
                >

                    <div class="flex items-start justify-between">

                        <div>

                            <p
                                class="
                                    text-sm
                                    font-medium
                                    text-slate-500
                                "
                            >
                                Matières inactives
                            </p>

                            <p
                                id="statInactive"
                                class="
                                    mt-2
                                    text-3xl
                                    font-extrabold
                                    text-slate-900
                                "
                            >
                                —
                            </p>

                            <p
                                class="
                                    mt-1
                                    text-xs
                                    text-slate-400
                                "
                            >
                                Disciplines désactivées
                            </p>

                        </div>


                        <div
                            class="
                                flex
                                h-11
                                w-11
                                items-center
                                justify-center
                                rounded-xl
                                bg-amber-50
                                text-amber-600
                            "
                        >
                            <i
                                class="
                                    fa-solid
                                    fa-circle-pause
                                "
                            ></i>
                        </div>

                    </div>

                </div>


                <!-- TAUX -->

                <div
                    class="
                        rounded-2xl
                        border
                        border-slate-200
                        bg-white
                        p-5
                        shadow-sm
                    "
                >

                    <div class="flex items-start justify-between">

                        <div>

                            <p
                                class="
                                    text-sm
                                    font-medium
                                    text-slate-500
                                "
                            >
                                Taux d'activation
                            </p>

                            <p
                                id="statActivationRate"
                                class="
                                    mt-2
                                    text-3xl
                                    font-extrabold
                                    text-slate-900
                                "
                            >
                                —
                            </p>

                            <p
                                class="
                                    mt-1
                                    text-xs
                                    text-slate-400
                                "
                            >
                                État global du catalogue
                            </p>

                        </div>


                        <div
                            class="
                                flex
                                h-11
                                w-11
                                items-center
                                justify-center
                                rounded-xl
                                bg-violet-50
                                text-violet-600
                            "
                        >
                            <i
                                class="
                                    fa-solid
                                    fa-chart-pie
                                "
                            ></i>
                        </div>

                    </div>

                </div>

            </section>


            <!-- =================================================
                 TABLE
            ================================================== -->

            <section
                class="
                    mt-8
                    overflow-hidden
                    rounded-2xl
                    border
                    border-slate-200
                    bg-white
                    shadow-sm
                "
            >

                <!-- FILTER HEADER -->

                <div
                    class="
                        border-b
                        border-slate-100
                        p-5
                        sm:p-6
                    "
                >

                    <div
                        class="
                            flex
                            flex-col
                            gap-4
                            lg:flex-row
                            lg:items-center
                            lg:justify-between
                        "
                    >

                        <div>

                            <h3
                                class="
                                    font-bold
                                    text-slate-800
                                "
                            >
                                Liste des matières
                            </h3>

                            <p
                                class="
                                    mt-1
                                    text-sm
                                    text-slate-400
                                "
                            >
                                Gérez les disciplines configurées dans l'établissement.
                            </p>

                        </div>


                        <div
                            class="
                                flex
                                flex-col
                                gap-3
                                sm:flex-row
                            "
                        >

                            <!-- SEARCH -->

                            <div class="relative">

                                <i
                                    class="
                                        fa-solid
                                        fa-magnifying-glass
                                        pointer-events-none
                                        absolute
                                        left-3
                                        top-1/2
                                        -translate-y-1/2
                                        text-xs
                                        text-slate-400
                                    "
                                ></i>

                                <input
                                    id="searchInput"
                                    type="search"
                                    placeholder="Rechercher une matière…"
                                    class="
                                        h-10
                                        w-full
                                        rounded-xl
                                        border
                                        border-slate-200
                                        bg-white
                                        pl-9
                                        pr-3
                                        text-sm
                                        outline-none
                                        transition
                                        focus:border-sky-400
                                        focus:ring-2
                                        focus:ring-sky-100
                                        sm:w-64
                                    "
                                >

                            </div>


                            <!-- STATUS -->

                            <select
                                id="statusFilter"
                                class="
                                    h-10
                                    rounded-xl
                                    border
                                    border-slate-200
                                    bg-white
                                    px-3
                                    text-sm
                                    text-slate-600
                                    outline-none
                                    focus:border-sky-400
                                    focus:ring-2
                                    focus:ring-sky-100
                                "
                            >
                                <option value="">
                                    Tous les statuts
                                </option>

                                <option value="ACTIVE">
                                    Actives
                                </option>

                                <option value="INACTIVE">
                                    Inactives
                                </option>
                            </select>

                        </div>

                    </div>

                </div>


                <!-- TABLE -->

                <div class="table-scroll overflow-x-auto">

                    <table
                        class="
                            w-full
                            min-w-[760px]
                        "
                    >

                        <thead
                            class="
                                border-b
                                border-slate-200
                                bg-slate-50
                            "
                        >

                            <tr>

                                <th
                                    class="
                                        px-6
                                        py-4
                                        text-left
                                        text-xs
                                        font-semibold
                                        uppercase
                                        tracking-wide
                                        text-slate-500
                                    "
                                >
                                    Matière
                                </th>

                                <th
                                    class="
                                        px-6
                                        py-4
                                        text-left
                                        text-xs
                                        font-semibold
                                        uppercase
                                        tracking-wide
                                        text-slate-500
                                    "
                                >
                                    Description
                                </th>

                                <th
                                    class="
                                        px-6
                                        py-4
                                        text-left
                                        text-xs
                                        font-semibold
                                        uppercase
                                        tracking-wide
                                        text-slate-500
                                    "
                                >
                                    Statut
                                </th>

                                <th
                                    class="
                                        px-6
                                        py-4
                                        text-right
                                        text-xs
                                        font-semibold
                                        uppercase
                                        tracking-wide
                                        text-slate-500
                                    "
                                >
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody
                            id="subjectsTableBody"
                            class="divide-y divide-slate-100"
                        >

                            <tr>

                                <td
                                    colspan="4"
                                    class="
                                        px-6
                                        py-14
                                        text-center
                                        text-sm
                                        text-slate-400
                                    "
                                >
                                    Chargement des matières…
                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>


                <!-- PAGINATION -->

                <div
                    class="
                        flex
                        flex-col
                        gap-4
                        border-t
                        border-slate-100
                        px-5
                        py-4
                        sm:flex-row
                        sm:items-center
                        sm:justify-between
                    "
                >

                    <p
                        id="paginationInfo"
                        class="
                            text-sm
                            text-slate-400
                        "
                    >
                        —
                    </p>


                    <div
                        id="pagination"
                        class="
                            flex
                            items-center
                            gap-2
                        "
                    ></div>

                </div>

            </section>


            <!-- =================================================
                 FOOTER
            ================================================== -->

            <footer
                class="
                    mt-8
                    pb-4
                    text-center
                "
            >

                <p
                    class="
                        text-xs
                        text-slate-400
                    "
                >
                    © 2026 Smart School.
                    Tous droits réservés.
                </p>

            </footer>

        </div>

    </main>


    <!-- =========================================================
         CREATE / EDIT SUBJECT MODAL
    ========================================================== -->

    <div
        id="subjectModal"
        class="
            fixed
            inset-0
            z-[100]
            hidden
            items-center
            justify-center
            bg-slate-900/50
            p-4
            opacity-0
            modal-transition
        "
    >

        <div
            id="subjectModalContent"
            class="
                max-h-[90vh]
                w-full
                max-w-2xl
                scale-95
                overflow-y-auto
                rounded-2xl
                bg-white
                shadow-2xl
                modal-transition
            "
        >

            <!-- MODAL HEADER -->

            <div
                class="
                    sticky
                    top-0
                    z-10
                    flex
                    items-center
                    justify-between
                    border-b
                    border-slate-100
                    bg-white
                    px-6
                    py-5
                "
            >

                <div>

                    <h3
                        id="subjectModalTitle"
                        class="
                            text-lg
                            font-bold
                            text-slate-800
                        "
                    >
                        Nouvelle matière
                    </h3>

                    <p
                        id="subjectModalSubtitle"
                        class="
                            mt-1
                            text-sm
                            text-slate-400
                        "
                    >
                        Ajoutez une nouvelle discipline.
                    </p>

                </div>


                <button
                    type="button"
                    onclick="closeSubjectModal()"
                    class="
                        flex
                        h-9
                        w-9
                        items-center
                        justify-center
                        rounded-lg
                        text-slate-400
                        transition
                        hover:bg-slate-100
                        hover:text-slate-700
                    "
                    aria-label="Fermer"
                >
                    <i
                        class="
                            fa-solid
                            fa-xmark
                        "
                    ></i>
                </button>

            </div>


            <!-- FORM -->

            <form
                id="subjectForm"
                class="p-6"
            >

                <div
                    id="subjectFormError"
                    class="
                        mb-5
                        hidden
                        rounded-xl
                        border
                        border-red-200
                        bg-red-50
                        px-4
                        py-3
                        text-sm
                        text-red-700
                    "
                ></div>


                <!-- NOM -->

                <div>

                    <label
                        for="subjectName"
                        class="
                            block
                            text-sm
                            font-semibold
                            text-slate-700
                        "
                    >
                        Nom de la matière
                        <span class="text-red-500">*</span>
                    </label>

                    <input
                        id="subjectName"
                        name="nom"
                        type="text"
                        maxlength="100"
                        required
                        placeholder="Ex. Mathématiques"
                        class="
                            mt-2
                            h-11
                            w-full
                            rounded-xl
                            border
                            border-slate-200
                            px-4
                            text-sm
                            outline-none
                            transition
                            focus:border-sky-400
                            focus:ring-2
                            focus:ring-sky-100
                        "
                    >

                </div>


                <!-- DESCRIPTION -->

                <div class="mt-5">

                    <label
                        for="subjectDescription"
                        class="
                            block
                            text-sm
                            font-semibold
                            text-slate-700
                        "
                    >
                        Description
                    </label>

                    <textarea
                        id="subjectDescription"
                        name="description"
                        rows="5"
                        placeholder="Décrivez brièvement cette matière…"
                        class="
                            mt-2
                            w-full
                            resize-none
                            rounded-xl
                            border
                            border-slate-200
                            px-4
                            py-3
                            text-sm
                            outline-none
                            transition
                            focus:border-sky-400
                            focus:ring-2
                            focus:ring-sky-100
                        "
                    ></textarea>

                </div>


                <!-- STATUS -->

                <div class="mt-5">

                    <label
                        for="subjectStatus"
                        class="
                            block
                            text-sm
                            font-semibold
                            text-slate-700
                        "
                    >
                        Statut
                    </label>

                    <select
                        id="subjectStatus"
                        name="statut"
                        class="
                            mt-2
                            h-11
                            w-full
                            rounded-xl
                            border
                            border-slate-200
                            bg-white
                            px-4
                            text-sm
                            text-slate-700
                            outline-none
                            transition
                            focus:border-sky-400
                            focus:ring-2
                            focus:ring-sky-100
                        "
                    >

                        <option value="ACTIVE">
                            Active
                        </option>

                        <option value="INACTIVE">
                            Inactive
                        </option>

                    </select>

                </div>


                <!-- BUTTONS -->

                <div
                    class="
                        mt-7
                        flex
                        flex-col-reverse
                        gap-3
                        sm:flex-row
                    "
                >

                    <button
                        type="button"
                        onclick="closeSubjectModal()"
                        class="
                            flex-1
                            rounded-xl
                            border
                            border-slate-200
                            px-4
                            py-3
                            text-sm
                            font-semibold
                            text-slate-600
                            transition
                            hover:bg-slate-50
                        "
                    >
                        Annuler
                    </button>


                    <button
                        id="subjectSubmitButton"
                        type="submit"
                        class="
                            flex-1
                            rounded-xl
                            bg-sky-500
                            px-4
                            py-3
                            text-sm
                            font-semibold
                            text-white
                            transition
                            hover:bg-sky-600
                            disabled:cursor-not-allowed
                            disabled:opacity-60
                        "
                    >

                        <span
                            id="subjectSubmitText"
                        >
                            Enregistrer la matière
                        </span>

                    </button>

                </div>

            </form>

        </div>

    </div>


    <!-- =========================================================
         DETAIL MODAL
    ========================================================== -->

    <div
        id="detailModal"
        class="
            fixed
            inset-0
            z-[100]
            hidden
            items-center
            justify-center
            bg-slate-900/50
            p-4
            opacity-0
            modal-transition
        "
    >

        <div
            id="detailModalContent"
            class="
                max-h-[90vh]
                w-full
                max-w-xl
                scale-95
                overflow-y-auto
                rounded-2xl
                bg-white
                shadow-2xl
                modal-transition
            "
        >

            <div
                class="
                    flex
                    items-center
                    justify-between
                    border-b
                    border-slate-100
                    px-6
                    py-5
                "
            >

                <div>

                    <p
                        class="
                            text-xs
                            font-bold
                            uppercase
                            tracking-widest
                            text-sky-500
                        "
                    >
                        Détails
                    </p>

                    <h3
                        id="detailSubjectTitle"
                        class="
                            mt-1
                            text-xl
                            font-bold
                            text-slate-800
                        "
                    >
                        Matière
                    </h3>

                </div>


                <button
                    type="button"
                    onclick="closeDetailModal()"
                    class="
                        flex
                        h-9
                        w-9
                        items-center
                        justify-center
                        rounded-lg
                        text-slate-400
                        hover:bg-slate-100
                    "
                >
                    <i
                        class="
                            fa-solid
                            fa-xmark
                        "
                    ></i>
                </button>

            </div>


            <div class="p-6">

                <div
                    id="detailStatus"
                    class="mb-5"
                ></div>


                <div
                    class="
                        rounded-xl
                        border
                        border-slate-100
                        bg-slate-50
                        p-4
                    "
                >

                    <p
                        class="
                            text-xs
                            font-semibold
                            uppercase
                            tracking-wide
                            text-slate-400
                        "
                    >
                        Description
                    </p>

                    <p
                        id="detailDescription"
                        class="
                            mt-2
                            text-sm
                            leading-6
                            text-slate-600
                        "
                    >
                        —
                    </p>

                </div>


                <div
                    class="
                        mt-5
                        grid
                        gap-3
                        sm:grid-cols-2
                    "
                >

                    <div
                        class="
                            rounded-xl
                            border
                            border-slate-100
                            bg-white
                            p-4
                        "
                    >

                        <p
                            class="
                                text-xs
                                text-slate-400
                            "
                        >
                            Devoirs associés
                        </p>

                        <p
                            id="detailDevoirs"
                            class="
                                mt-2
                                text-2xl
                                font-bold
                                text-slate-800
                            "
                        >
                            —
                        </p>

                    </div>


                    <div
                        class="
                            rounded-xl
                            border
                            border-slate-100
                            bg-white
                            p-4
                        "
                    >

                        <p
                            class="
                                text-xs
                                text-slate-400
                            "
                        >
                            Exercices associés
                        </p>

                        <p
                            id="detailExercices"
                            class="
                                mt-2
                                text-2xl
                                font-bold
                                text-slate-800
                            "
                        >
                            —
                        </p>

                    </div>

                </div>


                <div class="mt-5">

                    <button
                        type="button"
                        onclick="closeDetailModal()"
                        class="
                            w-full
                            rounded-xl
                            border
                            border-slate-200
                            px-4
                            py-3
                            text-sm
                            font-semibold
                            text-slate-600
                            hover:bg-slate-50
                        "
                    >
                        Fermer
                    </button>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         CONFIRM MODAL
    ========================================================== -->

    <div
        id="confirmModal"
        class="
            fixed
            inset-0
            z-[110]
            hidden
            items-center
            justify-center
            bg-slate-900/50
            p-4
            opacity-0
            modal-transition
        "
    >

        <div
            id="confirmModalContent"
            class="
                w-full
                max-w-md
                scale-95
                rounded-2xl
                bg-white
                shadow-2xl
                modal-transition
            "
        >

            <div class="p-6">

                <div
                    id="confirmIcon"
                    class="
                        flex
                        h-12
                        w-12
                        items-center
                        justify-center
                        rounded-xl
                        bg-amber-50
                        text-amber-600
                    "
                >
                    <i
                        class="
                            fa-solid
                            fa-triangle-exclamation
                        "
                    ></i>
                </div>


                <h3
                    id="confirmTitle"
                    class="
                        mt-5
                        text-lg
                        font-bold
                        text-slate-800
                    "
                >
                    Confirmation
                </h3>


                <p
                    id="confirmMessage"
                    class="
                        mt-2
                        text-sm
                        leading-6
                        text-slate-500
                    "
                >
                    Êtes-vous sûr ?
                </p>


                <div
                    class="
                        mt-6
                        flex
                        flex-col-reverse
                        gap-3
                        sm:flex-row
                    "
                >

                    <button
                        type="button"
                        onclick="closeConfirmModal()"
                        class="
                            flex-1
                            rounded-xl
                            border
                            border-slate-200
                            px-4
                            py-3
                            text-sm
                            font-semibold
                            text-slate-600
                            hover:bg-slate-50
                        "
                    >
                        Annuler
                    </button>


                    <button
                        id="confirmActionButton"
                        type="button"
                        class="
                            flex-1
                            rounded-xl
                            bg-red-500
                            px-4
                            py-3
                            text-sm
                            font-semibold
                            text-white
                            hover:bg-red-600
                            disabled:opacity-60
                        "
                    >
                        Confirmer
                    </button>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         TOAST
    ========================================================== -->

    <div
        id="toast"
        class="
            pointer-events-none
            fixed
            bottom-6
            right-6
            z-[200]
            hidden
            translate-y-3
            opacity-0
            toast-transition
        "
    >

        <div
            id="toastInner"
            class="
                flex
                max-w-sm
                items-start
                gap-3
                rounded-xl
                border
                border-slate-200
                bg-white
                px-4
                py-3
                shadow-xl
            "
        >

            <div
                id="toastIcon"
                class="
                    flex
                    h-8
                    w-8
                    shrink-0
                    items-center
                    justify-center
                    rounded-lg
                    bg-emerald-50
                    text-emerald-600
                "
            >
                <i
                    id="toastIconElement"
                    class="
                        fa-solid
                        fa-check
                    "
                ></i>
            </div>


            <div>

                <p
                    id="toastTitle"
                    class="
                        text-sm
                        font-semibold
                        text-slate-800
                    "
                >
                    Opération réussie
                </p>

                <p
                    id="toastMessage"
                    class="
                        mt-0.5
                        text-xs
                        leading-5
                        text-slate-500
                    "
                >
                    —
                </p>

            </div>

        </div>

    </div>


    <!-- =========================================================
         JS
    ========================================================== -->

    <script src="/assets/js/school_admin/matieres.js"></script>

</body>

</html>