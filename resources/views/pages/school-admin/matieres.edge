<!DOCTYPE html>
<html lang="fr">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Matières — Smart School
    </title>

    <meta
        name="description"
        content="Gestion des matières de votre établissement."
    >

    <!-- =========================================================
         TAILWIND
    ========================================================== -->

    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            500: '#0ea5e9',
                            600: '#0284c7',
                            700: '#0369a1',
                        },
                    },

                    boxShadow: {
                        soft:
                            '0 10px 30px rgba(15, 23, 42, 0.06)',
                    },
                },
            },
        }
    </script>


    <!-- =========================================================
         FONT AWESOME
    ========================================================== -->

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    >


    <!-- =========================================================
         STYLE LOCAL
    ========================================================== -->

    <style>

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family:
                Inter,
                ui-sans-serif,
                system-ui,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                sans-serif;
        }

        .sidebar-transition {
            transition:
                transform 0.3s ease-in-out;
        }

        .modal-transition {
            transition:
                opacity 0.2s ease,
                transform 0.2s ease;
        }

        .table-scroll::-webkit-scrollbar {
            height: 8px;
        }

        .table-scroll::-webkit-scrollbar-track {
            background: #f8fafc;
        }

        .table-scroll::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 999px;
        }

        .toast-transition {
            transition:
                opacity 0.25s ease,
                transform 0.25s ease;
        }

        .line-clamp-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

    </style>

</head>


<body class="bg-slate-50 text-slate-800">

    <!-- =========================================================
         MOBILE OVERLAY
    ========================================================== -->

    <div
        id="sidebarOverlay"
        class="
            fixed
            inset-0
            z-40
            hidden
            bg-slate-900/40
            lg:hidden
        "
    ></div>


    <!-- =========================================================
         SIDEBAR
    ========================================================== -->

    <aside
        id="sidebar"
        class="
            fixed
            inset-y-0
            left-0
            z-50
            w-72
            bg-white
            border-r
            border-slate-200
            -translate-x-full
            sidebar-transition
            lg:translate-x-0
        "
    >

        <!-- BRAND -->

        <div
            class="
                h-20
                px-6
                flex
                items-center
                border-b
                border-slate-100
            "
        >

            <div class="flex items-center gap-3">

                <div
                    class="
                        w-11
                        h-11
                        rounded-xl
                        bg-sky-500
                        text-white
                        flex
                        items-center
                        justify-center
                        shadow-sm
                    "
                >
                    <i
                        class="
                            fa-solid
                            fa-graduation-cap
                            text-xl
                        "
                    ></i>
                </div>

                <div>

                    <h1
                        class="
                            text-lg
                            font-bold
                            text-slate-800
                        "
                    >
                        Smart School
                    </h1>

                    <p
                        class="
                            text-xs
                            text-slate-400
                        "
                    >
                        Espace établissement
                    </p>

                </div>

            </div>


            <button
                id="closeSidebar"
                type="button"
                class="
                    ml-auto
                    lg:hidden
                    text-slate-400
                    hover:text-slate-700
                "
                aria-label="Fermer le menu"
            >
                <i
                    class="
                        fa-solid
                        fa-xmark
                        text-xl
                    "
                ></i>
            </button>

        </div>


        <!-- =====================================================
             SCHOOL CARD
        ====================================================== -->

        <div class="p-4">

            <div
                class="
                    rounded-xl
                    bg-sky-50
                    border
                    border-sky-100
                    p-4
                "
            >

                <div class="flex items-start gap-3">

                    <div
                        class="
                            w-10
                            h-10
                            rounded-lg
                            bg-white
                            text-sky-500
                            flex
                            items-center
                            justify-center
                            shadow-sm
                            shrink-0
                        "
                    >
                        <i
                            class="
                                fa-solid
                                fa-school
