```html
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Rapports | Smart School</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Font Awesome -->
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#38BDF8',
                        primaryDark: '#0284C7',
                        primaryLight: '#E0F2FE',
                        darkBlue: '#0F172A'
                    }
                }
            }
        }
    </script>

    <style>
        body {
            font-family: Inter, ui-sans-serif, system-ui, -apple-system,
                         BlinkMacSystemFont, "Segoe UI", sans-serif;
        }

        .sidebar-transition {
            transition: transform 0.3s ease-in-out;
        }

        .overlay-transition {
            transition: opacity 0.3s ease-in-out;
        }

        .modal-transition {
            transition: opacity 0.2s ease, transform 0.2s ease;
        }

        .scrollbar-hide::-webkit-scrollbar {
            display: none;
        }

        .scrollbar-hide {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>

<body class="bg-slate-50 text-slate-800">

<!-- ========================================================= -->
<!-- MOBILE OVERLAY -->
<!-- ========================================================= -->

<div
    id="sidebarOverlay"
    class="fixed inset-0 bg-slate-900/50 z-40 hidden opacity-0 overlay-transition lg:hidden"
></div>

<!-- ========================================================= -->
<!-- SIDEBAR -->
<!-- ========================================================= -->

<aside
    id="sidebar"
    class="fixed top-0 left-0 z-50 h-screen w-72 bg-white border-r border-slate-200
           sidebar-transition -translate-x-full lg:translate-x-0"
>

    <!-- Logo -->

    <div class="h-20 flex items-center px-6 border-b border-slate-100">

        <div class="flex items-center gap-3">

            <div
                class="w-11 h-11 rounded-xl bg-sky-500 flex items-center justify-center
                       text-white shadow-sm"
            >
                <i class="fa-solid fa-graduation-cap text-xl"></i>
            </div>

            <div>

                <h1 class="text-lg font-bold text-slate-800">
                    Smart School
                </h1>

                <p class="text-xs text-slate-400">
                    Administration
                </p>

            </div>

        </div>

        <button
            id="closeSidebar"
            class="ml-auto lg:hidden text-slate-400 hover:text-slate-700"
        >
            <i class="fa-solid fa-xmark text-xl"></i>
        </button>

    </div>

    <!-- Navigation -->

    <nav class="px-4 py-6 space-y-2">

        <p class="px-3 mb-3 text-xs font-semibold uppercase tracking-wider text-slate-400">
            Administration
        </p>

        <!-- Dashboard -->

        <a
            href="/super-admin/dashboard"
            class="flex items-center gap-3 px-4 py-3 rounded-xl
                   text-slate-600 hover:bg-sky-50 hover:text-sky-600 transition"
        >
            <i class="fa-solid fa-chart-pie w-5"></i>
            <span>Dashboard</span>
        </a>

        <!-- Ecoles -->

        <a
            href="/super-admin/ecoles"
            class="flex items-center gap-3 px-4 py-3 rounded-xl
                   text-slate-600 hover:bg-sky-50 hover:text-sky-600 transition"
        >
            <i class="fa-solid fa-school w-5"></i>
            <span>Écoles</span>
        </a>

        <!-- Utilisateurs -->

        <a
            href="/super-admin/utilisateurs"
            class="flex items-center gap-3 px-4 py-3 rounded-xl
                   text-slate-600 hover:bg-sky-50 hover:text-sky-600 transition"
        >
            <i class="fa-solid fa-users w-5"></i>
            <span>Utilisateurs</span>
        </a>

        <!-- Statistiques -->

        <a
            href="/super-admin/statistiques"
            class="flex items-center gap-3 px-4 py-3 rounded-xl
                   text-slate-600 hover:bg-sky-50 hover:text-sky-600 transition"
        >
            <i class="fa-solid fa-chart-line w-5"></i>
            <span>Statistiques</span>
        </a>

        <!-- Rapports ACTIVE -->

        <a
            href="/super-admin/rapports"
            class="flex items-center gap-3 px-4 py-3 rounded-xl
                   bg-sky-50 text-sky-600 font-semibold"
        >
            <i class="fa-solid fa-file-lines w-5"></i>
            <span>Rapports</span>
        </a>

    </nav>

    <!-- Sidebar bottom -->

    <div class="absolute bottom-0 left-0 right-0 p-4 border-t border-slate-100">

        <button
            class="w-full flex items-center gap-3 px-4 py-3 rounded-xl
                   text-slate-500 hover:bg-slate-50 transition"
        >
            <i class="fa-solid fa-gear w-5"></i>
            <span>Paramètres</span>
        </button>

        <button
            class="w-full flex items-center gap-3 px-4 py-3 rounded-xl
                   text-red-500 hover:bg-red-50 transition"
        >
            <i class="fa-solid fa-right-from-bracket w-5"></i>
            <span>Déconnexion</span>
        </button>

    </div>

</aside>

<!-- ========================================================= -->
<!-- MAIN -->
<!-- ========================================================= -->

<div class="lg:ml-72 min-h-screen">

    <!-- ===================================================== -->
    <!-- HEADER -->
    <!-- ===================================================== -->

    <header
        class="h-20 bg-white border-b border-slate-200 sticky top-0 z-30"
    >

        <div
            class="h-full px-4 sm:px-6 lg:px-8 flex items-center justify-between"
        >

            <!-- Left -->

            <div class="flex items-center gap-4">

                <button
                    id="openSidebar"
                    class="lg:hidden w-10 h-10 rounded-lg hover:bg-slate-100
                           flex items-center justify-center text-slate-600"
                >
                    <i class="fa-solid fa-bars"></i>
                </button>

                <div>

                    <h2 class="text-lg sm:text-xl font-bold text-slate-800">
                        Rapports
                    </h2>

                    <p class="text-xs sm:text-sm text-slate-400 hidden sm:block">
                        Gestion et génération des rapports
                    </p>

                </div>

            </div>

            <!-- Right -->

            <div class="flex items-center gap-3">

                <!-- Notification -->

                <button
                    class="relative w-10 h-10 rounded-xl hover:bg-slate-100
                           flex items-center justify-center text-slate-500"
                >

                    <i class="fa-regular fa-bell text-lg"></i>

                    <span
                        class="absolute top-2 right-2 w-2 h-2 bg-red-500
                               rounded-full border-2 border-white"
                    ></span>

                </button>

                <!-- Profile -->

                <div
                    class="hidden sm:flex items-center gap-3 pl-3
                           border-l border-slate-200"
                >

                    <div
                        class="w-10 h-10 rounded-full bg-sky-100 text-sky-600
                               flex items-center justify-center font-bold"
                    >
                        BM
                    </div>

                    <div class="hidden md:block">

                        <p class="text-sm font-semibold text-slate-700">
                            Super Admin
                        </p>

                        <p class="text-xs text-slate-400">
                            Administrateur système
                        </p>

                    </div>

                    <i class="fa-solid fa-chevron-down text-xs text-slate-400"></i>

                </div>

            </div>

        </div>

    </header>

    <!-- ===================================================== -->
    <!-- CONTENT -->
    <!-- ===================================================== -->

    <main class="p-4 sm:p-6 lg:p-8">

        <!-- ================================================= -->
        <!-- PAGE INTRO -->
        <!-- ================================================= -->

        <div
            class="flex flex-col lg:flex-row lg:items-center
                   lg:justify-between gap-4 mb-8"
        >

            <div>

                <h1 class="text-2xl font-bold text-slate-800">
                    Rapports
                </h1>

                <p class="mt-1 text-sm text-slate-500">
                    Consultez, générez et exportez les rapports de la plateforme.
                </p>

            </div>

            <!-- Generate -->

            <button
                onclick="openGenerateModal()"
                class="inline-flex items-center justify-center gap-2
                       px-5 py-3 rounded-xl bg-sky-500 hover:bg-sky-600
                       text-white text-sm font-semibold transition shadow-sm"
            >

                <i class="fa-solid fa-plus"></i>

                Générer un rapport

            </button>

        </div>

        <!-- ================================================= -->
        <!-- REPORT SUMMARY -->
        <!-- ================================================= -->

        <section class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5 mb-8">

            <!-- Total -->

            <div
                class="bg-white rounded-2xl border border-slate-200
                       p-5 shadow-sm"
            >

                <div class="flex items-start justify-between">

                    <div>

                        <p class="text-sm text-slate-500">
                            Rapports générés
                        </p>

                        <h3 class="mt-2 text-3xl font-bold text-slate-800">
                            248
                        </h3>

                    </div>

                    <div
                        class="w-12 h-12 rounded-xl bg-sky-50 text-sky-500
                               flex items-center justify-center"
                    >

                        <i class="fa-solid fa-file-lines text-xl"></i>

                    </div>

                </div>

                <p class="mt-4 text-xs text-slate-400">
                    Depuis le début de l'année
                </p>

            </div>

            <!-- Monthly -->

            <div
                class="bg-white rounded-2xl border border-slate-200
                       p-5 shadow-sm"
            >

                <div class="flex items-start justify-between">

                    <div>

                        <p class="text-sm text-slate-500">
                            Ce mois
                        </p>

                        <h3 class="mt-2 text-3xl font-bold text-slate-800">
                            32
                        </h3>

                    </div>

                    <div
                        class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-500
                               flex items-center justify-center"
                    >

                        <i class="fa-solid fa-calendar-days text-xl"></i>

                    </div>

                </div>

                <p class="mt-4 text-xs text-emerald-500 font-medium">
                    +14.3% par rapport au mois précédent
                </p>

            </div>

            <!-- Downloads -->

            <div
                class="bg-white rounded-2xl border border-slate-200
                       p-5 shadow-sm"
            >

                <div class="flex items-start justify-between">

                    <div>

                        <p class="text-sm text-slate-500">
                            Téléchargements
                        </p>

                        <h3 class="mt-2 text-3xl font-bold text-slate-800">
                            1,426
                        </h3>

                    </div>

                    <div
                        class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-500
                               flex items-center justify-center"
                    >

                        <i class="fa-solid fa-download text-xl"></i>

                    </div>

                </div>

                <p class="mt-4 text-xs text-slate-400">
                    Tous formats confondus
                </p>

            </div>

            <!-- Scheduled -->

            <div
                class="bg-white rounded-2xl border border-slate-200
                       p-5 shadow-sm"
            >

                <div class="flex items-start justify-between">

                    <div>

                        <p class="text-sm text-slate-500">
                            Rapports planifiés
                        </p>

                        <h3 class="mt-2 text-3xl font-bold text-slate-800">
                            8
                        </h3>

                    </div>

                    <div
                        class="w-12 h-12 rounded-xl bg-amber-50 text-amber-500
                               flex items-center justify-center"
                    >

                        <i class="fa-solid fa-clock text-xl"></i>

                    </div>

                </div>

                <p class="mt-4 text-xs text-slate-400">
                    Génération automatique
                </p>

            </div>

        </section>

        <!-- ================================================= -->
        <!-- AVAILABLE REPORTS -->
        <!-- ================================================= -->

        <section class="mb-8">

            <div class="mb-5">

                <h2 class="text-lg font-bold text-slate-800">
                    Types de rapports
                </h2>

                <p class="text-sm text-slate-400 mt-1">
                    Sélectionnez un type de rapport à générer.
                </p>

            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-5">

                <!-- School report -->

                <div
                    class="bg-white rounded-2xl border border-slate-200
                           p-5 shadow-sm hover:shadow-md hover:border-sky-200
                           transition group"
                >

                    <div
                        class="w-12 h-12 rounded-xl bg-sky-50 text-sky-500
                               flex items-center justify-center mb-4
                               group-hover:bg-sky-500 group-hover:text-white
                               transition"
                    >

                        <i class="fa-solid fa-school text-xl"></i>

                    </div>

                    <h3 class="font-bold text-slate-800">
                        Rapport des écoles
                    </h3>

                    <p class="text-sm text-slate-400 mt-2 leading-6">
                        Informations et statistiques générales sur les écoles.
                    </p>

                    <button
                        onclick="selectReport('schools')"
                        class="mt-5 text-sm font-semibold text-sky-500
                               hover:text-sky-600"
                    >
                        Générer
                        <i class="fa-solid fa-arrow-right ml-1"></i>
                    </button>

                </div>

                <!-- Users report -->

                <div
                    class="bg-white rounded-2xl border border-slate-200
                           p-5 shadow-sm hover:shadow-md hover:border-indigo-200
                           transition group"
                >

                    <div
                        class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-500
                               flex items-center justify-center mb-4
                               group-hover:bg-indigo-500 group-hover:text-white
                               transition"
                    >

                        <i class="fa-solid fa-users text-xl"></i>

                    </div>

                    <h3 class="font-bold text-slate-800">
                        Rapport des utilisateurs
                    </h3>

                    <p class="text-sm text-slate-400 mt-2 leading-6">
                        Synthèse des administrateurs, enseignants, élèves et parents.
                    </p>

                    <button
                        onclick="selectReport('users')"
                        class="mt-5 text-sm font-semibold text-indigo-500
                               hover:text-indigo-600"
                    >
                        Générer
                        <i class="fa-solid fa-arrow-right ml-1"></i>
                    </button>

                </div>

                <!-- Academic report -->

                <div
                    class="bg-white rounded-2xl border border-slate-200
                           p-5 shadow-sm hover:shadow-md hover:border-emerald-200
                           transition group"
                >

                    <div
                        class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-500
                               flex items-center justify-center mb-4
                               group-hover:bg-emerald-500 group-hover:text-white
                               transition"
                    >

                        <i class="fa-solid fa-graduation-cap text-xl"></i>

                    </div>

                    <h3 class="font-bold text-slate-800">
                        Rapport pédagogique
                    </h3>

                    <p class="text-sm text-slate-400 mt-2 leading-6">
                        Résultats, présence et performances académiques.
                    </p>

                    <button
                        onclick="selectReport('academic')"
                        class="mt-5 text-sm font-semibold text-emerald-500
                               hover:text-emerald-600"
                    >
                        Générer
                        <i class="fa-solid fa-arrow-right ml-1"></i>
                    </button>

                </div>

                <!-- Platform report -->

                <div
                    class="bg-white rounded-2xl border border-slate-200
                           p-5 shadow-sm hover:shadow-md hover:border-violet-200
                           transition group"
                >

                    <div
                        class="w-12 h-12 rounded-xl bg-violet-50 text-violet-500
                               flex items-center justify-center mb-4
                               group-hover:bg-violet-500 group-hover:text-white
                               transition"
                    >

                        <i class="fa-solid fa-chart-column text-xl"></i>

                    </div>

                    <h3 class="font-bold text-slate-800">
                        Rapport plateforme
                    </h3>

                    <p class="text-sm text-slate-400 mt-2 leading-6">
                        Activité, utilisation et performances globales du système.
                    </p>

                    <button
                        onclick="selectReport('platform')"
                        class="mt-5 text-sm font-semibold text-violet-500
                               hover:text-violet-600"
                    >
                        Générer
                        <i class="fa-solid fa-arrow-right ml-1"></i>
                    </button>

                </div>

            </div>

        </section>

        <!-- ================================================= -->
        <!-- FILTERS -->
        <!-- ================================================= -->

        <section
            class="bg-white rounded-2xl border border-slate-200
                   shadow-sm mb-6"
        >

            <div
                class="p-5 sm:p-6 border-b border-slate-100"
            >

                <div class="flex items-center gap-3">

                    <div
                        class="w-10 h-10 rounded-xl bg-sky-50 text-sky-500
                               flex items-center justify-center"
                    >

                        <i class="fa-solid fa-filter"></i>

                    </div>

                    <div>

                        <h3 class="font-bold text-slate-800">
                            Filtrer les rapports
                        </h3>

                        <p class="text-xs text-slate-400 mt-1">
                            Recherchez rapidement un rapport.
                        </p>

                    </div>

                </div>

            </div>

            <div class="p-5 sm:p-6">

                <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4">

                    <!-- Search -->

                    <div>

                        <label
                            class="block text-xs font-semibold text-slate-500 mb-2"
                        >
                            Recherche
                        </label>

                        <div class="relative">

                            <i
                                class="fa-solid fa-magnifying-glass absolute left-3
                                       top-1/2 -translate-y-1/2 text-slate-400"
                            ></i>

                            <input
                                id="searchInput"
                                type="text"
                                placeholder="Nom du rapport..."
                                class="w-full pl-10 pr-4 py-2.5 rounded-xl
                                       border border-slate-200 bg-slate-50
                                       text-sm outline-none
                                       focus:ring-2 focus:ring-sky-200
                                       focus:border-sky-400"
                            >

                        </div>

                    </div>

                    <!-- Type -->

                    <div>

                        <label
                            class="block text-xs font-semibold text-slate-500 mb-2"
                        >
                            Type
                        </label>

                        <select
                            id="typeFilter"
                            class="w-full px-4 py-2.5 rounded-xl
                                   border border-slate-200 bg-slate-50
                                   text-sm outline-none
                                   focus:ring-2 focus:ring-sky-200
                                   focus:border-sky-400"
                        >

                            <option value="">
                                Tous les types
                            </option>

                            <option value="schools">
                                Écoles
                            </option>

                            <option value="users">
                                Utilisateurs
                            </option>

                            <option value="academic">
                                Pédagogique
                            </option>

                            <option value="platform">
                                Plateforme
                            </option>

                        </select>

                    </div>

                    <!-- Status -->

                    <div>

                        <label
                            class="block text-xs font-semibold text-slate-500 mb-2"
                        >
                            Statut
                        </label>

                        <select
                            id="statusFilter"
                            class="w-full px-4 py-2.5 rounded-xl
                                   border border-slate-200 bg-slate-50
                                   text-sm outline-none
                                   focus:ring-2 focus:ring-sky-200
                                   focus:border-sky-400"
                        >

                            <option value="">
                                Tous les statuts
                            </option>

                            <option value="ready">
                                Disponible
                            </option>

                            <option value="processing">
                                En traitement
                            </option>

                            <option value="scheduled">
                                Planifié
                            </option>

                        </select>

                    </div>

                    <!-- Date -->

                    <div>

                        <label
                            class="block text-xs font-semibold text-slate-500 mb-2"
                        >
                            Période
                        </label>

                        <select
                            id="dateFilter"
                            class="w-full px-4 py-2.5 rounded-xl
                                   border border-slate-200 bg-slate-50
                                   text-sm outline-none
                                   focus:ring-2 focus:ring-sky-200
                                   focus:border-sky-400"
                        >

                            <option value="">
                                Toutes les périodes
                            </option>

                            <option value="today">
                                Aujourd'hui
                            </option>

                            <option value="week">
                                Cette semaine
                            </option>

                            <option value="month">
                                Ce mois
                            </option>

                            <option value="year">
                                Cette année
                            </option>

                        </select>

                    </div>

                </div>

            </div>

        </section>

        <!-- ================================================= -->
        <!-- REPORT TABLE -->
        <!-- ================================================= -->

        <section
            class="bg-white rounded-2xl border border-slate-200
                   shadow-sm overflow-hidden"
        >

            <!-- Table header -->

            <div
                class="p-5 sm:p-6 border-b border-slate-100
                       flex flex-col sm:flex-row sm:items-center
                       sm:justify-between gap-3"
            >

                <div>

                    <h3 class="font-bold text-slate-800">
                        Rapports générés
                    </h3>

                    <p class="text-sm text-slate-400 mt-1">
                        Historique des rapports disponibles.
                    </p>

                </div>

                <span
                    id="reportCount"
                    class="text-xs font-semibold text-slate-500
                           bg-slate-100 px-3 py-1.5 rounded-full"
                >
                    6 rapports
                </span>

            </div>

            <!-- Responsive table -->

            <div class="overflow-x-auto scrollbar-hide">

                <table class="w-full min-w-[850px]">

                    <thead class="bg-slate-50 border-b border-slate-100">

                        <tr>

                            <th
                                class="text-left px-6 py-4 text-xs font-semibold
                                       uppercase tracking-wider text-slate-400"
                            >
                                Rapport
                            </th>

                            <th
                                class="text-left px-6 py-4 text-xs font-semibold
                                       uppercase tracking-wider text-slate-400"
                            >
                                Type
                            </th>

                            <th
                                class="text-left px-6 py-4 text-xs font-semibold
                                       uppercase tracking-wider text-slate-400"
                            >
                                Période
                            </th>

                            <th
                                class="text-left px-6 py-4 text-xs font-semibold
                                       uppercase tracking-wider text-slate-400"
                            >
                                Généré le
                            </th>

                            <th
                                class="text-left px-6 py-4 text-xs font-semibold
                                       uppercase tracking-wider text-slate-400"
                            >
                                Statut
                            </th>

                            <th
                                class="text-right px-6 py-4 text-xs font-semibold
                                       uppercase tracking-wider text-slate-400"
                            >
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody
                        id="reportsTable"
                        class="divide-y divide-slate-100"
                    >

                        <!-- REPORT 1 -->

                        <tr
                            class="report-row hover:bg-slate-50 transition"
                            data-name="Rapport global des écoles"
                            data-type="schools"
                            data-status="ready"
                        >

                            <td class="px-6 py-4">

                                <div class="flex items-center gap-3">

                                    <div
                                        class="w-10 h-10 rounded-xl bg-sky-50
                                               text-sky-500 flex items-center
                                               justify-center shrink-0"
                                    >

                                        <i class="fa-solid fa-school"></i>

                                    </div>

                                    <div>

                                        <p class="text-sm font-semibold text-slate-700">
                                            Rapport global des écoles
                                        </p>

                                        <p class="text-xs text-slate-400 mt-1">
                                            PDF • 2.4 MB
                                        </p>

                                    </div>

                                </div>

                            </td>

                            <td class="px-6 py-4">

                                <span
                                    class="inline-flex px-2.5 py-1 rounded-full
                                           bg-sky-50 text-sky-600 text-xs font-medium"
                                >
                                    Écoles
                                </span>

                            </td>

