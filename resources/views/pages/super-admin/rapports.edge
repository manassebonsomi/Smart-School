<!DOCTYPE html>

<html lang="fr">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="description"
        content="Gestion des rapports Smart School"
    >

    <title>Rapports | Smart School</title>


    <!-- =========================================================
         TAILWIND
    ========================================================== -->

    <script src="https://cdn.tailwindcss.com"></script>


    <!-- =========================================================
         FONT AWESOME
    ========================================================== -->

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >


    <!-- =========================================================
         TAILWIND CONFIG
    ========================================================== -->

    <script>

        tailwind.config = {

            theme: {

                extend: {

                    colors: {

                        primary: {

                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            200: '#bae6fd',
                            300: '#7dd3fc',
                            400: '#38bdf8',
                            500: '#0ea5e9',
                            600: '#0284c7',
                            700: '#0369a1',
                            800: '#075985',
                            900: '#0c4a6e'

                        }

                    }

                }

            }

        }

    </script>


    <style>

        * {
            box-sizing: border-box;
        }


        html {
            scroll-behavior: smooth;
        }


        body {

            margin: 0;

            font-family:
                Inter,
                ui-sans-serif,
                system-ui,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                sans-serif;

        }


        ::-webkit-scrollbar {

            width: 7px;
            height: 7px;

        }


        ::-webkit-scrollbar-thumb {

            background: #cbd5e1;

            border-radius: 999px;

        }


        .sidebar-transition {

            transition:
                transform .3s ease-in-out;

        }


        .overlay-transition {

            transition:
                opacity .25s ease;

        }


        .modal-transition {

            transition:
                opacity .2s ease,
                transform .2s ease;

        }


        .loader {

            width: 21px;
            height: 21px;

            border:
                3px solid #bae6fd;

            border-top-color:
                #0284c7;

            border-radius:
                999px;

            animation:
                spin .7s linear infinite;

        }


        @keyframes spin {

            to {
                transform: rotate(360deg);
            }

        }


        .report-card {

            transition:
                transform .2s ease,
                box-shadow .2s ease,
                border-color .2s ease;

        }


        .report-card:hover {

            transform:
                translateY(-2px);

            box-shadow:
                0 14px 30px
                rgba(15, 23, 42, .06);

        }


        .action-button {

            transition:
                background-color .2s ease,
                color .2s ease,
                transform .2s ease;

        }


        .action-button:hover {

            transform:
                translateY(-1px);

        }


        .csv-preview {

            font-family:
                Consolas,
                Monaco,
                monospace;

            white-space: pre;

            overflow:
                auto;

            font-size:
                12px;

        }

    </style>

</head>


<body class="bg-slate-50 text-slate-800">


<!-- =========================================================
     MOBILE OVERLAY
========================================================= -->

<div
    id="sidebarOverlay"
    class="
        overlay-transition
        fixed
        inset-0
        z-40
        hidden
        bg-slate-900/50
    "
></div>


<!-- =========================================================
     SIDEBAR
========================================================= -->

<aside
    id="sidebar"
    class="
        sidebar-transition
        fixed
        inset-y-0
        left-0
        z-50
        flex
        w-72
        -translate-x-full
        flex-col
        border-r
        border-slate-200
        bg-white
        lg:translate-x-0
    "
>


    <!-- =====================================================
         SIDEBAR HEADER
    ====================================================== -->

    <div
        class="
            flex
            h-20
            items-center
            gap-3
            border-b
            border-slate-100
            px-6
        "
    >

        <div
            class="
                flex
                h-11
                w-11
                shrink-0
                items-center
                justify-center
                rounded-xl
                bg-primary-600
                text-white
                shadow-lg
                shadow-primary-600/20
            "
        >

            <i
                class="
                    fa-solid
                    fa-graduation-cap
                    text-lg
                "
            ></i>

        </div>


        <div class="min-w-0">

            <h1
                class="
                    truncate
                    text-base
                    font-extrabold
                    tracking-tight
                    text-slate-900
                "
            >
                SMART SCHOOL
            </h1>


            <p
                class="
                    truncate
                    text-xs
                    text-slate-400
                "
            >
                Administration Platform
            </p>

        </div>


        <button
            id="closeSidebar"
            type="button"
            class="
                ml-auto
                flex
                h-9
                w-9
                items-center
                justify-center
                rounded-lg
                text-slate-400
                hover:bg-slate-100
                hover:text-slate-700
                lg:hidden
            "
            aria-label="Fermer le menu"
        >

            <i class="fa-solid fa-xmark"></i>

        </button>

    </div>


    <!-- =====================================================
         SIDEBAR NAVIGATION
    ====================================================== -->

    <div
        class="
            flex-1
            overflow-y-auto
            px-4
            py-6
        "
    >

        <p
            class="
                mb-3
                px-3
                text-[10px]
                font-bold
                uppercase
                tracking-[0.18em]
                text-slate-400
            "
        >
            Principal
        </p>


        <nav class="space-y-1">


            <!-- Dashboard -->

            <a
                href="/super-admin/dashboard"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    px-4
                    py-3
                    text-sm
                    font-medium
                    text-slate-600
                    transition
                    hover:bg-slate-50
                    hover:text-slate-900
                "
            >

                <i
                    class="
                        fa-solid
                        fa-chart-pie
                        w-5
                        text-center
                    "
                ></i>

                <span>
                    Tableau de bord
                </span>

            </a>


            <!-- Écoles -->

            <a
                href="/super-admin/ecoles"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    px-4
                    py-3
                    text-sm
                    font-medium
                    text-slate-600
                    transition
                    hover:bg-slate-50
                    hover:text-slate-900
                "
            >

                <i
                    class="
                        fa-solid
                        fa-school
                        w-5
                        text-center
                    "
                ></i>

                <span>
                    Écoles
                </span>

            </a>


            <!-- Utilisateurs -->

            <a
                href="/super-admin/utilisateurs"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    px-4
                    py-3
                    text-sm
                    font-medium
                    text-slate-600
                    transition
                    hover:bg-slate-50
                    hover:text-slate-900
                "
            >

                <i
                    class="
                        fa-solid
                        fa-users
                        w-5
                        text-center
                    "
                ></i>

                <span>
                    Utilisateurs
                </span>

            </a>

        </nav>


        <p
            class="
                mb-3
                mt-8
                px-3
                text-[10px]
                font-bold
                uppercase
                tracking-[0.18em]
                text-slate-400
            "
        >
            Supervision
        </p>


        <nav class="space-y-1">


            <!-- Statistiques ACTIVE -->

            <a
                href="/super-admin/statistiques"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    bg-primary-50
                    px-4
                    py-3
                    text-sm
                    font-semibold
                    text-primary-700
                "
            >

                <i
                    class="
                        fa-solid
                        fa-chart-line
                        w-5
                        text-center
                    "
                ></i>

                <span>
                    Statistiques
                </span>

            </a>


            <!-- Rapports -->

            <a
                href="/super-admin/rapports"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    px-4
                    py-3
                    text-sm
                    font-medium
                    text-slate-600
                    transition
                    hover:bg-slate-50
                    hover:text-slate-900
                "
            >

                <i
                    class="
                        fa-solid
                        fa-file-lines
                        w-5
                        text-center
                    "
                ></i>

                <span>
                    Rapports
                </span>

            </a>

        </nav>


        <p
            class="
                mb-3
                mt-8
                px-3
                text-[10px]
                font-bold
                uppercase
                tracking-[0.18em]
                text-slate-400
            "
        >
            Système
        </p>


        <nav class="space-y-1">


            <a
                href="/super-admin/profil"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    bg-primary-50
                    px-4
                    py-3
                    text-sm
                    font-semibold
                    text-primary-700
                "
            >

                <i class="fa-solid fa-user-gear w-5 text-center"></i>

                Mon profil

            </a>


            <!-- Notifications -->

            <a
                href="#"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    px-4
                    py-3
                    text-sm
                    font-medium
                    text-slate-600
                    transition
                    hover:bg-slate-50
                    hover:text-slate-900
                "
            >

                <i
                    class="
                        fa-solid
                        fa-bell
                        w-5
                        text-center
                    "
                ></i>

                <span>
                    Notifications
                </span>

            </a>


            <!-- Paramètres -->

            <a
                href="#"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    px-4
                    py-3
                    text-sm
                    font-medium
                    text-slate-600
                    transition
                    hover:bg-slate-50
                    hover:text-slate-900
                "
            >

                <i
                    class="
                        fa-solid
                        fa-gear
                        w-5
                        text-center
                    "
                ></i>

                <span>
                    Paramètres
                </span>

            </a>


            <!-- Déconnexion -->

            <button
                type="button"
                onclick="logout()"
                class="
                    flex
                    w-full
                    items-center
                    gap-3
                    rounded-xl
                    px-4
                    py-3
                    text-sm
                    text-red-500
                    transition
                    hover:bg-red-50
                "
            >

                <i
                    class="
                        fa-solid
                        fa-right-from-bracket
                        w-5
                        text-center
                    "
                ></i>

                <span>
                    Déconnexion
                </span>

            </button>

        </nav>

    </div>


    <!-- =====================================================
         SIDEBAR USER
    ====================================================== -->

    <div
        class="
            border-t
            border-slate-100
            p-4
        "
    >

        <div
            class="
                flex
                items-center
                gap-3
                rounded-xl
                bg-slate-50
                p-3
            "
        >

            <div
                id="sidebarAvatar"
                class="
                    flex
                    h-10
                    w-10
                    shrink-0
                    items-center
                    justify-center
                    rounded-full
                    bg-primary-100
                    text-sm
                    font-bold
                    text-primary-700
                "
            >
                SA
            </div>


            <div class="min-w-0 flex-1">

                <p
                    id="sidebarUserName"
                    class="
                        truncate
                        text-sm
                        font-bold
                        text-slate-800
                    "
                >
                    Super Administrateur
                </p>


                <p
                    id="sidebarUserEmail"
                    class="
                        truncate
                        text-xs
                        text-slate-400
                    "
                >
                    Chargement...
                </p>

            </div>

        </div>

    </div>

</aside>


<!-- =========================================================
     MAIN
========================================================= -->

<div class="min-h-screen lg:ml-72">


    <!-- HEADER -->

    <header
        class="
            sticky
            top-0
            z-30
            flex
            h-20
            items-center
            justify-between
            border-b
            border-slate-200
            bg-white/95
            px-4
            backdrop-blur
            sm:px-6
            lg:px-8
        "
    >

        <div class="flex items-center gap-4">

            <button
                id="openSidebar"
                type="button"
                class="
                    flex
                    h-10
                    w-10
                    items-center
                    justify-center
                    rounded-xl
                    text-slate-600
                    hover:bg-slate-100
                    lg:hidden
                "
            >

                <i class="fa-solid fa-bars"></i>

            </button>


            <div>

                <p
                    class="
                        hidden
                        text-xs
                        font-semibold
                        uppercase
                        tracking-wider
                        text-primary-600
                        sm:block
                    "
                >
                    Supervision
                </p>


                <h2
                    class="
                        text-lg
                        font-bold
                        text-slate-900
                        sm:text-xl
                    "
                >
                    Rapports
                </h2>


                <p
                    class="
                        hidden
                        text-sm
                        text-slate-400
                        sm:block
                    "
                >
                    Génération et export des données
                </p>

            </div>

        </div>


        <div class="flex items-center gap-2 sm:gap-3">

            <button
                id="refreshReports"
                type="button"
                title="Actualiser"
                class="
                    flex
                    h-10
                    w-10
                    items-center
                    justify-center
                    rounded-xl
                    text-slate-500
                    hover:bg-slate-100
                    hover:text-primary-600
                "
            >

                <i class="fa-solid fa-rotate"></i>

            </button>


            <button
                type="button"
                title="Notifications"
                class="
                    relative
                    hidden
                    h-10
                    w-10
                    items-center
                    justify-center
                    rounded-xl
                    text-slate-500
                    hover:bg-slate-100
                    sm:flex
                "
            >

                <i class="fa-solid fa-bell"></i>


                <span
                    class="
                        absolute
                        right-2
                        top-2
                        h-2
                        w-2
                        rounded-full
                        bg-red-500
                        ring-2
                        ring-white
                    "
                ></span>

            </button>

        </div>

    </header>


    <!-- CONTENT -->

    <main
        class="
            p-4
            sm:p-6
            lg:p-8
        "
    >


        <!-- INTRO -->

        <section
            class="
                mb-8
                flex
                flex-col
                gap-4
                lg:flex-row
                lg:items-end
                lg:justify-between
            "
        >

            <div>

                <p
                    class="
                        text-sm
                        font-semibold
                        text-primary-600
                    "
                >
                    Centre documentaire
                </p>


                <h1
                    class="
                        mt-1
                        text-2xl
                        font-extrabold
                        tracking-tight
                        text-slate-900
                        sm:text-3xl
                    "
                >
                    Rapports
                </h1>


                <p
                    class="
                        mt-2
                        max-w-2xl
                        text-sm
                        leading-6
                        text-slate-500
                    "
                >
                    Générez et téléchargez les rapports réels
                    produits à partir des données de Smart School.
                </p>

            </div>


            <button
                type="button"
                onclick="openGenerateModal()"
                class="
                    inline-flex
                    items-center
                    justify-center
                    gap-2
                    rounded-xl
                    bg-primary-600
                    px-5
                    py-3
                    text-sm
                    font-semibold
                    text-white
                    shadow-sm
                    transition
                    hover:bg-primary-700
                "
            >

                <i class="fa-solid fa-file-circle-plus"></i>

                Générer un rapport

            </button>

        </section>


        <!-- GLOBAL ERROR -->

        <div
            id="reportsError"
            class="
                mb-6
                hidden
                items-start
                gap-3
                rounded-2xl
                border
                border-red-200
                bg-red-50
                px-4
                py-4
                text-sm
                text-red-700
            "
            role="alert"
        >

            <i
                class="
                    fa-solid
                    fa-circle-exclamation
                    mt-0.5
                "
            ></i>


            <span id="reportsErrorText"></span>

        </div>


        <!-- LOADING -->

        <div
            id="reportsLoading"
            class="
                mb-6
                flex
                items-center
                gap-3
                rounded-2xl
                border
                border-primary-100
                bg-primary-50
                px-4
                py-4
                text-sm
                font-medium
                text-primary-700
            "
        >

            <span class="loader"></span>

            Chargement des rapports...

        </div>


        <!-- =====================================================
             SUMMARY
        ====================================================== -->

        <section
            class="
                mb-8
                grid
                grid-cols-1
                gap-5
                sm:grid-cols-2
                xl:grid-cols-4
            "
        >


            <!-- TYPES -->

            <article
                class="
                    rounded-2xl
                    border
                    border-slate-200
                    bg-white
                    p-5
                    shadow-sm
                "
            >

                <div
                    class="
                        flex
                        items-start
                        justify-between
                    "
                >

                    <div>

                        <p class="text-sm text-slate-500">
                            Types disponibles
                        </p>


                        <h3
                            id="totalReportTypes"
                            class="
                                mt-2
                                text-3xl
                                font-extrabold
                            "
                        >
                            —
                        </h3>

                    </div>


                    <div
                        class="
                            flex
                            h-12
                            w-12
                            items-center
                            justify-center
                            rounded-xl
                            bg-sky-50
                            text-sky-600
                        "
                    >

                        <i class="fa-solid fa-file-lines"></i>

                    </div>

                </div>


                <p class="mt-4 text-xs text-slate-400">
                    Rapports pris en charge par la plateforme
                </p>

            </article>


            <!-- FORMAT -->

            <article
                class="
                    rounded-2xl
                    border
                    border-slate-200
                    bg-white
                    p-5
                    shadow-sm
                "
            >

                <div
                    class="
                        flex
                        items-start
                        justify-between
                    "
                >

                    <div>

                        <p class="text-sm text-slate-500">
                            Format disponible
                        </p>


                        <h3
                            id="availableFormat"
                            class="
                                mt-2
                                text-3xl
                                font-extrabold
                            "
                        >
                            CSV
                        </h3>

                    </div>


                    <div
                        class="
                            flex
                            h-12
                            w-12
                            items-center
                            justify-center
                            rounded-xl
                            bg-emerald-50
                            text-emerald-600
                        "
                    >

                        <i class="fa-solid fa-file-csv"></i>

                    </div>

                </div>


                <p class="mt-4 text-xs text-slate-400">
                    Export compatible avec Excel
                </p>

            </article>


            <!-- SESSION -->

            <article
                class="
                    rounded-2xl
                    border
                    border-slate-200
                    bg-white
                    p-5
                    shadow-sm
                "
            >

                <div
                    class="
                        flex
                        items-start
                        justify-between
                    "
                >

                    <div>

                        <p class="text-sm text-slate-500">
                            Générations de cette session
                        </p>


                        <h3
                            id="generatedCount"
                            class="
                                mt-2
                                text-3xl
                                font-extrabold
                            "
                        >
                            0
                        </h3>

                    </div>


                    <div
                        class="
                            flex
                            h-12
                            w-12
                            items-center
                            justify-center
                            rounded-xl
                            bg-indigo-50
                            text-indigo-600
                        "
                    >

                        <i class="fa-solid fa-arrows-rotate"></i>

                    </div>

                </div>


                <p class="mt-4 text-xs text-slate-400">
                    Depuis l'ouverture de cette page
                </p>

            </article>


            <!-- STATUS -->

            <article
                class="
                    rounded-2xl
                    border
                    border-slate-200
                    bg-white
                    p-5
                    shadow-sm
                "
            >

                <div
                    class="
                        flex
                        items-start
                        justify-between
                    "
                >

                    <div>

                        <p class="text-sm text-slate-500">
                            État du service
                        </p>


                        <h3
                            id="reportsServiceStatus"
                            class="
                                mt-2
                                text-2xl
                                font-extrabold
                                text-emerald-600
                            "
                        >
                            Opérationnel
                        </h3>

                    </div>


                    <div
                        class="
                            flex
                            h-12
                            w-12
                            items-center
                            justify-center
                            rounded-xl
                            bg-amber-50
                            text-amber-600
                        "
                    >

                        <i class="fa-solid fa-server"></i>

                    </div>

                </div>


                <p
                    id="lastGeneratedInfo"
                    class="
                        mt-4
                        text-xs
                        text-slate-400
                    "
                >
                    Aucun rapport généré
                </p>

            </article>

        </section>


        <!-- =====================================================
             FILTERS
        ====================================================== -->

        <section
            class="
                mb-8
                rounded-2xl
                border
                border-slate-200
                bg-white
                shadow-sm
            "
        >

            <div
                class="
                    flex
                    items-center
                    gap-3
                    border-b
                    border-slate-100
                    p-5
                    sm:p-6
                "
            >

                <div
                    class="
                        flex
                        h-10
                        w-10
                        items-center
                        justify-center
                        rounded-xl
                        bg-primary-50
                        text-primary-600
                    "
                >

                    <i class="fa-solid fa-filter"></i>

                </div>


                <div>

                    <h2
                        class="
                            font-bold
                            text-slate-900
                        "
                    >
                        Filtrer les rapports
                    </h2>


                    <p
                        class="
                            mt-1
                            text-xs
                            text-slate-400
                        "
                    >
                        Recherchez et filtrez les types disponibles.
                    </p>

                </div>

            </div>


            <div class="p-5 sm:p-6">

                <div
                    class="
                        grid
                        grid-cols-1
                        gap-4
                        md:grid-cols-2
                    "
                >

                    <!-- SEARCH -->

                    <div>

                        <label
                            for="searchInput"
                            class="
                                mb-2
                                block
                                text-xs
                                font-semibold
                                text-slate-500
                            "
                        >
                            Recherche
                        </label>


                        <div class="relative">

                            <i
                                class="
                                    fa-solid
                                    fa-magnifying-glass
                                    absolute
                                    left-3
                                    top-1/2
                                    -translate-y-1/2
                                    text-slate-400
                                "
                            ></i>


                            <input
                                id="searchInput"
                                type="text"
                                placeholder="Rechercher un rapport..."
                                class="
                                    w-full
                                    rounded-xl
                                    border
                                    border-slate-200
                                    bg-slate-50
                                    py-3
                                    pl-10
                                    pr-4
                                    text-sm
                                    outline-none
                                    transition
                                    focus:border-primary-400
                                    focus:bg-white
                                    focus:ring-4
                                    focus:ring-primary-100
                                "
                            >

                        </div>

                    </div>


                    <!-- TYPE -->

                    <div>

                        <label
                            for="typeFilter"
                            class="
                                mb-2
                                block
                                text-xs
                                font-semibold
                                text-slate-500
                            "
                        >
                            Type
                        </label>


                        <select
                            id="typeFilter"
                            class="
                                w-full
                                rounded-xl
                                border
                                border-slate-200
                                bg-slate-50
                                px-4
                                py-3
                                text-sm
                                outline-none
                                transition
                                focus:border-primary-400
                                focus:bg-white
                                focus:ring-4
                                focus:ring-primary-100
                            "
                        >

                            <option value="">
                                Tous les types
                            </option>

                        </select>

                    </div>

                </div>

            </div>

        </section>


        <!-- =====================================================
             REPORT TYPES
        ====================================================== -->

        <section>

            <div
                class="
                    mb-5
                    flex
                    items-end
                    justify-between
                    gap-3
                "
            >

                <div>

                    <h2
                        class="
                            text-lg
                            font-bold
                            text-slate-900
                        "
                    >
                        Types de rapports
                    </h2>


                    <p
                        class="
                            mt-1
                            text-sm
                            text-slate-400
                        "
                    >
                        Les rapports sont générés directement
                        depuis les données de la plateforme.
                    </p>

                </div>


                <span
                    id="filteredCount"
                    class="
                        rounded-full
                        bg-slate-100
                        px-3
                        py-1.5
                        text-xs
                        font-semibold
                        text-slate-500
                    "
                >
                    0 rapport
                </span>

            </div>


            <div
                id="reportsGrid"
                class="
                    grid
                    grid-cols-1
                    gap-5
                    md:grid-cols-2
                    xl:grid-cols-4
                "
            ></div>


            <!-- EMPTY -->

            <div
                id="emptyState"
                class="
                    hidden
                    rounded-2xl
                    border
                    border-dashed
                    border-slate-300
                    bg-white
                    px-6
                    py-16
                    text-center
                "
            >

                <div
                    class="
                        mx-auto
                        flex
                        h-16
                        w-16
                        items-center
                        justify-center
                        rounded-2xl
                        bg-slate-100
                        text-slate-400
                    "
                >

                    <i
                        class="
                            fa-solid
                            fa-file-circle-xmark
                            text-2xl
                        "
                    ></i>

                </div>


                <h3
                    class="
                        mt-4
                        font-semibold
                        text-slate-700
                    "
                >
                    Aucun rapport trouvé
                </h3>


                <p
                    class="
                        mt-1
                        text-sm
                        text-slate-400
                    "
                >
                    Modifiez votre recherche ou votre filtre.
                </p>

            </div>

        </section>


        <!-- FOOTER -->

        <footer class="mt-10 text-center">

            <p
                class="
                    text-xs
                    text-slate-400
                "
            >
                © 2026 Smart School.
                Tous droits réservés.
            </p>

        </footer>

    </main>

</div>


<!-- =========================================================
     GENERATE MODAL
========================================================= -->

<div
    id="generateModal"
    class="
        fixed
        inset-0
        z-[100]
        hidden
        items-center
        justify-center
        bg-slate-900/50
        p-4
        opacity-0
        modal-transition
    "
>

    <div
        id="generateModalContent"
        class="
            w-full
            max-w-xl
            scale-95
            overflow-hidden
            rounded-2xl
            bg-white
            shadow-2xl
            modal-transition
        "
    >

        <div
            class="
                flex
                items-center
                justify-between
                border-b
                border-slate-100
                px-6
                py-5
            "
        >

            <div>

                <h3
                    class="
                        text-lg
                        font-bold
                        text-slate-900
                    "
                >
                    Générer un rapport
                </h3>


                <p
                    class="
                        mt-1
                        text-sm
                        text-slate-400
                    "
                >
                    Sélectionnez les données à exporter.
                </p>

            </div>


            <button
                type="button"
                onclick="closeGenerateModal()"
                class="
                    flex
                    h-9
                    w-9
                    items-center
                    justify-center
                    rounded-lg
                    text-slate-400
                    hover:bg-slate-100
                    hover:text-slate-700
                "
            >

                <i class="fa-solid fa-xmark"></i>

            </button>

        </div>


        <form
            id="reportForm"
            onsubmit="generateReport(event)"
            class="p-6"
        >

            <div>

                <label
                    for="reportType"
                    class="
                        mb-2
                        block
                        text-sm
                        font-semibold
                        text-slate-700
                    "
                >
                    Type de rapport
                </label>


                <select
                    id="reportType"
                    required
                    class="
                        w-full
                        rounded-xl
                        border
                        border-slate-200
                        bg-slate-50
                        px-4
                        py-3
                        text-sm
                        outline-none
                        focus:border-primary-400
                        focus:bg-white
                        focus:ring-4
                        focus:ring-primary-100
                    "
                >

                    <option value="">
                        Sélectionner un rapport
                    </option>

                </select>

            </div>


            <div
                class="
                    mt-5
                    rounded-xl
                    border
                    border-emerald-100
                    bg-emerald-50
                    p-4
                "
            >

                <div class="flex items-start gap-3">

                    <div
                        class="
                            flex
                            h-9
                            w-9
                            shrink-0
                            items-center
                            justify-center
                            rounded-lg
                            bg-white
                            text-emerald-600
                        "
                    >

                        <i class="fa-solid fa-file-csv"></i>

                    </div>


                    <div>

                        <p
                            class="
                                text-sm
                                font-semibold
                                text-emerald-800
                            "
                        >
                            Format CSV
                        </p>


                        <p
                            class="
                                mt-1
                                text-xs
                                leading-5
                                text-emerald-700
                            "
                        >
                            Le rapport sera généré au format CSV
                            et pourra être ouvert avec Excel,
                            LibreOffice ou Google Sheets.
                        </p>

                    </div>

                </div>

            </div>


            <div
                id="generateError"
                class="
                    mt-5
                    hidden
                    rounded-xl
                    border
                    border-red-200
                    bg-red-50
                    px-4
                    py-3
                    text-sm
                    text-red-700
                "
            ></div>


            <div
                class="
                    mt-7
                    flex
                    flex-col-reverse
                    gap-3
                    border-t
                    border-slate-100
                    pt-5
                    sm:flex-row
                    sm:justify-end
                "
            >

                <button
                    type="button"
                    onclick="closeGenerateModal()"
                    class="
                        rounded-xl
                        border
                        border-slate-200
                        px-5
                        py-2.5
                        text-sm
                        font-semibold
                        text-slate-600
                        hover:bg-slate-50
                    "
                >
                    Annuler
                </button>


                <button
                    id="generateButton"
                    type="submit"
                    class="
                        inline-flex
                        items-center
                        justify-center
                        gap-2
                        rounded-xl
                        bg-primary-600
                        px-5
                        py-2.5
                        text-sm
                        font-semibold
                        text-white
                        hover:bg-primary-700
                    "
                >

                    <i
                        id="generateButtonIcon"
                        class="fa-solid fa-file-circle-plus"
                    ></i>


                    <span id="generateButtonText">
                        Générer
                    </span>

                </button>

            </div>

        </form>

    </div>

</div>


<!-- =========================================================
     PREVIEW MODAL
========================================================= -->

<div
    id="previewModal"
    class="
        fixed
        inset-0
        z-[100]
        hidden
        items-center
        justify-center
        bg-slate-900/50
        p-4
        opacity-0
        modal-transition
    "
>

    <div
        id="previewModalContent"
        class="
            flex
            max-h-[90vh]
            w-full
            max-w-5xl
            scale-95
            flex-col
            overflow-hidden
            rounded-2xl
            bg-white
            shadow-2xl
            modal-transition
        "
    >

        <div
            class="
                flex
                items-center
                justify-between
                border-b
                border-slate-100
                px-6
                py-5
            "
        >

            <div>

                <h3
                    id="previewTitle"
                    class="
                        text-lg
                        font-bold
                        text-slate-900
                    "
                >
                    Prévisualisation
                </h3>


                <p
                    id="previewSubtitle"
                    class="
                        mt-1
                        text-sm
                        text-slate-400
                    "
                >
                    Contenu du rapport
                </p>

            </div>


            <button
                type="button"
                onclick="closePreviewModal()"
                class="
                    flex
                    h-9
                    w-9
                    items-center
                    justify-center
                    rounded-lg
                    text-slate-400
                    hover:bg-slate-100
                "
            >

                <i class="fa-solid fa-xmark"></i>

            </button>

        </div>


        <div
            class="
                flex-1
                overflow-auto
                p-6
            "
        >

            <div
                id="previewLoading"
                class="
                    flex
                    items-center
                    justify-center
                    gap-3
                    py-16
                    text-sm
                    text-slate-500
                "
            >

                <span class="loader"></span>

                Chargement de l'aperçu...

            </div>


            <div
                id="previewError"
                class="
                    hidden
                    rounded-xl
                    border
                    border-red-200
                    bg-red-50
                    px-4
                    py-3
                    text-sm
                    text-red-700
                "
            ></div>


            <div
                id="previewContent"
                class="
                    hidden
                    overflow-hidden
                    rounded-xl
                    border
                    border-slate-200
                    bg-slate-50
                "
            >

                <pre
                    id="previewCsv"
                    class="
                        csv-preview
                        max-h-[55vh]
                        overflow-auto
                        p-5
                        text-slate-700
                    "
                ></pre>

            </div>

        </div>


        <div
            class="
                flex
                flex-col-reverse
                gap-3
                border-t
                border-slate-100
                px-6
                py-4
                sm:flex-row
                sm:justify-end
            "
        >

            <button
                type="button"
                onclick="closePreviewModal()"
                class="
                    rounded-xl
                    border
                    border-slate-200
                    px-5
                    py-2.5
                    text-sm
                    font-semibold
                    text-slate-600
                    hover:bg-slate-50
                "
            >
                Fermer
            </button>


            <button
                id="previewDownloadButton"
                type="button"
                class="
                    inline-flex
                    items-center
                    justify-center
                    gap-2
                    rounded-xl
                    bg-primary-600
                    px-5
                    py-2.5
                    text-sm
                    font-semibold
                    text-white
                    hover:bg-primary-700
                "
            >

                <i class="fa-solid fa-download"></i>

                Télécharger CSV

            </button>

        </div>

    </div>

</div>

<script src="/assets/js/super-admin/auth.js"></script>
<script src="/assets/js/super-admin/rapport.js"></script>

</body>

</html>