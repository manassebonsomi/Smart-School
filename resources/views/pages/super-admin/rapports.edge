<!-- ========================================================= -->
<!-- GENERATE REPORT MODAL -->
<!-- ========================================================= -->

<div
    id="generateModal"
    class="fixed inset-0 z-[100] hidden items-center justify-center
           bg-slate-900/50 p-4 opacity-0 modal-transition"
>

    <div
        id="generateModalContent"
        class="w-full max-w-2xl bg-white rounded-2xl shadow-2xl
               scale-95 modal-transition overflow-hidden"
    >

        <!-- Modal header -->

        <div
            class="px-6 py-5 border-b border-slate-100
                   flex items-center justify-between"
        >

            <div>

                <h3 class="text-lg font-bold text-slate-800">
                    Générer un rapport
                </h3>

                <p class="text-sm text-slate-400 mt-1">
                    Configurez les paramètres du rapport.
                </p>

            </div>

            <button
                onclick="closeGenerateModal()"
                class="w-9 h-9 rounded-lg hover:bg-slate-100
                       text-slate-400 hover:text-slate-700"
            >

                <i class="fa-solid fa-xmark"></i>

            </button>

        </div>

        <!-- Form -->

        <form
            id="reportForm"
            onsubmit="generateReport(event)"
            class="p-6"
        >

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                <!-- Report type -->

                <div>

                    <label
                        class="block text-sm font-semibold text-slate-600 mb-2"
                    >
                        Type de rapport
                    </label>

                    <select
                        id="reportType"
                        required
                        class="w-full px-4 py-3 rounded-xl border border-slate-200
                               bg-slate-50 text-sm outline-none
                               focus:ring-2 focus:ring-sky-200
                               focus:border-sky-400"
                    >

                        <option value="">
                            Sélectionner
                        </option>

                        <option value="schools">
                            Rapport des écoles
                        </option>

                        <option value="users">
                            Rapport des utilisateurs
                        </option>

                        <option value="academic">
                            Rapport pédagogique
                        </option>

                        <option value="platform">
                            Rapport plateforme
                        </option>

                    </select>

                </div>

                <!-- Format -->

                <div>

                    <label
                        class="block text-sm font-semibold text-slate-600 mb-2"
                    >
                        Format
                    </label>

                    <select
                        id="reportFormat"
                        required
                        class="w-full px-4 py-3 rounded-xl border border-slate-200
                               bg-slate-50 text-sm outline-none
                               focus:ring-2 focus:ring-sky-200
                               focus:border-sky-400"
                    >

                        <option value="pdf">
                            PDF
                        </option>

                        <option value="excel">
                            Excel
                        </option>

                        <option value="csv">
                            CSV
                        </option>

                    </select>

                </div>

                <!-- Start date -->

                <div>

                    <label
                        class="block text-sm font-semibold text-slate-600 mb-2"
                    >
                        Date de début
                    </label>

                    <input
                        id="startDate"
                        type="date"
                        required
                        class="w-full px-4 py-3 rounded-xl border border-slate-200
                               bg-slate-50 text-sm outline-none
                               focus:ring-2 focus:ring-sky-200
                               focus:border-sky-400"
                    >

                </div>

                <!-- End date -->

                <div>

                    <label
                        class="block text-sm font-semibold text-slate-600 mb-2"
                    >
                        Date de fin
                    </label>

                    <input
                        id="endDate"
                        type="date"
                        required
                        class="w-full px-4 py-3 rounded-xl border border-slate-200
                               bg-slate-50 text-sm outline-none
                               focus:ring-2 focus:ring-sky-200
                               focus:border-sky-400"
                    >

                </div>

            </div>

            <!-- Schedule -->

            <div class="mt-6">

                <label class="flex items-center gap-3 cursor-pointer">

                    <input
                        id="scheduleReport"
                        type="checkbox"
                        class="w-4 h-4 rounded border-slate-300
                               text-sky-500 focus:ring-sky-400"
                    >

                    <span>

                        <span class="block text-sm font-semibold text-slate-700">
                            Planifier ce rapport
                        </span>

                        <span class="block text-xs text-slate-400 mt-0.5">
                            Générer automatiquement ce rapport à une fréquence définie.
                        </span>

                    </span>

                </label>

            </div>

            <!-- Schedule options -->

            <div
                id="scheduleOptions"
                class="hidden mt-4 p-4 rounded-xl bg-slate-50
                       border border-slate-200"
            >

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

                    <div>

                        <label
                            class="block text-xs font-semibold text-slate-500 mb-2"
                        >
                            Fréquence
                        </label>

                        <select
                            class="w-full px-3 py-2.5 rounded-lg
                                   border border-slate-200 bg-white
                                   text-sm"
                        >

                            <option>
                                Chaque jour
                            </option>

                            <option selected>
                                Chaque semaine
                            </option>

                            <option>
                                Chaque mois
                            </option>

                        </select>

                    </div>

                    <div>

                        <label
                            class="block text-xs font-semibold text-slate-500 mb-2"
                        >
                            Heure
                        </label>

                        <input
                            type="time"
                            value="08:00"
                            class="w-full px-3 py-2.5 rounded-lg
                                   border border-slate-200 bg-white
                                   text-sm"
                        >

                    </div>

                </div>

            </div>

            <!-- Actions -->

            <div
                class="mt-7 pt-5 border-t border-slate-100
                       flex flex-col-reverse sm:flex-row
                       sm:justify-end gap-3"
            >

                <button
                    type="button"
                    onclick="closeGenerateModal()"
                    class="px-5 py-2.5 rounded-xl border border-slate-200
                           text-sm font-semibold text-slate-600
                           hover:bg-slate-50 transition"
                >
                    Annuler
                </button>

                <button
                    type="submit"
                    class="px-5 py-2.5 rounded-xl bg-sky-500
                           hover:bg-sky-600 text-white text-sm
                           font-semibold transition"
                >

                    <i class="fa-solid fa-file-circle-plus mr-2"></i>

                    Générer le rapport

                </button>

            </div>

        </form>

    </div>

</div>

<!-- ========================================================= -->
<!-- REPORT VIEW MODAL -->
<!-- ========================================================= -->

<div
    id="viewModal"
    class="fixed inset-0 z-[100] hidden items-center justify-center
           bg-slate-900/50 p-4 opacity-0 modal-transition"
>

    <div
        id="viewModalContent"
        class="w-full max-w-4xl max-h-[90vh] bg-white rounded-2xl
               shadow-2xl scale-95 modal-transition overflow-hidden"
    >

        <!-- Header -->

        <div
            class="px-6 py-5 border-b border-slate-100
                   flex items-center justify-between"
        >

            <div>

                <h3
                    id="viewReportTitle"
                    class="text-lg font-bold text-slate-800"
                >
                    Rapport
                </h3>

                <p class="text-sm text-slate-400 mt-1">
                    Aperçu du rapport
                </p>

            </div>

            <button
                onclick="closeViewModal()"
                class="w-9 h-9 rounded-lg hover:bg-slate-100
                       text-slate-400"
            >
                <i class="fa-solid fa-xmark"></i>
            </button>

        </div>

        <!-- Preview -->

        <div class="p-6 overflow-y-auto max-h-[65vh]">

            <div
                class="rounded-xl border border-slate-200
                       bg-slate-50 p-6"
            >

                <div class="flex items-center justify-between mb-8">

                    <div>

                        <div
                            class="w-12 h-12 rounded-xl bg-sky-500
                                   text-white flex items-center justify-center
                                   mb-3"
                        >

                            <i class="fa-solid fa-file-lines text-xl"></i>

                        </div>

                        <h4
                            id="previewTitle"
                            class="text-xl font-bold text-slate-800"
                        >
                            Rapport
                        </h4>

                        <p class="text-sm text-slate-400 mt-1">
                            Smart School • Super Administration
                        </p>

                    </div>

                    <span
                        class="px-3 py-1.5 rounded-full bg-emerald-50
                               text-emerald-600 text-xs font-semibold"
                    >
                        Disponible
                    </span>

                </div>

                <!-- Fake report content -->

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">

                    <div class="bg-white rounded-xl p-4 border border-slate-200">

                        <p class="text-xs text-slate-400">
                            Écoles
                        </p>

                        <p class="mt-2 text-2xl font-bold text-slate-800">
                            128
                        </p>

                    </div>

                    <div class="bg-white rounded-xl p-4 border border-slate-200">

                        <p class="text-xs text-slate-400">
                            Utilisateurs
                        </p>

                        <p class="mt-2 text-2xl font-bold text-slate-800">
                            29,901
                        </p>

                    </div>

                    <div class="bg-white rounded-xl p-4 border border-slate-200">

                        <p class="text-xs text-slate-400">
                            Activité
                        </p>

                        <p class="mt-2 text-2xl font-bold text-slate-800">
                            82%
                        </p>

                    </div>

                </div>

                <div class="bg-white rounded-xl border border-slate-200 overflow-hidden">

                    <div class="px-5 py-4 border-b border-slate-100">

                        <p class="font-semibold text-slate-700">
                            Résumé du rapport
                        </p>

                    </div>

                    <div class="p-5 space-y-3">

                        <div class="h-3 bg-slate-100 rounded-full w-full"></div>

                        <div class="h-3 bg-slate-100 rounded-full w-11/12"></div>

                        <div class="h-3 bg-slate-100 rounded-full w-10/12"></div>

                        <div class="h-3 bg-slate-100 rounded-full w-8/12"></div>

                    </div>

                </div>

            </div>

        </div>

        <!-- Footer -->

        <div
            class="px-6 py-4 border-t border-slate-100
                   flex justify-end gap-3"
        >

            <button
                onclick="closeViewModal()"
                class="px-5 py-2.5 rounded-xl border border-slate-200
                       text-sm font-semibold text-slate-600
                       hover:bg-slate-50"
            >
                Fermer
            </button>

            <button
                onclick="downloadCurrentReport()"
                class="px-5 py-2.5 rounded-xl bg-sky-500
                       hover:bg-sky-600 text-white text-sm
                       font-semibold"
            >

                <i class="fa-solid fa-download mr-2"></i>

                Télécharger

            </button>

        </div>

    </div>

</div>

<!-- ========================================================= -->
<!-- JAVASCRIPT -->
<!-- ========================================================= -->

<script>

    /* =========================================================
       SIDEBAR
    ========================================================= */

    const sidebar = document.getElementById("sidebar");
    const sidebarOverlay = document.getElementById("sidebarOverlay");

    document
        .getElementById("openSidebar")
        ?.addEventListener("click", () => {

            sidebar.classList.remove("-translate-x-full");

            sidebarOverlay.classList.remove("hidden");

            setTimeout(() => {
                sidebarOverlay.classList.remove("opacity-0");
            }, 10);

        });

    function hideSidebar() {

        sidebar.classList.add("-translate-x-full");

        sidebarOverlay.classList.add("opacity-0");

        setTimeout(() => {

            sidebarOverlay.classList.add("hidden");

        }, 300);

    }

    document
        .getElementById("closeSidebar")
        ?.addEventListener("click", hideSidebar);

    sidebarOverlay?.addEventListener("click", hideSidebar);

    /* =========================================================
       GENERATE MODAL
    ========================================================= */

    const generateModal =
        document.getElementById("generateModal");

    const generateModalContent =
        document.getElementById("generateModalContent");

    function openGenerateModal() {

        generateModal.classList.remove("hidden");

        generateModal.classList.add("flex");

        setTimeout(() => {

            generateModal.classList.remove("opacity-0");

            generateModalContent.classList.remove("scale-95");

            generateModalContent.classList.add("scale-100");

        }, 10);

    }

    function closeGenerateModal() {

        generateModal.classList.add("opacity-0");

        generateModalContent.classList.remove("scale-100");

        generateModalContent.classList.add("scale-95");

        setTimeout(() => {

            generateModal.classList.remove("flex");

            generateModal.classList.add("hidden");

        }, 200);

    }

    /* =========================================================
       SCHEDULE
    ========================================================= */

    const scheduleCheckbox =
        document.getElementById("scheduleReport");

    const scheduleOptions =
        document.getElementById("scheduleOptions");

    scheduleCheckbox.addEventListener(
        "change",
        function () {

            if (this.checked) {

                scheduleOptions.classList.remove("hidden");

            } else {

                scheduleOptions.classList.add("hidden");

            }

        }
    );

    /* =========================================================
       QUICK REPORT SELECTION
    ========================================================= */

    function selectReport(type) {

        openGenerateModal();

        document.getElementById("reportType").value = type;

    }

    /* =========================================================
       GENERATE REPORT
    ========================================================= */

    function generateReport(event) {

        event.preventDefault();

        const type =
            document.getElementById("reportType").value;

        const format =
            document.getElementById("reportFormat").value;

        console.log({
            type,
            format,
            startDate: document.getElementById("startDate").value,
            endDate: document.getElementById("endDate").value,
            scheduled: scheduleCheckbox.checked
        });

        /*
         * Plus tard :
         *
         * POST /super-admin/rapports
         *
         * Le backend AdonisJS recevra les paramètres
         * et lancera la génération réelle du rapport.
         */

        closeGenerateModal();

        setTimeout(() => {

            alert(
                "La génération du rapport sera connectée au backend AdonisJS."
            );

        }, 250);

    }

    /* =========================================================
       VIEW REPORT
    ========================================================= */

    let currentReport = "";

    const viewModal =
        document.getElementById("viewModal");

    const viewModalContent =
        document.getElementById("viewModalContent");

    function viewReport(name) {

        currentReport = name;

        document.getElementById("viewReportTitle").textContent = name;

        document.getElementById("previewTitle").textContent = name;

        viewModal.classList.remove("hidden");

        viewModal.classList.add("flex");

        setTimeout(() => {

            viewModal.classList.remove("opacity-0");

            viewModalContent.classList.remove("scale-95");

            viewModalContent.classList.add("scale-100");

        }, 10);

    }

    function closeViewModal() {

        viewModal.classList.add("opacity-0");

        viewModalContent.classList.remove("scale-100");

        viewModalContent.classList.add("scale-95");

        setTimeout(() => {

            viewModal.classList.remove("flex");

            viewModal.classList.add("hidden");

        }, 200);

    }

    /* =========================================================
       DOWNLOAD
    ========================================================= */

    function downloadReport(name) {

        /*
         * Plus tard :
         *
         * GET /super-admin/rapports/:id/download
         */

        alert(
            "Téléchargement de : " + name
        );

    }

    function downloadCurrentReport() {

        downloadReport(currentReport);

    }

    /* =========================================================
       DELETE
    ========================================================= */

    function deleteReport(name) {

        const confirmed =
            confirm(
                "Voulez-vous vraiment supprimer le rapport :\n\n" +
                name +
                " ?"
            );

        if (!confirmed) {
            return;
        }

        alert(
            "Le rapport sera supprimé via le backend AdonisJS."
        );

    }

    /* =========================================================
       SCHEDULED REPORT
    ========================================================= */

    function editScheduledReport() {

        alert(
            "Modification du rapport planifié."
        );

    }

    function cancelScheduledReport() {

        const confirmed =
            confirm(
                "Voulez-vous annuler ce rapport planifié ?"
            );

        if (confirmed) {

            alert(
                "Le rapport planifié sera annulé via AdonisJS."
            );

        }

    }

    /* =========================================================
       SEARCH + FILTER
    ========================================================= */

    const searchInput =
        document.getElementById("searchInput");

    const typeFilter =
        document.getElementById("typeFilter");

    const statusFilter =
        document.getElementById("statusFilter");

    const reportRows =
        document.querySelectorAll(".report-row");

    const emptyState =
        document.getElementById("emptyState");

    const reportCount =
        document.getElementById("reportCount");

    function filterReports() {

        const search =
            searchInput.value.toLowerCase().trim();

        const type =
            typeFilter.value;

        const status =
            statusFilter.value;

        let visible = 0;

        reportRows.forEach(row => {

            const name =
                row.dataset.name.toLowerCase();

            const rowType =
                row.dataset.type;

            const rowStatus =
                row.dataset.status;

            const matchesSearch =
                name.includes(search);

            const matchesType =
                !type || rowType === type;

            const matchesStatus =
                !status || rowStatus === status;

            const show =
                matchesSearch &&
                matchesType &&
                matchesStatus;

            if (show) {

                row.classList.remove("hidden");

                visible++;

            } else {

                row.classList.add("hidden");

            }

        });

        reportCount.textContent =
            visible + (visible > 1 ? " rapports" : " rapport");

        if (visible === 0) {

            emptyState.classList.remove("hidden");

        } else {

            emptyState.classList.add("hidden");

        }

    }

    searchInput.addEventListener(
        "input",
        filterReports
    );

    typeFilter.addEventListener(
        "change",
        filterReports
    );

    statusFilter.addEventListener(
        "change",
        filterReports
    );

    /* =========================================================
       ESCAPE KEY
    ========================================================= */

    document.addEventListener(
        "keydown",
        event => {

            if (event.key === "Escape") {

                closeGenerateModal();

                closeViewModal();

                hideSidebar();

            }

        }
    );

    /* =========================================================
       CLICK OUTSIDE MODAL
    ========================================================= */

    generateModal.addEventListener(
        "click",
        event => {

            if (event.target === generateModal) {

                closeGenerateModal();

            }

        }
    );

    viewModal.addEventListener(
        "click",
        event => {

            if (event.target === viewModal) {

                closeViewModal();

            }

        }
    );

</script>

<script src="/assets/js/smart-school-api.js"></script>
</body>
</html>
```
