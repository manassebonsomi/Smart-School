<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Nouvelle école | Smart School</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#38BDF8',
                        primaryDark: '#0284C7',
                        primaryLight: '#E0F2FE'
                    }
                }
            }
        }
    </script>

    <style>
        body {
            font-family: Inter, ui-sans-serif, system-ui, sans-serif;
        }

        .sidebar-transition {
            transition: transform .3s ease-in-out;
        }

        .form-input {
            width: 100%;
            padding: .75rem 1rem;
            border-radius: .75rem;
            border: 1px solid #e2e8f0;
            background: #fff;
            font-size: .875rem;
            outline: none;
            transition: .2s;
        }

        .form-input:focus {
            border-color: #38bdf8;
            box-shadow: 0 0 0 3px rgba(56,189,248,.15);
        }

        .form-label {
            display: block;
            margin-bottom: .5rem;
            font-size: .75rem;
            font-weight: 600;
            color: #475569;
        }
    </style>
</head>

<body class="bg-slate-50 text-slate-800">

<div id="overlay"
     class="fixed inset-0 z-40 hidden bg-slate-900/50 lg:hidden"></div>

<!-- SIDEBAR -->
<aside id="sidebar"
       class="fixed inset-y-0 left-0 z-50 w-72 bg-white border-r border-slate-200
              -translate-x-full sidebar-transition lg:translate-x-0">

    <div class="h-20 px-6 flex items-center border-b border-slate-100">
        <div class="flex items-center gap-3">

            <div class="w-11 h-11 rounded-xl bg-sky-500 text-white flex items-center justify-center">
                <i class="fa-solid fa-graduation-cap text-xl"></i>
            </div>

            <div>
                <h1 class="font-bold text-lg">Smart School</h1>
                <p class="text-xs text-slate-400">Administration</p>
            </div>

        </div>
    </div>

       <nav class="px-4 py-6 space-y-2">

        <p
            class="px-3 mb-3 text-xs font-semibold uppercase
                   tracking-wider text-slate-400"
        >
            Administration
        </p>

        <a
            href="/super-admin/dashboard"
            class="flex items-center gap-3 px-4 py-3 rounded-xl
                   text-slate-600 hover:bg-sky-50 hover:text-sky-600 transition"
        >
            <i class="fa-solid fa-chart-pie w-5"></i>
            <span>Dashboard</span>
        </a>

        <!-- ACTIVE -->

        <a
            href="/super-admin/ecoles"
            class="flex items-center gap-3 px-4 py-3 rounded-xl
                   bg-sky-50 text-sky-600 font-semibold"
        >
            <i class="fa-solid fa-school w-5"></i>
            <span>Écoles</span>
        </a>

        <a
            href="/super-admin/utilisateurs"
            class="flex items-center gap-3 px-4 py-3 rounded-xl
                   text-slate-600 hover:bg-sky-50 hover:text-sky-600 transition"
        >
            <i class="fa-solid fa-users w-5"></i>
            <span>Utilisateurs</span>
        </a>

        <a
            href="/super-admin/statistiques"
            class="flex items-center gap-3 px-4 py-3 rounded-xl
                   text-slate-600 hover:bg-sky-50 hover:text-sky-600 transition"
        >
            <i class="fa-solid fa-chart-line w-5"></i>
            <span>Statistiques</span>
        </a>

        <a
            href="/super-admin/rapports"
            class="flex items-center gap-3 px-4 py-3 rounded-xl
                   text-slate-600 hover:bg-sky-50 hover:text-sky-600 transition"
        >
            <i class="fa-solid fa-file-lines w-5"></i>
            <span>Rapports</span>
        </a>

    </nav>

    <!-- Bottom -->

    <div
        class="absolute bottom-0 left-0 right-0 p-4
               border-t border-slate-100"
    >

        <button
            class="w-full flex items-center gap-3 px-4 py-3
                   rounded-xl text-slate-500 hover:bg-slate-50 transition"
        >
            <i class="fa-solid fa-gear w-5"></i>
            <span>Paramètres</span>
        </button>

        <button
            onclick="logout()"
            class="w-full flex items-center gap-3 px-4 py-3
                   rounded-xl text-red-500 hover:bg-red-50 transition"
        >
            <i class="fa-solid fa-right-from-bracket w-5"></i>
            <span>Déconnexion</span>
        </button>

    </div>

    <div class="absolute bottom-0 left-0 right-0 p-4 border-t border-slate-100">

        <button class="w-full flex items-center gap-3 px-4 py-3 rounded-xl text-slate-500 hover:bg-slate-50">
            <i class="fa-solid fa-gear w-5"></i>
            Paramètres
        </button>

        <button onclick="logout()"
                class="w-full flex items-center gap-3 px-4 py-3 rounded-xl text-red-500 hover:bg-red-50">
            <i class="fa-solid fa-right-from-bracket w-5"></i>
            Déconnexion
        </button>

    </div>
</aside>

<!-- MAIN -->
<div class="lg:ml-72 min-h-screen">

    <!-- HEADER -->
    <header class="h-20 sticky top-0 z-30 bg-white border-b border-slate-200">

        <div class="h-full px-4 sm:px-6 lg:px-8 flex items-center justify-between">

            <div class="flex items-center gap-4">

                <button id="openSidebar"
                        class="lg:hidden w-10 h-10 rounded-xl hover:bg-slate-100">
                    <i class="fa-solid fa-bars"></i>
                </button>

                <div>
                    <div class="flex items-center gap-2">

                        <a href="/super-admin/ecoles"
                           class="text-slate-400 hover:text-sky-500">
                            Écoles
                        </a>

                        <i class="fa-solid fa-chevron-right text-[10px] text-slate-300"></i>

                        <span class="font-semibold text-slate-700">
                            Nouvelle école
                        </span>

                    </div>
                </div>

            </div>

            <div class="flex items-center gap-3">

                <button class="relative w-10 h-10 rounded-xl hover:bg-slate-100">
                    <i class="fa-regular fa-bell text-slate-500"></i>
                    <span class="absolute top-2 right-2 w-2 h-2 rounded-full bg-red-500"></span>
                </button>

                <div class="hidden sm:flex items-center gap-3 pl-3 border-l border-slate-200">

                    <div class="w-10 h-10 rounded-full bg-sky-100 text-sky-600 flex items-center justify-center font-bold">
                        SA
                    </div>

                    <div>
                        <p class="text-sm font-semibold">Super Admin</p>
                        <p class="text-xs text-slate-400">Administrateur système</p>
                    </div>

                </div>

            </div>
        </div>
    </header>

    <main class="p-4 sm:p-6 lg:p-8">

        <div class="max-w-5xl mx-auto">

            <!-- INTRO -->
            <div class="mb-8">

                <h1 class="text-2xl sm:text-3xl font-bold">
                    Créer une nouvelle école
                </h1>

                <p class="mt-2 text-sm text-slate-500">
                    Enregistrez l'établissement et son administrateur principal.
                </p>

            </div>

            <form id="schoolForm"
                  onsubmit="submitSchool(event)"
                  class="space-y-6">

                <!-- GENERAL -->
                <section class="bg-white rounded-2xl border border-slate-200 shadow-sm">

                    <div class="p-6 border-b border-slate-100 flex items-center gap-3">

                        <div class="w-11 h-11 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center">
                            <i class="fa-solid fa-school"></i>
                        </div>

                        <div>
                            <h2 class="font-bold">Informations générales</h2>
                            <p class="text-xs text-slate-400 mt-1">
                                Informations principales de l'établissement.
                            </p>
                        </div>

                    </div>

                    <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-5">

                        <div class="md:col-span-2">
                            <label class="form-label">Nom de l'école *</label>
                            <input
                                id="schoolName"
                                name="name"
                                type="text"
                                required
                                placeholder="Ex. Complexe Scolaire La Réussite"
                                class="form-input"
                            >
                        </div>

                        <div>
                            <label class="form-label">Type d'établissement *</label>

                            <select name="type" required class="form-input">
                                <option value="">Sélectionner</option>
                                <option>École primaire</option>
                                <option>École secondaire</option>
                                <option>Primaire et secondaire</option>
                                <option>Institut technique</option>
                            </select>
                        </div>

                        <div>
                            <label class="form-label">Année de création</label>

                            <input
                                type="number"
                                min="1800"
                                max="2026"
                                placeholder="2020"
                                class="form-input"
                            >
                        </div>

                        <div>
                            <label class="form-label">Téléphone</label>

                            <input
                                type="tel"
                                placeholder="+243 ..."
                                class="form-input"
                            >
                        </div>

                        <div>
                            <label class="form-label">Email</label>

                            <input
                                type="email"
                                placeholder="contact@ecole.cd"
                                class="form-input"
                            >
                        </div>

                        <div class="md:col-span-2">
                            <label class="form-label">Site web</label>

                            <input
                                type="url"
                                placeholder="https://www.ecole.cd"
                                class="form-input"
                            >
                        </div>

                        <div class="md:col-span-2">
                            <label class="form-label">Description</label>

                            <textarea
                                rows="4"
                                placeholder="Présentation de l'établissement..."
                                class="form-input resize-none"
                            ></textarea>
                        </div>

                    </div>
                </section>

                <!-- LOCATION -->
                <section class="bg-white rounded-2xl border border-slate-200 shadow-sm">

                    <div class="p-6 border-b border-slate-100 flex items-center gap-3">

                        <div class="w-11 h-11 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center">
                            <i class="fa-solid fa-location-dot"></i>
                        </div>

                        <div>
                            <h2 class="font-bold">Localisation</h2>
                            <p class="text-xs text-slate-400 mt-1">
                                Adresse de l'établissement.
                            </p>
                        </div>

                    </div>

                    <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-5">

                        <div>
                            <label class="form-label">Province *</label>

                            <select required class="form-input">
                                <option value="">Sélectionner</option>
                                <option>Kinshasa</option>
                                <option>Kongo-Central</option>
                                <option>Haut-Katanga</option>
                                <option>Lualaba</option>
                                <option>Nord-Kivu</option>
                                <option>Sud-Kivu</option>
                            </select>
                        </div>

                        <div>
                            <label class="form-label">Ville *</label>

                            <input
                                type="text"
                                required
                                placeholder="Kinshasa"
                                class="form-input"
                            >
                        </div>

                        <div>
                            <label class="form-label">Commune / Territoire</label>

                            <input
                                type="text"
                                placeholder="Limete"
                                class="form-input"
                            >
                        </div>

                        <div>
                            <label class="form-label">Quartier</label>

                            <input
                                type="text"
                                placeholder="Kingabwa"
                                class="form-input"
                            >
                        </div>

                        <div class="md:col-span-2">
                            <label class="form-label">Adresse complète</label>

                            <textarea
                                rows="3"
                                placeholder="Adresse précise..."
                                class="form-input resize-none"
                            ></textarea>
                        </div>

                    </div>
                </section>

                <!-- ADMIN -->
                <section class="bg-white rounded-2xl border border-slate-200 shadow-sm">

                    <div class="p-6 border-b border-slate-100 flex items-center gap-3">

                        <div class="w-11 h-11 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                            <i class="fa-solid fa-user-shield"></i>
                        </div>

                        <div>
                            <h2 class="font-bold">
                                Administrateur principal
                            </h2>

                            <p class="text-xs text-slate-400 mt-1">
                                Ce compte administrera l'école.
                            </p>
                        </div>

                    </div>

                    <div class="p-6">

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                            <div>
                                <label class="form-label">Prénom *</label>

                                <input
                                    type="text"
                                    required
                                    placeholder="Jean"
                                    class="form-input"
                                >
                            </div>

                            <div>
                                <label class="form-label">Nom *</label>

                                <input
                                    type="text"
                                    required
                                    placeholder="Mukendi"
                                    class="form-input"
                                >
                            </div>

                            <div>
                                <label class="form-label">Email *</label>

                                <input
                                    type="email"
                                    required
                                    placeholder="admin@ecole.cd"
                                    class="form-input"
                                >
                            </div>

                            <div>
                                <label class="form-label">Téléphone</label>

                                <input
                                    type="tel"
                                    placeholder="+243 ..."
                                    class="form-input"
                                >
                            </div>

                            <div>
                                <label class="form-label">Mot de passe temporaire *</label>

                                <input
                                    id="adminPassword"
                                    type="password"
                                    required
                                    minlength="8"
                                    placeholder="Minimum 8 caractères"
                                    class="form-input"
                                >
                            </div>

                            <div>
                                <label class="form-label">Confirmation *</label>

                                <input
                                    id="adminPasswordConfirm"
                                    type="password"
                                    required
                                    minlength="8"
                                    placeholder="Confirmer le mot de passe"
                                    class="form-input"
                                >
                            </div>

                        </div>

                        <div class="mt-5 rounded-xl bg-sky-50 border border-sky-100 p-4">

                            <div class="flex gap-3">

                                <i class="fa-solid fa-circle-info text-sky-500 mt-0.5"></i>

                                <p class="text-xs leading-5 text-sky-700">
                                    Un compte administrateur sera associé à cette école.
                                    Les informations d'accès devront être transmises de manière sécurisée.
                                </p>

                            </div>

                        </div>

                    </div>
                </section>

                <!-- STATUS -->
                <section class="bg-white rounded-2xl border border-slate-200 shadow-sm">

                    <div class="p-6">

                        <label class="flex items-start gap-3 cursor-pointer">

                            <input
                                type="checkbox"
                                checked
                                class="mt-1 w-4 h-4 rounded border-slate-300 text-sky-500"
                            >

                            <span>

                                <span class="block text-sm font-semibold text-slate-700">
                                    Activer l'école immédiatement
                                </span>

                                <span class="block text-xs text-slate-400 mt-1">
                                    Si cette option est cochée, l'établissement pourra utiliser la plateforme dès sa création.
                                </span>

                            </span>

                        </label>

                    </div>

                </section>

                <!-- ACTIONS -->
                <div class="flex flex-col-reverse sm:flex-row justify-end gap-3">

                    <a
                        href="/super-admin/ecoles"
                        class="px-5 py-3 rounded-xl border border-slate-200
                               text-sm font-semibold text-slate-600
                               text-center hover:bg-slate-50"
                    >
                        Annuler
                    </a>

                    <button
                        type="submit"
                        class="px-6 py-3 rounded-xl bg-sky-500
                               hover:bg-sky-600 text-white text-sm
                               font-semibold"
                    >
                        <i class="fa-solid fa-school mr-2"></i>
                        Créer l'école
                    </button>

                </div>

            </form>

        </div>

    </main>
</div>

<script>
    const sidebar = document.getElementById("sidebar");
    const overlay = document.getElementById("overlay");

    document.getElementById("openSidebar")?.addEventListener("click", () => {
        sidebar.classList.remove("-translate-x-full");
        overlay.classList.remove("hidden");
    });

    overlay?.addEventListener("click", () => {
        sidebar.classList.add("-translate-x-full");
        overlay.classList.add("hidden");
    });

    function submitSchool(event) {
        event.preventDefault();

        const password =
            document.getElementById("adminPassword").value;

        const confirmation =
            document.getElementById("adminPasswordConfirm").value;

        if (password !== confirmation) {
            alert("Les deux mots de passe ne correspondent pas.");
            return;
        }

        /*
         * Plus tard :
         *
         * POST /api/super-admin/schools
         *
         * avec les informations de l'école
         * et de son administrateur.
         */

        alert("École créée avec succès — connexion à AdonisJS à venir.");

        window.location.href = "/super-admin/ecoles";
    }

    function logout() {
        if (confirm("Voulez-vous vraiment vous déconnecter ?")) {
            window.location.href = "/";
        }
    }
</script>

<script src="/assets/js/smart-school-api.js"></script>
</body>
</html>
