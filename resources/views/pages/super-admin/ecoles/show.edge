<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Détails de l'école | Smart School</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#38BDF8',
                        primaryDark: '#0284C7',
                        primaryLight: '#E0F2FE'
                    }
                }
            }
        }
    </script>

    <style>
        body {
            font-family: Inter, ui-sans-serif, system-ui, sans-serif;
        }

        .sidebar-transition {
            transition: transform .3s ease-in-out;
        }
    </style>
</head>

<body class="bg-slate-50 text-slate-800">

<div id="overlay"
     class="fixed inset-0 z-40 hidden bg-slate-900/50 lg:hidden"></div>

<!-- SIDEBAR -->

<aside id="sidebar"
       class="fixed inset-y-0 left-0 z-50 w-72 bg-white border-r border-slate-200
              -translate-x-full sidebar-transition lg:translate-x-0">

    <div class="h-20 px-6 flex items-center border-b border-slate-100">

        <div class="flex items-center gap-3">

            <div class="w-11 h-11 rounded-xl bg-sky-500 text-white flex items-center justify-center">
                <i class="fa-solid fa-graduation-cap text-xl"></i>
            </div>

            <div>
                <h1 class="font-bold text-lg">Smart School</h1>
                <p class="text-xs text-slate-400">Administration</p>
            </div>

        </div>
    </div>

       <nav class="px-4 py-6 space-y-2">

        <p
            class="px-3 mb-3 text-xs font-semibold uppercase
                   tracking-wider text-slate-400"
        >
            Administration
        </p>

        <a
            href="/super-admin/dashboard"
            class="flex items-center gap-3 px-4 py-3 rounded-xl
                   text-slate-600 hover:bg-sky-50 hover:text-sky-600 transition"
        >
            <i class="fa-solid fa-chart-pie w-5"></i>
            <span>Dashboard</span>
        </a>

        <!-- ACTIVE -->

        <a
            href="/super-admin/ecoles"
            class="flex items-center gap-3 px-4 py-3 rounded-xl
                   bg-sky-50 text-sky-600 font-semibold"
        >
            <i class="fa-solid fa-school w-5"></i>
            <span>Écoles</span>
        </a>

        <a
            href="/super-admin/utilisateurs"
            class="flex items-center gap-3 px-4 py-3 rounded-xl
                   text-slate-600 hover:bg-sky-50 hover:text-sky-600 transition"
        >
            <i class="fa-solid fa-users w-5"></i>
            <span>Utilisateurs</span>
        </a>

        <a
            href="/super-admin/statistiques"
            class="flex items-center gap-3 px-4 py-3 rounded-xl
                   text-slate-600 hover:bg-sky-50 hover:text-sky-600 transition"
        >
            <i class="fa-solid fa-chart-line w-5"></i>
            <span>Statistiques</span>
        </a>

        <a
            href="/super-admin/rapports"
            class="flex items-center gap-3 px-4 py-3 rounded-xl
                   text-slate-600 hover:bg-sky-50 hover:text-sky-600 transition"
        >
            <i class="fa-solid fa-file-lines w-5"></i>
            <span>Rapports</span>
        </a>

    </nav>

    <!-- Bottom -->

    <div
        class="absolute bottom-0 left-0 right-0 p-4
               border-t border-slate-100"
    >

        <button
            class="w-full flex items-center gap-3 px-4 py-3
                   rounded-xl text-slate-500 hover:bg-slate-50 transition"
        >
            <i class="fa-solid fa-gear w-5"></i>
            <span>Paramètres</span>
        </button>

        <button
            onclick="logout()"
            class="w-full flex items-center gap-3 px-4 py-3
                   rounded-xl text-red-500 hover:bg-red-50 transition"
        >
            <i class="fa-solid fa-right-from-bracket w-5"></i>
            <span>Déconnexion</span>
        </button>

    </div>

</aside>

<!-- MAIN -->

<div class="lg:ml-72 min-h-screen">

    <!-- HEADER -->

    <header class="h-20 sticky top-0 z-30 bg-white border-b border-slate-200">

        <div class="h-full px-4 sm:px-6 lg:px-8 flex items-center justify-between">

            <div class="flex items-center gap-4">

                <button
                    id="openSidebar"
                    class="lg:hidden w-10 h-10 rounded-xl hover:bg-slate-100"
                >
                    <i class="fa-solid fa-bars"></i>
                </button>

                <div>

                    <div class="flex items-center gap-2 text-sm">

                        <a href="/super-admin/ecoles"
                           class="text-slate-400 hover:text-sky-500">
                            Écoles
                        </a>

                        <i class="fa-solid fa-chevron-right text-[9px] text-slate-300"></i>

                        <span class="font-semibold text-slate-700">
                            Détails
                        </span>

                    </div>

                </div>

            </div>

            <div class="flex items-center gap-3">

                <button class="relative w-10 h-10 rounded-xl hover:bg-slate-100">
                    <i class="fa-regular fa-bell text-slate-500"></i>
                    <span class="absolute top-2 right-2 w-2 h-2 rounded-full bg-red-500"></span>
                </button>

                <div
                    class="hidden sm:flex w-10 h-10 rounded-full bg-sky-100
                           text-sky-600 items-center justify-center font-bold"
                >
                    SA
                </div>

            </div>

        </div>

    </header>

    <main class="p-4 sm:p-6 lg:p-8">

        <div class="max-w-6xl mx-auto">

            <!-- HERO -->

            <section class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm">

                <div class="h-32 bg-gradient-to-r from-sky-600 via-sky-500 to-cyan-400"></div>

                <div class="px-5 sm:px-8 pb-7">

                    <div class="-mt-12 flex flex-col md:flex-row md:items-end md:justify-between gap-5">

                        <div class="flex items-end gap-4">

                            <div
                                class="w-24 h-24 rounded-2xl bg-white
                                       border-4 border-white shadow-lg
                                       flex items-center justify-center
                                       text-sky-600 text-3xl"
                            >
                                <i class="fa-solid fa-school"></i>
                            </div>

                            <div class="pb-1">

                                <div class="flex flex-wrap items-center gap-3">

                                    <h1 class="text-2xl font-bold">
                                        Complexe Scolaire La Réussite
                                    </h1>

                                    <span
                                        class="inline-flex items-center gap-1.5
                                               px-3 py-1 rounded-full
                                               bg-emerald-50 text-emerald-600
                                               text-xs font-semibold"
                                    >
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                        Active
                                    </span>

                                </div>

                                <p class="text-sm text-slate-400 mt-2">
                                    SCH-0001 • Kinshasa, Limete
                                </p>

                            </div>

                        </div>

                        <div class="flex gap-2">

                            <a
                                href="/super-admin/ecoles/1/edit"
                                class="px-4 py-2.5 rounded-xl bg-sky-500
                                       hover:bg-sky-600 text-white
                                       text-sm font-semibold"
                            >
                                <i class="fa-solid fa-pen mr-2"></i>
                                Modifier
                            </a>

                            <button
                                onclick="suspendSchool()"
                                class="px-4 py-2.5 rounded-xl
                                       border border-amber-200
                                       text-amber-600 hover:bg-amber-50
                                       text-sm font-semibold"
                            >
                                <i class="fa-solid fa-ban mr-2"></i>
                                Suspendre
                            </button>

                        </div>

                    </div>

                </div>

            </section>

            <!-- STATS -->

            <section class="grid grid-cols-2 lg:grid-cols-4 gap-4 mt-6">

                <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
                    <p class="text-xs text-slate-400">Élèves</p>
                    <p class="text-2xl font-bold mt-2">1,248</p>
                    <p class="text-xs text-emerald-500 mt-2">+8.4%</p>
                </div>

                <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
                    <p class="text-xs text-slate-400">Enseignants</p>
                    <p class="text-2xl font-bold mt-2">84</p>
                    <p class="text-xs text-slate-400 mt-2">Actifs</p>
                </div>

                <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
                    <p class="text-xs text-slate-400">Classes</p>
                    <p class="text-2xl font-bold mt-2">36</p>
                    <p class="text-xs text-slate-400 mt-2">Cette année</p>
                </div>

                <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
                    <p class="text-xs text-slate-400">Présence</p>
                    <p class="text-2xl font-bold mt-2">94.2%</p>
                    <p class="text-xs text-emerald-500 mt-2">Très bon niveau</p>
                </div>

            </section>

            <div class="grid grid-cols-1 xl:grid-cols-3 gap-6 mt-6">

                <!-- INFORMATION -->

                <section class="xl:col-span-2 bg-white rounded-2xl border border-slate-200 shadow-sm">

                    <div class="p-6 border-b border-slate-100">

                        <h2 class="font-bold">
                            Informations de l'établissement
                        </h2>

                        <p class="text-xs text-slate-400 mt-1">
                            Informations générales enregistrées.
                        </p>

                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2">

                        <div class="p-6 border-b sm:border-r border-slate-100">
                            <p class="text-xs text-slate-400">Type</p>
                            <p class="text-sm font-semibold mt-1">École secondaire</p>
                        </div>

                        <div class="p-6 border-b border-slate-100">
                            <p class="text-xs text-slate-400">Année de création</p>
                            <p class="text-sm font-semibold mt-1">2008</p>
                        </div>

                        <div class="p-6 border-b sm:border-r border-slate-100">
                            <p class="text-xs text-slate-400">Province</p>
                            <p class="text-sm font-semibold mt-1">Kinshasa</p>
                        </div>

                        <div class="p-6 border-b border-slate-100">
                            <p class="text-xs text-slate-400">Commune</p>
                            <p class="text-sm font-semibold mt-1">Limete</p>
                        </div>

                        <div class="p-6 border-b sm:border-r border-slate-100">
                            <p class="text-xs text-slate-400">Email</p>
                            <p class="text-sm font-semibold mt-1">admin@lareussite.cd</p>
                        </div>

                        <div class="p-6 border-b border-slate-100">
                            <p class="text-xs text-slate-400">Téléphone</p>
                            <p class="text-sm font-semibold mt-1">+243 81 000 00 00</p>
                        </div>

                        <div class="p-6 sm:col-span-2">
                            <p class="text-xs text-slate-400">Adresse</p>
                            <p class="text-sm font-semibold mt-1">
                                Avenue de la Réussite, Limete, Kinshasa
                            </p>
                        </div>

                    </div>

                </section>

                <!-- ADMIN -->

                <section class="bg-white rounded-2xl border border-slate-200 shadow-sm">

                    <div class="p-6 border-b border-slate-100">

                        <h2 class="font-bold">
                            Administrateur
                        </h2>

                        <p class="text-xs text-slate-400 mt-1">
                            Responsable de l'établissement.
                        </p>

                    </div>

                    <div class="p-6">

                        <div class="flex items-center gap-4">

                            <div class="w-14 h-14 rounded-full bg-sky-100 text-sky-600 flex items-center justify-center text-lg font-bold">
                                JK
                            </div>

                            <div>

                                <p class="font-bold">
                                    Jean Kabasele
                                </p>

                                <p class="text-xs text-slate-400 mt-1">
                                    School Administrator
                                </p>

                            </div>

                        </div>

                        <div class="mt-6 space-y-4">

                            <div class="flex items-center gap-3 text-sm">
                                <i class="fa-regular fa-envelope text-slate-400 w-5"></i>
                                <span>admin@lareussite.cd</span>
                            </div>

                            <div class="flex items-center gap-3 text-sm">
                                <i class="fa-solid fa-phone text-slate-400 w-5"></i>
                                <span>+243 81 000 00 00</span>
                            </div>

                            <div class="flex items-center gap-3 text-sm">
                                <i class="fa-regular fa-clock text-slate-400 w-5"></i>
                                <span>Dernière connexion : aujourd'hui 10:42</span>
                            </div>

                        </div>

                    </div>

                </section>

            </div>

            <!-- ACTIVITY -->

            <section class="mt-6 bg-white rounded-2xl border border-slate-200 shadow-sm">

                <div class="p-6 border-b border-slate-100">

                    <h2 class="font-bold">
                        Activité récente
                    </h2>

                    <p class="text-xs text-slate-400 mt-1">
                        Dernières activités associées à cette école.
                    </p>

                </div>

                <div class="divide-y divide-slate-100">

                    <div class="p-5 flex gap-4">

                        <div class="w-10 h-10 rounded-xl bg-sky-50 text-sky-500 flex items-center justify-center shrink-0">
                            <i class="fa-solid fa-user-plus"></i>
                        </div>

                        <div>
                            <p class="text-sm font-semibold">
                                24 nouveaux élèves inscrits
                            </p>
                            <p class="text-xs text-slate-400 mt-1">
                                Aujourd'hui, 09:32
                            </p>
                        </div>

                    </div>

                    <div class="p-5 flex gap-4">

                        <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-500 flex items-center justify-center shrink-0">
                            <i class="fa-solid fa-file-circle-check"></i>
                        </div>

                        <div>
                            <p class="text-sm font-semibold">
                                Résultats trimestriels publiés
                            </p>
                            <p class="text-xs text-slate-400 mt-1">
                                Hier, 16:48
                            </p>
                        </div>

                    </div>

                    <div class="p-5 flex gap-4">

                        <div class="w-10 h-10 rounded-xl bg-violet-50 text-violet-500 flex items-center justify-center shrink-0">
                            <i class="fa-solid fa-calendar-check"></i>
                        </div>

                        <div>
                            <p class="text-sm font-semibold">
                                Nouvelle période scolaire configurée
                            </p>
                            <p class="text-xs text-slate-400 mt-1">
                                08 Août 2026
                            </p>
                        </div>

                    </div>

                </div>

            </section>

        </div>

    </main>
</div>

<script>

    const sidebar = document.getElementById("sidebar");
    const overlay = document.getElementById("overlay");

    document.getElementById("openSidebar")?.addEventListener("click", () => {
        sidebar.classList.remove("-translate-x-full");
        overlay.classList.remove("hidden");
    });

    overlay?.addEventListener("click", () => {
        sidebar.classList.add("-translate-x-full");
        overlay.classList.add("hidden");
    });

    function suspendSchool() {
        if (
            confirm(
                "Voulez-vous vraiment suspendre cette école ?"
            )
        ) {
            alert(
                "La suspension sera effectuée par AdonisJS."
            );
        }
    }

</script>

<script src="/assets/js/smart-school-api.js"></script>
</body>
</html>
