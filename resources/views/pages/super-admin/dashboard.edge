<!DOCTYPE html>
<html lang="fr">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Super Admin Dashboard | Smart School</title>


    <!-- =========================================================
         TAILWIND
    ========================================================== -->

    <script src="https://cdn.tailwindcss.com"></script>


    <!-- =========================================================
         FONT AWESOME
    ========================================================== -->

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >


    <!-- =========================================================
         TAILWIND CONFIG
    ========================================================== -->

    <script>

        tailwind.config = {

            theme: {

                extend: {

                    colors: {

                        primary: {

                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            200: '#bae6fd',
                            300: '#7dd3fc',
                            400: '#38bdf8',
                            500: '#0ea5e9',
                            600: '#0284c7',
                            700: '#0369a1',
                            800: '#075985',
                            900: '#0c4a6e'

                        }

                    }

                }

            }

        }

    </script>


    <!-- =========================================================
         LUCIDE
    ========================================================== -->

    <script src="https://unpkg.com/lucide@latest"></script>


    <style>

        * {
            scrollbar-width: thin;
            scrollbar-color: #cbd5e1 transparent;
        }

        body {
            font-family:
                Inter,
                ui-sans-serif,
                system-ui,
                sans-serif;
        }

        .sidebar-transition {
            transition:
                transform .3s ease;
        }

        .overlay {
            transition:
                opacity .3s ease;
        }

        .chart-line {
            stroke-dasharray: 1000;
            stroke-dashoffset: 1000;
            animation:
                drawChart 1.5s ease forwards;
        }

        @keyframes drawChart {

            to {
                stroke-dashoffset: 0;
            }

        }

        .loading {
            animation:
                pulse 1.5s ease-in-out infinite;
        }

    </style>

</head>


<body class="bg-slate-50 text-slate-900">


<!-- =========================================================
     MOBILE OVERLAY
========================================================== -->

<div
    id="overlay"
    class="
        fixed
        inset-0
        z-40
        hidden
        bg-slate-900/40
        backdrop-blur-sm
        lg:hidden
    "
></div>


<!-- =========================================================
     SIDEBAR
========================================================== -->

<aside
    id="sidebar"
    class="
        sidebar-transition
        fixed
        inset-y-0
        left-0
        z-50
        flex
        w-72
        -translate-x-full
        flex-col
        border-r
        border-slate-200
        bg-white
        lg:translate-x-0
    "
>

    <!-- BRAND -->

    <div
        class="
            flex
            h-20
            items-center
            gap-3
            border-b
            border-slate-100
            px-6
        "
    >

        <div
            class="
                flex
                h-11
                w-11
                items-center
                justify-center
                rounded-xl
                bg-primary-600
                text-white
                shadow-lg
                shadow-primary-600/20
            "
        >

            <i
                data-lucide="graduation-cap"
                class="h-6 w-6"
            ></i>

        </div>


        <div>

            <h1 class="font-extrabold text-slate-900">
                SMART SCHOOL
            </h1>

            <p class="text-xs text-slate-400">
                Administration Platform
            </p>

        </div>

    </div>


    <!-- NAVIGATION -->

    <div class="flex-1 overflow-y-auto px-4 py-6">

        <p
            class="
                mb-3
                px-3
                text-[10px]
                font-bold
                uppercase
                tracking-widest
                text-slate-400
            "
        >
            Principal
        </p>


        <nav class="space-y-1">

            <a
                href="/super-admin/dashboard"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    bg-primary-50
                    px-4
                    py-3
                    text-sm
                    font-semibold
                    text-primary-700
                "
            >

                <i
                    data-lucide="layout-dashboard"
                    class="h-5 w-5"
                ></i>

                Tableau de bord

            </a>


            <a
                href="/super-admin/ecoles"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    px-4
                    py-3
                    text-sm
                    font-medium
                    text-slate-600
                    hover:bg-slate-50
                "
            >

                <i
                    data-lucide="school"
                    class="h-5 w-5"
                ></i>

                Écoles

            </a>


            <a
                href="/super-admin/utilisateurs"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    px-4
                    py-3
                    text-sm
                    font-medium
                    text-slate-600
                    hover:bg-slate-50
                "
            >

                <i
                    data-lucide="users"
                    class="h-5 w-5"
                ></i>

                Utilisateurs

            </a>

        </nav>


        <p
            class="
                mb-3
                mt-8
                px-3
                text-[10px]
                font-bold
                uppercase
                tracking-widest
                text-slate-400
            "
        >
            Supervision
        </p>


        <nav class="space-y-1">

            <a
                href="/super-admin/statistiques"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    px-4
                    py-3
                    text-sm
                    font-medium
                    text-slate-600
                    hover:bg-slate-50
                "
            >

                <i
                    data-lucide="bar-chart-3"
                    class="h-5 w-5"
                ></i>

                Statistiques

            </a>


            <a
                href="/super-admin/rapports"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    px-4
                    py-3
                    text-sm
                    font-medium
                    text-slate-600
                    hover:bg-slate-50
                "
            >

                <i
                    data-lucide="file-text"
                    class="h-5 w-5"
                ></i>

                Rapports

            </a>

        </nav>


        <p
            class="
                mb-3
                mt-8
                px-3
                text-[10px]
                font-bold
                uppercase
                tracking-widest
                text-slate-400
            "
        >
            Système
        </p>


        <nav class="space-y-1">

            <a
                href="#"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    px-4
                    py-3
                    text-sm
                    font-medium
                    text-slate-600
                    hover:bg-slate-50
                "
            >

                <i
                    data-lucide="bell"
                    class="h-5 w-5"
                ></i>

                Notifications

            </a>


            <a
                href="#"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    px-4
                    py-3
                    text-sm
                    font-medium
                    text-slate-600
                    hover:bg-slate-50
                "
            >

                <i
                    data-lucide="settings"
                    class="h-5 w-5"
                ></i>

                Paramètres

            </a>


            <button
                type="button"
                onclick="logout()"
                class="
                    flex
                    w-full
                    items-center
                    gap-3
                    rounded-xl
                    px-4
                    py-3
                    text-red-500
                    transition
                    hover:bg-red-50
                "
            >

                <i
                    class="fa-solid fa-right-from-bracket w-5"
                ></i>

                <span>
                    Déconnexion
                </span>

            </button>

        </nav>

    </div>


    <!-- USER -->

    <div class="border-t border-slate-100 p-4">

        <div
            class="
                flex
                items-center
                gap-3
                rounded-xl
                bg-slate-50
                p-3
            "
        >

            <div
                id="sidebarAvatar"
                class="
                    flex
                    h-10
                    w-10
                    items-center
                    justify-center
                    rounded-full
                    bg-primary-100
                    font-bold
                    text-primary-700
                "
            >
                SA
            </div>


            <div class="min-w-0 flex-1">

                <p
                    id="sidebarUserName"
                    class="
                        truncate
                        text-sm
                        font-bold
                    "
                >
                    Super Administrateur
                </p>


                <p
                    id="sidebarUserEmail"
                    class="
                        truncate
                        text-xs
                        text-slate-400
                    "
                >
                    Chargement...
                </p>

            </div>

        </div>

    </div>

</aside>


<!-- =========================================================
     MAIN
========================================================== -->

<div class="lg:pl-72">


    <!-- =====================================================
         HEADER
    ====================================================== -->

    <header
        class="
            sticky
            top-0
            z-30
            flex
            h-20
            items-center
            justify-between
            border-b
            border-slate-200
            bg-white/90
            px-4
            backdrop-blur-md
            sm:px-6
            lg:px-8
        "
    >

        <button
            id="menuButton"
            type="button"
            class="
                rounded-xl
                p-2
                text-slate-600
                hover:bg-slate-100
                lg:hidden
            "
        >

            <i
                data-lucide="menu"
                class="h-5 w-5"
            ></i>

        </button>


        <div class="hidden lg:block">

            <p
                id="dashboardDate"
                class="text-sm text-slate-400"
            >
                Chargement...
            </p>

            <h2 class="font-bold">
                Vue globale de la plateforme
            </h2>

        </div>


        <div class="flex items-center gap-3">

            <button
                type="button"
                class="
                    relative
                    rounded-xl
                    p-2.5
                    text-slate-500
                    hover:bg-slate-100
                "
            >

                <i
                    data-lucide="bell"
                    class="h-5 w-5"
                ></i>

            </button>


            <div
                class="
                    hidden
                    h-8
                    w-px
                    bg-slate-200
                    sm:block
                "
            ></div>


            <div class="flex items-center gap-3">

                <div
                    id="headerAvatar"
                    class="
                        flex
                        h-9
                        w-9
                        items-center
                        justify-center
                        rounded-full
                        bg-primary-600
                        text-sm
                        font-bold
                        text-white
                    "
                >
                    SA
                </div>


                <div class="hidden sm:block">

                    <p
                        id="headerUserName"
                        class="text-sm font-bold"
                    >
                        Super Administrateur
                    </p>


                    <p
                        class="
                            text-xs
                            text-slate-400
                        "
                    >
                        Super Admin
                    </p>

                </div>

            </div>

        </div>

    </header>


    <!-- =====================================================
         CONTENT
    ====================================================== -->

    <main class="p-4 sm:p-6 lg:p-8">


        <!-- PAGE HEADER -->

        <div class="mb-8">

            <p
                id="welcomeText"
                class="
                    mb-2
                    text-sm
                    font-medium
                    text-primary-600
                "
            >
                Bonjour 👋
            </p>


            <h1
                class="
                    text-2xl
                    font-extrabold
                    tracking-tight
                    sm:text-3xl
                "
            >
                Tableau de bord
            </h1>


            <p
                class="
                    mt-2
                    text-sm
                    text-slate-500
                "
            >
                Voici un aperçu global de votre plateforme scolaire.
            </p>

        </div>


        <!-- =====================================================
             ERROR
        ====================================================== -->

        <div
            id="dashboardError"
            class="
                mb-6
                hidden
                rounded-2xl
                border
                border-red-200
                bg-red-50
                px-5
                py-4
                text-sm
                text-red-700
            "
        ></div>


        <!-- =====================================================
             KPI
        ====================================================== -->

        <div
            class="
                grid
                gap-4
                sm:grid-cols-2
                xl:grid-cols-4
            "
        >


            <!-- ECOLES -->

            <div
                class="
                    rounded-2xl
                    border
                    border-slate-200
                    bg-white
                    p-5
                    shadow-sm
                "
            >

                <div class="flex items-center justify-between">

                    <div
                        class="
                            rounded-xl
                            bg-primary-50
                            p-3
                            text-primary-600
                        "
                    >

                        <i
                            data-lucide="school"
                            class="h-5 w-5"
                        ></i>

                    </div>


                    <span
                        id="activeSchoolsValue"
                        class="
                            text-xs
                            font-bold
                            text-emerald-600
                        "
                    >
                        —
                    </span>

                </div>


                <p class="mt-5 text-sm text-slate-500">
                    Écoles
                </p>


                <h3
                    id="totalSchools"
                    class="
                        mt-1
                        text-3xl
                        font-extrabold
                    "
                >
                    —
                </h3>


                <p
                    id="schoolsSubtext"
                    class="
                        mt-1
                        text-xs
                        text-slate-400
                    "
                >
                    Chargement...
                </p>

            </div>


            <!-- UTILISATEURS -->

            <div
                class="
                    rounded-2xl
                    border
                    border-slate-200
                    bg-white
                    p-5
                    shadow-sm
                "
            >

                <div class="flex items-center justify-between">

                    <div
                        class="
                            rounded-xl
                            bg-violet-50
                            p-3
                            text-violet-600
                        "
                    >

                        <i
                            data-lucide="users"
                            class="h-5 w-5"
                        ></i>

                    </div>


                    <span
                        id="activeUsersValue"
                        class="
                            text-xs
                            font-bold
                            text-emerald-600
                        "
                    >
                        —
                    </span>

                </div>


                <p class="mt-5 text-sm text-slate-500">
                    Utilisateurs
                </p>


                <h3
                    id="totalUsers"
                    class="
                        mt-1
                        text-3xl
                        font-extrabold
                    "
                >
                    —
                </h3>


                <p
                    class="
                        mt-1
                        text-xs
                        text-slate-400
                    "
                >
                    utilisateurs actifs
                </p>

            </div>


            <!-- ELEVES -->

            <div
                class="
                    rounded-2xl
                    border
                    border-slate-200
                    bg-white
                    p-5
                    shadow-sm
                "
            >

                <div class="flex items-center justify-between">

                    <div
                        class="
                            rounded-xl
                            bg-emerald-50
                            p-3
                            text-emerald-600
                        "
                    >

                        <i
                            data-lucide="graduation-cap"
                            class="h-5 w-5"
                        ></i>

                    </div>


                    <span
                        class="
                            text-xs
                            font-bold
                            text-slate-400
                        "
                    >
                        Global
                    </span>

                </div>


                <p class="mt-5 text-sm text-slate-500">
                    Élèves
                </p>


                <h3
                    id="totalStudents"
                    class="
                        mt-1
                        text-3xl
                        font-extrabold
                    "
                >
                    —
                </h3>


                <p
                    class="
                        mt-1
                        text-xs
                        text-slate-400
                    "
                >
                    élèves enregistrés
                </p>

            </div>


            <!-- ENSEIGNANTS -->

            <div
                class="
                    rounded-2xl
                    border
                    border-slate-200
                    bg-white
                    p-5
                    shadow-sm
                "
            >

                <div class="flex items-center justify-between">

                    <div
                        class="
                            rounded-xl
                            bg-amber-50
                            p-3
                            text-amber-600
                        "
                    >

                        <i
                            data-lucide="presentation"
                            class="h-5 w-5"
                        ></i>

                    </div>


                    <span
                        id="activeTeachersValue"
                        class="
                            text-xs
                            font-bold
                            text-emerald-600
                        "
                    >
                        —
                    </span>

                </div>


                <p class="mt-5 text-sm text-slate-500">
                    Enseignants
                </p>


                <h3
                    id="activeTeachers"
                    class="
                        mt-1
                        text-3xl
                        font-extrabold
                    "
                >
                    —
                </h3>


                <p
                    class="
                        mt-1
                        text-xs
                        text-slate-400
                    "
                >
                    enseignants actifs
                </p>

            </div>

        </div>


        <!-- =====================================================
             CHARTS
        ====================================================== -->

        <div
            class="
                mt-6
                grid
                gap-6
                xl:grid-cols-3
            "
        >


            <!-- CROISSANCE ECOLES -->

            <div
                class="
                    rounded-2xl
                    border
                    border-slate-200
                    bg-white
                    p-6
                    shadow-sm
                    xl:col-span-2
                "
            >

                <div
                    class="
                        flex
                        items-center
                        justify-between
                    "
                >

                    <div>

                        <h3 class="font-bold">
                            Croissance des écoles
                        </h3>

                        <p
                            class="
                                mt-1
                                text-xs
                                text-slate-400
                            "
                        >
                            Évolution mensuelle
                        </p>

                    </div>


                    <span
                        id="chartYear"
                        class="
                            rounded-lg
                            border
                            border-slate-200
                            px-3
                            py-2
                            text-xs
                            font-medium
                            text-slate-600
                        "
                    >
                        —
                    </span>

                </div>


                <div class="mt-8 h-64">

                    <svg
                        id="schoolsChart"
                        viewBox="0 0 800 260"
                        class="h-full w-full"
                    >

                        <line
                            x1="40"
                            y1="220"
                            x2="760"
                            y2="220"
                            stroke="#e2e8f0"
                        />

                        <line
                            x1="40"
                            y1="170"
                            x2="760"
                            y2="170"
                            stroke="#f1f5f9"
                        />

                        <line
                            x1="40"
                            y1="120"
                            x2="760"
                            y2="120"
                            stroke="#f1f5f9"
                        />

                        <line
                            x1="40"
                            y1="70"
                            x2="760"
                            y2="70"
                            stroke="#f1f5f9"
                        />

                        <polyline
                            id="schoolsChartLine"
                            points=""
                            fill="none"
                            stroke="#0ea5e9"
                            stroke-width="4"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="chart-line"
                        />

                        <g id="schoolsChartPoints"></g>

                    </svg>

                </div>

            </div>


            <!-- REPARTITION UTILISATEURS -->

            <div
                class="
                    rounded-2xl
                    border
                    border-slate-200
                    bg-white
                    p-6
                    shadow-sm
                "
            >

                <h3 class="font-bold">
                    Utilisateurs
                </h3>

                <p
                    class="
                        mt-1
                        text-xs
                        text-slate-400
                    "
                >
                    Répartition par profil
                </p>


                <div
                    id="usersDonut"
                    class="
                        relative
                        mx-auto
                        mt-8
                        flex
                        h-44
                        w-44
                        items-center
                        justify-center
                        rounded-full
                    "
                >

                    <div
                        class="
                            flex
                            h-28
                            w-28
                            items-center
                            justify-center
                            rounded-full
                            bg-white
                        "
                    >

                        <div class="text-center">

                            <p
                                id="usersDonutTotal"
                                class="text-2xl font-extrabold"
                            >
                                —
                            </p>

                            <p
                                class="text-xs text-slate-400"
                            >
                                Total
                            </p>

                        </div>

                    </div>

                </div>


                <div
                    id="usersLegend"
                    class="mt-6 space-y-3 text-sm"
                ></div>

            </div>

        </div>


        <!-- =====================================================
             SCHOOLS TABLE
        ====================================================== -->

        <div
            class="
                mt-6
                overflow-hidden
                rounded-2xl
                border
                border-slate-200
                bg-white
                shadow-sm
            "
        >

            <div
                class="
                    flex
                    flex-col
                    gap-4
                    border-b
                    border-slate-100
                    p-6
                    sm:flex-row
                    sm:items-center
                    sm:justify-between
                "
            >

                <div>

                    <h3 class="font-bold">
                        Écoles récemment ajoutées
                    </h3>

                    <p
                        class="
                            mt-1
                            text-xs
                            text-slate-400
                        "
                    >
                        Derniers établissements enregistrés
                    </p>

                </div>


                <a
                    href="/super-admin/ecoles"
                    class="
                        rounded-xl
                        bg-primary-600
                        px-4
                        py-2.5
                        text-center
                        text-sm
                        font-semibold
                        text-white
                        hover:bg-primary-700
                    "
                >
                    Voir toutes les écoles
                </a>

            </div>


            <div class="overflow-x-auto">

                <table
                    class="
                        w-full
                        min-w-[800px]
                        text-left
                    "
                >

                    <thead
                        class="
                            bg-slate-50
                            text-xs
                            uppercase
                            tracking-wide
                            text-slate-400
                        "
                    >

                        <tr>

                            <th class="px-6 py-4">
                                École
                            </th>

                            <th class="px-6 py-4">
                                Adresse
                            </th>

                            <th class="px-6 py-4">
                                Administrateurs
                            </th>

                            <th class="px-6 py-4">
                                Utilisateurs
                            </th>

                            <th class="px-6 py-4">
                                Élèves
                            </th>

                            <th class="px-6 py-4">
                                Statut
                            </th>

                        </tr>

                    </thead>


                    <tbody
                        id="schoolsTableBody"
                        class="divide-y divide-slate-100 text-sm"
                    >

                        <tr>

                            <td
                                colspan="6"
                                class="
                                    px-6
                                    py-10
                                    text-center
                                    text-slate-400
                                "
                            >
                                Chargement des écoles...
                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>

        </div>


        <!-- =====================================================
             SYSTEM STATUS
        ====================================================== -->

        <div
            class="
                mt-6
                rounded-2xl
                border
                border-slate-200
                bg-white
                p-6
                shadow-sm
            "
        >

            <div
                class="
                    flex
                    flex-col
                    gap-4
                    sm:flex-row
                    sm:items-center
                    sm:justify-between
                "
            >

                <div>

                    <h3 class="font-bold">
                        État du système
                    </h3>

                    <p
                        class="
                            mt-1
                            text-xs
                            text-slate-400
                        "
                    >
                        Dernière vérification
                    </p>

                </div>


                <div
                    class="
                        flex
                        items-center
                        gap-2
                        text-sm
                    "
                >

                    <span
                        id="systemStatusDot"
                        class="
                            h-2.5
                            w-2.5
                            rounded-full
                            bg-slate-300
                        "
                    ></span>


                    <span
                        id="systemStatus"
                        class="font-semibold"
                    >
                        Vérification...
                    </span>

                </div>

            </div>


            <div
                class="
                    mt-5
                    grid
                    gap-4
                    sm:grid-cols-2
                "
            >

                <div class="rounded-xl bg-slate-50 p-4">

                    <p
                        class="
                            text-xs
                            text-slate-400
                        "
                    >
                        Base de données
                    </p>

                    <p
                        id="databaseStatus"
                        class="
                            mt-1
                            font-bold
                            text-slate-700
                        "
                    >
                        —
                    </p>

                </div>


                <div class="rounded-xl bg-slate-50 p-4">

                    <p
                        class="
                            text-xs
                            text-slate-400
                        "
                    >
                        Temps de réponse
                    </p>

                    <p
                        id="responseTime"
                        class="
                            mt-1
                            font-bold
                            text-slate-700
                        "
                    >
                        —
                    </p>

                </div>

            </div>

        </div>

    </main>

</div>

<script src="/assets/js/super-admin/auth.js"></script>
<script src="/assets/js/super-admin/dashboard.js"></script>

</body>

</html>