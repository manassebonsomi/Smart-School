<!DOCTYPE html>

<html lang="fr">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Écoles | Smart School</title>


    <!-- =========================================================
         TAILWIND
    ========================================================== -->

    <script src="https://cdn.tailwindcss.com"></script>


    <!-- =========================================================
         LUCIDE
    ========================================================== -->

    <script src="https://unpkg.com/lucide@latest"></script>


    <!-- =========================================================
         FONT AWESOME
    ========================================================== -->

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >


    <script>

        tailwind.config = {

            theme: {

                extend: {

                    colors: {

                        primary: '#38BDF8',

                        primaryDark: '#0284C7',

                        primaryLight: '#E0F2FE',

                        darkBlue: '#0F172A'

                    }

                }

            }

        }

    </script>


    <style>

        body {
            font-family:
                Inter,
                ui-sans-serif,
                system-ui,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                sans-serif;
        }

        * {
            scrollbar-width: thin;
            scrollbar-color: #cbd5e1 transparent;
        }

        .sidebar-transition {
            transition:
                transform .3s ease-in-out;
        }

        .overlay-transition {
            transition:
                opacity .3s ease-in-out;
        }

        .modal-transition {
            transition:
                opacity .2s ease,
                transform .2s ease;
        }

        .action-btn {
            width: 36px;
            height: 36px;
            border-radius: 9px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #f8fafc;
            transition: .2s ease;
        }

        .form-label {
            display: block;
            margin-bottom: .5rem;
            font-size: .75rem;
            line-height: 1rem;
            font-weight: 600;
            color: #64748b;
        }

        .form-input {
            width: 100%;
            padding: .75rem 1rem;
            border-radius: .75rem;
            border: 1px solid #e2e8f0;
            background: #f8fafc;
            font-size: .875rem;
            outline: none;
            transition: .2s ease;
        }

        .form-input:focus {
            border-color: #38bdf8;
            box-shadow:
                0 0 0 3px rgba(56, 189, 248, .15);
            background: white;
        }

        .loading-row td {
            padding-top: 48px;
            padding-bottom: 48px;
            text-align: center;
        }

    </style>

</head>


<body class="bg-slate-50 text-slate-800">


<!-- =========================================================
     SIDEBAR OVERLAY
========================================================== -->

<div
    id="sidebarOverlay"
    class="
        fixed
        inset-0
        z-40
        hidden
        bg-slate-900/50
        opacity-0
        overlay-transition
        lg:hidden
    "
></div>


<!-- =========================================================
     SIDEBAR
========================================================== -->

<aside
    id="sidebar"
    class="
        sidebar-transition
        fixed
        inset-y-0
        left-0
        z-50
        flex
        w-72
        -translate-x-full
        flex-col
        border-r
        border-slate-200
        bg-white
        lg:translate-x-0
    "
>


    <!-- =====================================================
         SIDEBAR HEADER
    ====================================================== -->

    <div
        class="
            flex
            h-20
            items-center
            gap-3
            border-b
            border-slate-100
            px-6
        "
    >

        <div
            class="
                flex
                h-11
                w-11
                shrink-0
                items-center
                justify-center
                rounded-xl
                bg-primary-600
                text-white
                shadow-lg
                shadow-primary-600/20
            "
        >

            <i
                class="
                    fa-solid
                    fa-graduation-cap
                    text-lg
                "
            ></i>

        </div>


        <div class="min-w-0">

            <h1
                class="
                    truncate
                    text-base
                    font-extrabold
                    tracking-tight
                    text-slate-900
                "
            >
                SMART SCHOOL
            </h1>


            <p
                class="
                    truncate
                    text-xs
                    text-slate-400
                "
            >
                Administration Platform
            </p>

        </div>


        <button
            id="closeSidebar"
            type="button"
            class="
                ml-auto
                flex
                h-9
                w-9
                items-center
                justify-center
                rounded-lg
                text-slate-400
                hover:bg-slate-100
                hover:text-slate-700
                lg:hidden
            "
            aria-label="Fermer le menu"
        >

            <i class="fa-solid fa-xmark"></i>

        </button>

    </div>


    <!-- =====================================================
         SIDEBAR NAVIGATION
    ====================================================== -->

    <div
        class="
            flex-1
            overflow-y-auto
            px-4
            py-6
        "
    >

        <p
            class="
                mb-3
                px-3
                text-[10px]
                font-bold
                uppercase
                tracking-[0.18em]
                text-slate-400
            "
        >
            Principal
        </p>


        <nav class="space-y-1">


            <!-- Dashboard -->

            <a
                href="/super-admin/dashboard"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    px-4
                    py-3
                    text-sm
                    font-medium
                    text-slate-600
                    transition
                    hover:bg-slate-50
                    hover:text-slate-900
                "
            >

                <i
                    class="
                        fa-solid
                        fa-chart-pie
                        w-5
                        text-center
                    "
                ></i>

                <span>
                    Tableau de bord
                </span>

            </a>


            <!-- Écoles -->

            <a
                href="/super-admin/ecoles"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    px-4
                    py-3
                    text-sm
                    font-medium
                    text-slate-600
                    transition
                    hover:bg-slate-50
                    hover:text-slate-900
                "
            >

                <i
                    class="
                        fa-solid
                        fa-school
                        w-5
                        text-center
                    "
                ></i>

                <span>
                    Écoles
                </span>

            </a>


            <!-- Utilisateurs -->

            <a
                href="/super-admin/utilisateurs"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    px-4
                    py-3
                    text-sm
                    font-medium
                    text-slate-600
                    transition
                    hover:bg-slate-50
                    hover:text-slate-900
                "
            >

                <i
                    class="
                        fa-solid
                        fa-users
                        w-5
                        text-center
                    "
                ></i>

                <span>
                    Utilisateurs
                </span>

            </a>

        </nav>


        <p
            class="
                mb-3
                mt-8
                px-3
                text-[10px]
                font-bold
                uppercase
                tracking-[0.18em]
                text-slate-400
            "
        >
            Supervision
        </p>


        <nav class="space-y-1">


            <!-- Statistiques ACTIVE -->

            <a
                href="/super-admin/statistiques"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    bg-primary-50
                    px-4
                    py-3
                    text-sm
                    font-semibold
                    text-primary-700
                "
            >

                <i
                    class="
                        fa-solid
                        fa-chart-line
                        w-5
                        text-center
                    "
                ></i>

                <span>
                    Statistiques
                </span>

            </a>


            <!-- Rapports -->

            <a
                href="/super-admin/rapports"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    px-4
                    py-3
                    text-sm
                    font-medium
                    text-slate-600
                    transition
                    hover:bg-slate-50
                    hover:text-slate-900
                "
            >

                <i
                    class="
                        fa-solid
                        fa-file-lines
                        w-5
                        text-center
                    "
                ></i>

                <span>
                    Rapports
                </span>

            </a>

        </nav>


        <p
            class="
                mb-3
                mt-8
                px-3
                text-[10px]
                font-bold
                uppercase
                tracking-[0.18em]
                text-slate-400
            "
        >
            Système
        </p>


        <nav class="space-y-1">


            <a
                href="/super-admin/profil"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    bg-primary-50
                    px-4
                    py-3
                    text-sm
                    font-semibold
                    text-primary-700
                "
            >

                <i class="fa-solid fa-user-gear w-5 text-center"></i>

                Mon profil

            </a>


            <!-- Notifications -->

            <a
                href="#"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    px-4
                    py-3
                    text-sm
                    font-medium
                    text-slate-600
                    transition
                    hover:bg-slate-50
                    hover:text-slate-900
                "
            >

                <i
                    class="
                        fa-solid
                        fa-bell
                        w-5
                        text-center
                    "
                ></i>

                <span>
                    Notifications
                </span>

            </a>


            <!-- Paramètres -->

            <a
                href="#"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    px-4
                    py-3
                    text-sm
                    font-medium
                    text-slate-600
                    transition
                    hover:bg-slate-50
                    hover:text-slate-900
                "
            >

                <i
                    class="
                        fa-solid
                        fa-gear
                        w-5
                        text-center
                    "
                ></i>

                <span>
                    Paramètres
                </span>

            </a>


            <!-- Déconnexion -->

            <button
                type="button"
                onclick="logout()"
                class="
                    flex
                    w-full
                    items-center
                    gap-3
                    rounded-xl
                    px-4
                    py-3
                    text-sm
                    text-red-500
                    transition
                    hover:bg-red-50
                "
            >

                <i
                    class="
                        fa-solid
                        fa-right-from-bracket
                        w-5
                        text-center
                    "
                ></i>

                <span>
                    Déconnexion
                </span>

            </button>

        </nav>

    </div>


    <!-- =====================================================
         SIDEBAR USER
    ====================================================== -->

    <div
        class="
            border-t
            border-slate-100
            p-4
        "
    >

        <div
            class="
                flex
                items-center
                gap-3
                rounded-xl
                bg-slate-50
                p-3
            "
        >

            <div
                id="sidebarAvatar"
                class="
                    flex
                    h-10
                    w-10
                    shrink-0
                    items-center
                    justify-center
                    rounded-full
                    bg-primary-100
                    text-sm
                    font-bold
                    text-primary-700
                "
            >
                SA
            </div>


            <div class="min-w-0 flex-1">

                <p
                    id="sidebarUserName"
                    class="
                        truncate
                        text-sm
                        font-bold
                        text-slate-800
                    "
                >
                    Super Administrateur
                </p>


                <p
                    id="sidebarUserEmail"
                    class="
                        truncate
                        text-xs
                        text-slate-400
                    "
                >
                    Chargement...
                </p>

            </div>

        </div>

    </div>

</aside>


<!-- =========================================================
     MAIN
========================================================== -->

<div class="min-h-screen lg:ml-72">


    <!-- =====================================================
         HEADER
    ====================================================== -->

    <header
        class="
            sticky
            top-0
            z-30
            h-20
            border-b
            border-slate-200
            bg-white
        "
    >

        <div
            class="
                flex
                h-full
                items-center
                justify-between
                px-4
                sm:px-6
                lg:px-8
            "
        >

            <div class="flex items-center gap-4">

                <button
                    id="openSidebar"
                    type="button"
                    class="
                        flex
                        h-10
                        w-10
                        items-center
                        justify-center
                        rounded-lg
                        text-slate-600
                        hover:bg-slate-100
                        lg:hidden
                    "
                >

                    <i
                        class="fa-solid fa-bars"
                    ></i>

                </button>


                <div>

                    <h2
                        class="
                            text-lg
                            font-bold
                            text-slate-800
                            sm:text-xl
                        "
                    >
                        Écoles
                    </h2>

                    <p
                        class="
                            hidden
                            text-xs
                            text-slate-400
                            sm:block
                            sm:text-sm
                        "
                    >
                        Gestion des établissements scolaires
                    </p>

                </div>

            </div>


            <div class="flex items-center gap-3">

                <button
                    type="button"
                    class="
                        relative
                        flex
                        h-10
                        w-10
                        items-center
                        justify-center
                        rounded-xl
                        text-slate-500
                        hover:bg-slate-100
                    "
                >

                    <i
                        class="fa-regular fa-bell text-lg"
                    ></i>

                </button>


                <div
                    class="
                        hidden
                        items-center
                        gap-3
                        border-l
                        border-slate-200
                        pl-3
                        sm:flex
                    "
                >

                    <div
                        id="headerAvatar"
                        class="
                            flex
                            h-10
                            w-10
                            items-center
                            justify-center
                            rounded-full
                            bg-sky-100
                            font-bold
                            text-sky-600
                        "
                    >
                        SA
                    </div>


                    <div class="hidden md:block">

                        <p
                            id="headerUserName"
                            class="
                                text-sm
                                font-semibold
                                text-slate-700
                            "
                        >
                            Super Administrateur
                        </p>

                        <p class="text-xs text-slate-400">
                            Administrateur système
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </header>


    <!-- =====================================================
         CONTENT
    ====================================================== -->

    <main class="p-4 sm:p-6 lg:p-8">


        <!-- PAGE HEADER -->

        <div
            class="
                mb-8
                flex
                flex-col
                gap-4
                lg:flex-row
                lg:items-center
                lg:justify-between
            "
        >

            <div>

                <h1 class="text-2xl font-bold text-slate-800">
                    Gestion des écoles
                </h1>

                <p class="mt-1 text-sm text-slate-500">
                    Gérez les établissements enregistrés sur Smart School.
                </p>

            </div>


            <button
                id="createSchoolButton"
                type="button"
                class="
                    inline-flex
                    items-center
                    justify-center
                    gap-2
                    rounded-xl
                    bg-sky-500
                    px-5
                    py-3
                    text-sm
                    font-semibold
                    text-white
                    shadow-sm
                    transition
                    hover:bg-sky-600
                "
            >

                <i class="fa-solid fa-plus"></i>

                Nouvelle école

            </button>

        </div>


        <!-- ERROR -->

        <div
            id="pageError"
            class="
                mb-6
                hidden
                rounded-xl
                border
                border-red-200
                bg-red-50
                px-4
                py-3
                text-sm
                text-red-700
            "
        ></div>


        <!-- SUCCESS -->

        <div
            id="pageSuccess"
            class="
                mb-6
                hidden
                rounded-xl
                border
                border-emerald-200
                bg-emerald-50
                px-4
                py-3
                text-sm
                text-emerald-700
            "
        ></div>


        <!-- =====================================================
             SUMMARY
        ====================================================== -->

        <section
            class="
                mb-8
                grid
                grid-cols-1
                gap-5
                sm:grid-cols-2
                xl:grid-cols-4
            "
        >

            <div
                class="
                    rounded-2xl
                    border
                    border-slate-200
                    bg-white
                    p-5
                    shadow-sm
                "
            >

                <div class="flex items-start justify-between">

                    <div>

                        <p class="text-sm text-slate-500">
                            Total écoles
                        </p>

                        <p
                            id="totalSchools"
                            class="
                                mt-2
                                text-3xl
                                font-bold
                                text-slate-800
                            "
                        >
                            —
                        </p>

                    </div>


                    <div
                        class="
                            flex
                            h-12
                            w-12
                            items-center
                            justify-center
                            rounded-xl
                            bg-sky-50
                            text-sky-500
                        "
                    >

                        <i
                            class="fa-solid fa-school text-xl"
                        ></i>

                    </div>

                </div>

                <p class="mt-4 text-xs text-slate-400">
                    Établissements enregistrés
                </p>

            </div>


            <div
                class="
                    rounded-2xl
                    border
                    border-slate-200
                    bg-white
                    p-5
                    shadow-sm
                "
            >

                <div class="flex items-start justify-between">

                    <div>

                        <p class="text-sm text-slate-500">
                            Écoles actives
                        </p>

                        <p
                            id="activeSchools"
                            class="
                                mt-2
                                text-3xl
                                font-bold
                                text-slate-800
                            "
                        >
                            —
                        </p>

                    </div>


                    <div
                        class="
                            flex
                            h-12
                            w-12
                            items-center
                            justify-center
                            rounded-xl
                            bg-emerald-50
                            text-emerald-500
                        "
                    >

                        <i
                            class="fa-solid fa-circle-check text-xl"
                        ></i>

                    </div>

                </div>

                <p
                    id="activeSchoolsPercent"
                    class="
                        mt-4
                        text-xs
                        font-medium
                        text-emerald-500
                    "
                >
                    —
                </p>

            </div>


            <div
                class="
                    rounded-2xl
                    border
                    border-slate-200
                    bg-white
                    p-5
                    shadow-sm
                "
            >

                <div class="flex items-start justify-between">

                    <div>

                        <p class="text-sm text-slate-500">
                            Suspendues
                        </p>

                        <p
                            id="suspendedSchools"
                            class="
                                mt-2
                                text-3xl
                                font-bold
                                text-slate-800
                            "
                        >
                            —
                        </p>

                    </div>


                    <div
                        class="
                            flex
                            h-12
                            w-12
                            items-center
                            justify-center
                            rounded-xl
                            bg-amber-50
                            text-amber-500
                        "
                    >

                        <i
                            class="fa-solid fa-ban text-xl"
                        ></i>

                    </div>

                </div>

                <p class="mt-4 text-xs text-slate-400">
                    Établissements suspendus
                </p>

            </div>


            <div
                class="
                    rounded-2xl
                    border
                    border-slate-200
                    bg-white
                    p-5
                    shadow-sm
                "
            >

                <div class="flex items-start justify-between">

                    <div>

                        <p class="text-sm text-slate-500">
                            Élèves inscrits
                        </p>

                        <p
                            id="totalStudents"
                            class="
                                mt-2
                                text-3xl
                                font-bold
                                text-slate-800
                            "
                        >
                            —
                        </p>

                    </div>


                    <div
                        class="
                            flex
                            h-12
                            w-12
                            items-center
                            justify-center
                            rounded-xl
                            bg-indigo-50
                            text-indigo-500
                        "
                    >

                        <i
                            class="fa-solid fa-user-graduate text-xl"
                        ></i>

                    </div>

                </div>

                <p class="mt-4 text-xs text-indigo-500">
                    Dans tous les établissements
                </p>

            </div>

        </section>


        <!-- =====================================================
             FILTERS
        ====================================================== -->

        <section
            class="
                mb-6
                rounded-2xl
                border
                border-slate-200
                bg-white
                shadow-sm
            "
        >

            <div class="p-5 sm:p-6">

                <div
                    class="
                        grid
                        grid-cols-1
                        gap-4
                        md:grid-cols-2
                        xl:grid-cols-5
                    "
                >

                    <div class="xl:col-span-2">

                        <label
                            class="
                                mb-2
                                block
                                text-xs
                                font-semibold
                                text-slate-500
                            "
                            for="searchInput"
                        >
                            Rechercher une école
                        </label>


                        <div class="relative">

                            <i
                                class="
                                    fa-solid
                                    fa-magnifying-glass
                                    absolute
                                    left-3
                                    top-1/2
                                    -translate-y-1/2
                                    text-slate-400
                                "
                            ></i>


                            <input
                                id="searchInput"
                                type="search"
                                placeholder="Nom, code, ville, email..."
                                class="
                                    w-full
                                    rounded-xl
                                    border
                                    border-slate-200
                                    bg-slate-50
                                    py-3
                                    pl-10
                                    pr-4
                                    text-sm
                                    outline-none
                                    focus:border-sky-400
                                    focus:ring-2
                                    focus:ring-sky-200
                                "
                            >

                        </div>

                    </div>


                    <div>

                        <label
                            for="statusFilter"
                            class="
                                mb-2
                                block
                                text-xs
                                font-semibold
                                text-slate-500
                            "
                        >
                            Statut
                        </label>


                        <select
                            id="statusFilter"
                            class="
                                w-full
                                rounded-xl
                                border
                                border-slate-200
                                bg-slate-50
                                px-4
                                py-3
                                text-sm
                                outline-none
                                focus:border-sky-400
                                focus:ring-2
                                focus:ring-sky-200
                            "
                        >

                            <option value="">
                                Tous
                            </option>

                            <option value="ACTIF">
                                Active
                            </option>

                            <option value="SUSPENDU">
                                Suspendue
                            </option>

                            <option value="ARCHIVE">
                                Archivée
                            </option>

                        </select>

                    </div>


                    <div>

                        <label
                            for="provinceFilter"
                            class="
                                mb-2
                                block
                                text-xs
                                font-semibold
                                text-slate-500
                            "
                        >
                            Province
                        </label>


                        <select
                            id="provinceFilter"
                            class="
                                w-full
                                rounded-xl
                                border
                                border-slate-200
                                bg-slate-50
                                px-4
                                py-3
                                text-sm
                                outline-none
                                focus:border-sky-400
                                focus:ring-2
                                focus:ring-sky-200
                            "
                        >

                            <option value="">
                                Toutes
                            </option>

                            <option value="Kinshasa">
                                Kinshasa
                            </option>

                            <option value="Kongo-Central">
                                Kongo-Central
                            </option>

                            <option value="Haut-Katanga">
                                Haut-Katanga
                            </option>

                            <option value="Lualaba">
                                Lualaba
                            </option>

                        </select>

                    </div>


                    <div class="flex items-end">

                        <button
                            id="resetFiltersButton"
                            type="button"
                            class="
                                w-full
                                rounded-xl
                                border
                                border-slate-200
                                px-4
                                py-3
                                text-sm
                                font-semibold
                                text-slate-600
                                transition
                                hover:bg-slate-50
                            "
                        >

                            <i
                                class="fa-solid fa-rotate-left mr-2"
                            ></i>

                            Réinitialiser

                        </button>

                    </div>

                </div>

            </div>

        </section>


        <!-- =====================================================
             TABLE
        ====================================================== -->

        <section
            class="
                overflow-hidden
                rounded-2xl
                border
                border-slate-200
                bg-white
                shadow-sm
            "
        >

            <div
                class="
                    flex
                    flex-col
                    gap-3
                    border-b
                    border-slate-100
                    p-5
                    sm:flex-row
                    sm:items-center
                    sm:justify-between
                    sm:p-6
                "
            >

                <div>

                    <h2 class="font-bold text-slate-800">
                        Liste des écoles
                    </h2>

                    <p class="mt-1 text-sm text-slate-400">
                        Établissements enregistrés sur la plateforme.
                    </p>

                </div>


                <span
                    id="resultCount"
                    class="
                        inline-flex
                        w-fit
                        rounded-full
                        bg-slate-100
                        px-3
                        py-1.5
                        text-xs
                        font-semibold
                        text-slate-500
                    "
                >
                    0 école
                </span>

            </div>


            <div class="overflow-x-auto">

                <table class="w-full min-w-[1100px]">

                    <thead
                        class="
                            border-b
                            border-slate-100
                            bg-slate-50
                        "
                    >

                        <tr>

                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-400">
                                École
                            </th>

                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-400">
                                Localisation
                            </th>

                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-400">
                                Élèves
                            </th>

                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-400">
                                Administrateurs
                            </th>

                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-400">
                                Création
                            </th>

                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-400">
                                Statut
                            </th>

                            <th class="px-6 py-4 text-right text-xs font-semibold uppercase tracking-wider text-slate-400">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody
                        id="schoolsTable"
                        class="divide-y divide-slate-100"
                    >

                        <tr id="loadingRow">

                            <td
                                colspan="7"
                                class="
                                    px-6
                                    py-12
                                    text-center
                                    text-sm
                                    text-slate-400
                                "
                            >

                                <i
                                    class="
                                        fa-solid
                                        fa-spinner
                                        fa-spin
                                        mr-2
                                    "
                                ></i>

                                Chargement des écoles...

                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>


            <!-- EMPTY -->

            <div
                id="emptyState"
                class="hidden px-6 py-16 text-center"
            >

                <div
                    class="
                        mx-auto
                        flex
                        h-16
                        w-16
                        items-center
                        justify-center
                        rounded-2xl
                        bg-slate-100
                        text-slate-400
                    "
                >

                    <i
                        class="fa-solid fa-school-circle-xmark text-2xl"
                    ></i>

                </div>


                <h3
                    class="
                        mt-4
                        font-semibold
                        text-slate-700
                    "
                >
                    Aucune école trouvée
                </h3>


                <p
                    class="
                        mt-1
                        text-sm
                        text-slate-400
                    "
                >
                    Modifiez vos critères de recherche.
                </p>

            </div>


            <!-- PAGINATION -->

            <div
                class="
                    flex
                    flex-col
                    gap-4
                    border-t
                    border-slate-100
                    px-5
                    py-4
                    sm:flex-row
                    sm:items-center
                    sm:justify-between
                    sm:px-6
                "
            >

                <p
                    id="paginationInfo"
                    class="text-xs text-slate-400"
                >
                    Aucun résultat
                </p>


                <div
                    id="pagination"
                    class="
                        flex
                        items-center
                        gap-1
                    "
                ></div>

            </div>

        </section>


        <footer class="mt-8 text-center">

            <p class="text-xs text-slate-400">
                © 2026 Smart School. Tous droits réservés.
            </p>

        </footer>

    </main>

</div>


<!-- =========================================================
     CREATE MODAL
========================================================== -->
<div id="createModal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-slate-900/50 p-4 opacity-0 modal-transition">
    <div id="createModalContent" class="max-h-[92vh] w-full max-w-4xl overflow-y-auto rounded-2xl bg-white shadow-2xl">
        <div class="sticky top-0 z-10 flex items-center justify-between border-b border-slate-100 bg-white px-6 py-5">
            <div>
                <h3 class="text-lg font-bold text-slate-800">Nouvelle école</h3>
                <p class="mt-1 text-sm text-slate-400">
                    Enregistrer un nouvel établissement et, facultativement, son administrateur.
                </p>
            </div>
            <button id="closeCreateModal" type="button" class="flex h-9 w-9 items-center justify-center rounded-lg text-slate-400 hover:bg-slate-100">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <form id="createSchoolForm" class="p-6">
            <div class="mb-8">
                <div class="mb-5 flex items-center gap-3">
                    <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-sky-50 text-sky-500"><i class="fa-solid fa-school"></i></div>
                    <div><h4 class="font-semibold text-slate-700">Informations générales</h4><p class="text-xs text-slate-400">Informations principales de l'établissement.</p></div>
                </div>
                <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
                    <div class="md:col-span-2"><label for="create_nom" class="form-label">Nom de l'école *</label><input id="create_nom" name="nom" type="text" required class="form-input" placeholder="Ex : Complexe Scolaire La Réussite"></div>
                    <div><label for="create_code" class="form-label">Code école</label><input id="create_code" name="code" type="text" class="form-input" placeholder="Laisser vide pour génération automatique"></div>
                    <div>
                        <label for="create_type" class="form-label">Type d'établissement</label>
                        <select id="create_type" name="type" class="form-input">
                            <option value="">Sélectionner</option>
                            <option value="École primaire">École primaire</option>
                            <option value="École secondaire">École secondaire</option>
                            <option value="École primaire et secondaire">École primaire et secondaire</option>
                            <option value="Institut technique">Institut technique</option>
                            <option value="Établissement supérieur">Établissement supérieur</option>
                        </select>
                    </div>
                    <div><label for="create_email" class="form-label">Email</label><input id="create_email" name="email" type="email" class="form-input" placeholder="contact@ecole.cd"></div>
                    <div><label for="create_telephone" class="form-label">Téléphone</label><input id="create_telephone" name="telephone" type="tel" class="form-input" placeholder="+243 ..."></div>
                    <div><label for="create_siteWeb" class="form-label">Site web</label><input id="create_siteWeb" name="siteWeb" type="url" class="form-input" placeholder="https://..."></div>
                    <div class="md:col-span-2"><label for="create_description" class="form-label">Description</label><textarea id="create_description" name="description" rows="3" class="form-input resize-none"></textarea></div>
                </div>
            </div>

            <div class="border-t border-slate-100 pt-6">
                <div class="mb-5 flex items-center gap-3">
                    <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-50 text-indigo-500"><i class="fa-solid fa-location-dot"></i></div>
                    <div><h4 class="font-semibold text-slate-700">Localisation</h4><p class="text-xs text-slate-400">Adresse géographique de l'établissement.</p></div>
                </div>
                <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
                    <div><label for="create_province" class="form-label">Province</label><input id="create_province" name="province" type="text" class="form-input"></div>
                    <div><label for="create_ville" class="form-label">Ville</label><input id="create_ville" name="ville" type="text" class="form-input"></div>
                    <div><label for="create_commune" class="form-label">Commune / Territoire</label><input id="create_commune" name="commune" type="text" class="form-input"></div>
                    <div><label for="create_quartier" class="form-label">Quartier</label><input id="create_quartier" name="quartier" type="text" class="form-input"></div>
                    <div class="md:col-span-2"><label for="create_adresse" class="form-label">Adresse complète</label><textarea id="create_adresse" name="adresse" rows="3" class="form-input resize-none"></textarea></div>
                </div>
            </div>

            <div class="mt-7 border-t border-slate-100 pt-6">
                <div class="mb-5 flex items-center gap-3">
                    <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-50 text-emerald-500"><i class="fa-solid fa-user-shield"></i></div>
                    <div><h4 class="font-semibold text-slate-700">Administrateur de l'école</h4><p class="text-xs text-slate-400">Créer un compte ou rattacher un utilisateur existant.</p></div>
                </div>

                <div class="space-y-5">
                    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                        <label class="cursor-pointer rounded-xl border border-slate-200 p-4">
                            <input type="radio" name="admin_mode" value="new" checked class="mr-2">
                            <span class="text-sm font-semibold">Créer un nouveau compte</span>
                            <span class="mt-1 block pl-5 text-xs text-slate-400">Créer l'utilisateur pendant la création de l'école.</span>
                        </label>
                        <label class="cursor-pointer rounded-xl border border-slate-200 p-4">
                            <input type="radio" name="admin_mode" value="existing" class="mr-2">
                            <span class="text-sm font-semibold">Utilisateur existant</span>
                            <span class="mt-1 block pl-5 text-xs text-slate-400">Aucun compte utilisateur ne sera recréé.</span>
                        </label>
                    </div>

                    <div id="existingAdminSection" class="hidden">
                        <label class="form-label">Utilisateur existant *</label>
                        <div class="relative">
                            <input id="create_admin_userSearch" type="text" autocomplete="off"
                                class="form-input"
                                placeholder="Nom, prénom, postnom, email ou téléphone…">
                            <input id="create_admin_userId" name="admin_userId" type="hidden">
                            <div id="create_admin_userResults"
                                class="absolute left-0 right-0 top-full z-30 mt-2 hidden max-h-72 overflow-y-auto rounded-xl border border-slate-200 bg-white shadow-xl"></div>
                        </div>
                        <p id="create_admin_userSelected" class="mt-2 hidden text-xs text-slate-500"></p>
                    </div>

                    <div id="newAdminSection" class="grid grid-cols-1 gap-5 md:grid-cols-2">
                        <div><label for="create_admin_prenom" class="form-label">Prénom *</label><input id="create_admin_prenom" name="admin_prenom" type="text" class="form-input"></div>
                        <div><label for="create_admin_nom" class="form-label">Nom *</label><input id="create_admin_nom" name="admin_nom" type="text" class="form-input"></div>
                        <div><label for="create_admin_postnom" class="form-label">Postnom</label><input id="create_admin_postnom" name="admin_postnom" type="text" class="form-input"></div>
                        <div><label for="create_admin_pseudo" class="form-label">Pseudo</label><input id="create_admin_pseudo" name="admin_pseudo" type="text" class="form-input"></div>
                        <div><label for="create_admin_email" class="form-label">Email administrateur *</label><input id="create_admin_email" name="admin_email" type="email" class="form-input"></div>
                        <div><label for="create_admin_telephone" class="form-label">Téléphone administrateur</label><input id="create_admin_telephone" name="admin_telephone" type="tel" class="form-input"></div>
                        <div><label for="create_admin_password" class="form-label">Mot de passe *</label><input id="create_admin_password" name="admin_password" type="password" minlength="8" class="form-input"></div>
                        <div><label for="create_admin_password_confirmation" class="form-label">Confirmation *</label><input id="create_admin_password_confirmation" name="admin_password_confirmation" type="password" minlength="8" class="form-input"></div>
                    </div>
                </div>
            </div>

            <div id="createFormError" class="mt-6 hidden rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></div>
            <div class="mt-7 flex flex-col-reverse gap-3 border-t border-slate-100 pt-5 sm:flex-row sm:justify-end">
                <button id="cancelCreateButton" type="button" class="rounded-xl border border-slate-200 px-5 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-50">Annuler</button>
                <button id="submitCreateButton" type="submit" class="rounded-xl bg-sky-500 px-5 py-2.5 text-sm font-semibold text-white hover:bg-sky-600">
                    <i class="fa-solid fa-school mr-2"></i>Créer l'école
                </button>
            </div>
        </form>
    </div>
</div>

<!-- =========================================================
     CONFIRMATION MODAL
========================================================== -->

<div
    id="confirmModal"
    class="
        fixed
        inset-0
        z-[110]
        hidden
        items-center
        justify-center
        bg-slate-900/50
        p-4
        opacity-0
        modal-transition
    "
>

    <div
        id="confirmModalContent"
        class="
            w-full
            max-w-md
            rounded-2xl
            bg-white
            shadow-2xl
        "
    >

        <div class="p-6">

            <div
                id="confirmIcon"
                class="
                    mx-auto
                    flex
                    h-14
                    w-14
                    items-center
                    justify-center
                    rounded-2xl
                    bg-amber-50
                    text-amber-500
                "
            >

                <i
                    class="fa-solid fa-triangle-exclamation text-xl"
                ></i>

            </div>


            <div class="mt-5 text-center">

                <h3
                    id="confirmTitle"
                    class="text-lg font-bold text-slate-800"
                >
                    Confirmation
                </h3>


                <p
                    id="confirmMessage"
                    class="
                        mt-2
                        text-sm
                        leading-6
                        text-slate-500
                    "
                >
                    Êtes-vous sûr de vouloir continuer ?
                </p>

            </div>


            <div class="mt-7 flex flex-col gap-3 sm:flex-row">

                <button
                    id="cancelConfirmButton"
                    type="button"
                    class="
                        flex-1
                        rounded-xl
                        border
                        border-slate-200
                        px-4
                        py-3
                        text-sm
                        font-semibold
                        text-slate-600
                        hover:bg-slate-50
                    "
                >
                    Annuler
                </button>


                <button
                    id="confirmActionButton"
                    type="button"
                    class="
                        flex-1
                        rounded-xl
                        bg-amber-500
                        px-4
                        py-3
                        text-sm
                        font-semibold
                        text-white
                        hover:bg-amber-600
                    "
                >
                    Confirmer
                </button>

            </div>

        </div>

    </div>

</div>


