</div>


<!-- =========================================================
     EDIT MODAL
========================================================== -->

<div
    id="editModal"
    class="
        fixed
        inset-0
        z-[105]
        hidden
        items-center
        justify-center
        bg-slate-900/50
        p-4
        opacity-0
        modal-transition
    "
>

    <div
        id="editModalContent"
        class="
            max-h-[92vh]
            w-full
            max-w-3xl
            overflow-y-auto
            rounded-2xl
            bg-white
            shadow-2xl
        "
    >

        <div
            class="
                sticky
                top-0
                z-10
                flex
                items-center
                justify-between
                border-b
                border-slate-100
                bg-white
                px-6
                py-5
            "
        >

            <div>

                <h3 class="text-lg font-bold text-slate-800">
                    Modifier l'école
                </h3>

                <p
                    id="editSchoolSubtitle"
                    class="mt-1 text-sm text-slate-400"
                >
                    —
                </p>

            </div>


            <button
                id="closeEditModal"
                type="button"
                class="
                    flex
                    h-9
                    w-9
                    items-center
                    justify-center
                    rounded-lg
                    text-slate-400
                    hover:bg-slate-100
                "
            >

                <i class="fa-solid fa-xmark"></i>

            </button>

        </div>


        <form
            id="editSchoolForm"
            class="p-6"
        >

            <input
                id="edit_id"
                name="id"
                type="hidden"
            >


            <div
                class="
                    grid
                    grid-cols-1
                    gap-5
                    md:grid-cols-2
                "
            >

                <div class="md:col-span-2">

                    <label
                        for="edit_nom"
                        class="form-label"
                    >
                        Nom de l'école *
                    </label>

                    <input
                        id="edit_nom"
                        name="nom"
                        type="text"
                        required
                        class="form-input"
                    >

                </div>


                <div>

                    <label
                        for="edit_code"
                        class="form-label"
                    >
                        Code *
                    </label>

                    <input
                        id="edit_code"
                        name="code"
                        type="text"
                        required
                        class="form-input"
                    >

                </div>


                <div>

                    <label
                        for="edit_type"
                        class="form-label"
                    >
                        Type
                    </label>

                    <input
                        id="edit_type"
                        name="type"
                        type="text"
                        class="form-input"
                    >

                </div>


                <div>

                    <label
                        for="edit_email"
                        class="form-label"
                    >
                        Email
                    </label>

                    <input
                        id="edit_email"
                        name="email"
                        type="email"
                        class="form-input"
                    >

                </div>


                <div>

                    <label
                        for="edit_telephone"
                        class="form-label"
                    >
                        Téléphone
                    </label>

                    <input
                        id="edit_telephone"
                        name="telephone"
                        type="tel"
                        class="form-input"
                    >

                </div>


                <div>

                    <label
                        for="edit_province"
                        class="form-label"
                    >
                        Province
                    </label>

                    <input
                        id="edit_province"
                        name="province"
                        type="text"
                        class="form-input"
                    >

                </div>


                <div>

                    <label
                        for="edit_ville"
                        class="form-label"
                    >
                        Ville
                    </label>

                    <input
                        id="edit_ville"
                        name="ville"
                        type="text"
                        class="form-input"
                    >

                </div>


                <div>

                    <label
                        for="edit_commune"
                        class="form-label"
                    >
                        Commune
                    </label>

                    <input
                        id="edit_commune"
                        name="commune"
                        type="text"
                        class="form-input"
                    >

                </div>


                <div>

                    <label
                        for="edit_quartier"
                        class="form-label"
                    >
                        Quartier
                    </label>

                    <input
                        id="edit_quartier"
                        name="quartier"
                        type="text"
                        class="form-input"
                    >

                </div>


                <div class="md:col-span-2">

                    <label
                        for="edit_adresse"
                        class="form-label"
                    >
                        Adresse
                    </label>

                    <textarea
                        id="edit_adresse"
                        name="adresse"
                        rows="3"
                        class="form-input resize-none"
                    ></textarea>

                </div>


                <div class="md:col-span-2">

                    <label
                        for="edit_description"
                        class="form-label"
                    >
                        Description
                    </label>

                    <textarea
                        id="edit_description"
                        name="description"
                        rows="3"
                        class="form-input resize-none"
                    ></textarea>

                </div>


                <div>

                    <label
                        for="edit_statut"
                        class="form-label"
                    >
                        Statut
                    </label>

                    <select
                        id="edit_statut"
                        name="statut"
                        class="form-input"
                    >

                        <option value="ACTIF">
                            Active
                        </option>

                        <option value="SUSPENDU">
                            Suspendue
                        </option>

                        <option value="ARCHIVE">
                            Archivée
                        </option>

                    </select>

                </div>


                <div>

                    <label
                        for="edit_siteWeb"
                        class="form-label"
                    >
                        Site web
                    </label>

                    <input
                        id="edit_siteWeb"
                        name="siteWeb"
                        type="url"
                        class="form-input"
                    >

                </div>

            </div>


            <div
                id="editFormError"
                class="
                    mt-6
                    hidden
                    rounded-xl
                    border
                    border-red-200
                    bg-red-50
                    px-4
                    py-3
                    text-sm
                    text-red-700
                "
            ></div>


            <div
                class="
                    mt-7
                    flex
                    justify-end
                    gap-3
                    border-t
                    border-slate-100
                    pt-5
                "
            >

                <button
                    id="cancelEditButton"
                    type="button"
                    class="
                        rounded-xl
                        border
                        border-slate-200
                        px-5
                        py-2.5
                        text-sm
                        font-semibold
                        text-slate-600
                        hover:bg-slate-50
                    "
                >
                    Annuler
                </button>


                <button
                    id="submitEditButton"
                    type="submit"
                    class="
                        rounded-xl
                        bg-indigo-600
                        px-5
                        py-2.5
                        text-sm
                        font-semibold
                        text-white
                        hover:bg-indigo-700
                    "
                >
                    Enregistrer
                </button>

            </div>

        </form>

    </div>

</div>

<script src="/assets/js/super-admin/auth.js"></script>
<script src="/assets/js/super-admin/ecoles.js"></script>

</body>

</html>
</body>
</html>
