                    </p>

                    <p
                        id="detailsUsers"
                        class="
                            mt-1
                            text-xl
                            font-bold
                            text-slate-800
                        "
                    >
                        —
                    </p>

                </div>


                <div class="rounded-xl bg-slate-50 p-4">

                    <p class="text-xs text-slate-400">
                        Classes
                    </p>

                    <p
                        id="detailsClasses"
                        class="
                            mt-1
                            text-xl
                            font-bold
                            text-slate-800
                        "
                    >
                        —
                    </p>

                </div>


                <div class="rounded-xl bg-slate-50 p-4">

                    <p class="text-xs text-slate-400">
                        Statut
                    </p>

                    <p
                        id="detailsStatus"
