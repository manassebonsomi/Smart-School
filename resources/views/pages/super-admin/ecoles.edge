<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Écoles | Smart School</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#38BDF8',
                        primaryDark: '#0284C7',
                        primaryLight: '#E0F2FE',
                        darkBlue: '#0F172A'
                    }
                }
            }
        }
    </script>

    <style>
        body {
            font-family: Inter, ui-sans-serif, system-ui, -apple-system,
                         BlinkMacSystemFont, "Segoe UI", sans-serif;
        }

        .sidebar-transition {
            transition: transform .3s ease-in-out;
        }

        .overlay-transition {
            transition: opacity .3s ease-in-out;
        }

        .modal-transition {
            transition: opacity .2s ease, transform .2s ease;
        }

        .scrollbar-hide::-webkit-scrollbar {
            display: none;
        }

        .scrollbar-hide {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>

<body class="bg-slate-50 text-slate-800">

<!-- ========================================================= -->
<!-- MOBILE OVERLAY -->
<!-- ========================================================= -->

<div
    id="sidebarOverlay"
    class="fixed inset-0 z-40 hidden bg-slate-900/50 opacity-0
           overlay-transition lg:hidden"
></div>

<!-- ========================================================= -->
<!-- SIDEBAR -->
<!-- ========================================================= -->

<aside
    id="sidebar"
    class="fixed inset-y-0 left-0 z-50 w-72 bg-white border-r
           border-slate-200 -translate-x-full sidebar-transition
           lg:translate-x-0"
>

    <!-- Logo -->

    <div class="h-20 px-6 flex items-center border-b border-slate-100">

        <div class="flex items-center gap-3">

            <div
                class="w-11 h-11 rounded-xl bg-sky-500 text-white
                       flex items-center justify-center shadow-sm"
            >
                <i class="fa-solid fa-graduation-cap text-xl"></i>
            </div>

            <div>

                <h1 class="font-bold text-lg text-slate-800">
                    Smart School
                </h1>

                <p class="text-xs text-slate-400">
                    Administration
                </p>

            </div>

        </div>

        <button
            id="closeSidebar"
            class="ml-auto lg:hidden text-slate-400 hover:text-slate-700"
        >
            <i class="fa-solid fa-xmark text-xl"></i>
        </button>

    </div>

    <!-- Navigation -->

    <nav class="px-4 py-6 space-y-2">

        <p
            class="px-3 mb-3 text-xs font-semibold uppercase
                   tracking-wider text-slate-400"
        >
            Administration
        </p>

        <a
            href="/super-admin/dashboard"
            class="flex items-center gap-3 px-4 py-3 rounded-xl
                   text-slate-600 hover:bg-sky-50 hover:text-sky-600 transition"
        >
            <i class="fa-solid fa-chart-pie w-5"></i>
            <span>Dashboard</span>
        </a>

        <!-- ACTIVE -->

        <a
            href="/super-admin/ecoles"
            class="flex items-center gap-3 px-4 py-3 rounded-xl
                   bg-sky-50 text-sky-600 font-semibold"
        >
            <i class="fa-solid fa-school w-5"></i>
            <span>Écoles</span>
        </a>

        <a
            href="/super-admin/utilisateurs"
            class="flex items-center gap-3 px-4 py-3 rounded-xl
                   text-slate-600 hover:bg-sky-50 hover:text-sky-600 transition"
        >
            <i class="fa-solid fa-users w-5"></i>
            <span>Utilisateurs</span>
        </a>

        <a
            href="/super-admin/statistiques"
            class="flex items-center gap-3 px-4 py-3 rounded-xl
                   text-slate-600 hover:bg-sky-50 hover:text-sky-600 transition"
        >
            <i class="fa-solid fa-chart-line w-5"></i>
            <span>Statistiques</span>
        </a>

        <a
            href="/super-admin/rapports"
            class="flex items-center gap-3 px-4 py-3 rounded-xl
                   text-slate-600 hover:bg-sky-50 hover:text-sky-600 transition"
        >
            <i class="fa-solid fa-file-lines w-5"></i>
            <span>Rapports</span>
        </a>

    </nav>

    <!-- Bottom -->

    <div
        class="absolute bottom-0 left-0 right-0 p-4
               border-t border-slate-100"
    >

        <button
            class="w-full flex items-center gap-3 px-4 py-3
                   rounded-xl text-slate-500 hover:bg-slate-50 transition"
        >
            <i class="fa-solid fa-gear w-5"></i>
            <span>Paramètres</span>
        </button>

        <button
            onclick="logout()"
            class="w-full flex items-center gap-3 px-4 py-3
                   rounded-xl text-red-500 hover:bg-red-50 transition"
        >
            <i class="fa-solid fa-right-from-bracket w-5"></i>
            <span>Déconnexion</span>
        </button>

    </div>

</aside>

<!-- ========================================================= -->
<!-- MAIN -->
<!-- ========================================================= -->

<div class="lg:ml-72 min-h-screen">

    <!-- ===================================================== -->
    <!-- HEADER -->
    <!-- ===================================================== -->

    <header
        class="h-20 bg-white border-b border-slate-200
               sticky top-0 z-30"
    >

        <div
            class="h-full px-4 sm:px-6 lg:px-8
                   flex items-center justify-between"
        >

            <div class="flex items-center gap-4">

                <button
                    id="openSidebar"
                    class="lg:hidden w-10 h-10 rounded-lg
                           hover:bg-slate-100 flex items-center
                           justify-center text-slate-600"
                >
                    <i class="fa-solid fa-bars"></i>
                </button>

                <div>

                    <h2 class="text-lg sm:text-xl font-bold text-slate-800">
                        Écoles
                    </h2>

                    <p class="hidden sm:block text-xs sm:text-sm text-slate-400">
                        Gestion des établissements scolaires
                    </p>

                </div>

            </div>

            <div class="flex items-center gap-3">

                <!-- Notifications -->

                <button
                    class="relative w-10 h-10 rounded-xl
                           hover:bg-slate-100 flex items-center
                           justify-center text-slate-500"
                >

                    <i class="fa-regular fa-bell text-lg"></i>

                    <span
                        class="absolute top-2 right-2 w-2 h-2
                               rounded-full bg-red-500 border-2 border-white"
                    ></span>

                </button>

                <!-- Profile -->

                <div
                    class="hidden sm:flex items-center gap-3
                           pl-3 border-l border-slate-200"
                >

                    <div
                        class="w-10 h-10 rounded-full bg-sky-100
                               text-sky-600 flex items-center
                               justify-center font-bold"
                    >
                        SA
                    </div>

                    <div class="hidden md:block">

                        <p class="text-sm font-semibold text-slate-700">
                            Super Admin
                        </p>

                        <p class="text-xs text-slate-400">
                            Administrateur système
                        </p>

                    </div>

                    <i
                        class="fa-solid fa-chevron-down
                               text-xs text-slate-400"
                    ></i>

                </div>

            </div>

        </div>

    </header>

    <!-- ===================================================== -->
    <!-- CONTENT -->
    <!-- ===================================================== -->

    <main class="p-4 sm:p-6 lg:p-8">

        <!-- PAGE TITLE -->

        <div
            class="flex flex-col lg:flex-row lg:items-center
                   lg:justify-between gap-4 mb-8"
        >

            <div>

                <h1 class="text-2xl font-bold text-slate-800">
                    Gestion des écoles
                </h1>

                <p class="mt-1 text-sm text-slate-500">
                    Gérez les établissements enregistrés sur Smart School.
                </p>

            </div>

            <button
                onclick="openCreateModal()"
                class="inline-flex items-center justify-center gap-2
                       px-5 py-3 rounded-xl bg-sky-500
                       hover:bg-sky-600 text-white
                       text-sm font-semibold shadow-sm transition"
            >

                <i class="fa-solid fa-plus"></i>

                Nouvelle école

            </button>

        </div>

        <!-- ================================================= -->
        <!-- SUMMARY -->
        <!-- ================================================= -->

        <section
            class="grid grid-cols-1 sm:grid-cols-2
                   xl:grid-cols-4 gap-5 mb-8"
        >

            <!-- Total -->

            <div
                class="bg-white border border-slate-200
                       rounded-2xl p-5 shadow-sm"
            >

                <div class="flex items-start justify-between">

                    <div>

                        <p class="text-sm text-slate-500">
                            Total écoles
                        </p>

                        <p
                            id="totalSchools"
                            class="mt-2 text-3xl font-bold text-slate-800"
                        >
                            128
                        </p>

                    </div>

                    <div
                        class="w-12 h-12 rounded-xl bg-sky-50
                               text-sky-500 flex items-center
                               justify-center"
                    >
                        <i class="fa-solid fa-school text-xl"></i>
                    </div>

                </div>

                <p class="mt-4 text-xs text-slate-400">
                    Établissements enregistrés
                </p>

            </div>

            <!-- Active -->

            <div
                class="bg-white border border-slate-200
                       rounded-2xl p-5 shadow-sm"
            >

                <div class="flex items-start justify-between">

                    <div>

                        <p class="text-sm text-slate-500">
                            Écoles actives
                        </p>

                        <p class="mt-2 text-3xl font-bold text-slate-800">
                            121
                        </p>

                    </div>

                    <div
                        class="w-12 h-12 rounded-xl bg-emerald-50
                               text-emerald-500 flex items-center
                               justify-center"
                    >
                        <i class="fa-solid fa-circle-check text-xl"></i>
                    </div>

                </div>

                <p class="mt-4 text-xs text-emerald-500 font-medium">
                    94.5% du total
                </p>

            </div>

            <!-- Suspended -->

            <div
                class="bg-white border border-slate-200
                       rounded-2xl p-5 shadow-sm"
            >

                <div class="flex items-start justify-between">

                    <div>

                        <p class="text-sm text-slate-500">
                            Suspendues
                        </p>

                        <p class="mt-2 text-3xl font-bold text-slate-800">
                            7
                        </p>

                    </div>

                    <div
                        class="w-12 h-12 rounded-xl bg-amber-50
                               text-amber-500 flex items-center
                               justify-center"
                    >
                        <i class="fa-solid fa-ban text-xl"></i>
                    </div>

                </div>

                <p class="mt-4 text-xs text-slate-400">
                    Nécessitent une vérification
                </p>

            </div>

            <!-- Students -->

            <div
                class="bg-white border border-slate-200
                       rounded-2xl p-5 shadow-sm"
            >

                <div class="flex items-start justify-between">

                    <div>

                        <p class="text-sm text-slate-500">
                            Élèves inscrits
                        </p>

                        <p class="mt-2 text-3xl font-bold text-slate-800">
                            29,841
                        </p>

                    </div>

                    <div
                        class="w-12 h-12 rounded-xl bg-indigo-50
                               text-indigo-500 flex items-center
                               justify-center"
                    >
                        <i class="fa-solid fa-user-graduate text-xl"></i>
                    </div>

                </div>

                <p class="mt-4 text-xs text-indigo-500 font-medium">
                    Dans tous les établissements
                </p>

            </div>

        </section>

        <!-- ================================================= -->
        <!-- SEARCH / FILTER -->
        <!-- ================================================= -->

        <section
            class="bg-white rounded-2xl border border-slate-200
                   shadow-sm mb-6"
        >

            <div class="p-5 sm:p-6">

                <div
                    class="grid grid-cols-1 md:grid-cols-2
                           xl:grid-cols-5 gap-4"
                >

                    <!-- Search -->

                    <div class="xl:col-span-2">

                        <label
                            class="block text-xs font-semibold
                                   text-slate-500 mb-2"
                        >
                            Rechercher une école
                        </label>

                        <div class="relative">

                            <i
                                class="fa-solid fa-magnifying-glass
                                       absolute left-3 top-1/2
                                       -translate-y-1/2
                                       text-slate-400"
                            ></i>

                            <input
                                id="searchInput"
                                type="text"
                                placeholder="Nom, ville, email..."
                                class="w-full pl-10 pr-4 py-3 rounded-xl
                                       border border-slate-200
                                       bg-slate-50 text-sm outline-none
                                       focus:ring-2 focus:ring-sky-200
                                       focus:border-sky-400"
                            >

                        </div>

                    </div>

                    <!-- Status -->

                    <div>

                        <label
                            class="block text-xs font-semibold
                                   text-slate-500 mb-2"
                        >
                            Statut
                        </label>

                        <select
                            id="statusFilter"
                            class="w-full px-4 py-3 rounded-xl
                                   border border-slate-200
                                   bg-slate-50 text-sm outline-none
                                   focus:ring-2 focus:ring-sky-200
                                   focus:border-sky-400"
                        >

                            <option value="">
                                Tous
                            </option>

                            <option value="active">
                                Active
                            </option>

                            <option value="suspended">
                                Suspendue
                            </option>

                        </select>

                    </div>

                    <!-- Province -->

                    <div>

                        <label
                            class="block text-xs font-semibold
                                   text-slate-500 mb-2"
                        >
                            Province
                        </label>

                        <select
                            id="provinceFilter"
                            class="w-full px-4 py-3 rounded-xl
                                   border border-slate-200
                                   bg-slate-50 text-sm outline-none
                                   focus:ring-2 focus:ring-sky-200
                                   focus:border-sky-400"
                        >

                            <option value="">
                                Toutes
                            </option>

                            <option value="kinshasa">
                                Kinshasa
                            </option>

                            <option value="kongo-central">
                                Kongo-Central
                            </option>

                            <option value="haut-katanga">
                                Haut-Katanga
                            </option>

                            <option value="lualaba">
                                Lualaba
                            </option>

                        </select>

                    </div>

                    <!-- Reset -->

                    <div class="flex items-end">

                        <button
                            onclick="resetFilters()"
                            class="w-full px-4 py-3 rounded-xl
                                   border border-slate-200
                                   text-sm font-semibold
                                   text-slate-600 hover:bg-slate-50
                                   transition"
                        >

                            <i class="fa-solid fa-rotate-left mr-2"></i>

                            Réinitialiser

                        </button>

                    </div>

                </div>

            </div>

        </section>

        <!-- ================================================= -->
        <!-- TABLE -->
        <!-- ================================================= -->

        <section
            class="bg-white rounded-2xl border border-slate-200
                   shadow-sm overflow-hidden"
        >

            <!-- Table header -->

            <div
                class="p-5 sm:p-6 border-b border-slate-100
                       flex flex-col sm:flex-row
                       sm:items-center sm:justify-between gap-3"
            >

                <div>

                    <h2 class="font-bold text-slate-800">
                        Liste des écoles
                    </h2>

                    <p class="text-sm text-slate-400 mt-1">
                        Établissements enregistrés sur la plateforme.
                    </p>

                </div>

                <span
                    id="resultCount"
                    class="inline-flex w-fit px-3 py-1.5
                           rounded-full bg-slate-100
                           text-xs font-semibold text-slate-500"
                >
                    8 écoles
                </span>

            </div>

            <!-- Table -->

            <div class="overflow-x-auto scrollbar-hide">

                <table class="w-full min-w-[1100px]">

                    <thead class="bg-slate-50 border-b border-slate-100">

                        <tr>

                            <th
                                class="px-6 py-4 text-left text-xs
                                       font-semibold uppercase
                                       tracking-wider text-slate-400"
                            >
                                École
                            </th>

                            <th
                                class="px-6 py-4 text-left text-xs
                                       font-semibold uppercase
                                       tracking-wider text-slate-400"
                            >
                                Localisation
                            </th>

                            <th
                                class="px-6 py-4 text-left text-xs
                                       font-semibold uppercase
                                       tracking-wider text-slate-400"
                            >
                                Élèves
                            </th>

                            <th
                                class="px-6 py-4 text-left text-xs
                                       font-semibold uppercase
                                       tracking-wider text-slate-400"
                            >
                                Administrateur
                            </th>

                            <th
                                class="px-6 py-4 text-left text-xs
                                       font-semibold uppercase
                                       tracking-wider text-slate-400"
                            >
                                Création
                            </th>

                            <th
                                class="px-6 py-4 text-left text-xs
                                       font-semibold uppercase
                                       tracking-wider text-slate-400"
                            >
                                Statut
                            </th>

                            <th
                                class="px-6 py-4 text-right text-xs
                                       font-semibold uppercase
                                       tracking-wider text-slate-400"
                            >
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody
                        id="schoolsTable"
                        class="divide-y divide-slate-100"
                    >

                        <!-- SCHOOL 1 -->

                        <tr
                            class="school-row hover:bg-slate-50 transition"
                            data-name="Complexe Scolaire La Réussite"
                            data-city="Kinshasa"
                            data-province="kinshasa"
                            data-status="active"
                        >

                            <td class="px-6 py-4">

                                <div class="flex items-center gap-3">

                                    <div
                                        class="w-11 h-11 rounded-xl
                                               bg-sky-50 text-sky-600
                                               flex items-center
                                               justify-center shrink-0"
                                    >
                                        <i class="fa-solid fa-school"></i>
                                    </div>

                                    <div>

                                        <p class="text-sm font-semibold text-slate-700">
                                            Complexe Scolaire La Réussite
                                        </p>

                                        <p class="text-xs text-slate-400 mt-1">
                                            SCH-0001
                                        </p>

                                    </div>

                                </div>

                            </td>

                            <td class="px-6 py-4">

                                <p class="text-sm text-slate-600">
                                    Kinshasa
                                </p>

                                <p class="text-xs text-slate-400 mt-1">
                                    Limete
                                </p>

                            </td>

                            <td class="px-6 py-4">

                                <span class="text-sm font-semibold text-slate-700">
                                    1,248
                                </span>

                            </td>

                            <td class="px-6 py-4">

                                <p class="text-sm font-medium text-slate-700">
                                    Jean Kabasele
                                </p>

                                <p class="text-xs text-slate-400 mt-1">
                                    admin@lareussite.cd
                                </p>

                            </td>

                            <td class="px-6 py-4 text-sm text-slate-500">
                                12 Jan. 2026
                            </td>

                            <td class="px-6 py-4">

                                <span
                                    class="inline-flex items-center gap-1.5
                                           px-2.5 py-1 rounded-full
                                           bg-emerald-50 text-emerald-600
                                           text-xs font-semibold"
                                >

                                    <span
                                        class="w-1.5 h-1.5 rounded-full
                                               bg-emerald-500"
                                    ></span>

                                    Active

                                </span>

                            </td>

                            <td class="px-6 py-4">

                                <div class="flex justify-end gap-2">

                                    <button
                                        onclick="viewSchool('Complexe Scolaire La Réussite')"
                                        title="Détails"
                                        class="action-btn text-sky-600 hover:bg-sky-50"
                                    >
                                        <i class="fa-regular fa-eye"></i>
                                    </button>

                                    <button
                                        onclick="editSchool('Complexe Scolaire La Réussite')"
                                        title="Modifier"
                                        class="action-btn text-indigo-600 hover:bg-indigo-50"
                                    >
                                        <i class="fa-solid fa-pen"></i>
                                    </button>

                                    <button
                                        onclick="suspendSchool('Complexe Scolaire La Réussite')"
                                        title="Suspendre"
                                        class="action-btn text-amber-600 hover:bg-amber-50"
                                    >
                                        <i class="fa-solid fa-ban"></i>
                                    </button>

                                    <button
                                        onclick="deleteSchool('Complexe Scolaire La Réussite')"
                                        title="Supprimer"
                                        class="action-btn text-red-600 hover:bg-red-50"
                                    >
                                        <i class="fa-regular fa-trash-can"></i>
                                    </button>

                                </div>

                            </td>

                        </tr>

                        <!-- SCHOOL 2 -->

                        <tr
                            class="school-row hover:bg-slate-50 transition"
                            data-name="Collège Saint Pierre"
                            data-city="Kinshasa"
                            data-province="kinshasa"
                            data-status="active"
                        >

                            <td class="px-6 py-4">

                                <div class="flex items-center gap-3">

                                    <div
                                        class="w-11 h-11 rounded-xl bg-indigo-50
                                               text-indigo-600 flex items-center
                                               justify-center shrink-0"
                                    >
                                        <i class="fa-solid fa-school"></i>
                                    </div>

                                    <div>

                                        <p class="text-sm font-semibold text-slate-700">
                                            Collège Saint Pierre
                                        </p>

                                        <p class="text-xs text-slate-400 mt-1">
                                            SCH-0002
                                        </p>

                                    </div>

                                </div>

                            </td>

                            <td class="px-6 py-4">
                                <p class="text-sm text-slate-600">
                                    Kinshasa
                                </p>
                                <p class="text-xs text-slate-400 mt-1">
                                    Gombe
                                </p>
                            </td>

                            <td class="px-6 py-4">
                                <span class="text-sm font-semibold text-slate-700">
                                    936
                                </span>
                            </td>

                            <td class="px-6 py-4">
                                <p class="text-sm font-medium text-slate-700">
                                    Marie Ilunga
                                </p>
                                <p class="text-xs text-slate-400 mt-1">
                                    admin@saintpierre.cd
                                </p>
                            </td>

                            <td class="px-6 py-4 text-sm text-slate-500">
                                24 Jan. 2026
                            </td>

                            <td class="px-6 py-4">

                                <span
                                    class="inline-flex items-center gap-1.5
                                           px-2.5 py-1 rounded-full
                                           bg-emerald-50 text-emerald-600
                                           text-xs font-semibold"
                                >
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                    Active
                                </span>

                            </td>

                            <td class="px-6 py-4">

                                <div class="flex justify-end gap-2">

                                    <button
                                        onclick="viewSchool('Collège Saint Pierre')"
                                        title="Détails"
                                        class="action-btn text-sky-600 hover:bg-sky-50"
                                    >
                                        <i class="fa-regular fa-eye"></i>
                                    </button>

                                    <button
                                        onclick="editSchool('Collège Saint Pierre')"
                                        title="Modifier"
                                        class="action-btn text-indigo-600 hover:bg-indigo-50"
                                    >
                                        <i class="fa-solid fa-pen"></i>
                                    </button>

                                    <button
                                        onclick="suspendSchool('Collège Saint Pierre')"
                                        title="Suspendre"
                                        class="action-btn text-amber-600 hover:bg-amber-50"
                                    >
