                    flex
                    h-9
                    w-9
                    items-center
                    justify-center
                    rounded-lg
                    text-slate-400
                    hover:bg-slate-100
                "
            >

                <i class="fa-solid fa-xmark"></i>

            </button>

        </div>


        <div class="p-6">


            <div
                class="
                    grid
                    grid-cols-2
                    gap-4
                    sm:grid-cols-4
                "
            >

                <div class="rounded-xl bg-slate-50 p-4">

