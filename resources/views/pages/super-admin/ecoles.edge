                </div>

            </div>


            <div
                class="
                    mt-6
                    overflow-hidden
                    rounded-xl
                    border
                    border-slate-200
                "
            >

                <div
                    class="
                        border-b
                        border-slate-100
                        px-5
                        py-4
                    "
                >

                    <h4 class="font-semibold text-slate-700">
                        Informations de l'établissement
                    </h4>

                </div>


                <div
                    class="
                        grid
                        grid-cols-1
                        sm:grid-cols-2
                    "
                >

                    <div class="border-b border-slate-100 p-5">
                        <p class="text-xs text-slate-400">
                            Province
                        </p>

                        <p
                            id="detailsProvince"
