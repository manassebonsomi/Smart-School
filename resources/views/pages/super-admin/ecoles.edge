<!-- CREATE SCHOOL MODAL -->
<!-- ========================================================= -->

<div
    id="createModal"
    class="fixed inset-0 z-[100] hidden items-center justify-center
           bg-slate-900/50 p-4 opacity-0 modal-transition"
>

    <div
        id="createModalContent"
        class="w-full max-w-3xl max-h-[90vh] overflow-y-auto
               bg-white rounded-2xl shadow-2xl scale-95
               modal-transition"
    >

        <!-- Header -->

        <div
            class="sticky top-0 bg-white z-10 px-6 py-5
                   border-b border-slate-100
                   flex items-center justify-between"
        >

            <div>

                <h3 class="text-lg font-bold text-slate-800">
                    Nouvelle école
                </h3>

                <p class="text-sm text-slate-400 mt-1">
                    Enregistrer un nouvel établissement.
                </p>

            </div>

            <button
                onclick="closeCreateModal()"
                class="w-9 h-9 rounded-lg hover:bg-slate-100
                       text-slate-400"
            >
                <i class="fa-solid fa-xmark"></i>
            </button>

        </div>

        <!-- Form -->

        <form
            onsubmit="createSchool(event)"
            class="p-6"
        >

            <div class="mb-6">

                <div class="flex items-center gap-3 mb-4">

                    <div
                        class="w-10 h-10 rounded-xl bg-sky-50
                               text-sky-500 flex items-center
                               justify-center"
                    >
                        <i class="fa-solid fa-school"></i>
                    </div>

                    <div>

                        <h4 class="font-semibold text-slate-700">
                            Informations générales
                        </h4>

                        <p class="text-xs text-slate-400">
                            Informations principales de l'établissement.
                        </p>

                    </div>

                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                    <div class="md:col-span-2">

                        <label class="form-label">
                            Nom de l'école *
                        </label>

                        <input
                            type="text"
                            required
                            placeholder="Ex : Complexe Scolaire La Réussite"
                            class="form-input"
                        >

                    </div>

                    <div>

                        <label class="form-label">
                            Type d'établissement *
                        </label>

                        <select required class="form-input">

                            <option value="">
                                Sélectionner
                            </option>

                            <option>
                                École primaire
                            </option>

                            <option>
                                École secondaire
                            </option>

                            <option>
                                École primaire et secondaire
                            </option>

                            <option>
                                Institut technique
                            </option>

                            <option>
                                Établissement supérieur
                            </option>

                        </select>

                    </div>

                    <div>

                        <label class="form-label">
                            Téléphone
                        </label>

                        <input
                            type="tel"
                            placeholder="+243 ..."
                            class="form-input"
                        >

                    </div>

                    <div>

                        <label class="form-label">
                            Email
                        </label>

                        <input
                            type="email"
                            placeholder="contact@ecole.cd"
                            class="form-input"
                        >

                    </div>

                    <div>

                        <label class="form-label">
                            Site web
                        </label>

                        <input
                            type="url"
                            placeholder="https://..."
                            class="form-input"
                        >

                    </div>

                </div>

            </div>

            <!-- Location -->

            <div class="pt-6 border-t border-slate-100">

                <div class="flex items-center gap-3 mb-4">

                    <div
                        class="w-10 h-10 rounded-xl bg-indigo-50
                               text-indigo-500 flex items-center
                               justify-center"
                    >
                        <i class="fa-solid fa-location-dot"></i>
                    </div>

                    <div>

                        <h4 class="font-semibold text-slate-700">
                            Localisation
                        </h4>

                        <p class="text-xs text-slate-400">
                            Adresse géographique de l'établissement.
                        </p>

                    </div>

                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                    <div>

                        <label class="form-label">
                            Province *
                        </label>

                        <select required class="form-input">

                            <option value="">
                                Sélectionner
                            </option>

                            <option>
                                Kinshasa
                            </option>

                            <option>
                                Kongo-Central
                            </option>

                            <option>
                                Haut-Katanga
                            </option>

                            <option>
                                Lualaba
                            </option>

                            <option>
                                Autre
                            </option>

                        </select>

                    </div>

                    <div>

                        <label class="form-label">
                            Ville *
                        </label>

                        <input
                            type="text"
                            required
                            placeholder="Ex : Kinshasa"
                            class="form-input"
                        >

                    </div>

                    <div>

                        <label class="form-label">
                            Commune / Territoire
                        </label>

                        <input
                            type="text"
                            placeholder="Ex : Limete"
                            class="form-input"
                        >

                    </div>

                    <div>

                        <label class="form-label">
                            Quartier
                        </label>

                        <input
                            type="text"
                            placeholder="Ex : Kingabwa"
                            class="form-input"
                        >

                    </div>

                    <div class="md:col-span-2">

                        <label class="form-label">
                            Adresse complète
                        </label>

                        <textarea
                            rows="3"
                            placeholder="Adresse de l'établissement..."
                            class="form-input resize-none"
                        ></textarea>

                    </div>

                </div>

            </div>

            <!-- Admin -->

            <div class="pt-6 border-t border-slate-100 mt-6">

                <div class="flex items-center gap-3 mb-4">

                    <div
                        class="w-10 h-10 rounded-xl bg-emerald-50
                               text-emerald-500 flex items-center
                               justify-center"
                    >
                        <i class="fa-solid fa-user-shield"></i>
                    </div>

                    <div>

                        <h4 class="font-semibold text-slate-700">
                            Administrateur de l'école
                        </h4>

                        <p class="text-xs text-slate-400">
                            Compte principal de gestion de l'établissement.
                        </p>

                    </div>

                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                    <div>

                        <label class="form-label">
                            Prénom *
                        </label>

                        <input
                            type="text"
                            required
                            placeholder="Prénom"
                            class="form-input"
                        >

                    </div>

                    <div>

                        <label class="form-label">
                            Nom *
                        </label>

                        <input
                            type="text"
                            required
                            placeholder="Nom"
                            class="form-input"
                        >

                    </div>

                    <div>

                        <label class="form-label">
                            Email administrateur *
                        </label>

                        <input
                            type="email"
                            required
                            placeholder="admin@ecole.cd"
                            class="form-input"
                        >

                    </div>

                    <div>

                        <label class="form-label">
                            Téléphone administrateur
                        </label>

                        <input
                            type="tel"
                            placeholder="+243 ..."
                            class="form-input"
                        >

                    </div>

                </div>

            </div>

            <!-- Footer -->

            <div
                class="mt-7 pt-5 border-t border-slate-100
                       flex flex-col-reverse sm:flex-row
                       sm:justify-end gap-3"
            >

                <button
                    type="button"
                    onclick="closeCreateModal()"
                    class="px-5 py-2.5 rounded-xl
                           border border-slate-200
                           text-sm font-semibold text-slate-600
                           hover:bg-slate-50"
                >
                    Annuler
                </button>

                <button
                    type="submit"
                    class="px-5 py-2.5 rounded-xl
                           bg-sky-500 hover:bg-sky-600
                           text-white text-sm font-semibold"
                >

                    <i class="fa-solid fa-school mr-2"></i>

                    Créer l'école

                </button>

            </div>

        </form>

    </div>

</div>

<!-- ========================================================= -->
<!-- CONFIRMATION MODAL -->
<!-- ========================================================= -->

<div
    id="confirmModal"
    class="fixed inset-0 z-[110] hidden items-center
           justify-center bg-slate-900/50 p-4 opacity-0
           modal-transition"
>

    <div
        id="confirmModalContent"
        class="w-full max-w-md bg-white rounded-2xl
               shadow-2xl scale-95 modal-transition"
    >

        <div class="p-6">

            <div
                id="confirmIcon"
                class="w-14 h-14 rounded-2xl mx-auto
                       flex items-center justify-center
                       bg-amber-50 text-amber-500"
            >
                <i class="fa-solid fa-triangle-exclamation text-xl"></i>
            </div>

            <div class="text-center mt-5">

                <h3
                    id="confirmTitle"
                    class="text-lg font-bold text-slate-800"
                >
                    Confirmation
                </h3>

                <p
                    id="confirmMessage"
                    class="text-sm text-slate-500
                           leading-6 mt-2"
                >
                    Êtes-vous sûr de vouloir continuer ?
                </p>

            </div>

            <div class="flex flex-col sm:flex-row gap-3 mt-7">

                <button
                    onclick="closeConfirmModal()"
                    class="flex-1 px-4 py-3 rounded-xl
                           border border-slate-200
                           text-sm font-semibold
                           text-slate-600 hover:bg-slate-50"
                >
                    Annuler
                </button>

                <button
                    id="confirmActionButton"
                    class="flex-1 px-4 py-3 rounded-xl
                           bg-amber-500 hover:bg-amber-600
                           text-white text-sm font-semibold"
                >
                    Confirmer
                </button>

            </div>

        </div>

    </div>

</div>

<!-- ========================================================= -->
<!-- SCHOOL DETAILS MODAL -->
<!-- ========================================================= -->

<div
    id="detailsModal"
    class="fixed inset-0 z-[100] hidden items-center
           justify-center bg-slate-900/50 p-4 opacity-0
           modal-transition"
>

    <div
        id="detailsModalContent"
        class="w-full max-w-3xl max-h-[90vh]
               overflow-y-auto bg-white rounded-2xl
               shadow-2xl scale-95 modal-transition"
    >

        <!-- Header -->

        <div
            class="sticky top-0 bg-white z-10
                   px-6 py-5 border-b border-slate-100
                   flex items-center justify-between"
        >

            <div class="flex items-center gap-3">

                <div
                    class="w-12 h-12 rounded-xl bg-sky-50
                           text-sky-600 flex items-center
                           justify-center"
                >
                    <i class="fa-solid fa-school text-xl"></i>
                </div>

                <div>

                    <h3
                        id="detailsSchoolName"
                        class="font-bold text-slate-800"
                    >
                        École
                    </h3>

                    <p
                        id="detailsSchoolId"
                        class="text-xs text-slate-400 mt-1"
                    >
                        SCH-0000
                    </p>

                </div>

            </div>

            <button
                onclick="closeDetailsModal()"
                class="w-9 h-9 rounded-lg hover:bg-slate-100
                       text-slate-400"
            >
                <i class="fa-solid fa-xmark"></i>
            </button>

        </div>

        <div class="p-6">

            <!-- Quick stats -->

            <div
                class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6"
            >

                <div class="bg-slate-50 rounded-xl p-4">
                    <p class="text-xs text-slate-400">
                        Élèves
                    </p>
                    <p class="text-xl font-bold text-slate-800 mt-1">
                        1,248
                    </p>
                </div>

                <div class="bg-slate-50 rounded-xl p-4">
                    <p class="text-xs text-slate-400">
                        Enseignants
                    </p>
                    <p class="text-xl font-bold text-slate-800 mt-1">
                        84
                    </p>
                </div>

                <div class="bg-slate-50 rounded-xl p-4">
                    <p class="text-xs text-slate-400">
                        Classes
                    </p>
                    <p class="text-xl font-bold text-slate-800 mt-1">
                        36
                    </p>
                </div>

                <div class="bg-slate-50 rounded-xl p-4">
                    <p class="text-xs text-slate-400">
                        Statut
                    </p>
                    <p class="text-sm font-semibold text-emerald-600 mt-2">
                        Active
                    </p>
                </div>

            </div>

            <!-- Information -->

            <div
                class="border border-slate-200 rounded-xl
                       overflow-hidden"
            >

                <div
                    class="px-5 py-4 border-b border-slate-100"
                >

                    <h4 class="font-semibold text-slate-700">
                        Informations de l'établissement
                    </h4>

                </div>

                <div
                    class="grid grid-cols-1 sm:grid-cols-2
                           divide-y sm:divide-y-0"
                >

                    <div class="p-5">

                        <p class="text-xs text-slate-400">
                            Province
                        </p>

                        <p class="text-sm font-medium text-slate-700 mt-1">
                            Kinshasa
                        </p>

                    </div>

                    <div class="p-5">

                        <p class="text-xs text-slate-400">
                            Ville
                        </p>

                        <p class="text-sm font-medium text-slate-700 mt-1">
                            Kinshasa
                        </p>

                    </div>

                    <div class="p-5 border-t border-slate-100">

                        <p class="text-xs text-slate-400">
                            Commune
                        </p>

                        <p class="text-sm font-medium text-slate-700 mt-1">
                            Limete
                        </p>

                    </div>

                    <div class="p-5 border-t border-slate-100">

                        <p class="text-xs text-slate-400">
                            Date de création
                        </p>

                        <p class="text-sm font-medium text-slate-700 mt-1">
                            12 Janvier 2026
                        </p>

                    </div>

                    <div class="p-5 border-t border-slate-100">

                        <p class="text-xs text-slate-400">
                            Email
                        </p>

                        <p class="text-sm font-medium text-slate-700 mt-1">
                            admin@lareussite.cd
                        </p>

                    </div>

                    <div class="p-5 border-t border-slate-100">

                        <p class="text-xs text-slate-400">
                            Téléphone
                        </p>

                        <p class="text-sm font-medium text-slate-700 mt-1">
                            +243 81 000 00 00
                        </p>

                    </div>

                </div>

            </div>

            <!-- Administrator -->

            <div class="mt-6">

                <h4 class="font-semibold text-slate-700 mb-3">
                    Administrateur
                </h4>

                <div
                    class="flex items-center gap-4
                           p-4 rounded-xl bg-slate-50"
                >

                    <div
                        class="w-11 h-11 rounded-full bg-sky-100
                               text-sky-600 flex items-center
                               justify-center font-bold"
                    >
                        JK
                    </div>

                    <div>

                        <p class="text-sm font-semibold text-slate-700">
                            Jean Kabasele
                        </p>

                        <p class="text-xs text-slate-400 mt-1">
                            admin@lareussite.cd
                        </p>

                    </div>

                </div>

            </div>

        </div>

        <div
            class="px-6 py-4 border-t border-slate-100
                   flex justify-end"
        >

            <button
                onclick="closeDetailsModal()"
                class="px-5 py-2.5 rounded-xl
                       bg-slate-100 hover:bg-slate-200
                       text-sm font-semibold text-slate-600"
            >
                Fermer
            </button>

        </div>

    </div>

</div>

<!-- ========================================================= -->
<!-- JAVASCRIPT -->
<!-- ========================================================= -->

<script>

    /* =========================================================
       COMMON STYLES
    ========================================================= */

    const style = document.createElement("style");

    style.innerHTML = `
        .action-btn {
            width: 36px;
            height: 36px;
            border-radius: 9px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #f8fafc;
            transition: .2s ease;
        }

        .form-label {
            display: block;
            margin-bottom: .5rem;
            font-size: .75rem;
            line-height: 1rem;
            font-weight: 600;
            color: #64748b;
        }

        .form-input {
            width: 100%;
            padding: .75rem 1rem;
            border-radius: .75rem;
            border: 1px solid #e2e8f0;
            background: #f8fafc;
            font-size: .875rem;
            outline: none;
        }

        .form-input:focus {
            border-color: #38bdf8;
            box-shadow: 0 0 0 3px rgba(56,189,248,.15);
        }
    `;

    document.head.appendChild(style);

    /* =========================================================
       SIDEBAR
    ========================================================= */

    const sidebar =
        document.getElementById("sidebar");

    const sidebarOverlay =
        document.getElementById("sidebarOverlay");

    document
        .getElementById("openSidebar")
        .addEventListener("click", () => {

            sidebar.classList.remove("-translate-x-full");

            sidebarOverlay.classList.remove("hidden");

            setTimeout(() => {
                sidebarOverlay.classList.remove("opacity-0");
            }, 10);

        });

    function hideSidebar() {

        sidebar.classList.add("-translate-x-full");

        sidebarOverlay.classList.add("opacity-0");

        setTimeout(() => {

            sidebarOverlay.classList.add("hidden");

        }, 300);

    }

    document
        .getElementById("closeSidebar")
        .addEventListener("click", hideSidebar);

    sidebarOverlay.addEventListener("click", hideSidebar);

    /* =========================================================
       CREATE MODAL
    ========================================================= */

    const createModal =
        document.getElementById("createModal");

    const createModalContent =
        document.getElementById("createModalContent");

    function openCreateModal() {

        createModal.classList.remove("hidden");

        createModal.classList.add("flex");

        setTimeout(() => {

            createModal.classList.remove("opacity-0");

            createModalContent.classList.remove("scale-95");

            createModalContent.classList.add("scale-100");

        }, 10);

    }

    function closeCreateModal() {

        createModal.classList.add("opacity-0");

        createModalContent.classList.remove("scale-100");

        createModalContent.classList.add("scale-95");

        setTimeout(() => {

            createModal.classList.remove("flex");

            createModal.classList.add("hidden");

        }, 200);

    }

    function createSchool(event) {

        event.preventDefault();

        /*
         * Plus tard :
         *
         * POST /api/super-admin/schools
         *
         * Les données du formulaire seront envoyées
         * au backend AdonisJS.
         */

        closeCreateModal();

        alert(
            "L'école sera créée via l'API AdonisJS."
        );

    }

    /* =========================================================
       DETAILS MODAL
    ========================================================= */

    const detailsModal =
        document.getElementById("detailsModal");

    const detailsModalContent =
        document.getElementById("detailsModalContent");

    function viewSchool(name) {

        document.getElementById(
            "detailsSchoolName"
        ).textContent = name;

        detailsModal.classList.remove("hidden");

        detailsModal.classList.add("flex");

        setTimeout(() => {

            detailsModal.classList.remove("opacity-0");

            detailsModalContent.classList.remove("scale-95");

            detailsModalContent.classList.add("scale-100");

        }, 10);

    }

    function closeDetailsModal() {

        detailsModal.classList.add("opacity-0");

        detailsModalContent.classList.remove("scale-100");

        detailsModalContent.classList.add("scale-95");

        setTimeout(() => {

            detailsModal.classList.remove("flex");

            detailsModal.classList.add("hidden");

        }, 200);

    }

    /* =========================================================
       CONFIRMATION MODAL
    ========================================================= */

    const confirmModal =
        document.getElementById("confirmModal");

    const confirmModalContent =
        document.getElementById("confirmModalContent");

    let confirmCallback = null;

    function openConfirmModal(
        title,
        message,
        callback,
        type = "warning"
    ) {

        document.getElementById(
            "confirmTitle"
        ).textContent = title;

        document.getElementById(
            "confirmMessage"
        ).textContent = message;

        const button =
            document.getElementById(
                "confirmActionButton"
            );

        const icon =
            document.getElementById(
                "confirmIcon"
            );

        confirmCallback = callback;

        if (type === "danger") {

            button.className =
                "flex-1 px-4 py-3 rounded-xl bg-red-500 " +
                "hover:bg-red-600 text-white text-sm font-semibold";

            button.textContent = "Supprimer";

            icon.className =
                "w-14 h-14 rounded-2xl mx-auto flex items-center " +
                "justify-center bg-red-50 text-red-500";

            icon.innerHTML =
                '<i class="fa-solid fa-trash text-xl"></i>';

        } else if (type === "success") {

            button.className =
                "flex-1 px-4 py-3 rounded-xl bg-emerald-500 " +
                "hover:bg-emerald-600 text-white text-sm font-semibold";

            button.textContent = "Réactiver";

            icon.className =
                "w-14 h-14 rounded-2xl mx-auto flex items-center " +
                "justify-center bg-emerald-50 text-emerald-500";

            icon.innerHTML =
                '<i class="fa-solid fa-check text-xl"></i>';

        } else {

            button.className =
                "flex-1 px-4 py-3 rounded-xl bg-amber-500 " +
                "hover:bg-amber-600 text-white text-sm font-semibold";

            button.textContent = "Confirmer";

            icon.className =
                "w-14 h-14 rounded-2xl mx-auto flex items-center " +
                "justify-center bg-amber-50 text-amber-500";

            icon.innerHTML =
                '<i class="fa-solid fa-triangle-exclamation text-xl"></i>';

        }

        confirmModal.classList.remove("hidden");

        confirmModal.classList.add("flex");

        setTimeout(() => {

            confirmModal.classList.remove("opacity-0");

            confirmModalContent.classList.remove("scale-95");

            confirmModalContent.classList.add("scale-100");

        }, 10);

    }

    function closeConfirmModal() {

        confirmModal.classList.add("opacity-0");

        confirmModalContent.classList.remove("scale-100");

        confirmModalContent.classList.add("scale-95");

        setTimeout(() => {

            confirmModal.classList.remove("flex");

            confirmModal.classList.add("hidden");

            confirmCallback = null;

        }, 200);

    }

    document
        .getElementById("confirmActionButton")
        .addEventListener("click", () => {

            if (typeof confirmCallback === "function") {

                confirmCallback();

            }

            closeConfirmModal();

        });

    /* =========================================================
       SCHOOL ACTIONS
    ========================================================= */

    function editSchool(name) {

        /*
         * Plus tard :
         *
         * window.location.href =
         * `/super-admin/ecoles/${schoolId}/edit`;
         */

        alert(
            "Ouverture du formulaire de modification pour :\n\n" +
            name
        );

    }

    function suspendSchool(name) {

        openConfirmModal(
            "Suspendre l'école ?",
            "L'école « " + name +
            " » ne pourra plus utiliser normalement la plateforme " +
            "tant qu'elle sera suspendue.",
            () => {

                /*
                 * PATCH /api/super-admin/schools/:id/suspend
                 */

                alert(
                    "L'école sera suspendue via AdonisJS."
                );

            }
        );

    }

    function activateSchool(name) {

        openConfirmModal(
            "Réactiver l'école ?",
            "L'école « " + name +
            " » sera de nouveau active sur la plateforme.",
            () => {

                /*
                 * PATCH /api/super-admin/schools/:id/activate
                 */

                alert(
                    "L'école sera réactivée via AdonisJS."
                );

            },
            "success"
        );

    }

    function deleteSchool(name) {

        openConfirmModal(
            "Supprimer définitivement ?",
            "Cette action supprimera l'école « " +
            name +
            " ». Cette opération devra être confirmée par le backend.",
            () => {

                /*
                 * DELETE /api/super-admin/schools/:id
                 */

                alert(
                    "L'école sera supprimée via AdonisJS."
                );

            },
            "danger"
        );

    }

    /* =========================================================
       SEARCH / FILTER
    ========================================================= */

    const searchInput =
        document.getElementById("searchInput");

    const statusFilter =
        document.getElementById("statusFilter");

    const provinceFilter =
        document.getElementById("provinceFilter");

    const schoolRows =
        document.querySelectorAll(".school-row");

    const emptyState =
        document.getElementById("emptyState");

    const resultCount =
        document.getElementById("resultCount");

    function filterSchools() {

        const search =
            searchInput.value
                .toLowerCase()
                .trim();

        const status =
            statusFilter.value;

        const province =
            provinceFilter.value;

        let visible = 0;

        schoolRows.forEach(row => {

            const name =
                row.dataset.name.toLowerCase();

            const city =
                row.dataset.city.toLowerCase();

            const rowStatus =
                row.dataset.status;

            const rowProvince =
                row.dataset.province;

            const matchesSearch =
                !search ||
                name.includes(search) ||
                city.includes(search);

            const matchesStatus =
                !status ||
                rowStatus === status;

            const matchesProvince =
                !province ||
                rowProvince === province;

            const show =
                matchesSearch &&
                matchesStatus &&
                matchesProvince;

            if (show) {

                row.classList.remove("hidden");

                visible++;

            } else {

                row.classList.add("hidden");

            }

        });

        resultCount.textContent =
            visible +
            (visible > 1 ? " écoles" : " école");

        if (visible === 0) {

            emptyState.classList.remove("hidden");

        } else {

            emptyState.classList.add("hidden");

        }

    }

    searchInput.addEventListener(
        "input",
        filterSchools
    );

    statusFilter.addEventListener(
        "change",
        filterSchools
    );

    provinceFilter.addEventListener(
        "change",
        filterSchools
    );

    function resetFilters() {

        searchInput.value = "";

        statusFilter.value = "";

        provinceFilter.value = "";

        filterSchools();

    }

    /* =========================================================
       LOGOUT
    ========================================================= */

    function logout() {

        const confirmed =
            confirm(
                "Voulez-vous vraiment vous déconnecter ?"
            );

        if (!confirmed) {
            return;
        }

        /*
         * Plus tard :
         *
         * POST /api/auth/logout
         */

        window.location.href = "/";

    }

    /* =========================================================
       ESCAPE
    ========================================================= */

    document.addEventListener(
        "keydown",
        event => {

            if (event.key === "Escape") {

                hideSidebar();

                closeCreateModal();

                closeDetailsModal();

                closeConfirmModal();

            }

        }
    );

    /* =========================================================
       OUTSIDE CLICK
    ========================================================= */

    createModal.addEventListener(
        "click",
        event => {

            if (event.target === createModal) {

                closeCreateModal();

            }

        }
    );

    detailsModal.addEventListener(
        "click",
        event => {

            if (event.target === detailsModal) {

                closeDetailsModal();

            }

        }
    );

    confirmModal.addEventListener(
        "click",
        event => {

            if (event.target === confirmModal) {

                closeConfirmModal();

            }

        }
    );

</script>

<script src="/assets/js/smart-school-api.js"></script>
</body>
</html>
