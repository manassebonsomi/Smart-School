                    </p>

                </div>

                <div class="space-y-6">

                    <!-- Attendance -->

                    <div>

                        <div class="flex items-center justify-between mb-2">

                            <span class="text-sm font-medium text-slate-600">
                                Taux moyen de présence
                            </span>

                            <span class="text-sm font-bold text-slate-800">
                                87%
                            </span>

                        </div>

                        <div class="h-2 bg-slate-100 rounded-full overflow-hidden">

                            <div
                                class="h-full bg-sky-500 rounded-full"
                                style="width: 87%"
                            ></div>

                        </div>

                    </div>

                    <!-- Success -->

                    <div>

                        <div class="flex items-center justify-between mb-2">

                            <span class="text-sm font-medium text-slate-600">
                                Taux moyen de réussite
                            </span>

                            <span class="text-sm font-bold text-slate-800">
                                78%
                            </span>

                        </div>

                        <div class="h-2 bg-slate-100 rounded-full overflow-hidden">

                            <div
                                class="h-full bg-indigo-500 rounded-full"
                                style="width: 78%"
                            ></div>

                        </div>

                    </div>

                    <!-- Active accounts -->

                    <div>

                        <div class="flex items-center justify-between mb-2">

                            <span class="text-sm font-medium text-slate-600">
                                Comptes actifs
                            </span>

                            <span class="text-sm font-bold text-slate-800">
                                94%
                            </span>

                        </div>

                        <div class="h-2 bg-slate-100 rounded-full overflow-hidden">

                            <div
                                class="h-full bg-emerald-500 rounded-full"
                                style="width: 94%"
                            ></div>

                        </div>

                    </div>

                    <!-- Platform activity -->

                    <div>

                        <div class="flex items-center justify-between mb-2">

                            <span class="text-sm font-medium text-slate-600">
                                Activité de la plateforme
                            </span>

                            <span class="text-sm font-bold text-slate-800">
                                82%
                            </span>

                        </div>

                        <div class="h-2 bg-slate-100 rounded-full overflow-hidden">

                            <div
                                class="h-full bg-violet-500 rounded-full"
                                style="width: 82%"
                            ></div>

                        </div>

                    </div>

                </div>

            </div>

        </section>

        <!-- ================================================= -->
        <!-- RECENT ACTIVITY -->
        <!-- ================================================= -->

        <section
            class="bg-white rounded-2xl border border-slate-200
                   shadow-sm overflow-hidden"
        >

            <div
                class="p-5 sm:p-6 border-b border-slate-100
                       flex flex-col sm:flex-row sm:items-center
                       sm:justify-between gap-3"
            >

                <div>

                    <h3 class="font-bold text-slate-800">
                        Activité récente
                    </h3>

                    <p class="text-sm text-slate-400 mt-1">
                        Dernières activités enregistrées sur la plateforme
                    </p>

                </div>

                <button
                    class="text-sm text-sky-500 hover:text-sky-600 font-semibold"
                >
                    Voir tout
                    <i class="fa-solid fa-arrow-right ml-1"></i>
                </button>

            </div>

            <!-- Activity list -->

            <div class="divide-y divide-slate-100">

                <!-- Activity -->

                <div class="p-5 flex items-center gap-4">

                    <div
                        class="w-10 h-10 rounded-full bg-sky-50
                               text-sky-500 flex items-center justify-center shrink-0"
                    >
                        <i class="fa-solid fa-school"></i>
                    </div>

                    <div class="flex-1 min-w-0">

                        <p class="text-sm font-medium text-slate-700">
                            Nouvelle école enregistrée
                        </p>

                        <p class="text-xs text-slate-400 mt-1">
                            École Saint-Augustin
                        </p>

                    </div>

                    <span class="text-xs text-slate-400">
                        Il y a 15 min
                    </span>

                </div>

                <!-- Activity -->

                <div class="p-5 flex items-center gap-4">

                    <div
                        class="w-10 h-10 rounded-full bg-indigo-50
                               text-indigo-500 flex items-center justify-center shrink-0"
                    >
                        <i class="fa-solid fa-user-plus"></i>
                    </div>

                    <div class="flex-1 min-w-0">

                        <p class="text-sm font-medium text-slate-700">
                            25 nouveaux élèves inscrits
                        </p>

                        <p class="text-xs text-slate-400 mt-1">
                            Complexe Scolaire La Référence
                        </p>

                    </div>

                    <span class="text-xs text-slate-400">
                        Il y a 42 min
                    </span>

                </div>

                <!-- Activity -->

                <div class="p-5 flex items-center gap-4">

                    <div
                        class="w-10 h-10 rounded-full bg-emerald-50
                               text-emerald-500 flex items-center justify-center shrink-0"
                    >
                        <i class="fa-solid fa-user-check"></i>
                    </div>

                    <div class="flex-1 min-w-0">

                        <p class="text-sm font-medium text-slate-700">
                            Administrateur ajouté
                        </p>

                        <p class="text-xs text-slate-400 mt-1">
                            Groupe Scolaire Horizon
                        </p>

                    </div>

                    <span class="text-xs text-slate-400">
                        Il y a 1 h
                    </span>

                </div>

                <!-- Activity -->

                <div class="p-5 flex items-center gap-4">

                    <div
                        class="w-10 h-10 rounded-full bg-amber-50
                               text-amber-500 flex items-center justify-center shrink-0"
                    >
                        <i class="fa-solid fa-file-circle-check"></i>
                    </div>

                    <div class="flex-1 min-w-0">

                        <p class="text-sm font-medium text-slate-700">
                            Rapport mensuel généré
                        </p>

                        <p class="text-xs text-slate-400 mt-1">
                            Rapport de juillet 2026
                        </p>

                    </div>

                    <span class="text-xs text-slate-400">
                        Il y a 2 h
                    </span>

                </div>

            </div>

        </section>

        <!-- Footer -->

        <footer class="mt-8 text-center">

            <p class="text-xs text-slate-400">
                © 2026 Smart School. Tous droits réservés.
            </p>

        </footer>

    </main>

</div>

<!-- ========================================================= -->
<!-- JAVASCRIPT -->
<!-- ========================================================= -->

<script>

    /* =========================================================
       SIDEBAR MOBILE
    ========================================================= */

    const sidebar = document.getElementById("sidebar");
    const sidebarOverlay = document.getElementById("sidebarOverlay");
    const openSidebar = document.getElementById("openSidebar");
    const closeSidebar = document.getElementById("closeSidebar");

    function showSidebar() {

        sidebar.classList.remove("-translate-x-full");

        sidebarOverlay.classList.remove("hidden");

        setTimeout(() => {
            sidebarOverlay.classList.remove("opacity-0");
        }, 10);
    }

    function hideSidebar() {

        sidebar.classList.add("-translate-x-full");

        sidebarOverlay.classList.add("opacity-0");

        setTimeout(() => {
            sidebarOverlay.classList.add("hidden");
        }, 300);
    }

    openSidebar?.addEventListener("click", showSidebar);

    closeSidebar?.addEventListener("click", hideSidebar);

    sidebarOverlay?.addEventListener("click", hideSidebar);

    /* =========================================================
       CHART DEFAULT CONFIGURATION
    ========================================================= */

    Chart.defaults.font.family =
        'Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif';

    Chart.defaults.color = "#64748B";

    /* =========================================================
       REGISTRATION CHART
    ========================================================= */

    const registrationCtx =
        document.getElementById("registrationChart");

    const registrationChart =
        new Chart(registrationCtx, {

            type: "line",

            data: {

                labels: [
                    "Jan",
                    "Fév",
                    "Mar",
                    "Avr",
                    "Mai",
                    "Juin",
                    "Juil",
                    "Août"
                ],

                datasets: [

                    {
                        label: "Élèves",

                        data: [
                            11200,
                            12400,
                            13100,
                            13900,
                            14800,
                            15700,
                            17200,
                            18642
                        ],

                        borderColor: "#38BDF8",

                        backgroundColor: "rgba(56,189,248,0.10)",

                        borderWidth: 3,

                        fill: true,

                        tension: 0.4,

                        pointRadius: 3,

                        pointHoverRadius: 6
                    },

                    {
                        label: "Enseignants",

                        data: [
                            850,
                            890,
                            925,
                            970,
                            1040,
                            1110,
                            1190,
                            1284
                        ],

                        borderColor: "#818CF8",

                        backgroundColor: "rgba(129,140,248,0.05)",

                        borderWidth: 2,

                        fill: false,

                        tension: 0.4,

                        pointRadius: 3,

                        pointHoverRadius: 6
                    }

                ]

            },

            options: {

                responsive: true,

                maintainAspectRatio: false,

                interaction: {
                    intersect: false,
                    mode: "index"
                },

                plugins: {

                    legend: {
                        display: false
                    },

                    tooltip: {
                        backgroundColor: "#0F172A",
                        padding: 12,
                        cornerRadius: 8
                    }

                },

                scales: {

                    y: {
                        beginAtZero: false,

                        grid: {
                            color: "#F1F5F9"
                        },

                        border: {
                            display: false
                        }
                    },

                    x: {

                        grid: {
                            display: false
                        },

                        border: {
                            display: false
                        }
                    }

                }

            }

        });

    /* =========================================================
       SCHOOL STATUS CHART
    ========================================================= */

    const schoolStatusCtx =
        document.getElementById("schoolStatusChart");

    new Chart(schoolStatusCtx, {

        type: "doughnut",

        data: {

            labels: [
                "Actives",
                "En attente",
                "Suspendues"
            ],

            datasets: [

                {
                    data: [
                        112,
                        9,
                        7
                    ],

                    backgroundColor: [
                        "#38BDF8",
                        "#FBBF24",
                        "#F87171"
                    ],

                    borderWidth: 0,

                    hoverOffset: 5
                }

            ]

        },

        options: {

            responsive: true,

            maintainAspectRatio: false,

            cutout: "72%",

            plugins: {

                legend: {
                    display: false
                }

            }

        }

    });

    /* =========================================================
       USERS CHART
    ========================================================= */

    const usersCtx =
        document.getElementById("usersChart");

    new Chart(usersCtx, {

        type: "bar",

        data: {

            labels: [
                "Élèves",
                "Enseignants",
                "Parents",
                "Admins"
            ],

            datasets: [

                {
                    label: "Utilisateurs",

                    data: [
                        18642,
                        1284,
                        9847,
                        128
                    ],

                    backgroundColor: [
                        "#38BDF8",
                        "#818CF8",
                        "#FBBF24",
                        "#34D399"
                    ],

                    borderRadius: 8,

                    borderSkipped: false

                }

            ]

        },

        options: {

            responsive: true,

            maintainAspectRatio: false,

            plugins: {

                legend: {
                    display: false
                }

            },

            scales: {

                y: {

                    beginAtZero: true,

                    grid: {
                        color: "#F1F5F9"
                    },

                    border: {
                        display: false
                    }

                },

                x: {

                    grid: {
                        display: false
                    },

                    border: {
                        display: false
                    }

                }

            }

        }

    });

    /* =========================================================
       PERIOD FILTER
    ========================================================= */

    document
        .getElementById("periodFilter")
        .addEventListener("change", function () {

            const period = this.value;

            /*
             * Pour le moment les données sont statiques.
             *
             * Dans AdonisJS, cette valeur sera envoyée
             * au backend afin de récupérer les statistiques
             * correspondant à la période sélectionnée.
             */

            console.log(
                "Période sélectionnée :",
                period
            );

        });

    /* =========================================================
       EXPORT
    ========================================================= */

    function exportStatistics() {

        alert(
            "La fonctionnalité d'export sera connectée au backend AdonisJS."
        );

    }

</script>

<script src="/assets/js/smart-school-api.js"></script>
<script>window.addEventListener("smart-school-statistics-loaded",event=>{const data=event.detail||{};const el=document.getElementById("schoolsCount");if(el&&data.totalSchools!==undefined)el.textContent=Number(data.totalSchools).toLocaleString("fr-FR")});</script>
</body>
</html>
