<!DOCTYPE html>

<html lang="fr">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="description"
        content="Statistiques globales de la plateforme Smart School"
    >

    <title>Statistiques | Smart School</title>


    <!-- =========================================================
         TAILWIND CSS
    ========================================================== -->

    <script src="https://cdn.tailwindcss.com"></script>


    <!-- =========================================================
         FONT AWESOME
    ========================================================== -->

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >


    <!-- =========================================================
         CHART.JS
    ========================================================== -->

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>


    <!-- =========================================================
         TAILWIND CONFIG
    ========================================================== -->

    <script>

        tailwind.config = {

            theme: {

                extend: {

                    colors: {

                        primary: {

                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            200: '#bae6fd',
                            300: '#7dd3fc',
                            400: '#38bdf8',
                            500: '#0ea5e9',
                            600: '#0284c7',
                            700: '#0369a1',
                            800: '#075985',
                            900: '#0c4a6e'

                        }

                    },

                    boxShadow: {

                        soft:
                            '0 10px 30px rgba(15, 23, 42, 0.05)'

                    }

                }

            }

        }

    </script>


    <!-- =========================================================
         STYLE
    ========================================================== -->

    <style>

        * {
            box-sizing: border-box;
        }


        html {
            scroll-behavior: smooth;
        }


        body {

            margin: 0;

            font-family:
                Inter,
                ui-sans-serif,
                system-ui,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                sans-serif;

        }


        ::-webkit-scrollbar {

            width: 7px;
            height: 7px;

        }


        ::-webkit-scrollbar-thumb {

            background: #cbd5e1;

            border-radius: 999px;

        }


        ::-webkit-scrollbar-track {

            background: transparent;

        }


        .sidebar-transition {

            transition:
                transform .3s ease-in-out;

        }


        .overlay-transition {

            transition:
                opacity .3s ease-in-out;

        }


        .loader {

            width: 22px;
            height: 22px;

            display: inline-block;

            border:
                3px solid #bae6fd;

            border-top-color:
                #0284c7;

            border-radius:
                9999px;

            animation:
                spin .7s linear infinite;

        }


        @keyframes spin {

            to {

                transform:
                    rotate(360deg);

            }

        }


        .chart-container {

            position: relative;

            width: 100%;

            height: 320px;

        }


        .kpi-card {

            transition:
                transform .2s ease,
                box-shadow .2s ease;

        }


        .kpi-card:hover {

            transform:
                translateY(-2px);

            box-shadow:
                0 14px 35px
                rgba(15, 23, 42, .07);

        }


        .icon-button {

            transition:
                background-color .2s ease,
                color .2s ease,
                transform .2s ease;

        }


        .icon-button:hover {

            transform:
                translateY(-1px);

        }

    </style>

</head>


<body class="bg-slate-50 text-slate-800">


<!-- =========================================================
     MOBILE OVERLAY
========================================================= -->

<div
    id="sidebarOverlay"
    class="
        overlay-transition
        fixed
        inset-0
        z-40
        hidden
        bg-slate-900/50
        opacity-100
        lg:hidden
    "
></div>


<!-- =========================================================
     SIDEBAR
========================================================= -->

<aside
    id="sidebar"
    class="
        sidebar-transition
        fixed
        inset-y-0
        left-0
        z-50
        flex
        w-72
        -translate-x-full
        flex-col
        border-r
        border-slate-200
        bg-white
        lg:translate-x-0
    "
>


    <!-- =====================================================
         SIDEBAR HEADER
    ====================================================== -->

    <div
        class="
            flex
            h-20
            items-center
            gap-3
            border-b
            border-slate-100
            px-6
        "
    >

        <div
            class="
                flex
                h-11
                w-11
                shrink-0
                items-center
                justify-center
                rounded-xl
                bg-primary-600
                text-white
                shadow-lg
                shadow-primary-600/20
            "
        >

            <i
                class="
                    fa-solid
                    fa-graduation-cap
                    text-lg
                "
            ></i>

        </div>


        <div class="min-w-0">

            <h1
                class="
                    truncate
                    text-base
                    font-extrabold
                    tracking-tight
                    text-slate-900
                "
            >
                SMART SCHOOL
            </h1>


            <p
                class="
                    truncate
                    text-xs
                    text-slate-400
                "
            >
                Administration Platform
            </p>

        </div>


        <button
            id="closeSidebar"
            type="button"
            class="
                ml-auto
                flex
                h-9
                w-9
                items-center
                justify-center
                rounded-lg
                text-slate-400
                hover:bg-slate-100
                hover:text-slate-700
                lg:hidden
            "
            aria-label="Fermer le menu"
        >

            <i class="fa-solid fa-xmark"></i>

        </button>

    </div>


    <!-- =====================================================
         SIDEBAR NAVIGATION
    ====================================================== -->

    <div
        class="
            flex-1
            overflow-y-auto
            px-4
            py-6
        "
    >

        <p
            class="
                mb-3
                px-3
                text-[10px]
                font-bold
                uppercase
                tracking-[0.18em]
                text-slate-400
            "
        >
            Principal
        </p>


        <nav class="space-y-1">


            <!-- Dashboard -->

            <a
                href="/super-admin/dashboard"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    px-4
                    py-3
                    text-sm
                    font-medium
                    text-slate-600
                    transition
                    hover:bg-slate-50
                    hover:text-slate-900
                "
            >

                <i
                    class="
                        fa-solid
                        fa-chart-pie
                        w-5
                        text-center
                    "
                ></i>

                <span>
                    Tableau de bord
                </span>

            </a>


            <!-- Écoles -->

            <a
                href="/super-admin/ecoles"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    px-4
                    py-3
                    text-sm
                    font-medium
                    text-slate-600
                    transition
                    hover:bg-slate-50
                    hover:text-slate-900
                "
            >

                <i
                    class="
                        fa-solid
                        fa-school
                        w-5
                        text-center
                    "
                ></i>

                <span>
                    Écoles
                </span>

            </a>


            <!-- Utilisateurs -->

            <a
                href="/super-admin/utilisateurs"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    px-4
                    py-3
                    text-sm
                    font-medium
                    text-slate-600
                    transition
                    hover:bg-slate-50
                    hover:text-slate-900
                "
            >

                <i
                    class="
                        fa-solid
                        fa-users
                        w-5
                        text-center
                    "
                ></i>

                <span>
                    Utilisateurs
                </span>

            </a>

        </nav>


        <p
            class="
                mb-3
                mt-8
                px-3
                text-[10px]
                font-bold
                uppercase
                tracking-[0.18em]
                text-slate-400
            "
        >
            Supervision
        </p>


        <nav class="space-y-1">


            <!-- Statistiques ACTIVE -->

            <a
                href="/super-admin/statistiques"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    bg-primary-50
                    px-4
                    py-3
                    text-sm
                    font-semibold
                    text-primary-700
                "
            >

                <i
                    class="
                        fa-solid
                        fa-chart-line
                        w-5
                        text-center
                    "
                ></i>

                <span>
                    Statistiques
                </span>

            </a>


            <!-- Rapports -->

            <a
                href="/super-admin/rapports"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    px-4
                    py-3
                    text-sm
                    font-medium
                    text-slate-600
                    transition
                    hover:bg-slate-50
                    hover:text-slate-900
                "
            >

                <i
                    class="
                        fa-solid
                        fa-file-lines
                        w-5
                        text-center
                    "
                ></i>

                <span>
                    Rapports
                </span>

            </a>

        </nav>


        <p
            class="
                mb-3
                mt-8
                px-3
                text-[10px]
                font-bold
                uppercase
                tracking-[0.18em]
                text-slate-400
            "
        >
            Système
        </p>


        <nav class="space-y-1">


            <a
                href="/super-admin/profil"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    bg-primary-50
                    px-4
                    py-3
                    text-sm
                    font-semibold
                    text-primary-700
                "
            >

                <i class="fa-solid fa-user-gear w-5 text-center"></i>

                Mon profil

            </a>


            <!-- Notifications -->

            <a
                href="#"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    px-4
                    py-3
                    text-sm
                    font-medium
                    text-slate-600
                    transition
                    hover:bg-slate-50
                    hover:text-slate-900
                "
            >

                <i
                    class="
                        fa-solid
                        fa-bell
                        w-5
                        text-center
                    "
                ></i>

                <span>
                    Notifications
                </span>

            </a>


            <!-- Paramètres -->

            <a
                href="#"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    px-4
                    py-3
                    text-sm
                    font-medium
                    text-slate-600
                    transition
                    hover:bg-slate-50
                    hover:text-slate-900
                "
            >

                <i
                    class="
                        fa-solid
                        fa-gear
                        w-5
                        text-center
                    "
                ></i>

                <span>
                    Paramètres
                </span>

            </a>


            <!-- Déconnexion -->

            <button
                type="button"
                onclick="logout()"
                class="
                    flex
                    w-full
                    items-center
                    gap-3
                    rounded-xl
                    px-4
                    py-3
                    text-sm
                    text-red-500
                    transition
                    hover:bg-red-50
                "
            >

                <i
                    class="
                        fa-solid
                        fa-right-from-bracket
                        w-5
                        text-center
                    "
                ></i>

                <span>
                    Déconnexion
                </span>

            </button>

        </nav>

    </div>


    <!-- =====================================================
         SIDEBAR USER
    ====================================================== -->

    <div
        class="
            border-t
            border-slate-100
            p-4
        "
    >

        <div
            class="
                flex
                items-center
                gap-3
                rounded-xl
                bg-slate-50
                p-3
            "
        >

            <div
                id="sidebarAvatar"
                class="
                    flex
                    h-10
                    w-10
                    shrink-0
                    items-center
                    justify-center
                    rounded-full
                    bg-primary-100
                    text-sm
                    font-bold
                    text-primary-700
                "
            >
                SA
            </div>


            <div class="min-w-0 flex-1">

                <p
                    id="sidebarUserName"
                    class="
                        truncate
                        text-sm
                        font-bold
                        text-slate-800
                    "
                >
                    Super Administrateur
                </p>


                <p
                    id="sidebarUserEmail"
                    class="
                        truncate
                        text-xs
                        text-slate-400
                    "
                >
                    Chargement...
                </p>

            </div>

        </div>

    </div>

</aside>


<!-- =========================================================
     MAIN
========================================================= -->

<div class="min-h-screen lg:ml-72">


    <!-- =====================================================
         HEADER
    ====================================================== -->

    <header
        class="
            sticky
            top-0
            z-30
            flex
            h-20
            items-center
            justify-between
            border-b
            border-slate-200
            bg-white/95
            px-4
            backdrop-blur
            sm:px-6
            lg:px-8
        "
    >

        <div
            class="
                flex
                items-center
                gap-4
            "
        >

            <!-- Mobile menu -->

            <button
                id="openSidebar"
                type="button"
                class="
                    icon-button
                    flex
                    h-10
                    w-10
                    items-center
                    justify-center
                    rounded-xl
                    text-slate-600
                    hover:bg-slate-100
                    lg:hidden
                "
                aria-label="Ouvrir le menu"
            >

                <i class="fa-solid fa-bars"></i>

            </button>


            <div>

                <p
                    class="
                        hidden
                        text-xs
                        font-semibold
                        uppercase
                        tracking-wider
                        text-primary-600
                        sm:block
                    "
                >
                    Supervision
                </p>


                <h2
                    class="
                        text-lg
                        font-bold
                        text-slate-900
                        sm:text-xl
                    "
                >
                    Statistiques
                </h2>


                <p
                    class="
                        hidden
                        text-sm
                        text-slate-400
                        sm:block
                    "
                >
                    Analyse globale de la plateforme
                </p>

            </div>

        </div>


        <div
            class="
                flex
                items-center
                gap-2
                sm:gap-3
            "
        >

            <!-- Actualiser -->

            <button
                id="refreshStatistics"
                type="button"
                title="Actualiser les statistiques"
                aria-label="Actualiser les statistiques"
                class="
                    icon-button
                    flex
                    h-10
                    w-10
                    items-center
                    justify-center
                    rounded-xl
                    text-slate-500
                    hover:bg-slate-100
                    hover:text-primary-600
                "
            >

                <i
                    class="fa-solid fa-rotate"
                ></i>

            </button>


            <!-- Notifications -->

            <button
                type="button"
                title="Notifications"
                aria-label="Notifications"
                class="
                    relative
                    icon-button
                    hidden
                    h-10
                    w-10
                    items-center
                    justify-center
                    rounded-xl
                    text-slate-500
                    hover:bg-slate-100
                    sm:flex
                "
            >

                <i
                    class="fa-solid fa-bell"
                ></i>


                <span
                    class="
                        absolute
                        right-2
                        top-2
                        h-2
                        w-2
                        rounded-full
                        bg-red-500
                        ring-2
                        ring-white
                    "
                ></span>

            </button>


            <!-- Déconnexion -->

            <button
                type="button"
                onclick="logout()"
                class="
                    hidden
                    items-center
                    gap-2
                    rounded-xl
                    border
                    border-red-100
                    px-4
                    py-2.5
                    text-sm
                    font-semibold
                    text-red-500
                    transition
                    hover:bg-red-50
                    sm:inline-flex
                "
            >

                <i
                    class="fa-solid fa-right-from-bracket"
                ></i>

                Déconnexion

            </button>

        </div>

    </header>


    <!-- =====================================================
         CONTENT
    ====================================================== -->

    <main
        class="
            p-4
            sm:p-6
            lg:p-8
        "
    >


        <!-- =================================================
             INTRODUCTION
        ================================================== -->

        <div
            class="
                mb-8
                flex
                flex-col
                gap-4
                lg:flex-row
                lg:items-end
                lg:justify-between
            "
        >

            <div>

                <p
                    class="
                        text-sm
                        font-semibold
                        text-primary-600
                    "
                >
                    Centre analytique
                </p>


                <h1
                    class="
                        mt-1
                        text-2xl
                        font-extrabold
                        tracking-tight
                        text-slate-900
                        sm:text-3xl
                    "
                >
                    Vue d'ensemble
                </h1>


                <p
                    class="
                        mt-2
                        max-w-2xl
                        text-sm
                        leading-6
                        text-slate-500
                    "
                >
                    Consultez les indicateurs réels de la
                    plateforme Smart School et leur évolution.
                </p>

            </div>


            <div
                class="
                    flex
                    flex-col
                    gap-2
                    sm:flex-row
                "
            >

                <!-- Période -->

                <label class="sr-only" for="periodFilter">
                    Période
                </label>

                <select
                    id="periodFilter"
                    class="
                        rounded-xl
                        border
                        border-slate-200
                        bg-white
                        px-4
                        py-2.5
                        text-sm
                        text-slate-600
                        outline-none
                        transition
                        focus:border-primary-400
                        focus:ring-4
                        focus:ring-primary-100
                    "
                >

                    <option value="12">
                        12 derniers mois
                    </option>

                    <option value="6">
                        6 derniers mois
                    </option>

                    <option value="3">
                        3 derniers mois
                    </option>

                    <option value="1">
                        Ce mois
                    </option>

                </select>


                <!-- Export -->

                <button
                    type="button"
                    onclick="exportStatistics()"
                    class="
                        inline-flex
                        items-center
                        justify-center
                        gap-2
                        rounded-xl
                        bg-primary-600
                        px-4
                        py-2.5
                        text-sm
                        font-semibold
                        text-white
                        shadow-sm
                        transition
                        hover:bg-primary-700
                        hover:shadow-md
                    "
                >

                    <i
                        class="fa-solid fa-file-csv"
                    ></i>

                    Exporter CSV

                </button>

            </div>

        </div>


        <!-- =================================================
             ERROR
        ================================================== -->

        <div
            id="statisticsError"
            role="alert"
            aria-live="polite"
            class="
                mb-6
                hidden
                items-start
                gap-3
                rounded-2xl
                border
                border-red-200
                bg-red-50
                px-4
                py-4
                text-sm
                text-red-700
            "
        >

            <i
                class="
                    fa-solid
                    fa-circle-exclamation
                    mt-0.5
                    shrink-0
                "
            ></i>


            <span id="statisticsErrorMessage">
                Impossible de charger les statistiques.
            </span>

        </div>


        <!-- =================================================
             LOADING
        ================================================== -->

        <div
            id="statisticsLoading"
            class="
                mb-6
                flex
                items-center
                gap-3
                rounded-2xl
                border
                border-primary-100
                bg-primary-50
                px-4
                py-4
                text-sm
                font-medium
                text-primary-700
            "
        >

            <span class="loader"></span>

            <span>
                Chargement des statistiques...
            </span>

        </div>


        <!-- =================================================
             KPI
        ================================================== -->

        <section
            class="
                grid
                grid-cols-1
                gap-5
                sm:grid-cols-2
                xl:grid-cols-4
            "
        >


            <!-- ÉCOLES -->

            <article
                class="
                    kpi-card
                    rounded-2xl
                    border
                    border-slate-200
                    bg-white
                    p-5
                    shadow-sm
                "
            >

                <div
                    class="
                        flex
                        items-start
                        justify-between
                    "
                >

                    <div>

                        <p
                            class="
                                text-sm
                                font-medium
                                text-slate-500
                            "
                        >
                            Écoles inscrites
                        </p>


                        <h3
                            id="schoolsCount"
                            class="
                                mt-2
                                text-3xl
                                font-extrabold
                                tracking-tight
                                text-slate-900
                            "
                        >
                            —
                        </h3>

                    </div>


                    <div
                        class="
                            flex
                            h-12
                            w-12
                            items-center
                            justify-center
                            rounded-xl
                            bg-sky-50
                            text-sky-600
                        "
                    >

                        <i
                            class="fa-solid fa-school"
                        ></i>

                    </div>

                </div>


                <div class="mt-4 space-y-1">

                    <p
                        id="activeSchoolsInfo"
                        class="
                            text-xs
                            font-semibold
                            text-emerald-600
                        "
                    >
                        —
                    </p>


                    <p
                        id="suspendedSchoolsInfo"
                        class="
                            text-xs
                            text-amber-600
                        "
                    >
                        —
                    </p>

                </div>

            </article>


            <!-- ÉLÈVES -->

            <article
                class="
                    kpi-card
                    rounded-2xl
                    border
                    border-slate-200
                    bg-white
                    p-5
                    shadow-sm
                "
            >

                <div
                    class="
                        flex
                        items-start
                        justify-between
                    "
                >

                    <div>

                        <p
                            class="
                                text-sm
                                font-medium
                                text-slate-500
                            "
                        >
                            Élèves
                        </p>


                        <h3
                            id="studentsCount"
                            class="
                                mt-2
                                text-3xl
                                font-extrabold
                                tracking-tight
                                text-slate-900
                            "
                        >
                            —
                        </h3>

                    </div>


                    <div
                        class="
                            flex
                            h-12
                            w-12
                            items-center
                            justify-center
                            rounded-xl
                            bg-indigo-50
                            text-indigo-600
                        "
                    >

                        <i
                            class="
                                fa-solid
                                fa-user-graduate
                            "
                        ></i>

                    </div>

                </div>


                <p
                    class="
                        mt-4
                        text-xs
                        text-slate-400
                    "
                >
                    Élèves enregistrés dans la plateforme
                </p>

            </article>


            <!-- UTILISATEURS -->

            <article
                class="
                    kpi-card
                    rounded-2xl
                    border
                    border-slate-200
                    bg-white
                    p-5
                    shadow-sm
                "
            >

                <div
                    class="
                        flex
                        items-start
                        justify-between
                    "
                >

                    <div>

                        <p
                            class="
                                text-sm
                                font-medium
                                text-slate-500
                            "
                        >
                            Utilisateurs
                        </p>


                        <h3
                            id="usersCount"
                            class="
                                mt-2
                                text-3xl
                                font-extrabold
                                tracking-tight
                                text-slate-900
                            "
                        >
                            —
                        </h3>

                    </div>


                    <div
                        class="
                            flex
                            h-12
                            w-12
                            items-center
                            justify-center
                            rounded-xl
                            bg-violet-50
                            text-violet-600
                        "
                    >

                        <i
                            class="fa-solid fa-users"
                        ></i>

                    </div>

                </div>


                <p
                    id="activeUsersInfo"
                    class="
                        mt-4
                        text-xs
                        font-semibold
                        text-emerald-600
                    "
