<!-- =========================================================
     LOGOUT
========================================================= -->

<script>

    async function logout() {

        const confirmed =
            window.confirm(
                'Voulez-vous vraiment vous déconnecter ?'
            )


        if (!confirmed) {

            return

        }


        const token =
            sessionStorage.getItem(
                'smart_school_access_token'
            )


        try {

            if (token) {

                await fetch(
                    '/api/auth/logout',
                    {

                        method:
                            'POST',

                        headers: {

                            Authorization:
                                `Bearer ${token}`,

                            Accept:
                                'application/json',

                        },

                    }
                )

            }

        } catch (
            error
        ) {

            console.error(
                'Erreur déconnexion:',
                error
            )

        } finally {

            sessionStorage.removeItem(
                'smart_school_access_token'
            )

            sessionStorage.removeItem(
                'smart_school_user'
            )

            window.location.replace(
                '/'
            )

        }

    }

</script>


