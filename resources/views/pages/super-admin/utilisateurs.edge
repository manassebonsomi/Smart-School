<!DOCTYPE html>
<html lang="fr">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Utilisateurs | Smart School</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <script>

        tailwind.config = {

            theme: {

                extend: {

                    colors: {

                        primary: {

                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            200: '#bae6fd',
                            300: '#7dd3fc',
                            400: '#38bdf8',
                            500: '#0ea5e9',
                            600: '#0284c7',
                            700: '#0369a1',
                            800: '#075985',
                            900: '#0c4a6e'

                        }

                    }

                }

            }

        }

    </script>

    <style>

        body {

            font-family: Inter, ui-sans-serif, system-ui,
                -apple-system, BlinkMacSystemFont,
                "Segoe UI", sans-serif;

        }

        .sidebar-transition {

            transition: transform .3s ease-in-out;

        }

        ::-webkit-scrollbar {

            width: 7px;
            height: 7px;

        }

        ::-webkit-scrollbar-thumb {

            background: #bae6fd;
            border-radius: 10px;

        }

    </style>

</head>

<body class="bg-slate-50 text-slate-800">

<div class="min-h-screen">

    <!-- MOBILE OVERLAY -->

    <div id="sidebarOverlay"
         class="fixed inset-0 bg-slate-900/50 z-40
                hidden lg:hidden">
    </div>

    <!-- SIDEBAR -->

    <aside id="sidebar"
           class="fixed top-0 left-0 z-50 h-screen w-72
                  bg-white border-r border-slate-200
                  transform -translate-x-full
                  lg:translate-x-0 sidebar-transition">

        <!-- BRAND -->

        <div class="h-20 px-6 flex items-center
                    border-b border-slate-200">

            <div class="flex items-center gap-3">

                <div class="w-11 h-11 rounded-xl
                            bg-primary-500
                            flex items-center justify-center">

                    <svg class="w-6 h-6 text-white"
                         fill="none"
                         stroke="currentColor"
                         viewBox="0 0 24 24">

                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M12 14l9-5-9-5-9 5 9 5z"/>

                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M12 14v7"/>

                    </svg>

                </div>

                <div>

                    <h1 class="font-bold text-lg text-slate-900">
                        Smart School
                    </h1>

                    <p class="text-xs text-slate-500">
                        Administration
                    </p>

                </div>

            </div>

        </div>

        <!-- NAVIGATION -->

        <nav class="p-4 space-y-1">

            <p class="px-3 pt-2 pb-3 text-xs font-semibold
                      text-slate-400 uppercase tracking-wider">
                Administration
            </p>

            <a href="/super-admin/dashboard"
               class="flex items-center gap-3 px-4 py-3
                      rounded-xl text-slate-600
                      hover:bg-primary-50
                      hover:text-primary-600">

                <svg class="w-5 h-5"
                     fill="none"
                     stroke="currentColor"
                     viewBox="0 0 24 24">

                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M3 12l9-9 9 9M5 10v10h14V10"/>

                </svg>

                Dashboard

            </a>

            <a href="/super-admin/ecoles"
               class="flex items-center gap-3 px-4 py-3
                      rounded-xl text-slate-600
                      hover:bg-primary-50
                      hover:text-primary-600">

                <svg class="w-5 h-5"
                     fill="none"
                     stroke="currentColor"
                     viewBox="0 0 24 24">

                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M3 21h18M5 21V10l7-5 7 5v11"/>

                </svg>

                Écoles

            </a>

            <a href="/super-admin/utilisateurs"
               class="flex items-center gap-3 px-4 py-3
                      rounded-xl bg-primary-50
                      text-primary-600">

                <svg class="w-5 h-5"
                     fill="none"
                     stroke="currentColor"
                     viewBox="0 0 24 24">

                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M17 20h5v-2a4 4 0 00-4-4h-1M9 20H4v-2a4 4 0 014-4h1M12 12a4 4 0 100-8 4 4 0 000 8z"/>

                </svg>

                <span class="font-semibold">
                    Utilisateurs
                </span>

            </a>

            <a href="/super-admin/statistiques"
               class="flex items-center gap-3 px-4 py-3
                      rounded-xl text-slate-600
                      hover:bg-primary-50
                      hover:text-primary-600">

                <svg class="w-5 h-5"
                     fill="none"
                     stroke="currentColor"
                     viewBox="0 0 24 24">

                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M4 19V5M4 19h16M8 16v-4M12 16V8M16 16V4"/>

                </svg>

                Statistiques

            </a>

            <a href="/super-admin/rapports"
               class="flex items-center gap-3 px-4 py-3
                      rounded-xl text-slate-600
                      hover:bg-primary-50
                      hover:text-primary-600">

                <svg class="w-5 h-5"
                     fill="none"
                     stroke="currentColor"
                     viewBox="0 0 24 24">

                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M9 17v-2a2 2 0 012-2h2a2 2 0 012 2v2M5 21h14M6 3h9l3 3v15H6V3z"/>

                </svg>

                Rapports

            </a>

            <div class="border-t border-slate-200 my-5"></div>

            <a href="#"
               class="flex items-center gap-3 px-4 py-3
                      rounded-xl text-slate-600
                      hover:bg-primary-50
                      hover:text-primary-600">

                <svg class="w-5 h-5"
                     fill="none"
                     stroke="currentColor"
                     viewBox="0 0 24 24">

                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M12 15.5a3.5 3.5 0 100-7 3.5 3.5 0 000 7z"/>

                </svg>

                Paramètres

            </a>

        </nav>

    </aside>

    <!-- MAIN -->

    <div class="lg:ml-72 min-h-screen">

        <!-- HEADER -->

        <header class="h-20 bg-white
                       border-b border-slate-200
                       flex items-center
                       justify-between
                       px-4 sm:px-6 lg:px-8
                       sticky top-0 z-30">

            <div class="flex items-center gap-4">

                <button id="menuButton"
                        class="lg:hidden p-2
                               rounded-lg hover:bg-slate-100">

                    <svg class="w-6 h-6"
                         fill="none"
                         stroke="currentColor"
                         viewBox="0 0 24 24">

                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M4 6h16M4 12h16M4 18h16"/>

                    </svg>

                </button>

                <div>

                    <h2 class="text-lg sm:text-xl
                               font-bold text-slate-900">

                        Administrateurs scolaires

                    </h2>

                    <p class="hidden sm:block
                              text-sm text-slate-500">

                        Gestion des comptes administrateurs des écoles.

                    </p>

                </div>

            </div>

            <div class="flex items-center gap-3">

                <button class="relative p-2
                               rounded-xl hover:bg-slate-100">

                    <svg class="w-6 h-6 text-slate-600"
                         fill="none"
                         stroke="currentColor"
                         viewBox="0 0 24 24">

                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M15 17h5l-1.5-2V10a6.5 6.5 0 00-13 0v5L4 17h5"/>

                    </svg>

                    <span class="absolute top-1 right-1
                                 w-2 h-2 bg-red-500
                                 rounded-full"></span>

                </button>

                <div class="hidden sm:block text-right">

                    <p class="text-sm font-semibold">
                        Super Admin
                    </p>

                    <p class="text-xs text-slate-500">
                        Administrateur système
                    </p>

                </div>

                <div class="w-10 h-10 rounded-xl
                            bg-primary-100
                            flex items-center justify-center">

                    <span class="font-bold text-primary-700">
                        SA
                    </span>

                </div>

            </div>

        </header>

        <!-- CONTENT -->

        <main class="p-4 sm:p-6 lg:p-8">

            <!-- TITLE -->

            <div class="mb-6">

                <h1 class="text-2xl font-bold text-slate-900">
                    Utilisateurs
                </h1>

                <p class="text-sm text-slate-500 mt-1">
                    Administrateurs responsables de la gestion des écoles.
                </p>

            </div>

            <!-- STATS -->

            <div class="grid grid-cols-1 sm:grid-cols-2
                        xl:grid-cols-4 gap-4 mb-6">

                <div class="bg-white border
                            border-slate-200
                            rounded-2xl p-5">

                    <p class="text-sm text-slate-500">
                        Administrateurs
                    </p>

                    <p class="text-2xl font-bold mt-2">
                        128
                    </p>

                    <p class="text-xs text-emerald-600 mt-1">
                        +8 ce mois
                    </p>

                </div>

                <div class="bg-white border
                            border-slate-200
                            rounded-2xl p-5">

                    <p class="text-sm text-slate-500">
                        Comptes actifs
                    </p>

                    <p class="text-2xl font-bold mt-2">
                        121
                    </p>

                    <p class="text-xs text-slate-500 mt-1">
                        94.5 %
                    </p>

                </div>

                <div class="bg-white border
                            border-slate-200
                            rounded-2xl p-5">

                    <p class="text-sm text-slate-500">
                        Comptes suspendus
                    </p>

                    <p class="text-2xl font-bold mt-2">
                        7
                    </p>

                    <p class="text-xs text-red-500 mt-1">
                        Nécessitent une vérification
                    </p>

                </div>

                <div class="bg-white border
                            border-slate-200
                            rounded-2xl p-5">

                    <p class="text-sm text-slate-500">
                        Dernière connexion
                    </p>

                    <p class="text-2xl font-bold mt-2">
                        96 %
                    </p>

                    <p class="text-xs text-emerald-600 mt-1">
                        Activité récente
                    </p>

                </div>

            </div>

            <!-- TABLE -->

            <div class="bg-white border
                        border-slate-200
                        rounded-2xl overflow-hidden">

                <!-- FILTER -->

                <div class="p-4 sm:p-5
                            border-b border-slate-200">

                    <div class="flex flex-col
                                md:flex-row
                                gap-3
                                md:justify-between">

                        <div class="relative
                                    w-full md:max-w-md">

                            <svg class="absolute left-3 top-1/2
                                        -translate-y-1/2
                                        w-5 h-5 text-slate-400"
                                 fill="none"
                                 stroke="currentColor"
                                 viewBox="0 0 24 24">

                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      stroke-width="2"
                                      d="M21 21l-4.35-4.35m2.35-5.65a8 8 0 11-16 0 8 8 0 0116 0z"/>

                            </svg>

                            <input
                                id="searchUser"
                                type="text"
                                placeholder="Rechercher un administrateur..."
                                class="w-full pl-10 pr-4 py-3
                                       bg-slate-50
                                       border border-slate-200
                                       rounded-xl
                                       outline-none
                                       focus:bg-white
                                       focus:ring-2
                                       focus:ring-primary-200">

                        </div>

                        <button
                            class="px-5 py-3
                                   rounded-xl
                                   bg-primary-500
                                   hover:bg-primary-600
                                   text-white font-semibold">

                            + Nouvel administrateur

                        </button>

                    </div>

                </div>

                <!-- TABLE -->

                <div class="overflow-x-auto">

                    <table class="w-full min-w-[1050px]">

                        <thead class="bg-slate-50
                                      border-b border-slate-200">

                        <tr>

                            <th class="px-6 py-4 text-left
                                       text-xs font-semibold
                                       uppercase
                                       text-slate-500">

                                Administrateur

                            </th>

                            <th class="px-6 py-4 text-left
                                       text-xs font-semibold
                                       uppercase
                                       text-slate-500">

                                École

                            </th>

                            <th class="px-6 py-4 text-left
                                       text-xs font-semibold
                                       uppercase
                                       text-slate-500">

                                Email

                            </th>

                            <th class="px-6 py-4 text-left
                                       text-xs font-semibold
                                       uppercase
                                       text-slate-500">

                                Dernière connexion

                            </th>

                            <th class="px-6 py-4 text-left
                                       text-xs font-semibold
                                       uppercase
                                       text-slate-500">

                                Statut

                            </th>

                            <th class="px-6 py-4 text-right
                                       text-xs font-semibold
                                       uppercase
                                       text-slate-500">

                                Actions

                            </th>

                        </tr>

                        </thead>

                        <tbody id="userTable"
                               class="divide-y divide-slate-100">

                        <!-- USER -->

                        <tr class="hover:bg-slate-50">

                            <td class="px-6 py-4">

                                <div class="flex items-center gap-3">

                                    <div class="w-10 h-10
                                                rounded-xl
                                                bg-primary-100
                                                flex items-center
                                                justify-center">

                                        <span class="font-bold
                                                     text-primary-600">

                                            JM

                                        </span>

                                    </div>

                                    <div>

                                        <p class="font-semibold
                                                  text-slate-900">

                                            Jean Mukendi

                                        </p>

                                        <p class="text-xs
                                                  text-slate-500">

                                            ADM-000128

                                        </p>

                                    </div>

                                </div>

                            </td>

                            <td class="px-6 py-4
                                       text-sm">

                                Lycée Moderne

                            </td>

                            <td class="px-6 py-4
                                       text-sm
                                       text-slate-600">

                                jean.mukendi@example.com

                            </td>

                            <td class="px-6 py-4
                                       text-sm
                                       text-slate-600">

                                Aujourd'hui, 20:42

                            </td>

                            <td class="px-6 py-4">

                                <span class="inline-flex
                                             items-center gap-2
                                             px-3 py-1
                                             rounded-full
                                             bg-emerald-50
                                             text-emerald-700
                                             text-xs font-semibold">

                                    <span class="w-1.5 h-1.5
                                                 rounded-full
                                                 bg-emerald-500">
                                    </span>

                                    Actif

                                </span>

                            </td>

                            <td class="px-6 py-4">

                                <div class="flex justify-end gap-1">

                                    <!-- DETAILS -->

                                    <button
                                        title="Afficher"
                                        class="p-2 rounded-lg
                                               hover:bg-primary-50
                                               text-slate-500
                                               hover:text-primary-600">

                                        <svg class="w-5 h-5"
                                             fill="none"
                                             stroke="currentColor"
                                             viewBox="0 0 24 24">

                                            <path stroke-linecap="round"
                                                  stroke-linejoin="round"
                                                  stroke-width="2"
                                                  d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>

                                            <path stroke-linecap="round"
                                                  stroke-linejoin="round"
                                                  stroke-width="2"
                                                  d="M2.458 12C3.732 7.943 7.523 5 12 5c4.477 0 8.268 2.943 9.542 7-1.274 4.057-5.065 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>

                                        </svg>

                                    </button>

                                    <!-- EDIT -->

                                    <button
                                        title="Modifier"
                                        class="p-2 rounded-lg
                                               hover:bg-blue-50
                                               text-slate-500
                                               hover:text-blue-600">

                                        <svg class="w-5 h-5"
                                             fill="none"
                                             stroke="currentColor"
                                             viewBox="0 0 24 24">

                                            <path stroke-linecap="round"
                                                  stroke-linejoin="round"
                                                  stroke-width="2"
                                                  d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5"/>

                                            <path stroke-linecap="round"
                                                  stroke-linejoin="round"
                                                  stroke-width="2"
                                                  d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>

                                        </svg>

                                    </button>

                                    <!-- SUSPEND -->

                                    <button
                                        title="Suspendre"
                                        class="p-2 rounded-lg
                                               hover:bg-amber-50
                                               text-slate-500
                                               hover:text-amber-600">

                                        <svg class="w-5 h-5"
                                             fill="none"
                                             stroke="currentColor"
                                             viewBox="0 0 24 24">

                                            <path stroke-linecap="round"
                                                  stroke-linejoin="round"
                                                  stroke-width="2"
                                                  d="M6 4h12M6 20h12"/>

                                        </svg>

                                    </button>

                                    <!-- DELETE -->

                                    <button
                                        title="Supprimer"
                                        class="p-2 rounded-lg
                                               hover:bg-red-50
                                               text-slate-500
                                               hover:text-red-600">

                                        <svg class="w-5 h-5"
                                             fill="none"
                                             stroke="currentColor"
                                             viewBox="0 0 24 24">

                                            <path stroke-linecap="round"
                                                  stroke-linejoin="round"
                                                  stroke-width="2"
                                                  d="M6 7h12M10 11v6M14 11v6M9 7V4h6v3m-9 0l1 13h10l1-13"/>

                                        </svg>

                                    </button>

                                </div>

                            </td>

                        </tr>

                        <!-- USER 2 -->

                        <tr class="hover:bg-slate-50">

                            <td class="px-6 py-4">

                                <div class="flex items-center gap-3">

                                    <div class="w-10 h-10
                                                rounded-xl
                                                bg-purple-100
                                                flex items-center
                                                justify-center">

                                        <span class="font-bold
                                                     text-purple-600">

                                            MK

                                        </span>

                                    </div>

                                    <div>

                                        <p class="font-semibold">
                                            Marie Kabeya
                                        </p>

                                        <p class="text-xs text-slate-500">
                                            ADM-000127
                                        </p>

                                    </div>

                                </div>

                            </td>

                            <td class="px-6 py-4 text-sm">
                                Complexe Scolaire Horizon
                            </td>

                            <td class="px-6 py-4 text-sm
                                       text-slate-600">

                                marie.kabeya@example.com

                            </td>

                            <td class="px-6 py-4 text-sm
                                       text-slate-600">

                                Hier, 17:25

                            </td>

                            <td class="px-6 py-4">

                                <span class="inline-flex
                                             items-center gap-2
                                             px-3 py-1
                                             rounded-full
                                             bg-emerald-50
                                             text-emerald-700
                                             text-xs font-semibold">

                                    <span class="w-1.5 h-1.5
                                                 rounded-full
                                                 bg-emerald-500">
                                    </span>

                                    Actif

                                </span>

                            </td>

                            <td class="px-6 py-4">

                                <div class="flex justify-end gap-1">

                                    <button title="Afficher"
                                            class="p-2 rounded-lg
                                                   hover:bg-primary-50
                                                   text-slate-500
                                                   hover:text-primary-600">

                                        <svg class="w-5 h-5"
                                             fill="none"
                                             stroke="currentColor"
                                             viewBox="0 0 24 24">

                                            <path stroke-linecap="round"
                                                  stroke-linejoin="round"
                                                  stroke-width="2"
                                                  d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>

                                            <path stroke-linecap="round"
                                                  stroke-linejoin="round"
                                                  stroke-width="2"
                                                  d="M2.458 12C3.732 7.943 7.523 5 12 5c4.477 0 8.268 2.943 9.542 7-1.274 4.057-5.065 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>

                                        </svg>

                                    </button>

                                    <button title="Modifier"
                                            class="p-2 rounded-lg
                                                   hover:bg-blue-50
                                                   text-slate-500
                                                   hover:text-blue-600">

                                        <svg class="w-5 h-5"
                                             fill="none"
                                             stroke="currentColor"
                                             viewBox="0 0 24 24">

                                            <path stroke-linecap="round"
                                                  stroke-linejoin="round"
                                                  stroke-width="2"
                                                  d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5"/>

                                        </svg>

                                    </button>

                                    <button title="Suspendre"
                                            class="p-2 rounded-lg
                                                   hover:bg-amber-50
                                                   text-slate-500
                                                   hover:text-amber-600">

                                        <svg class="w-5 h-5"
                                             fill="none"
                                             stroke="currentColor"
                                             viewBox="0 0 24 24">

                                            <path stroke-linecap="round"
                                                  stroke-linejoin="round"
                                                  stroke-width="2"
                                                  d="M6 4h12M6 20h12"/>

                                        </svg>

                                    </button>

                                    <button title="Supprimer"
                                            class="p-2 rounded-lg
                                                   hover:bg-red-50
                                                   text-slate-500
                                                   hover:text-red-600">

                                        <svg class="w-5 h-5"
                                             fill="none"
                                             stroke="currentColor"
                                             viewBox="0 0 24 24">

                                            <path stroke-linecap="round"
                                                  stroke-linejoin="round"
                                                  stroke-width="2"
                                                  d="M6 7h12M10 11v6M14 11v6M9 7V4h6v3m-9 0l1 13h10l1-13"/>

                                        </svg>

                                    </button>

                                </div>

                            </td>

                        </tr>

                        </tbody>

                    </table>

                </div>

                <!-- PAGINATION -->

                <div class="px-4 sm:px-6 py-4
                            border-t border-slate-200
                            flex flex-col sm:flex-row
                            justify-between items-center gap-4">

                    <p class="text-sm text-slate-500">

                        Affichage de
                        <strong>1</strong>
                        à
                        <strong>10</strong>
                        sur
                        <strong>128</strong>
                        utilisateurs

                    </p>

                    <div class="flex gap-1">

                        <button
                            class="px-3 py-2
                                   border border-slate-200
                                   rounded-lg text-sm">

                            Précédent

                        </button>

                        <button
                            class="w-9 h-9 rounded-lg
                                   bg-primary-500
                                   text-white font-semibold">

                            1

                        </button>

                        <button
                            class="w-9 h-9 rounded-lg
                                   hover:bg-slate-100">

                            2

                        </button>

                        <button
                            class="w-9 h-9 rounded-lg
                                   hover:bg-slate-100">

                            3

                        </button>

                        <span class="px-2 py-2 text-slate-400">
                            ...
                        </span>

                        <button
                            class="w-9 h-9 rounded-lg
                                   hover:bg-slate-100">

                            13

                        </button>

                        <button
                            class="px-3 py-2
                                   border border-slate-200
                                   rounded-lg text-sm">

                            Suivant

                        </button>

                    </div>

                </div>

            </div>

        </main>

    </div>

</div>

<script>

    const menuButton =
        document.getElementById('menuButton');

    const sidebar =
        document.getElementById('sidebar');

    const overlay =
        document.getElementById('sidebarOverlay');

    menuButton?.addEventListener('click', () => {

        sidebar.classList.remove('-translate-x-full');

        overlay.classList.remove('hidden');

    });

    overlay?.addEventListener('click', () => {

        sidebar.classList.add('-translate-x-full');

        overlay.classList.add('hidden');

    });

    /* SEARCH */

    const search =
        document.getElementById('searchUser');

    search?.addEventListener('input', function () {

        const value =
            this.value.toLowerCase().trim();

        document
            .querySelectorAll('#userTable tr')
            .forEach(row => {

                row.style.display =
                    row.textContent
                        .toLowerCase()
                        .includes(value)
                        ? ''
                        : 'none';

            });

    });

</script>

<script src="/assets/js/smart-school-api.js"></script>
</body>
</html>
