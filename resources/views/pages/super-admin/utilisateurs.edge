<!DOCTYPE html>

<html lang="fr">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Administrateurs | Smart School</title>


    <!-- TAILWIND -->

    <script src="https://cdn.tailwindcss.com"></script>


    <!-- LUCIDE -->

    <script src="https://unpkg.com/lucide@latest"></script>


    <!-- FONT AWESOME -->

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >


    <script>

        tailwind.config = {

            theme: {

                extend: {

                    colors: {

                        primary: {

                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            200: '#bae6fd',
                            300: '#7dd3fc',
                            400: '#38bdf8',
                            500: '#0ea5e9',
                            600: '#0284c7',
                            700: '#0369a1',
                            800: '#075985',
                            900: '#0c4a6e'

                        }

                    }

                }

            }

        }

    </script>


    <style>

        body {

            font-family:
                Inter,
                ui-sans-serif,
                system-ui,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                sans-serif;

        }


        * {

            scrollbar-width: thin;
            scrollbar-color: #cbd5e1 transparent;

        }


        .sidebar-transition {

            transition:
                transform .3s ease-in-out;

        }


        .modal-transition {

            transition:
                opacity .2s ease,
                transform .2s ease;

        }


        .action-btn {

            width: 36px;
            height: 36px;
            border-radius: 9px;

            display:
                inline-flex;

            align-items:
                center;

            justify-content:
                center;

            transition:
                .2s ease;

        }


        .form-input {

            width: 100%;

            border:
                1px solid #e2e8f0;

            border-radius:
                .75rem;

            background:
                #f8fafc;

            padding:
                .75rem 1rem;

            font-size:
                .875rem;

            outline:
                none;

        }


        .form-input:focus {

            border-color:
                #38bdf8;

            background:
                white;

            box-shadow:
                0 0 0 3px rgba(
                    56,
                    189,
                    248,
                    .15
                );

        }


        .form-label {

            display:
                block;

            margin-bottom:
                .5rem;

            font-size:
                .75rem;

            font-weight:
                600;

            color:
                #64748b;

        }

    </style>

</head>


<body class="bg-slate-50 text-slate-800">


<!-- =========================================================
     OVERLAY
========================================================= -->

<div
    id="sidebarOverlay"
    class="
        fixed
        inset-0
        z-40
        hidden
        bg-slate-900/50
        lg:hidden
    "
></div>


<!-- =========================================================
     SIDEBAR
========================================================= -->

<aside
    id="sidebar"
    class="
        sidebar-transition
        fixed
        inset-y-0
        left-0
        z-50
        flex
        w-72
        -translate-x-full
        flex-col
        border-r
        border-slate-200
        bg-white
        lg:translate-x-0
    "
>


    <!-- =====================================================
         SIDEBAR HEADER
    ====================================================== -->

    <div
        class="
            flex
            h-20
            items-center
            gap-3
            border-b
            border-slate-100
            px-6
        "
    >

        <div
            class="
                flex
                h-11
                w-11
                shrink-0
                items-center
                justify-center
                rounded-xl
                bg-primary-600
                text-white
                shadow-lg
                shadow-primary-600/20
            "
        >

            <i
                class="
                    fa-solid
                    fa-graduation-cap
                    text-lg
                "
            ></i>

        </div>


        <div class="min-w-0">

            <h1
                class="
                    truncate
                    text-base
                    font-extrabold
                    tracking-tight
                    text-slate-900
                "
            >
                SMART SCHOOL
            </h1>


            <p
                class="
                    truncate
                    text-xs
                    text-slate-400
                "
            >
                Administration Platform
            </p>

        </div>


        <button
            id="closeSidebar"
            type="button"
            class="
                ml-auto
                flex
                h-9
                w-9
                items-center
                justify-center
                rounded-lg
                text-slate-400
                hover:bg-slate-100
                hover:text-slate-700
                lg:hidden
            "
            aria-label="Fermer le menu"
        >

            <i class="fa-solid fa-xmark"></i>

        </button>

    </div>


    <!-- =====================================================
         SIDEBAR NAVIGATION
    ====================================================== -->

    <div
        class="
            flex-1
            overflow-y-auto
            px-4
            py-6
        "
    >

        <p
            class="
                mb-3
                px-3
                text-[10px]
                font-bold
                uppercase
                tracking-[0.18em]
                text-slate-400
            "
        >
            Principal
        </p>


        <nav class="space-y-1">


            <!-- Dashboard -->

            <a
                href="/super-admin/dashboard"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    px-4
                    py-3
                    text-sm
                    font-medium
                    text-slate-600
                    transition
                    hover:bg-slate-50
                    hover:text-slate-900
                "
            >

                <i
                    class="
                        fa-solid
                        fa-chart-pie
                        w-5
                        text-center
                    "
                ></i>

                <span>
                    Tableau de bord
                </span>

            </a>


            <!-- Écoles -->

            <a
                href="/super-admin/ecoles"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    px-4
                    py-3
                    text-sm
                    font-medium
                    text-slate-600
                    transition
                    hover:bg-slate-50
                    hover:text-slate-900
                "
            >

                <i
                    class="
                        fa-solid
                        fa-school
                        w-5
                        text-center
                    "
                ></i>

                <span>
                    Écoles
                </span>

            </a>


            <!-- Utilisateurs -->

            <a
                href="/super-admin/utilisateurs"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    px-4
                    py-3
                    text-sm
                    font-medium
                    text-slate-600
                    transition
                    hover:bg-slate-50
                    hover:text-slate-900
                "
            >

                <i
                    class="
                        fa-solid
                        fa-users
                        w-5
                        text-center
                    "
                ></i>

                <span>
                    Utilisateurs
                </span>

            </a>

        </nav>


        <p
            class="
                mb-3
                mt-8
                px-3
                text-[10px]
                font-bold
                uppercase
                tracking-[0.18em]
                text-slate-400
            "
        >
            Supervision
        </p>


        <nav class="space-y-1">


            <!-- Statistiques ACTIVE -->

            <a
                href="/super-admin/statistiques"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    bg-primary-50
                    px-4
                    py-3
                    text-sm
                    font-semibold
                    text-primary-700
                "
            >

                <i
                    class="
                        fa-solid
                        fa-chart-line
                        w-5
                        text-center
                    "
                ></i>

                <span>
                    Statistiques
                </span>

            </a>


            <!-- Rapports -->

            <a
                href="/super-admin/rapports"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    px-4
                    py-3
                    text-sm
                    font-medium
                    text-slate-600
                    transition
                    hover:bg-slate-50
                    hover:text-slate-900
                "
            >

                <i
                    class="
                        fa-solid
                        fa-file-lines
                        w-5
                        text-center
                    "
                ></i>

                <span>
                    Rapports
                </span>

            </a>

        </nav>


        <p
            class="
                mb-3
                mt-8
                px-3
                text-[10px]
                font-bold
                uppercase
                tracking-[0.18em]
                text-slate-400
            "
        >
            Système
        </p>


        <nav class="space-y-1">


            <a
                href="/super-admin/profil"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    bg-primary-50
                    px-4
                    py-3
                    text-sm
                    font-semibold
                    text-primary-700
                "
            >

                <i class="fa-solid fa-user-gear w-5 text-center"></i>

                Mon profil

            </a>


            <!-- Notifications -->

            <a
                href="#"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    px-4
                    py-3
                    text-sm
                    font-medium
                    text-slate-600
                    transition
                    hover:bg-slate-50
                    hover:text-slate-900
                "
            >

                <i
                    class="
                        fa-solid
                        fa-bell
                        w-5
                        text-center
                    "
                ></i>

                <span>
                    Notifications
                </span>

            </a>


            <!-- Paramètres -->

            <a
                href="#"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    px-4
                    py-3
                    text-sm
                    font-medium
                    text-slate-600
                    transition
                    hover:bg-slate-50
                    hover:text-slate-900
                "
            >

                <i
                    class="
                        fa-solid
                        fa-gear
                        w-5
                        text-center
                    "
                ></i>

                <span>
                    Paramètres
                </span>

            </a>


            <!-- Déconnexion -->

            <button
                type="button"
                onclick="logout()"
                class="
                    flex
                    w-full
                    items-center
                    gap-3
                    rounded-xl
                    px-4
                    py-3
                    text-sm
                    text-red-500
                    transition
                    hover:bg-red-50
                "
            >

                <i
                    class="
                        fa-solid
                        fa-right-from-bracket
                        w-5
                        text-center
                    "
                ></i>

                <span>
                    Déconnexion
                </span>

            </button>

        </nav>

    </div>


    <!-- =====================================================
         SIDEBAR USER
    ====================================================== -->

    <div
        class="
            border-t
            border-slate-100
            p-4
        "
    >

        <div
            class="
                flex
                items-center
                gap-3
                rounded-xl
                bg-slate-50
                p-3
            "
        >

            <div
                id="sidebarAvatar"
                class="
                    flex
                    h-10
                    w-10
                    shrink-0
                    items-center
                    justify-center
                    rounded-full
                    bg-primary-100
                    text-sm
                    font-bold
                    text-primary-700
                "
            >
                SA
            </div>


            <div class="min-w-0 flex-1">

                <p
                    id="sidebarUserName"
                    class="
                        truncate
                        text-sm
                        font-bold
                        text-slate-800
                    "
                >
                    Super Administrateur
                </p>


                <p
                    id="sidebarUserEmail"
                    class="
                        truncate
                        text-xs
                        text-slate-400
                    "
                >
                    Chargement...
                </p>

            </div>

        </div>

    </div>

</aside>


<!-- =========================================================
     MAIN
========================================================= -->

<div class="min-h-screen lg:ml-72">


    <!-- HEADER -->

    <header
        class="
            sticky
            top-0
            z-30
            flex
            h-20
            items-center
            justify-between
            border-b
            border-slate-200
            bg-white
            px-4
            sm:px-6
            lg:px-8
        "
    >

        <div class="flex items-center gap-4">

            <button
                id="menuButton"
                type="button"
                class="
                    rounded-xl
                    p-2
                    text-slate-600
                    hover:bg-slate-100
                    lg:hidden
                "
            >

                <i
                    class="fa-solid fa-bars"
                ></i>

            </button>


            <div>

                <h2
                    class="
                        text-lg
                        font-bold
                        text-slate-900
                        sm:text-xl
                    "
                >
                    Administrateurs scolaires
                </h2>


                <p
                    class="
                        hidden
                        text-sm
                        text-slate-500
                        sm:block
                    "
                >
                    Gestion des comptes administrateurs des écoles.
                </p>

            </div>

        </div>


        <div class="flex items-center gap-3">

            <button
                type="button"
                class="
                    relative
                    rounded-xl
                    p-2.5
                    text-slate-500
                    hover:bg-slate-100
                "
            >

                <i
                    class="fa-regular fa-bell text-lg"
                ></i>

            </button>


            <div
                class="
                    hidden
                    h-8
                    w-px
                    bg-slate-200
                    sm:block
                "
            ></div>


            <div class="hidden items-center gap-3 sm:flex">

                <div
                    id="headerAvatar"
                    class="
                        flex
                        h-10
                        w-10
                        items-center
                        justify-center
                        rounded-full
                        bg-primary-100
                        font-bold
                        text-primary-700
                    "
                >
                    SA
                </div>


                <div>

                    <p
                        id="headerUserName"
                        class="
                            text-sm
                            font-semibold
                        "
                    >
                        Super Admin
                    </p>


                    <p
                        class="
                            text-xs
                            text-slate-400
                        "
                    >
                        Administrateur système
                    </p>

                </div>

            </div>

        </div>

    </header>


    <!-- CONTENT -->

    <main class="p-4 sm:p-6 lg:p-8">


        <!-- PAGE HEADER -->

        <div
            class="
                mb-7
                flex
                flex-col
                gap-4
                lg:flex-row
                lg:items-center
                lg:justify-between
            "
        >

            <div>

                <h1
                    class="
                        text-2xl
                        font-bold
                        text-slate-900
                    "
                >
                    Utilisateurs
                </h1>


                <p
                    class="
                        mt-1
                        text-sm
                        text-slate-500
                    "
                >
                    Administrateurs responsables de la gestion des écoles.
                </p>

            </div>


            <button
                id="createAdminButton"
                type="button"
                class="
                    inline-flex
                    items-center
                    justify-center
                    gap-2
                    rounded-xl
                    bg-primary-600
                    px-5
                    py-3
                    text-sm
                    font-semibold
                    text-white
                    shadow-sm
                    hover:bg-primary-700
                "
            >

                <i
                    class="fa-solid fa-user-plus"
                ></i>

                Nouvel administrateur

            </button>

        </div>


        <!-- ALERTS -->

        <div
            id="pageError"
            class="
                mb-6
                hidden
                rounded-xl
                border
                border-red-200
                bg-red-50
                px-4
                py-3
                text-sm
                text-red-700
            "
        ></div>


        <div
            id="pageSuccess"
            class="
                mb-6
                hidden
                rounded-xl
                border
                border-emerald-200
                bg-emerald-50
                px-4
                py-3
                text-sm
                text-emerald-700
            "
        ></div>


        <!-- =====================================================
             STATS
        ====================================================== -->

        <section
            class="
                mb-6
                grid
                grid-cols-1
                gap-4
                sm:grid-cols-2
                xl:grid-cols-4
            "
        >

            <div
                class="
                    rounded-2xl
                    border
                    border-slate-200
                    bg-white
                    p-5
                    shadow-sm
                "
            >

                <div class="flex items-center justify-between">

                    <div>

                        <p class="text-sm text-slate-500">
                            Administrateurs
                        </p>


                        <p
                            id="statTotal"
                            class="
                                mt-2
                                text-3xl
                                font-bold
                                text-slate-800
                            "
                        >
                            —
                        </p>

                    </div>


                    <div
                        class="
                            flex
                            h-12
                            w-12
                            items-center
                            justify-center
                            rounded-xl
                            bg-primary-50
                            text-primary-600
                        "
                    >

                        <i
                            class="fa-solid fa-users-gear text-xl"
                        ></i>

                    </div>

                </div>


                <p
                    id="statNew"
                    class="
                        mt-3
                        text-xs
                        text-emerald-600
                    "
                >
                    —
                </p>

            </div>


            <div
                class="
                    rounded-2xl
                    border
                    border-slate-200
                    bg-white
                    p-5
                    shadow-sm
                "
            >

                <div class="flex items-center justify-between">

                    <div>

                        <p class="text-sm text-slate-500">
                            Comptes actifs
                        </p>


                        <p
                            id="statActive"
                            class="
                                mt-2
                                text-3xl
                                font-bold
                                text-slate-800
                            "
                        >
                            —
                        </p>

                    </div>


                    <div
                        class="
                            flex
                            h-12
                            w-12
                            items-center
                            justify-center
                            rounded-xl
                            bg-emerald-50
                            text-emerald-600
                        "
                    >

                        <i
                            class="fa-solid fa-circle-check text-xl"
                        ></i>

                    </div>

                </div>


                <p
                    id="statActivePercent"
                    class="
                        mt-3
                        text-xs
                        text-emerald-600
                    "
                >
                    —
                </p>

            </div>


            <div
                class="
                    rounded-2xl
                    border
                    border-slate-200
                    bg-white
                    p-5
                    shadow-sm
                "
            >

                <div class="flex items-center justify-between">

                    <div>

                        <p class="text-sm text-slate-500">
                            Comptes suspendus
                        </p>


                        <p
                            id="statInactive"
                            class="
                                mt-2
                                text-3xl
                                font-bold
                                text-slate-800
                            "
                        >
                            —
                        </p>

                    </div>


                    <div
                        class="
                            flex
                            h-12
                            w-12
                            items-center
                            justify-center
                            rounded-xl
                            bg-amber-50
                            text-amber-600
                        "
                    >

                        <i
                            class="fa-solid fa-user-lock text-xl"
                        ></i>

                    </div>

                </div>


                <p
                    class="
                        mt-3
                        text-xs
                        text-slate-400
                    "
                >
                    Accès actuellement bloqué
                </p>

            </div>


            <div
                class="
                    rounded-2xl
                    border
                    border-slate-200
                    bg-white
                    p-5
                    shadow-sm
                "
            >

                <div class="flex items-center justify-between">

                    <div>

                        <p class="text-sm text-slate-500">
                            Avec connexion
                        </p>


                        <p
                            id="statLoginRate"
                            class="
                                mt-2
                                text-3xl
                                font-bold
                                text-slate-800
                            "
                        >
                            —
                        </p>

                    </div>


                    <div
                        class="
                            flex
                            h-12
                            w-12
                            items-center
                            justify-center
                            rounded-xl
                            bg-indigo-50
                            text-indigo-600
                        "
                    >

                        <i
                            class="fa-solid fa-right-to-bracket text-xl"
                        ></i>

                    </div>

                </div>


                <p
                    id="statNeverLogin"
                    class="
                        mt-3
                        text-xs
                        text-slate-400
                    "
                >
                    —
                </p>

            </div>

        </section>


        <!-- =====================================================
             FILTERS
        ====================================================== -->

        <section
            class="
                mb-6
                rounded-2xl
                border
                border-slate-200
                bg-white
                p-5
                shadow-sm
            "
        >

            <div
                class="
                    grid
                    grid-cols-1
                    gap-4
                    md:grid-cols-2
                    xl:grid-cols-4
                "
            >

                <div class="xl:col-span-2">

                    <label
                        for="searchUser"
                        class="form-label"
                    >
                        Rechercher
                    </label>


                    <div class="relative">

                        <i
                            class="
                                fa-solid
                                fa-magnifying-glass
                                absolute
                                left-4
                                top-1/2
                                -translate-y-1/2
                                text-slate-400
                            "
                        ></i>


                        <input
                            id="searchUser"
                            type="search"
                            placeholder="Nom, email, téléphone, pseudo..."
                            class="
                                form-input
                                pl-11
                            "
                        >

                    </div>

                </div>


                <div>

                    <label
                        for="statusFilter"
                        class="form-label"
                    >
                        Statut
                    </label>


                    <select
                        id="statusFilter"
                        class="form-input"
                    >

                        <option value="">
                            Tous les statuts
                        </option>

                        <option value="ACTIF">
                            Actifs
                        </option>

                        <option value="INACTIF">
                            Suspendus
                        </option>

                        <option value="SUPPRIME">
                            Supprimés
                        </option>

                    </select>

                </div>


                <div>

                    <label
                        for="schoolFilter"
                        class="form-label"
                    >
                        École
                    </label>


                    <select
                        id="schoolFilter"
                        class="form-input"
                    >

                        <option value="">
                            Toutes les écoles
                        </option>

                    </select>

                </div>

            </div>

        </section>


        <!-- =====================================================
             TABLE
        ====================================================== -->

        <section
            class="
                overflow-hidden
                rounded-2xl
                border
                border-slate-200
                bg-white
                shadow-sm
            "
        >

            <div
                class="
                    flex
                    flex-col
                    gap-3
                    border-b
                    border-slate-100
                    p-5
                    sm:flex-row
                    sm:items-center
                    sm:justify-between
                "
            >

                <div>

                    <h2 class="font-bold">
                        Liste des administrateurs
                    </h2>


                    <p
                        class="
                            mt-1
                            text-sm
                            text-slate-400
                        "
                    >
                        Tous les comptes ayant le rôle administrateur d'école.
                    </p>

                </div>


                <span
                    id="resultCount"
                    class="
                        w-fit
                        rounded-full
                        bg-slate-100
                        px-3
                        py-1.5
                        text-xs
                        font-semibold
                        text-slate-500
                    "
                >
                    0
                </span>

            </div>


            <div class="overflow-x-auto">

                <table
                    class="
                        w-full
                        min-w-[1050px]
                    "
                >

                    <thead
                        class="
                            border-b
                            border-slate-100
                            bg-slate-50
                        "
                    >

                        <tr>

                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-400">
                                Administrateur
                            </th>

                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-400">
                                École
                            </th>

                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-400">
                                Email
                            </th>

                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-400">
                                Dernière connexion
                            </th>

                            <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-400">
                                Statut
                            </th>

                            <th class="px-6 py-4 text-right text-xs font-semibold uppercase tracking-wider text-slate-400">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody
                        id="userTable"
                        class="divide-y divide-slate-100"
                    ></tbody>

                </table>

            </div>


            <div
                id="emptyState"
                class="
                    hidden
                    px-6
                    py-16
                    text-center
                "
            >

                <div
                    class="
                        mx-auto
                        flex
                        h-16
                        w-16
                        items-center
                        justify-center
                        rounded-2xl
                        bg-slate-100
                        text-slate-400
                    "
                >

                    <i
                        class="fa-solid fa-users-slash text-2xl"
                    ></i>

                </div>


                <h3
                    class="
                        mt-4
                        font-semibold
                        text-slate-700
                    "
                >
                    Aucun administrateur trouvé
                </h3>


                <p
                    class="
                        mt-1
                        text-sm
                        text-slate-400
                    "
                >
                    Modifiez vos critères de recherche.
                </p>

            </div>


            <!-- PAGINATION -->

            <div
                class="
                    flex
                    flex-col
                    gap-4
                    border-t
                    border-slate-100
                    px-5
                    py-4
                    sm:flex-row
                    sm:items-center
                    sm:justify-between
                "
            >

                <p
                    id="paginationInfo"
                    class="text-sm text-slate-400"
                >
                    —
                </p>


                <div
                    id="pagination"
                    class="flex items-center gap-1"
                ></div>

            </div>

        </section>

    </main>

</div>


<!-- =========================================================
     CREATE MODAL
========================================================= -->

<div
    id="createModal"
    class="fixed inset-0 z-[100] hidden items-center justify-center bg-slate-900/50 p-4 opacity-0 modal-transition"
>
    <div
        id="createModalContent"
        class="max-h-[92vh] w-full max-w-4xl overflow-y-auto rounded-2xl bg-white shadow-2xl"
    >
        <div class="sticky top-0 z-10 flex items-center justify-between border-b border-slate-100 bg-white px-6 py-5">
            <div>
                <h3 class="text-lg font-bold text-slate-800">Nouvel administrateur</h3>
                <p class="mt-1 text-sm text-slate-400">
                    Créer un nouvel administrateur ou associer un utilisateur existant à une école.
                </p>
            </div>

            <button
                id="closeCreateModal"
                type="button"
                class="flex h-9 w-9 items-center justify-center rounded-lg text-slate-400 hover:bg-slate-100 hover:text-slate-700"
                aria-label="Fermer"
            >
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <form id="createAdminForm" class="p-6">
            <div id="createFormError" class="mb-5 hidden rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></div>

            <div class="mb-6">
                <label for="create_ecoleSearch" class="form-label">École *</label>

                <div class="relative">
                    <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
                    <input
                        id="create_ecoleSearch"
                        type="text"
                        autocomplete="off"
                        class="form-input pl-11"
                        placeholder="Rechercher une école par nom, code ou ville..."
                    >
                    <input id="create_ecoleId" name="ecoleId" type="hidden" value="">
                </div>

                <div id="create_ecoleResults" class="relative z-20 mt-2 hidden max-h-56 overflow-y-auto rounded-xl border border-slate-200 bg-white shadow-lg"></div>
                <div id="create_ecoleSelected" class="mt-2 hidden rounded-xl border border-sky-100 bg-sky-50 px-4 py-3 text-sm font-medium text-sky-700"></div>
            </div>

            <div class="mb-6">
                <p class="form-label">Mode d’attribution</p>

                <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                    <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-slate-200 p-4 hover:bg-slate-50">
                        <input type="radio" name="mode" value="new" checked class="mt-1 h-4 w-4 accent-sky-600">
                        <span>
                            <span class="block text-sm font-semibold text-slate-700">Créer un nouvel utilisateur</span>
                            <span class="mt-1 block text-xs text-slate-400">Créer le compte puis lui attribuer le rôle administrateur.</span>
                        </span>
                    </label>

                    <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-slate-200 p-4 hover:bg-slate-50">
                        <input type="radio" name="mode" value="existing" class="mt-1 h-4 w-4 accent-sky-600">
                        <span>
                            <span class="block text-sm font-semibold text-slate-700">Associer un utilisateur existant</span>
                            <span class="mt-1 block text-xs text-slate-400">Utiliser un compte déjà présent dans Smart School.</span>
                        </span>
                    </label>
                </div>
            </div>

            <div id="existingUserSection" class="mb-6 hidden">
                <label for="create_userSearch" class="form-label">Utilisateur existant *</label>

                <div class="relative">
                    <i class="fa-solid fa-user absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
                    <input
                        id="create_userSearch"
                        type="text"
                        autocomplete="off"
                        class="form-input pl-11"
                        placeholder="Nom, email, téléphone ou pseudo..."
                    >
                    <input id="create_userId" name="userId" type="hidden" value="">
                </div>

                <div id="create_userResults" class="relative z-20 mt-2 hidden max-h-56 overflow-y-auto rounded-xl border border-slate-200 bg-white shadow-lg"></div>
                <div id="create_userSelected" class="mt-2 hidden rounded-xl border border-emerald-100 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-700"></div>
            </div>

            <div id="newUserSection">
                <div class="mb-4 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3">
                    <p class="text-sm font-semibold text-slate-700">Informations du nouvel administrateur</p>
                    <p class="mt-1 text-xs text-slate-400">Un email de vérification pourra être envoyé après la création du compte.</p>
                </div>

                <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
                    <div>
                        <label for="create_prenom" class="form-label">Prénom *</label>
                        <input id="create_prenom" name="prenom" required class="form-input" placeholder="Prénom">
                    </div>
                    <div>
                        <label for="create_nom" class="form-label">Nom *</label>
                        <input id="create_nom" name="nom" required class="form-input" placeholder="Nom">
                    </div>
                    <div>
                        <label for="create_postnom" class="form-label">Postnom</label>
                        <input id="create_postnom" name="postnom" class="form-input" placeholder="Postnom">
                    </div>
                    <div>
                        <label for="create_pseudo" class="form-label">Pseudo</label>
                        <input id="create_pseudo" name="pseudo" class="form-input" placeholder="Pseudo">
                    </div>
                    <div>
                        <label for="create_email" class="form-label">Email *</label>
                        <input id="create_email" name="email" type="email" required class="form-input" placeholder="admin@ecole.cd">
                    </div>
                    <div>
                        <label for="create_telephone" class="form-label">Téléphone</label>
                        <input id="create_telephone" name="telephone" type="tel" class="form-input" placeholder="+243 ...">
                    </div>
                    <div>
                        <label for="create_sexe" class="form-label">Sexe</label>
                        <select id="create_sexe" name="sexe" class="form-input">
                            <option value="">Sélectionner</option>
                            <option value="HOMME">Homme</option>
                            <option value="FEMME">Femme</option>
                            <option value="AUTRE">Autre</option>
                        </select>
                    </div>
                    <div>
                        <label for="create_password" class="form-label">Mot de passe *</label>
                        <input id="create_password" name="password" type="password" minlength="8" required class="form-input" placeholder="Minimum 8 caractères">
                    </div>
                    <div class="md:col-span-2">
                        <label for="create_password_confirmation" class="form-label">Confirmation du mot de passe *</label>
                        <input id="create_password_confirmation" name="password_confirmation" type="password" minlength="8" required class="form-input" placeholder="Confirmer le mot de passe">
                    </div>
                </div>
            </div>

            <div class="mt-7 flex flex-col-reverse gap-3 border-t border-slate-100 pt-5 sm:flex-row sm:justify-end">
                <button
                    id="cancelCreateButton"
                    type="button"
                    class="rounded-xl border border-slate-200 px-5 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-50"
                >
                    Annuler
                </button>

                <button
                    id="submitCreateButton"
                    type="submit"
                    class="rounded-xl bg-primary-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-primary-700"
                >
                    Créer
                </button>
            </div>
        </form>
    </div>
</div>

<!-- =========================================================
     DETAILS MODAL
========================================================= -->

<div
    id="detailsModal"
    class="
        fixed
        inset-0
        z-[100]
        hidden
        items-center
        justify-center
        bg-slate-900/50
        p-4
        opacity-0
        modal-transition
    "
>

    <div
        class="
            max-h-[92vh]
            w-full
            max-w-3xl
            overflow-y-auto
            rounded-2xl
            bg-white
            shadow-2xl
        "
    >

        <div
            class="
                sticky
                top-0
                z-10
                flex
                items-center
                justify-between
                border-b
                border-slate-100
                bg-white
                px-6
                py-5
            "
        >

            <div>

                <h3
                    id="detailsName"
                    class="text-lg font-bold"
                >
                    Administrateur
                </h3>

                <p
                    id="detailsEmail"
                    class="
                        mt-1
                        text-sm
                        text-slate-400
                    "
                >
                    —
                </p>

            </div>


            <button
                id="closeDetailsModal"
                type="button"
                class="
                    flex
                    h-9
                    w-9
                    items-center
                    justify-center
                    rounded-lg
                    text-slate-400
                    hover:bg-slate-100
                "
            >

                <i class="fa-solid fa-xmark"></i>

            </button>

        </div>


        <div class="p-6">

            <div
                id="detailsStats"
                class="
                    grid
                    grid-cols-1
                    gap-4
                    sm:grid-cols-3
                "
            ></div>


            <div class="mt-7">

                <h4
                    class="
                        mb-3
                        font-semibold
                    "
                >
                    Écoles associées
                </h4>


                <div
                    id="detailsSchools"
                    class="space-y-3"
                ></div>

            </div>


            <div class="mt-7">

                <h4
                    class="
                        mb-3
                        font-semibold
                    "
                >
                    Informations du compte
                </h4>


                <div
                    class="
                        grid
                        grid-cols-1
                        gap-4
                        sm:grid-cols-2
                    "
                >

                    <div
                        class="
                            rounded-xl
                            bg-slate-50
                            p-4
                        "
                    >

                        <p class="text-xs text-slate-400">
                            Téléphone
                        </p>

                        <p
                            id="detailsPhone"
                            class="
                                mt-1
                                text-sm
                                font-semibold
                                text-slate-700
                            "
                        >
                            —
                        </p>

                    </div>


                    <div
                        class="
                            rounded-xl
                            bg-slate-50
                            p-4
                        "
                    >

                        <p class="text-xs text-slate-400">
                            Pseudo
                        </p>

                        <p
                            id="detailsPseudo"
                            class="
                                mt-1
                                text-sm
                                font-semibold
                                text-slate-700
                            "
                        >
                            —
                        </p>

                    </div>


                    <div
                        class="
                            rounded-xl
                            bg-slate-50
                            p-4
                        "
                    >

                        <p class="text-xs text-slate-400">
                            Création
                        </p>

                        <p
                            id="detailsCreatedAt"
                            class="
                                mt-1
                                text-sm
                                font-semibold
                                text-slate-700
                            "
                        >
                            —
                        </p>

                    </div>


                    <div
                        class="
                            rounded-xl
                            bg-slate-50
                            p-4
                        "
                    >

                        <p class="text-xs text-slate-400">
                            Dernière connexion
                        </p>

                        <p
                            id="detailsLastLogin"
                            class="
                                mt-1
                                text-sm
                                font-semibold
                                text-slate-700
                            "
                        >
                            —
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     EDIT MODAL
========================================================= -->

<div
    id="editModal"
    class="
        fixed
        inset-0
        z-[105]
        hidden
        items-center
        justify-center
        bg-slate-900/50
        p-4
        opacity-0
        modal-transition
    "
>

    <div
        class="
            max-h-[92vh]
            w-full
            max-w-2xl
            overflow-y-auto
            rounded-2xl
            bg-white
            shadow-2xl
        "
    >

        <div
            class="
                sticky
                top-0
                z-10
                flex
                items-center
                justify-between
                border-b
                border-slate-100
                bg-white
                px-6
                py-5
            "
        >

            <div>

                <h3 class="text-lg font-bold">
                    Modifier l'administrateur
                </h3>

                <p
                    id="editSubtitle"
                    class="
                        mt-1
                        text-sm
                        text-slate-400
                    "
                >
                    —
                </p>

            </div>


            <button
                id="closeEditModal"
                type="button"
                class="
                    flex
                    h-9
                    w-9
                    items-center
                    justify-center
                    rounded-lg
                    text-slate-400
                    hover:bg-slate-100
                "
            >

                <i class="fa-solid fa-xmark"></i>

            </button>

        </div>


        <form
            id="editAdminForm"
            class="p-6"
        >

            <input
                id="edit_id"
                type="hidden"
                name="id"
            >


            <div
                id="editFormError"
                class="
                    mb-5
                    hidden
                    rounded-xl
                    border
                    border-red-200
                    bg-red-50
                    px-4
                    py-3
                    text-sm
                    text-red-700
                "
            ></div>


            <div
                class="
                    grid
                    grid-cols-1
                    gap-5
                    md:grid-cols-2
                "
            >

                <div>

                    <label
                        for="edit_prenom"
                        class="form-label"
                    >
                        Prénom
                    </label>

                    <input
                        id="edit_prenom"
                        name="prenom"
                        class="form-input"
                    >

                </div>


                <div>

                    <label
                        for="edit_nom"
                        class="form-label"
                    >
                        Nom
                    </label>

                    <input
                        id="edit_nom"
                        name="nom"
                        class="form-input"
                    >

                </div>


                <div>

                    <label
                        for="edit_postnom"
                        class="form-label"
                    >
                        Postnom
                    </label>

                    <input
                        id="edit_postnom"
                        name="postnom"
                        class="form-input"
                    >

                </div>


                <div>

                    <label
                        for="edit_pseudo"
                        class="form-label"
                    >
                        Pseudo
                    </label>

                    <input
                        id="edit_pseudo"
                        name="pseudo"
                        class="form-input"
                    >

                </div>


                <div>

                    <label
                        for="edit_email"
                        class="form-label"
                    >
                        Email
                    </label>

                    <input
                        id="edit_email"
                        name="email"
                        type="email"
                        class="form-input"
                    >

                </div>


                <div>

                    <label
                        for="edit_telephone"
                        class="form-label"
                    >
                        Téléphone
                    </label>

                    <input
                        id="edit_telephone"
                        name="telephone"
                        class="form-input"
                    >

                </div>


                <div>

                    <label
                        for="edit_sexe"
                        class="form-label"
                    >
                        Sexe
                    </label>

                    <select
                        id="edit_sexe"
                        name="sexe"
                        class="form-input"
                    >

                        <option value="">
                            Sélectionner
                        </option>

                        <option value="HOMME">
                            Homme
                        </option>

                        <option value="FEMME">
                            Femme
                        </option>

                        <option value="AUTRE">
                            Autre
                        </option>

                    </select>

                </div>


                <div>

                    <label
                        for="edit_statut"
                        class="form-label"
                    >
                        Statut
                    </label>

                    <select
                        id="edit_statut"
                        name="statut"
                        class="form-input"
                    >

                        <option value="ACTIF">
                            Actif
                        </option>

                        <option value="INACTIF">
                            Suspendu
                        </option>

                    </select>

                </div>


                <div class="md:col-span-2">

                    <label
                        for="edit_password"
                        class="form-label"
                    >
                        Nouveau mot de passe
                    </label>

                    <input
                        id="edit_password"
                        name="password"
                        type="password"
                        minlength="8"
                        placeholder="Laisser vide pour conserver l'actuel"
                        class="form-input"
                    >

                </div>

            </div>


            <div
                class="
                    mt-7
                    flex
                    justify-end
                    gap-3
                    border-t
                    border-slate-100
                    pt-5
                "
            >

                <button
                    id="cancelEditButton"
                    type="button"
                    class="
                        rounded-xl
                        border
                        border-slate-200
                        px-5
                        py-2.5
                        text-sm
                        font-semibold
                        text-slate-600
                        hover:bg-slate-50
                    "
                >
                    Annuler
                </button>


                <button
                    id="submitEditButton"
                    type="submit"
                    class="
                        rounded-xl
                        bg-indigo-600
                        px-5
                        py-2.5
                        text-sm
                        font-semibold
                        text-white
                        hover:bg-indigo-700
                    "
                >
                    Enregistrer
                </button>

            </div>

        </form>

    </div>

</div>


<!-- =========================================================
     CONFIRM MODAL
========================================================= -->

<div
    id="confirmModal"
    class="
        fixed
        inset-0
        z-[110]
        hidden
        items-center
        justify-center
        bg-slate-900/50
        p-4
        opacity-0
        modal-transition
    "
>

    <div
        class="
            w-full
            max-w-md
            rounded-2xl
            bg-white
            shadow-2xl
        "
    >

        <div class="p-6">

            <div
                id="confirmIcon"
                class="
                    mx-auto
                    flex
                    h-14
                    w-14
                    items-center
                    justify-center
                    rounded-2xl
                    bg-amber-50
                    text-amber-500
                "
            >

                <i
                    class="fa-solid fa-triangle-exclamation"
                ></i>

            </div>


            <h3
                id="confirmTitle"
                class="
                    mt-5
                    text-center
                    text-lg
                    font-bold
                "
            >
                Confirmation
            </h3>


            <p
                id="confirmMessage"
                class="
                    mt-2
                    text-center
                    text-sm
                    leading-6
                    text-slate-500
                "
            >
                —
            </p>


            <div
                class="
                    mt-7
                    flex
                    gap-3
                "
            >

                <button
                    id="cancelConfirmButton"
                    type="button"
                    class="
                        flex-1
                        rounded-xl
                        border
                        border-slate-200
                        px-4
                        py-3
                        text-sm
                        font-semibold
                        text-slate-600
                    "
                >
                    Annuler
                </button>


                <button
                    id="confirmActionButton"
                    type="button"
                    class="
                        flex-1
                        rounded-xl
                        bg-amber-500
                        px-4
                        py-3
                        text-sm
                        font-semibold
                        text-white
                    "
                >
                    Confirmer
                </button>

            </div>

        </div>

    </div>

</div>

<script src="/assets/js/super-admin/auth.js"></script>
<script src="/assets/js/super-admin/user.js"></script>

</body>

</html>