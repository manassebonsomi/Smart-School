<!DOCTYPE html>

<html lang="fr">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Mon profil | Smart School</title>


    <!-- =========================================================
         TAILWIND CSS
    ========================================================== -->

    <script src="https://cdn.tailwindcss.com"></script>


    <!-- =========================================================
         FONT AWESOME
    ========================================================== -->

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >


    <!-- =========================================================
         TAILWIND CONFIG
    ========================================================== -->

    <script>

        tailwind.config = {

            theme: {

                extend: {

                    colors: {

                        primary: {

                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            200: '#bae6fd',
                            300: '#7dd3fc',
                            400: '#38bdf8',
                            500: '#0ea5e9',
                            600: '#0284c7',
                            700: '#0369a1',
                            800: '#075985',
                            900: '#0c4a6e'

                        }

                    }

                }

            }

        }

    </script>


    <!-- =========================================================
         STYLES
    ========================================================== -->

    <style>

        * {
            box-sizing: border-box;
        }


        body {

            font-family:
                Inter,
                ui-sans-serif,
                system-ui,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                sans-serif;

        }


        .sidebar-transition {

            transition:
                transform .3s ease-in-out;

        }


        .tab-transition {

            transition:
                .2s ease;

        }


        .avatar-ring {

            box-shadow:
                0 0 0 5px #e0f2fe,
                0 12px 30px rgba(14,165,233,.12);

        }


        .form-input {

            width: 100%;

            padding:
                .75rem
                1rem;

            border:
                1px solid #e2e8f0;

            border-radius:
                .75rem;

            background:
                white;

            outline:
                none;

            font-size:
                .875rem;

            transition:
                .2s ease;

        }


        .form-input:focus {

            border-color:
                #38bdf8;

            box-shadow:
                0 0 0 3px
                rgba(56,189,248,.15);

        }


        .loader {

            width: 20px;
            height: 20px;

            border:
                3px solid #bae6fd;

            border-top-color:
                #0284c7;

            border-radius:
                999px;

            animation:
                spin .7s linear infinite;

        }


        @keyframes spin {

            to {
                transform: rotate(360deg);
            }

        }


        ::-webkit-scrollbar {

            width: 7px;
            height: 7px;

        }


        ::-webkit-scrollbar-thumb {

            background:
                #bae6fd;

            border-radius:
                999px;

        }

    </style>

</head>


<body
    class="
        bg-slate-50
        text-slate-800
    "
>


<!-- =========================================================
     MOBILE OVERLAY
========================================================= -->

<div
    id="sidebarOverlay"
    class="
        fixed
        inset-0
        z-40
        hidden
        bg-slate-900/50
    "
></div>


<!-- =========================================================
     SIDEBAR
========================================================= -->

<aside
    id="sidebar"
    class="
        sidebar-transition
        fixed
        inset-y-0
        left-0
        z-50
        flex
        w-72
        -translate-x-full
        flex-col
        border-r
        border-slate-200
        bg-white
        lg:translate-x-0
    "
>


    <!-- =====================================================
         SIDEBAR HEADER
    ====================================================== -->

    <div
        class="
            flex
            h-20
            items-center
            gap-3
            border-b
            border-slate-100
            px-6
        "
    >

        <div
            class="
                flex
                h-11
                w-11
                shrink-0
                items-center
                justify-center
                rounded-xl
                bg-primary-600
                text-white
                shadow-lg
                shadow-primary-600/20
            "
        >

            <i
                class="
                    fa-solid
                    fa-graduation-cap
                    text-lg
                "
            ></i>

        </div>


        <div class="min-w-0">

            <h1
                class="
                    truncate
                    text-base
                    font-extrabold
                    tracking-tight
                    text-slate-900
                "
            >
                SMART SCHOOL
            </h1>


            <p
                class="
                    truncate
                    text-xs
                    text-slate-400
                "
            >
                Administration Platform
            </p>

        </div>


        <button
            id="closeSidebar"
            type="button"
            class="
                ml-auto
                flex
                h-9
                w-9
                items-center
                justify-center
                rounded-lg
                text-slate-400
                hover:bg-slate-100
                hover:text-slate-700
                lg:hidden
            "
            aria-label="Fermer le menu"
        >

            <i class="fa-solid fa-xmark"></i>

        </button>

    </div>


    <!-- =====================================================
         SIDEBAR NAVIGATION
    ====================================================== -->

    <div
        class="
            flex-1
            overflow-y-auto
            px-4
            py-6
        "
    >

        <p
            class="
                mb-3
                px-3
                text-[10px]
                font-bold
                uppercase
                tracking-[0.18em]
                text-slate-400
            "
        >
            Principal
        </p>


        <nav class="space-y-1">


            <!-- Dashboard -->

            <a
                href="/super-admin/dashboard"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    px-4
                    py-3
                    text-sm
                    font-medium
                    text-slate-600
                    transition
                    hover:bg-slate-50
                    hover:text-slate-900
                "
            >

                <i
                    class="
                        fa-solid
                        fa-chart-pie
                        w-5
                        text-center
                    "
                ></i>

                <span>
                    Tableau de bord
                </span>

            </a>


            <!-- Écoles -->

            <a
                href="/super-admin/ecoles"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    px-4
                    py-3
                    text-sm
                    font-medium
                    text-slate-600
                    transition
                    hover:bg-slate-50
                    hover:text-slate-900
                "
            >

                <i
                    class="
                        fa-solid
                        fa-school
                        w-5
                        text-center
                    "
                ></i>

                <span>
                    Écoles
                </span>

            </a>


            <!-- Utilisateurs -->

            <a
                href="/super-admin/utilisateurs"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    px-4
                    py-3
                    text-sm
                    font-medium
                    text-slate-600
                    transition
                    hover:bg-slate-50
                    hover:text-slate-900
                "
            >

                <i
                    class="
                        fa-solid
                        fa-users
                        w-5
                        text-center
                    "
                ></i>

                <span>
                    Utilisateurs
                </span>

            </a>

        </nav>


        <p
            class="
                mb-3
                mt-8
                px-3
                text-[10px]
                font-bold
                uppercase
                tracking-[0.18em]
                text-slate-400
            "
        >
            Supervision
        </p>


        <nav class="space-y-1">


            <!-- Statistiques ACTIVE -->

            <a
                href="/super-admin/statistiques"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    bg-primary-50
                    px-4
                    py-3
                    text-sm
                    font-semibold
                    text-primary-700
                "
            >

                <i
                    class="
                        fa-solid
                        fa-chart-line
                        w-5
                        text-center
                    "
                ></i>

                <span>
                    Statistiques
                </span>

            </a>


            <!-- Rapports -->

            <a
                href="/super-admin/rapports"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    px-4
                    py-3
                    text-sm
                    font-medium
                    text-slate-600
                    transition
                    hover:bg-slate-50
                    hover:text-slate-900
                "
            >

                <i
                    class="
                        fa-solid
                        fa-file-lines
                        w-5
                        text-center
                    "
                ></i>

                <span>
                    Rapports
                </span>

            </a>

        </nav>


        <p
            class="
                mb-3
                mt-8
                px-3
                text-[10px]
                font-bold
                uppercase
                tracking-[0.18em]
                text-slate-400
            "
        >
            Système
        </p>


        <nav class="space-y-1">


            <a
                href="/super-admin/profil"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    bg-primary-50
                    px-4
                    py-3
                    text-sm
                    font-semibold
                    text-primary-700
                "
            >

                <i class="fa-solid fa-user-gear w-5 text-center"></i>

                Mon profil

            </a>


            <!-- Notifications -->

            <a
                href="#"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    px-4
                    py-3
                    text-sm
                    font-medium
                    text-slate-600
                    transition
                    hover:bg-slate-50
                    hover:text-slate-900
                "
            >

                <i
                    class="
                        fa-solid
                        fa-bell
                        w-5
                        text-center
                    "
                ></i>

                <span>
                    Notifications
                </span>

            </a>


            <!-- Paramètres -->

            <a
                href="#"
                class="
                    flex
                    items-center
                    gap-3
                    rounded-xl
                    px-4
                    py-3
                    text-sm
                    font-medium
                    text-slate-600
                    transition
                    hover:bg-slate-50
                    hover:text-slate-900
                "
            >

                <i
                    class="
                        fa-solid
                        fa-gear
                        w-5
                        text-center
                    "
                ></i>

                <span>
                    Paramètres
                </span>

            </a>


            <!-- Déconnexion -->

            <button
                type="button"
                onclick="logout()"
                class="
                    flex
                    w-full
                    items-center
                    gap-3
                    rounded-xl
                    px-4
                    py-3
                    text-sm
                    text-red-500
                    transition
                    hover:bg-red-50
                "
            >

                <i
                    class="
                        fa-solid
                        fa-right-from-bracket
                        w-5
                        text-center
                    "
                ></i>

                <span>
                    Déconnexion
                </span>

            </button>

        </nav>

    </div>


    <!-- =====================================================
         SIDEBAR USER
    ====================================================== -->

    <div
        class="
            border-t
            border-slate-100
            p-4
        "
    >

        <div
            class="
                flex
                items-center
                gap-3
                rounded-xl
                bg-slate-50
                p-3
            "
        >

            <div
                id="sidebarAvatar"
                class="
                    flex
                    h-10
                    w-10
                    shrink-0
                    items-center
                    justify-center
                    rounded-full
                    bg-primary-100
                    text-sm
                    font-bold
                    text-primary-700
                "
            >
                SA
            </div>


            <div class="min-w-0 flex-1">

                <p
                    id="sidebarUserName"
                    class="
                        truncate
                        text-sm
                        font-bold
                        text-slate-800
                    "
                >
                    Super Administrateur
                </p>


                <p
                    id="sidebarUserEmail"
                    class="
                        truncate
                        text-xs
                        text-slate-400
                    "
                >
                    Chargement...
                </p>

            </div>

        </div>

    </div>

</aside>


<!-- =========================================================
     MAIN
========================================================= -->

<div class="min-h-screen lg:ml-72">


    <!-- HEADER -->

    <header
        class="
            sticky
            top-0
            z-30
            flex
            h-20
            items-center
            justify-between
            border-b
            border-slate-200
            bg-white/95
            px-4
            backdrop-blur
            sm:px-6
            lg:px-8
        "
    >

        <div class="flex items-center gap-4">

            <button
                id="openSidebar"
                type="button"
                class="
                    flex
                    h-10
                    w-10
                    items-center
                    justify-center
                    rounded-xl
                    text-slate-600
                    hover:bg-slate-100
                    lg:hidden
                "
            >

                <i class="fa-solid fa-bars"></i>

            </button>


            <div>

                <h2
                    class="
                        text-lg
                        font-bold
                        sm:text-xl
                    "
                >
                    Mon profil
                </h2>


                <p
                    class="
                        hidden
                        text-sm
                        text-slate-400
                        sm:block
                    "
                >
                    Gestion de votre compte Super Admin
                </p>

            </div>

        </div>


        <button
            type="button"
            onclick="logout()"
            class="
                hidden
                rounded-xl
                border
                border-red-100
                px-4
                py-2
                text-sm
                font-semibold
                text-red-500
                hover:bg-red-50
                sm:block
            "
        >
            Déconnexion
        </button>

    </header>


    <!-- CONTENT -->

    <main
        class="
            p-4
            sm:p-6
            lg:p-8
        "
    >


        <!-- INTRO -->

        <section class="mb-8">

            <div
                class="
                    mb-3
                    flex
                    flex-wrap
                    gap-2
                "
            >

                <span
                    class="
                        inline-flex
                        items-center
                        gap-2
                        rounded-full
                        bg-primary-50
                        px-3
                        py-1.5
                        text-xs
                        font-semibold
                        text-primary-700
                    "
                >

                    <i class="fa-solid fa-user-shield"></i>

                    Super Administrateur

                </span>


                <span
                    id="verificationBadge"
                    class="
                        inline-flex
                        items-center
                        gap-2
                        rounded-full
                        bg-slate-100
                        px-3
                        py-1.5
                        text-xs
                        font-semibold
                        text-slate-600
                    "
                >

                    <i class="fa-solid fa-circle-info"></i>

                    Vérification...

                </span>

            </div>


            <h1
                class="
                    text-2xl
                    font-bold
                    text-slate-900
                    sm:text-3xl
                "
            >
                Mon profil
            </h1>


            <p
                class="
                    mt-2
                    max-w-3xl
                    text-sm
                    leading-6
                    text-slate-500
                "
            >
                Gérez vos informations personnelles
                et la sécurité de votre compte
                d'administration.
            </p>

        </section>


        <!-- PROFILE HERO -->

        <section
            class="
                mb-6
                overflow-hidden
                rounded-2xl
                border
                border-slate-200
                bg-white
                shadow-sm
            "
        >

            <div
                class="
                    h-28
                    bg-gradient-to-r
                    from-primary-600
                    via-primary-500
                    to-cyan-400
                "
            ></div>


            <div class="px-5 pb-7 sm:px-8">

                <div
                    class="
                        -mt-10
                        flex
                        flex-col
                        gap-5
                        md:flex-row
                        md:items-end
                        md:justify-between
                    "
                >

                    <div
                        class="
                            flex
                            flex-col
                            gap-4
                            sm:flex-row
                            sm:items-end
                        "
                    >

                        <div
                            id="profileAvatar"
                            class="
                                avatar-ring
                                flex
                                h-24
                                w-24
                                shrink-0
                                items-center
                                justify-center
                                rounded-full
                                border-4
                                border-white
                                bg-primary-100
                                text-2xl
                                font-bold
                                text-primary-700
                            "
                        >
                            SA
                        </div>


                        <div class="pb-1">

                            <div
                                class="
                                    flex
                                    flex-wrap
                                    items-center
                                    gap-2
                                "
                            >

                                <h2
                                    id="profileName"
                                    class="
                                        text-2xl
                                        font-bold
                                        text-slate-900
                                    "
                                >
                                    Chargement...
                                </h2>


                                <span
                                    id="statusBadge"
                                    class="
                                        rounded-full
                                        bg-emerald-50
                                        px-2.5
                                        py-1
                                        text-[10px]
                                        font-semibold
                                        text-emerald-700
                                    "
                                >
                                    —
                                </span>

                            </div>


                            <p
                                class="
                                    mt-1
                                    text-sm
                                    text-slate-500
                                "
                            >
                                Administrateur système
                            </p>


                            <div
                                class="
                                    mt-3
                                    flex
                                    flex-wrap
                                    gap-x-4
                                    gap-y-2
                                    text-xs
                                    text-slate-400
                                "
                            >

                                <span>

                                    <i
                                        class="
                                            fa-solid
                                            fa-envelope
                                            mr-1
                                        "
                                    ></i>

                                    <span id="profileEmail">
                                        —
                                    </span>

                                </span>


                                <span>

                                    <i
                                        class="
                                            fa-solid
                                            fa-phone
                                            mr-1
                                        "
                                    ></i>

                                    <span id="profilePhone">
                                        —
                                    </span>

                                </span>

                            </div>

                        </div>

                    </div>


                    <button
                        type="button"
                        onclick="switchTab('personal')"
                        class="
                            inline-flex
                            items-center
                            justify-center
                            gap-2
                            rounded-xl
                            bg-primary-600
                            px-4
                            py-2.5
                            text-xs
                            font-semibold
                            text-white
                            hover:bg-primary-700
                        "
                    >

                        <i class="fa-solid fa-pen"></i>

                        Modifier le profil

                    </button>

                </div>

            </div>

        </section>


        <!-- TABS -->

        <div
            class="
                mb-6
                flex
                gap-2
                overflow-x-auto
                pb-2
            "
        >

            <button
                type="button"
                data-tab-button="personal"
                onclick="switchTab('personal')"
                class="
                    shrink-0
                    rounded-xl
                    bg-primary-600
                    px-4
                    py-2.5
                    text-sm
                    font-semibold
                    text-white
                "
            >

                <i class="fa-solid fa-user mr-1"></i>

                Informations

            </button>


            <button
                type="button"
                data-tab-button="security"
                onclick="switchTab('security')"
                class="
                    shrink-0
                    rounded-xl
                    bg-slate-100
                    px-4
                    py-2.5
                    text-sm
                    font-semibold
                    text-slate-600
                "
            >

                <i class="fa-solid fa-shield-halved mr-1"></i>

                Sécurité

            </button>


            <button
                type="button"
                data-tab-button="account"
                onclick="switchTab('account')"
                class="
                    shrink-0
                    rounded-xl
                    bg-slate-100
                    px-4
                    py-2.5
                    text-sm
                    font-semibold
                    text-slate-600
                "
            >

                <i class="fa-solid fa-gear mr-1"></i>

                Compte

            </button>

        </div>


        <!-- =====================================================
             PERSONAL
        ====================================================== -->

        <section id="personalTab">

            <div
                class="
                    grid
                    grid-cols-1
                    gap-6
                    xl:grid-cols-3
                "
            >

                <div
                    class="
                        overflow-hidden
                        rounded-2xl
                        border
                        border-slate-200
                        bg-white
                        shadow-sm
                        xl:col-span-2
                    "
                >

                    <div
                        class="
                            border-b
                            border-slate-100
                            px-5
                            py-5
                            sm:px-6
                        "
                    >

                        <div class="flex items-center gap-3">

                            <div
                                class="
                                    flex
                                    h-10
                                    w-10
                                    items-center
                                    justify-center
                                    rounded-xl
                                    bg-primary-50
                                    text-primary-600
                                "
                            >

                                <i class="fa-solid fa-user-pen"></i>

                            </div>


                            <div>

                                <h2 class="font-bold">
                                    Informations personnelles
                                </h2>


                                <p
                                    class="
                                        mt-1
                                        text-sm
                                        text-slate-400
                                    "
                                >
                                    Modifiez les informations
                                    associées à votre compte.
                                </p>

                            </div>

                        </div>

                    </div>


                    <form
                        id="profileForm"
                        onsubmit="saveProfile(event)"
                        class="p-5 sm:p-6"
                    >

                        <div
                            class="
                                grid
                                grid-cols-1
                                gap-5
                                md:grid-cols-2
                            "
                        >

                            <div>

                                <label
                                    class="
                                        mb-2
                                        block
                                        text-xs
                                        font-semibold
                                        text-slate-500
                                    "
                                >
                                    Prénom
                                </label>


                                <input
                                    id="prenom"
                                    type="text"
                                    class="form-input"
                                    required
                                >

                            </div>


                            <div>

                                <label
                                    class="
                                        mb-2
                                        block
                                        text-xs
                                        font-semibold
                                        text-slate-500
                                    "
                                >
                                    Nom
                                </label>


                                <input
                                    id="nom"
                                    type="text"
                                    class="form-input"
                                    required
                                >

                            </div>


                            <div>

                                <label
                                    class="
                                        mb-2
                                        block
                                        text-xs
                                        font-semibold
                                        text-slate-500
                                    "
                                >
                                    Postnom
                                </label>


                                <input
                                    id="postnom"
                                    type="text"
                                    class="form-input"
                                >

                            </div>


                            <div>

                                <label
                                    class="
                                        mb-2
                                        block
                                        text-xs
                                        font-semibold
                                        text-slate-500
                                    "
                                >
                                    Pseudo
                                </label>


                                <input
                                    id="pseudo"
                                    type="text"
                                    class="form-input"
                                >

                            </div>


                            <div>

                                <label
                                    class="
                                        mb-2
                                        block
                                        text-xs
                                        font-semibold
                                        text-slate-500
                                    "
                                >
                                    Adresse e-mail
                                </label>


                                <input
                                    id="email"
                                    type="email"
                                    class="form-input"
                                    required
                                >

                            </div>


                            <div>

                                <label
                                    class="
                                        mb-2
                                        block
                                        text-xs
                                        font-semibold
                                        text-slate-500
                                    "
                                >
                                    Téléphone
                                </label>


                                <input
                                    id="telephone"
                                    type="tel"
                                    class="form-input"
                                >

                            </div>


                            <div>

                                <label
                                    class="
                                        mb-2
                                        block
                                        text-xs
