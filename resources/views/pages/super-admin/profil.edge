<script>

/*
|--------------------------------------------------------------------------
| API
|--------------------------------------------------------------------------
*/

const PROFILE_API =
    '/api/super-admin/profile'

const PASSWORD_API =
    '/api/auth/change-password'


/*
|--------------------------------------------------------------------------
| TOKEN
|--------------------------------------------------------------------------
*/

function getToken() {

    return sessionStorage.getItem(
        'smart_school_access_token'
    )

}


/*
|--------------------------------------------------------------------------
| API REQUEST
|--------------------------------------------------------------------------
*/

async function apiRequest(
    url,
    options = {}
) {

    const token =
        getToken()


    if (!token) {

        sessionStorage.clear()

        window.location.replace('/')

        throw new Error(
            'Votre session a expiré.'
        )

    }


    const response =
        await fetch(
            url,
            {

                ...options,

                headers: {

                    ...(options.headers || {}),

                    Authorization:
                        `Bearer ${token}`,

                    Accept:
                        'application/json',

                },

            }
        )


    if (
        response.status ===
        401
    ) {

        sessionStorage.clear()

        window.location.replace('/')

        throw new Error(
            'Votre session a expiré.'
        )

    }


    return response

}


/*
|--------------------------------------------------------------------------
| FORMATAGE
|--------------------------------------------------------------------------
*/

function formatDate(
    value
) {

    if (!value) {

        return '—'

    }


    const date =
        new Date(value)


    if (
        Number.isNaN(
            date.getTime()
        )
    ) {

        return '—'

    }


    return date.toLocaleString(
        'fr-FR',
        {
            dateStyle:
                'medium',
            timeStyle:
                'short',
        }
    )

}


function initials(
    prenom,
    nom
) {

    const first =
        String(
            prenom || ''
        )
            .trim()
            .charAt(0)


    const last =
        String(
            nom || ''
        )
            .trim()
            .charAt(0)


    return (
        `${first}${last}` ||
        'SA'
    ).toUpperCase()

}


/*
|--------------------------------------------------------------------------
| TOAST
|--------------------------------------------------------------------------
*/

function showToast(
    message,
    type = 'success'
) {

    document
        .getElementById(
            'smartSchoolToast'
        )
        ?.remove()


    const toast =
        document.createElement(
            'div'
        )


    const icon =
        type === 'error'
            ? 'fa-circle-exclamation'
            : 'fa-circle-check'


    const iconClass =
        type === 'error'
            ? 'text-red-600 bg-red-50'
            : 'text-emerald-600 bg-emerald-50'


    toast.id =
        'smartSchoolToast'


    toast.className =
        `
            fixed
            bottom-5
            right-5
            z-[200]
            flex
            max-w-sm
            items-center
            gap-3
            rounded-2xl
            border
            border-slate-200
            bg-white
            px-4
            py-3
            shadow-2xl
        `


    toast.innerHTML =
        `
            <div
                class="
                    flex
                    h-9
                    w-9
                    shrink-0
                    items-center
                    justify-center
                    rounded-xl
                    ${iconClass}
                "
            >
                <i class="fa-solid ${icon}"></i>
            </div>

            <p class="text-sm font-medium text-slate-700">
                ${String(message)
                    .replaceAll('&', '&amp;')
                    .replaceAll('<', '&lt;')
                    .replaceAll('>', '&gt;')}
            </p>
        `


    document.body.appendChild(
        toast
    )


    setTimeout(
        () => toast.remove(),
        3500
    )

}


/*
|--------------------------------------------------------------------------
| CHARGEMENT PROFIL
|--------------------------------------------------------------------------
*/

async function loadProfile() {

    try {

        const response =
            await apiRequest(
                PROFILE_API
            )


        const result =
            await response.json()


        if (
            !response.ok ||
            !result?.success
        ) {

            throw new Error(
                result?.message ||
                'Impossible de récupérer votre profil.'
            )

        }


        const user =
            result.data


        /*
         * FORMULAIRE
         */

        document
            .getElementById(
                'prenom'
            )
            .value =
            user.prenom ?? ''


        document
            .getElementById(
                'nom'
            )
            .value =
            user.nom ?? ''


        document
            .getElementById(
                'postnom'
            )
            .value =
            user.postnom ?? ''


        document
            .getElementById(
                'pseudo'
            )
            .value =
            user.pseudo ?? ''


        document
            .getElementById(
                'email'
            )
            .value =
            user.email ?? ''


        document
            .getElementById(
                'telephone'
            )
            .value =
            user.telephone ?? ''


        document
            .getElementById(
                'sexe'
            )
            .value =
            user.sexe ?? ''


        document
            .getElementById(
                'statut'
            )
            .value =
            user.statut ?? '—'


        /*
         * NOM
         */

        const fullName =
            [
                user.prenom,
                user.postnom,
                user.nom
            ]
                .filter(Boolean)
                .join(' ')


        const avatar =
            initials(
                user.prenom,
                user.nom
            )


        document
            .getElementById(
                'profileName'
            )
            .textContent =
            fullName ||
            'Super Administrateur'


        document
            .getElementById(
                'profileAvatar'
            )
            .textContent =
            avatar


        document
            .getElementById(
                'sidebarAvatar'
            )
            .textContent =
            avatar


        document
            .getElementById(
                'sidebarUserName'
            )
            .textContent =
            fullName ||
            'Super Administrateur'


        document
            .getElementById(
                'sidebarUserEmail'
            )
            .textContent =
            user.email ||
            '—'


        document
            .getElementById(
                'profileEmail'
            )
            .textContent =
            user.email ||
            '—'


        document
            .getElementById(
                'profilePhone'
            )
            .textContent =
            user.telephone ||
            'Non renseigné'


        /*
         * STATUT
         */

        const status =
            String(
                user.statut ||
                ''
            ).toUpperCase()


        const statusBadge =
            document.getElementById(
                'statusBadge'
            )


        if (
            status ===
            'ACTIF'
        ) {

            statusBadge.textContent =
                'Compte actif'

            statusBadge.className =
                `
                    rounded-full
                    bg-emerald-50
                    px-2.5
                    py-1
                    text-[10px]
                    font-semibold
                    text-emerald-700
                `

        } else {

            statusBadge.textContent =
                user.statut ||
                'Statut inconnu'

            statusBadge.className =
                `
                    rounded-full
                    bg-amber-50
                    px-2.5
                    py-1
                    text-[10px]
                    font-semibold
                    text-amber-700
                `

        }


        /*
         * VÉRIFICATION E-MAIL
         */

        const verificationBadge =
            document.getElementById(
                'verificationBadge'
            )


        const securityEmailStatus =
            document.getElementById(
                'securityEmailStatus'
            )


        if (
            user.isVerified
        ) {

            verificationBadge.innerHTML =
                `
                    <i class="fa-solid fa-circle-check"></i>
                    E-mail vérifié
                `


            verificationBadge.className =
                `
                    inline-flex
                    items-center
                    gap-2
                    rounded-full
                    bg-emerald-50
                    px-3
                    py-1.5
                    text-xs
                    font-semibold
                    text-emerald-700
                `


            securityEmailStatus.textContent =
                'Adresse confirmée'

            securityEmailStatus.className =
                `
                    mt-1
                    text-[10px]
                    text-emerald-600
                `

        } else {

            verificationBadge.innerHTML =
                `
                    <i class="fa-solid fa-circle-exclamation"></i>
                    E-mail non vérifié
                `


            verificationBadge.className =
                `
                    inline-flex
                    items-center
                    gap-2
                    rounded-full
                    bg-amber-50
                    px-3
                    py-1.5
                    text-xs
                    font-semibold
                    text-amber-700
                `


            securityEmailStatus.textContent =
                'Adresse non confirmée'

            securityEmailStatus.className =
                `
                    mt-1
                    text-[10px]
                    text-amber-600
                `

        }


        /*
         * COMPTE
         */

        document
            .getElementById(
                'accountId'
            )
            .textContent =
            `#${user.id}`


        document
            .getElementById(
                'accountId2'
            )
            .textContent =
            `#${user.id}`


        document
            .getElementById(
                'accountRole'
            )
            .textContent =
            user.systemRole ||
            'SUPER_ADMIN'


        document
            .getElementById(
                'accountRole2'
            )
            .textContent =
            user.systemRole ||
            'SUPER_ADMIN'


        document
            .getElementById(
                'accountStatus2'
            )
            .textContent =
            user.statut ||
            '—'


        document
            .getElementById(
                'accountCreatedAt'
            )
            .textContent =
            formatDate(
                user.createdAt
            )


        document
            .getElementById(
                'accountLastLogin'
            )
            .textContent =
            formatDate(
                user.lastLoginAt
            )

    } catch (
        error
    ) {

        console.error(
            'Profile:',
            error
        )


        showToast(
            error.message ||
            'Impossible de charger votre profil.',
            'error'
        )

    }

}


/*
|--------------------------------------------------------------------------
| MODIFICATION PROFIL
|--------------------------------------------------------------------------
*/

async function saveProfile(
    event
) {

    event.preventDefault()


    const errorElement =
        document.getElementById(
            'profileFormError'
        )


    errorElement.classList.add(
        'hidden'
    )


    const button =
        document.getElementById(
            'saveProfileButton'
        )


    const icon =
        document.getElementById(
            'saveProfileIcon'
        )


    const text =
        document.getElementById(
            'saveProfileText'
        )


    const payload = {

        prenom:
            document
                .getElementById(
                    'prenom'
                )
                .value
                .trim(),

        nom:
            document
                .getElementById(
                    'nom'
                )
                .value
                .trim(),

        postnom:
            document
                .getElementById(
                    'postnom'
                )
                .value
                .trim(),

        pseudo:
            document
                .getElementById(
                    'pseudo'
                )
                .value
                .trim(),

        email:
            document
                .getElementById(
                    'email'
                )
                .value
                .trim(),

        telephone:
            document
                .getElementById(
                    'telephone'
                )
                .value
                .trim(),

        sexe:
            document
                .getElementById(
                    'sexe'
                )
                .value,

    }


    button.disabled =
        true


    icon.className =
        'fa-solid fa-spinner fa-spin'


    text.textContent =
        'Enregistrement...'


    try {

        const response =
            await apiRequest(
                PROFILE_API,
                {

                    method:
                        'PUT',

                    headers: {

                        'Content-Type':
                            'application/json',

                    },

                    body:
                        JSON.stringify(
                            payload
                        ),

                }
            )


        const result =
            await response.json()


        if (
            !response.ok ||
            !result?.success
        ) {

            throw new Error(
                result?.message ||
                'Impossible de modifier le profil.'
            )

        }


        showToast(
            result.message ||
            'Profil mis à jour avec succès.'
        )


        await loadProfile()

    } catch (
        error
    ) {

        console.error(
            'Update profile:',
            error
        )


        errorElement.textContent =
            error.message


        errorElement.classList.remove(
            'hidden'
        )

    } finally {

        button.disabled =
            false

        icon.className =
            'fa-solid fa-floppy-disk'

        text.textContent =
            'Enregistrer'

    }

}


/*
|--------------------------------------------------------------------------
| TABS
|--------------------------------------------------------------------------
*/

function switchTab(
    tab
) {

    const tabs = [
        'personal',
        'security',
        'account'
    ]


    tabs.forEach(
        name => {

            const section =
                document.getElementById(
                    `${name}Tab`
                )


            const button =
                document.querySelector(
                    `[data-tab-button="${name}"]`
                )


            if (
                name === tab
            ) {

                section.classList.remove(
                    'hidden'
                )


                button.className =
                    `
                        shrink-0
                        rounded-xl
                        bg-primary-600
                        px-4
                        py-2.5
                        text-sm
                        font-semibold
                        text-white
                    `

            } else {

                section.classList.add(
                    'hidden'
                )


                button.className =
                    `
                        shrink-0
                        rounded-xl
                        bg-slate-100
                        px-4
                        py-2.5
                        text-sm
                        font-semibold
                        text-slate-600
                    `

            }

        }
    )


    window.scrollTo({
        top: 0,
        behavior: 'smooth'
    })

}


/*
|--------------------------------------------------------------------------
| PASSWORD VISIBILITY
|--------------------------------------------------------------------------
*/

function togglePassword(
    inputId,
    button
) {

    const input =
        document.getElementById(
            inputId
        )


    const icon =
        button.querySelector(
            'i'
        )


    const show =
        input.type ===
        'password'


    input.type =
        show
            ? 'text'
            : 'password'


    icon.classList.toggle(
        'fa-eye',
        !show
    )


    icon.classList.toggle(
        'fa-eye-slash',
        show
    )

}


/*
|--------------------------------------------------------------------------
| PASSWORD STRENGTH
|--------------------------------------------------------------------------
*/

function updatePasswordStrength() {

    const password =
        document
            .getElementById(
                'newPassword'
            )
            .value


    const bar =
        document.getElementById(
            'passwordStrength'
        )


    const text =
        document.getElementById(
            'passwordStrengthText'
        )


    let score = 0


    if (
        password.length >= 8
    ) score++


    if (
        /[A-Z]/.test(
            password
        )
    ) score++


    if (
        /[a-z]/.test(
            password
        )
    ) score++


    if (
        /[0-9]/.test(
            password
        )
    ) score++


    if (
        /[^A-Za-z0-9]/.test(
            password
        )
    ) score++


    bar.style.width =
        `${score * 20}%`


    if (
        score <= 1
    ) {

        bar.style.backgroundColor =
            '#ef4444'

        text.textContent =
            'Mot de passe faible'

    } else if (
        score <= 3
    ) {

        bar.style.backgroundColor =
            '#f59e0b'

        text.textContent =
            'Mot de passe moyen'

    } else {

        bar.style.backgroundColor =
            '#10b981'

        text.textContent =
            'Mot de passe fort'

    }

}


/*
|--------------------------------------------------------------------------
| CHANGEMENT MOT DE PASSE
|--------------------------------------------------------------------------
*/

async function changePassword(
    event
) {

    event.preventDefault()


    const current =
        document
            .getElementById(
                'currentPassword'
            )
            .value


    const next =
        document
            .getElementById(
                'newPassword'
            )
            .value


    const confirmation =
        document
            .getElementById(
                'confirmPassword'
            )
            .value


    const errorElement =
        document.getElementById(
            'passwordError'
        )


    errorElement.classList.add(
        'hidden'
    )


    if (
        next.length < 8
    ) {

        errorElement.textContent =
            'Le nouveau mot de passe doit contenir au moins 8 caractères.'

        errorElement.classList.remove(
            'hidden'
        )

        return

    }


    if (
        next !== confirmation
    ) {

        errorElement.textContent =
            'Les mots de passe ne correspondent pas.'

        errorElement.classList.remove(
            'hidden'
        )

        return

    }


    const button =
        document.getElementById(
            'changePasswordButton'
        )


    const icon =
        document.getElementById(
            'changePasswordIcon'
        )


    const text =
        document.getElementById(
            'changePasswordText'
        )


    button.disabled =
        true


    icon.className =
        'fa-solid fa-spinner fa-spin'


    text.textContent =
        'Modification...'


    try {

        const response =
            await apiRequest(
                PASSWORD_API,
                {

                    method:
                        'PATCH',

                    headers: {

                        'Content-Type':
                            'application/json',

                    },

                    body:
                        JSON.stringify({

                            current_password:
                                current,

                            new_password:
                                next,

                            new_password_confirmation:
                                confirmation,

                        }),

                }
            )


        const result =
            await response.json()


        if (
            !response.ok ||
            !result?.success
        ) {

            throw new Error(
                result?.message ||
                'Impossible de modifier le mot de passe.'
            )

        }


        document
            .getElementById(
                'currentPassword'
            )
            .value =
            ''


        document
            .getElementById(
                'newPassword'
            )
            .value =
            ''


        document
            .getElementById(
                'confirmPassword'
            )
            .value =
            ''


        document
            .getElementById(
                'passwordStrength'
            )
            .style.width =
            '0'


        document
            .getElementById(
                'passwordStrengthText'
            )
            .textContent =
            'Minimum 8 caractères'


        showToast(
            result.message ||
            'Mot de passe modifié avec succès.'
        )

    } catch (
        error
    ) {

        console.error(
            'Change password:',
            error
        )


        errorElement.textContent =
            error.message


        errorElement.classList.remove(
            'hidden'
        )

    } finally {

        button.disabled =
            false

        icon.className =
            'fa-solid fa-key'

        text.textContent =
            'Modifier le mot de passe'

    }

}


/*
|--------------------------------------------------------------------------
| SIDEBAR
|--------------------------------------------------------------------------
*/

const sidebar =
    document.getElementById(
        'sidebar'
    )


const overlay =
    document.getElementById(
        'sidebarOverlay'
    )


document
    .getElementById(
        'openSidebar'
    )
    ?.addEventListener(
        'click',
        () => {

            sidebar.classList.remove(
                '-translate-x-full'
            )

            overlay.classList.remove(
                'hidden'
            )

        }
    )


document
    .getElementById(
        'closeSidebar'
    )
    ?.addEventListener(
        'click',
        hideSidebar
    )


overlay
    ?.addEventListener(
        'click',
        hideSidebar
    )


function hideSidebar() {

    sidebar.classList.add(
        '-translate-x-full'
    )

    overlay.classList.add(
        'hidden'
    )

}


/*
|--------------------------------------------------------------------------
| LOGOUT
|--------------------------------------------------------------------------
*/

async function logout() {

    if (
        !window.confirm(
            'Voulez-vous vraiment vous déconnecter ?'
        )
    ) {

        return

    }


    const token =
        getToken()


    try {

        if (token) {

            await fetch(
                '/api/auth/logout',
                {

                    method:
                        'POST',

                    headers: {

                        Authorization:
                            `Bearer ${token}`,

                        Accept:
                            'application/json',

                    },

                }
            )

        }

    } catch (
        error
    ) {

        console.error(
            'Logout:',
            error
        )

    } finally {

        sessionStorage.clear()

        window.location.replace(
            '/'
        )

    }

}


/*
|--------------------------------------------------------------------------
| INITIALISATION
|--------------------------------------------------------------------------
*/

document.addEventListener(
    'DOMContentLoaded',
    () => {

        loadProfile()

        switchTab(
            'personal'
        )

    }
)

</script>

</body>

</html>